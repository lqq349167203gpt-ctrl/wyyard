/* 公共登录面板样式 — 与「我的」页会员卡同一套设计语言 */
/* 组件样式隔离,不依赖页面;宿主页面提供浅灰底色即可 */

.profile-card {
  background: #ffffff;
  border-radius: 40rpx;
  padding: 52rpx 32rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 4rpx rgba(33, 38, 49, 0.05);
}

/* 空头像:灰底人形剪影占位 */
.avatar-empty {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: #eef0f2;
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
}

.ae-head {
  position: absolute;
  left: 50%;
  top: 26rpx;
  transform: translateX(-50%);
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: #c3c9d2;
}

.ae-body {
  position: absolute;
  left: 50%;
  bottom: -10rpx;
  transform: translateX(-50%);
  width: 92rpx;
  height: 62rpx;
  border-radius: 46rpx 46rpx 0 0;
  background: #c3c9d2;
}

.nickname {
  margin-top: 28rpx;
  font-size: 36rpx;
  font-weight: 800;
  color: #212631;
  letter-spacing: -0.01em;
}

.member-type {
  margin-top: 16rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #3d5500;
  background: #c9f24b;
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
  line-height: 1.5;
}

.stats {
  display: flex;
  width: 100%;
  margin-top: 36rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(33, 38, 49, 0.07);
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 34rpx;
  font-weight: 800;
  color: #212631;
  letter-spacing: -0.02em;
}

.stat.feat .stat-num {
  font-size: 26rpx;
  font-weight: 700;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #a8b1bd;
  font-weight: 600;
}

/* 登录按钮:flex 双向居中(不依赖行高,各端一致) */
/* 与卡片保持适度间距:不贴卡片、不沉底,重心落在页面中段 */
.login-area {
  margin-top: 12vh;
  padding-bottom: 24rpx;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #212631;
  color: #c9f24b;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  border-radius: 999rpx;
  border: none;
}

.login-btn::after {
  border: none;
}

.login-btn-hover {
  background: #3a4150;
}

/* 按钮下说明灰字 */
.login-tip {
  display: block;
  margin-top: 22rpx;
  text-align: center;
  font-size: 20rpx;
  color: #a8b1bd;
}
