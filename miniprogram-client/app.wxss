page {
  background-color: #f7f8fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 14px;
  color: #2b2f36;
  line-height: 1.5;
}

/* 活动图片默认调色：方案二·轻滤镜 */
.activity-image-filter {
  filter: saturate(0.8) contrast(1.03) brightness(1.02);
}
/* 个人历史分页提示：追加失败不替换已加载列表。 */
.history-page-status {
  padding: 24rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #8f959e;
}
