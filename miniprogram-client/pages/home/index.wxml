<view class="page">
  <!-- 加载中 -->
  <view wx:if="{{loading && activities.length === 0}}" class="loading">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{!loading && activities.length === 0}}" class="empty">
    <text class="empty-text">暂无活动</text>
    <text class="empty-hint">请关注后续活动安排</text>
  </view>

  <!-- 活动列表 -->
  <view wx:else class="list">
    <block wx:for="{{grouped}}" wx:key="date">
      <view class="date-group">
        <view class="date-header">
          <text class="date-text">{{item.date}}</text>
          <text class="date-weekday">{{item.weekday}}</text>
        </view>
        <view
          wx:for="{{item.items}}"
          wx:for-item="act"
          wx:key="id"
          class="card"
          bindtap="onTapActivity"
          data-id="{{act.id}}"
        >
          <view class="card-top">
            <text class="card-name">{{act.name}}</text>
            <view class="card-tags">
              <text wx:if="{{act.activity_mode === '线上'}}" class="tag tag-online">线上</text>
              <text wx:if="{{act.is_public_welfare}}" class="tag tag-welfare">公益</text>
            </view>
          </view>
          <view class="card-info">
            <view class="info-row">
              <text class="info-label">时间</text>
              <text class="info-value">{{act.start_time || '待定'}}{{act.end_time ? ' - ' + act.end_time : ''}}</text>
            </view>
            <view wx:if="{{act.teacher_names.length > 0}}" class="info-row">
              <text class="info-label">老师</text>
              <text class="info-value">{{act.teacher_names[0]}}</text>
            </view>
            <view wx:if="{{act.location}}" class="info-row">
              <text class="info-label">地点</text>
              <text class="info-value">{{act.location}}</text>
            </view>
          </view>
          <view wx:if="{{act.description}}" class="card-desc">
            <text class="desc-text">{{act.description}}</text>
          </view>
        </view>
      </view>
    </block>

    <!-- 加载更多 -->
    <view wx:if="{{loading}}" class="loading-more">
      <text class="loading-text">加载中...</text>
    </view>
    <view wx:elif="{{!hasMore && activities.length > 0}}" class="no-more">
      <text class="no-more-text">已显示全部活动</text>
    </view>
  </view>
</view>
