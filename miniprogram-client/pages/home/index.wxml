<view class="page">
  <!-- 日期行:兼任月历入口 -->
  <view class="datebar" bindtap="onTapHeroDate">
    <view class="d-btn">
      <text class="d-strong">{{heroText}}</text>
      <text class="d-em">· {{heroWeek}}</text>
      <view class="d-arrow"></view>
    </view>
    <text class="d-count">{{themeCount}} 场活动</text>
  </view>

  <!-- 周日历：左右滑动切换整周，日期仍可单独点击 -->
  <swiper
    class="week-swiper"
    current="{{weekSwiperCurrent}}"
    duration="{{weekSwiperDuration}}"
    easing-function="easeOutCubic"
    circular
    bindchange="onWeekSwiperChange"
    skip-hidden-item-layout
  >
    <swiper-item wx:for="{{weekPages}}" wx:key="key" wx:for-item="weekPage">
      <view class="week">
        <view wx:for="{{weekPage.days}}" wx:key="dateStr" wx:for-item="day" class="wk {{day.selected ? 'sel' : ''}} {{day.hasActivity ? 'has' : ''}}" bindtap="onTapDay" data-date="{{day.dateStr}}">
          <text class="wk-name">{{day.name}}</text>
          <view class="wk-num-wrap">
            <text class="wk-num">{{day.num}}</text>
          </view>
          <view class="wk-dot"></view>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <!-- 主题区 -->
  <view class="section" wx:if="{{themeWeek || themeTitle}}">
    <view wx:if="{{themeWeek}}" class="theme-week">
      <text class="theme-week-label">本周主题</text>
      <text class="theme-week-text">{{themeWeek}}</text>
    </view>
    <view wx:if="{{themeTitle}}" class="theme-main">
      <text class="theme-eyebrow">当日主题</text>
      <text class="theme-title">{{themeTitle}}</text>
      <text class="theme-copy" wx:if="{{themeDesc}}">{{themeDesc}}</text>
      <!-- 周一至周日：按当前选中日期切换蜡笔装饰 -->
      <image class="theme-deco" src="{{themeDecoSrc}}" mode="aspectFit" />
    </view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading && grouped.length === 0}}" class="loading">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{!loading && grouped.length === 0}}" class="empty">
    <view class="e-icon">
      <view class="e-chime">
        <view class="e-string"></view>
        <view class="e-dome"></view>
        <view class="e-rim"></view>
        <view class="e-clap"></view>
        <view class="e-paper">
          <view class="e-paper-line"></view>
          <view class="e-paper-line short"></view>
        </view>
      </view>
      <view class="e-leaf e-leaf-a"></view>
      <view class="e-leaf e-leaf-b"></view>
    </view>
    <text class="e-title">暂无活动</text>
    <text class="e-sub">新活动发布后会第一时间在这里出现</text>
  </view>

  <!-- 活动列表(无分割线) -->
  <view wx:else class="activity-list">
    <block wx:for="{{grouped}}" wx:key="date">
      <!-- 日期头(多日时显示) -->
      <view wx:if="{{grouped.length > 1}}" class="day-head" id="day-{{item.date}}">
        <text class="dh-date">{{item.dateLabel}}</text>
        <view class="dh-diamond"></view>
        <text class="dh-week">{{item.weekday}}<text wx:if="{{item.isToday}}" class="today"> · 今天</text></text>
      </view>
      <view wx:else id="day-{{item.date}}"></view>
      <!-- 活动行 -->
      <view
        wx:for="{{item.items}}"
        wx:for-item="act"
        wx:key="id"
        class="ev-row"
        bindtap="onTapActivity"
        data-id="{{act.id}}"
      >
        <view class="ev-cover">
          <image
            wx:if="{{act.list_image}}"
            class="ev-cover-img"
            src="{{act.list_image}}"
            mode="aspectFill"
            data-id="{{act.id}}"
            binderror="onActivityImageError"
          />
          <view wx:else class="ev-cover-placeholder"></view>
          <view class="ev-signup-mask">
            <text class="ev-signup-text">{{act.signup_count || 0}}人</text>
          </view>
        </view>
        <view class="ev-body">
          <view class="ev-name-row">
            <text class="ev-name">{{act.name}}</text>
          </view>
          <view class="ev-time">
            <view wx:if="{{act.isPublicWelfare || act.isOnline}}" class="ev-time-tags">
              <text wx:if="{{act.isPublicWelfare}}" class="ev-tag-gy">公益</text>
              <text wx:if="{{act.isOnline}}" class="ev-tag-ol">线上</text>
            </view>
            <view class="ev-time-value">
              <text class="ev-t1">{{act.start_time || '待定'}}</text>
              <text wx:if="{{act.end_time}}" class="ev-t2"> – {{act.end_time}}</text>
            </view>
          </view>
          <view wx:if="{{act.locationText}}" class="ev-teacher-row">
            <view class="ev-teacher-avatars">
              <block wx:for="{{act.teacherPreview}}" wx:key="index" wx:for-item="teacher">
                <image wx:if="{{teacher.avatarUrl}}" class="ev-teacher-avatar" src="{{teacher.avatarUrl}}" mode="aspectFill" />
                <view wx:else class="ev-teacher-avatar ev-teacher-fallback">{{teacher.initial}}</view>
              </block>
            </view>
            <text class="ev-teacher">{{act.locationText}}</text>
          </view>
          <text wx:if="{{act.introText}}" class="ev-desc">{{act.introText}}</text>
        </view>
        <text wx:if="{{act.isEnded}}" class="ev-ended-tag">已结束</text>
        <text wx:else class="ev-chev">›</text>
      </view>
    </block>

    <!-- 加载更多 -->
    <view wx:if="{{loading}}" class="loading-more">
      <text class="loading-text">加载中...</text>
    </view>
    <view wx:elif="{{!hasMore && grouped.length > 0}}" class="no-more">
      <text class="no-more-text">已显示全部活动</text>
    </view>
  </view>

  <!-- 月历选择弹层 -->
  <view wx:if="{{calVisible}}" class="cal-mask" bindtap="onCalClose">
    <view class="cal-sheet" catchtap="">
      <view class="cal-grab"></view>
      <view class="cal-head">
        <text class="cal-title">{{calYear}}年{{calMonth}}月</text>
        <view class="cal-navs">
          <view class="cal-nav" bindtap="onCalPrev">‹</view>
          <view class="cal-nav" bindtap="onCalNext">›</view>
        </view>
      </view>
      <view class="cal-week">
        <text wx:for="{{calWeekNames}}" wx:key="*this" class="cal-wk">{{item}}</text>
      </view>
      <view class="cal-grid">
        <view
          wx:for="{{calCells}}"
          wx:key="index"
          class="cal-cell {{item.inMonth ? '' : 'cal-out'}} {{item.isSelected ? 'cal-sel' : ''}} {{item.hasAct ? 'cal-has' : ''}}"
          data-date="{{item.dateStr}}"
          bindtap="onCalTapDay"
        >
          <view class="cal-num">{{item.day}}</view>
          <view class="cal-dot"></view>
        </view>
      </view>
    </view>
  </view>
</view>
