.page {
  min-height: 100vh;
  background: #ffffff;
  padding: 0;
  box-sizing: border-box;
}

/* ===== 日期行:兼任月历入口 ===== */
.datebar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 40rpx 20rpx;
}

.d-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.d-strong {
  font-size: 25rpx;
  font-weight: 800;
  color: #212631;
}

.d-em {
  font-size: 25rpx;
  color: #9aa3ac;
}

.d-arrow {
  width: 8rpx;
  height: 8rpx;
  margin-left: 2rpx;
  margin-top: -2rpx;
  border-top: 2rpx solid #d2d7dc;
  border-right: 2rpx solid #d2d7dc;
  transform: rotate(45deg);
}

.d-count {
  font-size: 22rpx;
  color: #a8b1bd;
  letter-spacing: 1rpx;
}

/* ===== 周日历(紧凑) ===== */
.week-swiper {
  width: 100%;
  height: 112rpx;
}

.week {
  display: flex;
  padding: 0 40rpx;
  height: 112rpx;
  box-sizing: border-box;
}

.wk {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 112rpx;
}

.wk-name {
  font-size: 21rpx;
  color: #b7bcc1;
  letter-spacing: 1rpx;
  line-height: 30rpx;
}

.wk-num-wrap {
  width: 68rpx;
  height: 68rpx;
  margin-top: 2rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wk-num {
  font-size: 32rpx;
  font-weight: 800;
  color: #212631;
}

.wk.sel .wk-num-wrap {
  background: #212631;
  color: #c9f24b;
}

.wk.sel .wk-num {
  color: #c9f24b;
}

.wk.sel .wk-name {
  color: #9aa0a6;
}

.wk-dot {
  margin-top: 6rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: transparent;
}

.wk.has .wk-dot {
  background: #c9f24b;
}

/* ===== 主题区 ===== */
.section {
  padding: 24rpx 0 0;
}

.theme-week {
  margin: 0 32rpx 20rpx;
}

.theme-week-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: #a8b1bd;
  letter-spacing: 3rpx;
}

.theme-week-text {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.55;
  color: #4e535a;
  white-space: pre-wrap;
  word-break: break-word;
}

/* Hero 卡片 — M4+ 轻模糊 + 暗纱 · P1 按钮右上角 */
.hero-card {
  margin: 0 36rpx 20rpx;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
  background: #2a2f38;
  max-height: 296rpx;
  transition: max-height 0.38s cubic-bezier(0.32, 0.72, 0.24, 1);
}

.hero-card.expanded {
  max-height: 860rpx;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 42%;
  filter: blur(12rpx) brightness(0.97);
  transform: scale(1.16);
}

.hero-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to bottom, rgba(15, 19, 26, 0.24) 0%, rgba(15, 19, 26, 0.40) 46%, rgba(15, 19, 26, 0.64) 100%);
}

.hero-in {
  position: relative;
  padding: 64rpx 26rpx 22rpx;
  box-sizing: border-box;
}

.hero-eyebrow-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-in .theme-eyebrow {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.8);
  letter-spacing: 4rpx;
  text-shadow: 0 2rpx 8rpx rgba(10, 14, 20, 0.4);
}

.hero-lime-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #c9f24b;
  box-shadow: 0 0 10rpx rgba(201, 242, 75, 0.6);
  flex-shrink: 0;
}

.hero-in .theme-title {
  display: block;
  margin-top: 6rpx;
  font-size: 38rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-shadow: 0 2rpx 12rpx rgba(10, 14, 20, 0.45);
}

.hero-in .theme-copy {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-top: 6rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.88);
  text-shadow: 0 2rpx 8rpx rgba(10, 14, 20, 0.45);
}

.hero-card.expanded .theme-copy {
  -webkit-line-clamp: unset;
}

/* 展开/收起药丸按钮 — P1 右上角 */
.hero-chip {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  z-index: 3;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  padding: 5rpx 18rpx;
  border-radius: 999px;
  letter-spacing: 1rpx;
}

/* 分割线：今日全部活动 */
.list-divider {
  display: flex;
  align-items: center;
  padding: 20rpx 36rpx 4rpx;
  gap: 16rpx;
}

.list-divider-text {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: #a8b1bd;
  flex-shrink: 0;
}

.list-divider-line {
  flex: 1;
  height: 1rpx;
  background: #eef1f3;
}

/* ===== 活动列表(无分割线) ===== */
.activity-list {
  padding: 0 36rpx;
}

/* 日期头(多日时) */
.day-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0 12rpx;
}

.dh-date {
  font-size: 28rpx;
  font-weight: 800;
  color: #212631;
  letter-spacing: 1rpx;
}

.dh-diamond {
  width: 10rpx;
  height: 10rpx;
  background: #c9f24b;
  transform: rotate(-8deg);
  flex-shrink: 0;
}

.dh-week {
  font-size: 22rpx;
  font-weight: 600;
  color: #a8b1bd;
  letter-spacing: 2rpx;
}

.dh-week .today {
  color: #3d5500;
  font-weight: 700;
}

/* 活动行 */
.ev-row {
  display: grid;
  grid-template-columns: 128rpx minmax(0, 1fr) auto;
  align-items: center;
  column-gap: 24rpx;
  padding: 24rpx 0;
}

.ev-row + .ev-row {
  border-top: 1rpx solid #f1f3f5;
}

.ev-cover {
  width: 141rpx;
  height: 176rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  box-shadow: inset 0 0 0 1rpx rgba(0, 0, 0, 0.035);
}

.ev-cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.ev-cover-placeholder {
  width: 100%;
  height: 100%;
  background: #f1f0ed;
}

.ev-signup-mask {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  height: 44rpx;
  padding: 14rpx 12rpx 0;
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  background: linear-gradient(to bottom, transparent, rgba(24, 27, 33, 0.34));
}

.ev-signup-text {
  font-size: 17rpx;
  font-weight: 400;
  line-height: 1;
  color: rgba(255, 255, 255, 0.94);
}

.ev-time {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ev-time-tags {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}

.ev-time-value {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.ev-t1 {
  font-family: Georgia, "Times New Roman", serif;
  font-style: normal;
  font-size: 24rpx;
  color: #3d5500;
}

.ev-t2 {
  font-family: Georgia, "Times New Roman", serif;
  font-style: normal;
  font-size: 24rpx;
  color: #3d5500;
}

.ev-body {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.ev-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.ev-name {
  font-size: 29rpx;
  font-weight: 600;
  color: #212631;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ev-teacher-row {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  min-width: 0;
}

.ev-course-icon {
  flex-shrink: 0;
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.ev-teacher {
  min-width: 0;
  flex: 1;
  font-size: 22rpx;
  line-height: 26rpx;
  color: #6b7178;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ev-desc {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #a0a7ad;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ev-tag-gy {
  flex-shrink: 0;
  font-size: 19rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #faf0cd;
  color: #7f620c;
  line-height: 1.3;
}

.ev-tag-ol {
  flex-shrink: 0;
  font-size: 19rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid #e2e4e7;
  background: #ffffff;
  color: #212631;
  line-height: 1.3;
}

.ev-chev {
  justify-self: end;
  color: #c9cdd2;
  font-size: 30rpx;
  text-align: right;
}

.ev-ended-tag {
  justify-self: end;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  background: #f5f5f2;
  color: #92999f;
  font-size: 19rpx;
  font-weight: 500;
  line-height: 1.3;
  white-space: nowrap;
}

/* ===== 加载/空状态 ===== */
.loading, .empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 50vh;
}

.loading-text {
  font-size: 26rpx;
  color: #a8b1bd;
}

.loading-more, .no-more {
  text-align: center;
  padding: 32rpx 0;
}

.no-more-text {
  font-size: 24rpx;
  color: #a8b1bd;
}

/* ===== 空状态:CSS 风铃 ===== */
.e-icon {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #f1f0ed;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.e-chime {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: -14rpx;
}

.e-string {
  width: 4rpx;
  height: 26rpx;
  border-radius: 2rpx;
  background: #c4cad2;
}

.e-dome {
  width: 76rpx;
  height: 54rpx;
  margin-top: 2rpx;
  background: linear-gradient(135deg, #d3d8df 0%, #bcc3cd 100%);
  border-radius: 38rpx 38rpx 10rpx 10rpx;
}

.e-rim {
  width: 88rpx;
  height: 10rpx;
  margin-top: -4rpx;
  border-radius: 5rpx;
  background: #b3bac4;
}

.e-clap {
  width: 12rpx;
  height: 12rpx;
  margin-top: 6rpx;
  border-radius: 50%;
  background: #a8b1bd;
}

.e-paper {
  width: 34rpx;
  height: 60rpx;
  margin-top: 3rpx;
  border-radius: 8rpx;
  background: #c9f24b;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 12rpx;
  box-sizing: border-box;
}

.e-paper-line {
  width: 16rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #3d5500;
  margin-bottom: 6rpx;
}

.e-paper-line.short {
  width: 10rpx;
}

.e-leaf {
  position: absolute;
  width: 22rpx;
  height: 15rpx;
  border-radius: 100% 4rpx 100% 4rpx;
}

.e-leaf-a {
  left: 34rpx;
  bottom: 34rpx;
  background: #c4cad2;
  transform: rotate(-24deg);
}

.e-leaf-b {
  right: 38rpx;
  bottom: 26rpx;
  background: #dde9ac;
  transform: rotate(18deg);
}

.e-title {
  margin-top: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #212631;
  letter-spacing: 2rpx;
}

.e-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #79838f;
  letter-spacing: 1rpx;
  line-height: 1.6;
  text-align: center;
}

/* ===== 月历选择弹层 ===== */
.cal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(28, 32, 38, 0.34);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.cal-sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 44rpx 44rpx 0 0;
  padding: 20rpx 40rpx 60rpx;
  box-shadow: 0 -24rpx 80rpx rgba(20, 24, 30, 0.18);
  box-sizing: border-box;
}

.cal-grab {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #e6e8ea;
  margin: 4rpx auto 24rpx;
}

.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12rpx 24rpx;
}

.cal-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #212631;
}

.cal-navs {
  display: flex;
  gap: 36rpx;
}

.cal-nav {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #212631;
}

.cal-week {
  display: flex;
  padding-bottom: 12rpx;
}

.cal-wk {
  flex: 1;
  text-align: center;
  font-size: 21rpx;
  color: #b7bcc1;
  letter-spacing: 1rpx;
}

.cal-grid {
  display: flex;
  flex-wrap: wrap;
}

.cal-cell {
  width: 14.2857%;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 88rpx;
  justify-content: center;
}

.cal-num {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 600;
  color: #212631;
}

.cal-out .cal-num {
  color: #c9cdd2;
  font-weight: 400;
}

.cal-dot {
  margin-top: 4rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: transparent;
}

.cal-has .cal-dot {
  background: #c9f24b;
}

.cal-sel .cal-num {
  background: #212631;
  color: #c9f24b;
  font-weight: 800;
}
