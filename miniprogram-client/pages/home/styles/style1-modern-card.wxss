/* 风格一：现代卡片式设计 */
/* 特点：清晰的卡片层次、圆角设计、微妙的阴影效果 */

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
  padding-bottom: 20rpx;
}

/* 加载和空状态 */
.loading, .empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
}

.loading-text {
  font-size: 28rpx;
  color: #94a3b8;
  font-weight: 500;
}

.empty-text {
  font-size: 32rpx;
  color: #1e293b;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #94a3b8;
}

/* 列表容器 */
.list {
  padding: 32rpx 24rpx;
}

/* 日期分组 */
.date-group {
  margin-bottom: 40rpx;
}

.date-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.date-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
  background: linear-gradient(135deg, #3b82f6, #8b5cf6);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.date-weekday {
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: 500;
}

/* 现代卡片设计 */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #3b82f6, #8b5cf6, #ec4899);
  border-radius: 20rpx 20rpx 0 0;
}

.card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

/* 卡片头部 */
.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.card-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.4;
}

.card-tags {
  display: flex;
  gap: 12rpx;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.tag {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

.tag-online {
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
  color: #1d4ed8;
  border: 1rpx solid #93c5fd;
}

.tag-welfare {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  color: #d97706;
  border: 1rpx solid #fbbf24;
}

/* 卡片信息区域 */
.card-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  align-items: center;
  font-size: 26rpx;
}

.info-label {
  color: #64748b;
  width: 80rpx;
  flex-shrink: 0;
  font-weight: 500;
  position: relative;
}

.info-label::after {
  content: '';
  position: absolute;
  right: 12rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 4rpx;
  height: 4rpx;
  background: #cbd5e1;
  border-radius: 50%;
}

.info-value {
  color: #334155;
  flex: 1;
  font-weight: 400;
}

/* 卡片描述 */
.card-desc {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f1f5f9;
}

.desc-text {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.7;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 加载更多 */
.loading-more, .no-more {
  text-align: center;
  padding: 40rpx 0;
}

.no-more-text {
  font-size: 24rpx;
  color: #cbd5e1;
  font-weight: 500;
}

/* 响应式调整 */
@media (max-width: 750rpx) {
  .list {
    padding: 24rpx 16rpx;
  }
  
  .card {
    padding: 24rpx;
    border-radius: 16rpx;
  }
  
  .card-name {
    font-size: 30rpx;
  }
}