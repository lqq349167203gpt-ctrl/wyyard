/* 方案C：暖纸琥珀 — 温暖的纸质感 + 琥珀色点缀 */
/* 背景：暖白渐变 + 微妙横线纹理，卡片略带暖色调 */

.page {
  min-height: 100vh;
  background-color: #f9f6f1;
  background-image: linear-gradient(180deg, #fdf9f3 0%, #f9f6f1 20%, #f7f5f0 100%);
  padding-bottom: 20rpx;
}

.loading, .empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
}

.loading-text {
  font-size: 28rpx;
  color: #b0a690;
}

.empty-text {
  font-size: 30rpx;
  color: #423a2c;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #b0a690;
}

.list {
  padding: 20rpx 28rpx;
}

.date-group {
  margin-bottom: 28rpx;
}

.date-header {
  display: flex;
  align-items: center;
  gap: 0;
  margin-bottom: 14rpx;
  padding: 0 4rpx;
}

.date-header::before {
  content: '';
  width: 24rpx;
  height: 2rpx;
  background: #c8954a;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.date-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #423a2c;
  margin-right: 12rpx;
}

.date-weekday {
  font-size: 24rpx;
  color: #b0a690;
}

.date-header::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, #e0d8c8, transparent);
  margin-left: 12rpx;
}

.card {
  background: #fffdf9;
  border-radius: 4rpx;
  padding: 28rpx 28rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 1rpx 4rpx rgba(180, 150, 100, 0.08);
  border: 1rpx solid #f0ebe0;
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #423a2c;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-tags {
  display: flex;
  gap: 8rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 2rpx;
  font-weight: 500;
}

.tag-online {
  background: #e8f3ff;
  color: #3370ff;
}

.tag-welfare {
  background: #fef0e0;
  color: #c47d20;
}

.card-info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.info-row {
  display: flex;
  align-items: center;
  font-size: 26rpx;
}

.info-label {
  color: #b0a690;
  width: 72rpx;
  flex-shrink: 0;
}

.info-value {
  color: #5c5340;
  flex: 1;
}

.card-desc {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f0e5;
}

.desc-text {
  font-size: 24rpx;
  color: #908570;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.loading-more, .no-more {
  text-align: center;
  padding: 32rpx 0;
}

.no-more-text {
  font-size: 24rpx;
  color: #c9bfa8;
}