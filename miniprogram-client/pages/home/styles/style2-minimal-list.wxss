/* 风格二：简约列表式设计 */
/* 特点：简洁的线条分隔、清晰的排版、高效的空间利用 */

.page {
  min-height: 100vh;
  background: #ffffff;
  padding-bottom: 20rpx;
}

/* 加载和空状态 */
.loading, .empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
}

.loading-text {
  font-size: 28rpx;
  color: #8f959e;
  font-weight: 400;
}

.empty-text {
  font-size: 30rpx;
  color: #2b2f36;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #8f959e;
}

/* 列表容器 */
.list {
  padding: 0;
}

/* 日期分组 */
.date-group {
  margin-bottom: 0;
}

.date-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 32rpx 16rpx;
  background: #f8f9fa;
  border-bottom: 1rpx solid #eef0f3;
  position: sticky;
  top: 0;
  z-index: 10;
}

.date-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #2b2f36;
}

.date-weekday {
  font-size: 22rpx;
  color: #8f959e;
  font-weight: 400;
}

/* 简约列表项 */
.card {
  background: #ffffff;
  padding: 28rpx 32rpx;
  margin-bottom: 0;
  border-bottom: 1rpx solid #f0f0f0;
  position: relative;
  transition: background-color 0.2s ease;
}

.card:active {
  background-color: #f8f9fa;
}

/* 卡片头部 */
.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.card-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #2b2f36;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.4;
}

.card-tags {
  display: flex;
  gap: 8rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

.tag-online {
  background: #e8f3ff;
  color: #3370ff;
}

.tag-welfare {
  background: #fff2e8;
  color: #f5a623;
}

/* 卡片信息区域 */
.card-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.info-row {
  display: flex;
  align-items: center;
  font-size: 24rpx;
}

.info-label {
  color: #8f959e;
  width: 64rpx;
  flex-shrink: 0;
  font-weight: 400;
}

.info-value {
  color: #5f6672;
  flex: 1;
  font-weight: 400;
}

/* 卡片描述 */
.card-desc {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f5f5f5;
}

.desc-text {
  font-size: 22rpx;
  color: #8f959e;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 加载更多 */
.loading-more, .no-more {
  text-align: center;
  padding: 32rpx 0;
}

.no-more-text {
  font-size: 24rpx;
  color: #c9cdd4;
  font-weight: 400;
}

/* 响应式调整 */
@media (max-width: 750rpx) {
  .date-header {
    padding: 20rpx 24rpx 12rpx;
  }
  
  .card {
    padding: 24rpx;
  }
  
  .card-name {
    font-size: 28rpx;
  }
  
  .info-row {
    font-size: 22rpx;
  }
}