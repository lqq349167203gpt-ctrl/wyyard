/* 风格三：时间轴式设计 */
/* 特点：垂直时间线连接活动、突出时间顺序、活动流程清晰 */

.page {
  min-height: 100vh;
  background: #f8fafc;
  padding-bottom: 20rpx;
}

/* 加载和空状态 */
.loading, .empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
}

.loading-text {
  font-size: 28rpx;
  color: #94a3b8;
  font-weight: 500;
}

.empty-text {
  font-size: 32rpx;
  color: #1e293b;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #94a3b8;
}

/* 列表容器 */
.list {
  padding: 32rpx 24rpx 32rpx 48rpx;
  position: relative;
}

/* 时间轴主线 */
.list::before {
  content: '';
  position: absolute;
  left: 60rpx;
  top: 32rpx;
  bottom: 32rpx;
  width: 4rpx;
  background: linear-gradient(180deg, #3b82f6 0%, #8b5cf6 50%, #ec4899 100%);
  border-radius: 2rpx;
}

/* 日期分组 */
.date-group {
  margin-bottom: 48rpx;
  position: relative;
}

.date-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
  position: relative;
}

/* 时间轴节点 */
.date-header::before {
  content: '';
  position: absolute;
  left: -24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 20rpx;
  height: 20rpx;
  background: #ffffff;
  border: 4rpx solid #3b82f6;
  border-radius: 50%;
  z-index: 2;
  box-shadow: 0 0 0 6rpx rgba(59, 130, 246, 0.2);
}

.date-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
  background: linear-gradient(135deg, #3b82f6, #8b5cf6);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.date-weekday {
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: 500;
}

/* 时间轴卡片 */
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  margin-left: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  position: relative;
  transition: all 0.3s ease;
}

/* 卡片连接线 */
.card::before {
  content: '';
  position: absolute;
  left: -16rpx;
  top: 32rpx;
  width: 16rpx;
  height: 4rpx;
  background: #3b82f6;
  border-radius: 2rpx;
}

/* 卡片连接点 */
.card::after {
  content: '';
  position: absolute;
  left: -20rpx;
  top: 28rpx;
  width: 12rpx;
  height: 12rpx;
  background: #ffffff;
  border: 3rpx solid #8b5cf6;
  border-radius: 50%;
  z-index: 2;
}

.card:active {
  transform: translateX(4rpx);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

/* 卡片头部 */
.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.4;
}

.card-tags {
  display: flex;
  gap: 10rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.tag {
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: 6rpx;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

.tag-online {
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
  color: #1d4ed8;
  border: 1rpx solid #93c5fd;
}

.tag-welfare {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  color: #d97706;
  border: 1rpx solid #fbbf24;
}

/* 卡片信息区域 */
.card-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  align-items: center;
  font-size: 24rpx;
}

.info-label {
  color: #64748b;
  width: 72rpx;
  flex-shrink: 0;
  font-weight: 500;
  position: relative;
}

.info-label::before {
  content: '';
  position: absolute;
  left: -16rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 8rpx;
  background: #cbd5e1;
  border-radius: 50%;
}

.info-value {
  color: #334155;
  flex: 1;
  font-weight: 400;
}

/* 卡片描述 */
.card-desc {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f1f5f9;
}

.desc-text {
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.7;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 加载更多 */
.loading-more, .no-more {
  text-align: center;
  padding: 40rpx 0;
}

.no-more-text {
  font-size: 24rpx;
  color: #cbd5e1;
  font-weight: 500;
}

/* 响应式调整 */
@media (max-width: 750rpx) {
  .list {
    padding: 24rpx 16rpx 24rpx 40rpx;
  }
  
  .list::before {
    left: 48rpx;
  }
  
  .date-header::before {
    left: -20rpx;
    width: 16rpx;
    height: 16rpx;
  }
  
  .card {
    padding: 24rpx;
    margin-left: 24rpx;
  }
  
  .card::before {
    left: -12rpx;
    width: 12rpx;
  }
  
  .card::after {
    left: -16rpx;
    width: 10rpx;
    height: 10rpx;
  }
  
  .card-name {
    font-size: 28rpx;
  }
}