<view class="page">
  <!-- 已登录 -->
  <block wx:if="{{isLoggedIn && customer}}">
    <!-- 头部区域 -->
    <view class="head">
      <!-- 消息铃铛（右上角） -->
      <view class="bell" bindtap="onBellTap">
        <image class="bell-svg" src="/assets/bell.png" mode="aspectFit" />
        <view wx:if="{{unreadCount > 0}}" class="bell-dot"></view>
      </view>

      <view class="g-hi">{{greeting}}</view>
      <view class="id-row">
        <view class="avatar">
          <text class="avatar-text">{{customer.nickname[0] || '用'}}</text>
        </view>
        <view class="id-text">
          <text class="id-name">{{customer.nickname}}</text>
          <text class="id-slogan">{{customer.member_type || '助力亿万家庭幸福美满'}}</text>
        </view>
      </view>
    </view>

    <!-- 数据统计 -->
    <view class="stats-flow">
      <view class="sf">
        <text class="sf-num">{{stats.visit_count}}</text>
        <text class="sf-lab">次到店</text>
      </view>
      <view class="sf">
        <text class="sf-num">{{stats.activity_count}}</text>
        <text class="sf-lab">场活动</text>
      </view>
      <view class="sf-big">
        <text class="sf-big-num {{remainClass}}">{{remainNum}}</text>
        <text class="sf-big-lab">{{remainLabel}}</text>
      </view>
    </view>

    <!-- 管理入口 -->
    <view class="mgmt">
      <view class="m-blk" bindtap="onRecordTap" data-type="transactions">交易记录</view>
      <view class="m-blk" bindtap="onRecordTap" data-type="cancel">销卡记录</view>
    </view>

    <!-- 我的活动 -->
    <view wx:if="{{activityGroups.length > 0}}">
      <view class="sec-head">
        <text class="sec-title">我的活动</text>
        <view class="sec-rule"></view>
        <text class="sec-note">本周 {{weekCount}} 场</text>
      </view>

      <view class="days">
        <block wx:for="{{activityGroups}}" wx:key="date">
          <view class="day-card">
            <view class="d-head">
              <text class="d-chip {{item.isPast ? 'past' : ''}}">{{item.isToday ? '今天 · ' : ''}}{{item.dateChip}}</text>
              <text wx:if="{{item.items.length > 1}}" class="d-count">{{item.items.length}} 场</text>
            </view>
            <view wx:for="{{item.items}}" wx:for-item="act" wx:key="index" class="r2" bindtap="onActivityTap" data-id="{{act.session_id}}">
              <view class="r2-l1">
                <text class="r-name">{{act.displayName}}</text>
                <text class="r-st {{act.badgeClass}}">{{act.badge}}</text>
              </view>
              <view class="r2-l2">
                <text class="m-time {{act.timeUndecided ? 'undecided' : ''}}">{{act.timeRange}}</text>
                <text class="role-tag">· {{act.roleLabel}}</text>
                <text wx:if="{{act.membership_deduction_count > 0 && !act.is_public_welfare}}" class="role-tag"> · 扣卡{{act.membership_deduction_count}}次</text>
                <text
                  class="followup-btn {{act.has_followup ? 'done' : ''}}"
                  catchtap="onFollowupTap"
                  data-key="{{act.activity_key}}"
                >{{act.has_followup ? '已回访' : '写回访'}}</text>
              </view>
            </view>
          </view>
        </block>
      </view>

      <view class="all-link" bindtap="onViewAll">查看全部 {{activityTotalCount}} 场 ›</view>
    </view>

    <view class="logout" bindtap="onLogout">退出登录</view>
  </block>

  <!-- 未登录 -->
  <block wx:else>
    <view class="head">
      <view class="g-hi">你好</view>
      <view class="id-row">
        <view class="avatar-empty">
          <view class="ae-head"></view>
          <view class="ae-body"></view>
        </view>
        <view class="id-text">
          <text class="id-name">未登录</text>
          <text class="id-slogan">助力亿万家庭幸福美满</text>
        </view>
      </view>
    </view>

    <view class="invite">
      <text>登录后，你参加的每一场活动，</text>
      <text>都会在这里记成一本小册子。</text>
    </view>

    <!-- 我的活动：空态预览 -->
    <view class="sec-head guest-sec-head">
      <text class="sec-title">我的活动</text>
      <view class="sec-rule"></view>
      <text class="sec-note">登录后可见</text>
    </view>
    <view class="ghost">
      <view class="ghost-leaf"></view>
      <text class="ghost-text">你的活动小册子，等你翻开第一页</text>
    </view>

    <view class="guest-login-area">
      <view class="login-wrap">
        <button class="login-btn" hover-class="login-btn-hover" bindtap="onGoLogin">手机号快捷登录</button>
      </view>
      <text class="login-tip">微信授权一键登录，新用户将自动注册</text>
    </view>
  </block>
</view>

<followup-editor
  visible="{{!!selectedFollowupActivity}}"
  activity="{{selectedFollowupActivity}}"
  bind:close="onFollowupClose"
  bind:saved="onFollowupSaved"
/>
