<view class="page">
  <!-- 已登录 -->
  <block wx:if="{{isLoggedIn && customer}}">
    <!-- 白色顶部区域 -->
    <view class="topzone">
      <!-- 风铃装饰 -->
      <view class="chime">
        <view class="c-string"></view>
        <view class="c-dome"></view>
        <view class="c-paper"></view>
      </view>
      <!-- 消息铃铛 -->
      <view class="bell" bindtap="onBellTap">
        <view class="bell-icon">
          <view class="bell-body"></view>
          <view class="bell-clapper"></view>
        </view>
        <view wx:if="{{unreadCount > 0}}" class="bell-dot"></view>
      </view>

      <view class="g-hi">{{greeting}}</view>
      <view class="id-row">
        <view class="avatar">
          <text class="avatar-text">{{customer.nickname[0] || '用'}}</text>
        </view>
        <view class="id-text">
          <text class="id-name">{{customer.nickname}}</text>
          <text class="id-slogan">助力亿万家庭幸福美满</text>
        </view>
      </view>

      <!-- 数字即入口 -->
      <view class="stats-flow">
        <view class="sf" bindtap="onStatTap" data-type="activity">
          <text class="sf-num">{{stats.activity_count}}</text>
          <text class="sf-lab">场活动</text>
          <text class="sf-arr">›</text>
        </view>
        <view class="sf" bindtap="onStatTap" data-type="visit">
          <text class="sf-num">{{stats.visit_count}}</text>
          <text class="sf-lab">次到店</text>
          <text class="sf-arr">›</text>
        </view>
        <view class="sf">
          <text class="sf-num hl">{{stats.remain_count}}</text>
          <text class="sf-lab">次剩余</text>
          <text class="sf-arr">›</text>
        </view>
      </view>
    </view>

    <!-- 我的活动 -->
    <view wx:if="{{activityGroups.length > 0}}" class="act-section">
      <view class="sec-head">
        <text class="sec-title">我的活动</text>
      </view>

      <view class="days">
        <view wx:for="{{activityGroups}}" wx:key="date" class="day-card {{index === 0 ? 'day-next' : ''}}">
          <view wx:if="{{index === 0}}" class="d-leaf"></view>
          <view class="d-head">
            <text class="d-chip">{{item.dateChip}}</text>
            <text wx:if="{{item.items.length > 1}}" class="d-count">{{item.items.length}} 场</text>
          </view>
          <view wx:for="{{item.items}}" wx:for-item="act" wx:key="index" class="r-row">
            <text class="r-time">{{act.start_time}}</text>
            <text class="r-name">{{act.name}}</text>
            <text class="r-st {{act.badgeClass}}">{{act.badge}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="logout" bindtap="onLogout">退出登录</view>
  </block>

  <!-- 未登录 -->
  <block wx:else>
    <view class="topzone">
      <view class="g-hi">你好</view>
      <view class="id-row">
        <view class="avatar-empty">
          <view class="ae-head"></view>
          <view class="ae-body"></view>
        </view>
        <view class="id-text">
          <text class="id-name id-name-login" hover-class="id-name-login-hover" bindtap="onGoLogin">登录</text>
          <text class="id-slogan">助力亿万家庭幸福美满</text>
        </view>
      </view>
      <view class="stats-flow">
        <view class="sf"><text class="sf-num">—</text><text class="sf-lab">场活动</text></view>
        <view class="sf"><text class="sf-num">—</text><text class="sf-lab">次到店</text></view>
        <view class="sf"><text class="sf-num hl">—</text><text class="sf-lab">次剩余</text></view>
      </view>
    </view>
    <view class="login-area">
      <button class="login-btn" hover-class="login-btn-hover" bindtap="onGoLogin">手机号快捷登录</button>
      <text class="login-tip">微信授权一键登录，新用户将自动注册</text>
    </view>
  </block>
</view>
