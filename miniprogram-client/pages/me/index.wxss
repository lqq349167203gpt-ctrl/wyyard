.page {
  min-height: 100vh;
  background: #f4f5f6;
  display: flex;
  flex-direction: column;
}

/* ============ 白色顶部区域 ============ */

.topzone {
  position: relative;
  background: #fff;
  border-radius: 0 0 44rpx 44rpx;
  padding: 52rpx 44rpx 40rpx;
}

/* 风铃装饰 */
.chime {
  position: absolute;
  right: 48rpx;
  top: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 2;
}

.c-string {
  width: 4rpx;
  height: 28rpx;
  background: #e2e5e9;
}

.c-dome {
  width: 48rpx;
  height: 32rpx;
  background: #e2e5e9;
  border-radius: 24rpx 24rpx 6rpx 6rpx;
}

.c-paper {
  width: 18rpx;
  height: 30rpx;
  margin-top: 4rpx;
  border-radius: 6rpx;
  background: #c9f24b;
}

/* 消息铃铛 */
.bell {
  position: absolute;
  right: 128rpx;
  top: 48rpx;
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bell-icon {
  position: relative;
  width: 38rpx;
  height: 38rpx;
}

.bell-body {
  width: 38rpx;
  height: 30rpx;
  background: #e2e5e9;
  border-radius: 19rpx 19rpx 4rpx 4rpx;
  position: absolute;
  top: 0;
}

.bell-clapper {
  width: 14rpx;
  height: 14rpx;
  background: #e2e5e9;
  border-radius: 50%;
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
}

.bell-dot {
  position: absolute;
  right: 12rpx;
  top: 14rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #e8544d;
  border: 4rpx solid #fff;
  z-index: 3;
}

.g-hi {
  font-size: 24rpx;
  color: #a8b1bd;
  letter-spacing: 2rpx;
}

.id-row {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #212631;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 40rpx;
  color: #c9f24b;
  font-weight: 800;
}

.id-text {
  margin-left: 28rpx;
  display: flex;
  flex-direction: column;
}

.id-name {
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.id-slogan {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #a8b1bd;
  letter-spacing: 2rpx;
}

/* 数字即入口 */
.stats-flow {
  margin-top: 32rpx;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.sf {
  display: flex;
  align-items: baseline;
}

.sf + .sf {
  margin-left: 40rpx;
}

.sf-num {
  font-size: 34rpx;
  font-weight: 800;
}

.sf-num.hl {
  color: #3d5500;
}

.sf-lab {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #a8b1bd;
  letter-spacing: 2rpx;
}

.sf-arr {
  margin-left: 6rpx;
  font-size: 22rpx;
  color: #c9cfd6;
}

/* ============ 我的活动 ============ */

.act-section {
  padding: 0 32rpx;
}

.sec-head {
  margin-top: 48rpx;
  display: flex;
  align-items: baseline;
}

.sec-title {
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.days {
  margin-top: 24rpx;
}

.day-card {
  position: relative;
  background: #fff;
  border-radius: 28rpx;
  padding: 24rpx 30rpx 12rpx;
  overflow: hidden;
}

.day-card + .day-card {
  margin-top: 20rpx;
}

.day-next {
  background: #f2f7e2;
}

.d-head {
  display: flex;
  align-items: center;
  padding-bottom: 16rpx;
}

.d-chip {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  padding: 8rpx 20rpx;
  border-radius: 14rpx;
  background: #212631;
  color: #c9f24b;
}

.d-count {
  margin-left: auto;
  font-size: 22rpx;
  color: #a8b1bd;
  letter-spacing: 2rpx;
}

.r-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
}

.r-row + .r-row {
  border-top: 1rpx solid rgba(33, 38, 49, 0.05);
}

.r-time {
  width: 92rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: #79838f;
  letter-spacing: 1rpx;
}

.r-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.r-st {
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.st-up {
  background: #c9f24b;
  color: #3d5500;
}

.st-done {
  background: #eef0f1;
  color: #a8b1bd;
}

.st-missed {
  background: #fef2f2;
  color: #dc2626;
}

.d-leaf {
  position: absolute;
  right: 28rpx;
  top: 28rpx;
  width: 36rpx;
  height: 24rpx;
  border-radius: 100% 8rpx 100% 8rpx;
  background: #c9f24b;
  transform: rotate(-16deg);
}

/* ============ 退出登录 ============ */

.logout {
  margin-top: 52rpx;
  padding-bottom: 60rpx;
  text-align: center;
  font-size: 26rpx;
  color: #a8b1bd;
}

/* ============ 未登录态 ============ */

.avatar-empty {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #eef0f2;
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
}

.ae-head {
  position: absolute;
  left: 50%;
  top: 22rpx;
  transform: translateX(-50%);
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #c3c9d2;
}

.ae-body {
  position: absolute;
  left: 50%;
  bottom: -10rpx;
  transform: translateX(-50%);
  width: 76rpx;
  height: 52rpx;
  border-radius: 46rpx 46rpx 0 0;
  background: #c3c9d2;
}

.id-name-login {
  color: #212631;
}

.id-name-login-hover {
  opacity: 0.6;
}

.login-area {
  margin-top: 16rpx;
  padding: 0 24rpx 48rpx;
}

.login-btn {
  width: 100% !important;
  height: 92rpx;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #212631;
  color: #c9f24b;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  border-radius: 999rpx;
  border: none;
  box-sizing: border-box;
}

.login-btn::after {
  border: none;
}

.login-btn[disabled] {
  background: #212631;
  color: rgba(201, 242, 75, 0.45);
}

.login-btn-hover {
  background: #3a4150;
}

.login-tip {
  display: block;
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.5;
  color: #a8b1bd;
}
