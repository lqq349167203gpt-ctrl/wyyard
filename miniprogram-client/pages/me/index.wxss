.page {
  min-height: 100vh;
  background: #fff;
  display: flex;
  flex-direction: column;
}

/* ============ 消息铃铛 ============ */

.bell {
  position: absolute;
  right: 48rpx;
  top: 52rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bell-svg {
  width: 40rpx;
  height: 40rpx;
}

.bell-dot {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #e8544d;
  border: 4rpx solid #fff;
  z-index: 3;
}

/* ============ 头部区域 ============ */

.head {
  position: relative;
  padding: 52rpx 44rpx 0;
}

.g-hi {
  font-size: 24rpx;
  color: #a8b1bd;
  letter-spacing: 4rpx;
}

.id-row {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #212631;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 40rpx;
  color: #c9f24b;
  font-weight: 800;
}

.id-text {
  margin-left: 28rpx;
  display: flex;
  flex-direction: column;
}

.id-name {
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.id-slogan {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #a8b1bd;
  letter-spacing: 2rpx;
}

/* ============ 数据统计 ============ */

.stats-flow {
  margin: 36rpx 44rpx 0;
  display: flex;
  align-items: flex-end;
}

.sf {
  display: flex;
  align-items: flex-end;
}

.sf + .sf {
  margin-left: 36rpx;
}

.sf-num {
  font-size: 30rpx;
  font-weight: 700;
}

.sf-lab {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #a8b1bd;
  letter-spacing: 2rpx;
}

.sf-big {
  margin-left: auto;
  text-align: right;
  line-height: 1;
}

.sf-big-num {
  font-size: 60rpx;
  font-weight: 300;
  letter-spacing: 2rpx;
  color: #212631;
  line-height: 1;
}

.sf-big-num.inf {
}

.sf-big-num.zero {
  color: #c4cad2;
}

.sf-big-lab {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #a8b1bd;
  letter-spacing: 4rpx;
  line-height: 1.4;
}

.sf-big-lab .dot-sep {
  color: #3d5500;
}

.sf-big-lab .link-go {
  color: #3d5500;
  text-decoration: none;
  border-bottom: 2rpx solid #c9f24b;
  padding-bottom: 2rpx;
}

/* ============ 管理入口 ============ */

.mgmt {
  margin: 36rpx 44rpx 0;
  display: flex;
  gap: 16rpx;
}

.m-blk {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f6f7;
  border-radius: 24rpx;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #454e59;
  letter-spacing: 2rpx;
}

/* ============ 我的活动 ============ */

.sec-head {
  margin: 32rpx 44rpx 0;
  display: flex;
  align-items: center;
}

.sec-title {
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.sec-rule {
  flex: 1;
  height: 2rpx;
  background: #eceff1;
  margin: 0 24rpx;
}

.sec-note {
  font-size: 22rpx;
  color: #a8b1bd;
  letter-spacing: 2rpx;
  white-space: nowrap;
}

/* ============ 活动卡片 ============ */

.days {
  margin: 0 32rpx;
}

.day-card {
  position: relative;
  background: #f8f9fa;
  border-radius: 32rpx;
  padding: 20rpx 28rpx 10rpx;
  overflow: hidden;
  margin-top: 20rpx;
}

.d-head {
  display: flex;
  align-items: center;
  padding-bottom: 8rpx;
}

.d-chip {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  padding: 8rpx 20rpx;
  border-radius: 14rpx;
  background: #212631;
  color: #c9f24b;
}

.d-chip.past {
  background: #ffffff;
  color: #98a1ad;
}

.d-count {
  margin-left: auto;
  font-size: 22rpx;
  color: #a8b1bd;
  letter-spacing: 2rpx;
}

/* ============ U1 双行活动清单 ============ */

.r2 {
  padding: 16rpx 0 18rpx;
}

.r2 + .r2 {
  border-top: 1rpx solid rgba(33, 38, 49, 0.06);
}

.r2-l1 {
  display: flex;
  align-items: center;
}

.r2-l2 {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
}

.followup-btn {
  flex-shrink: 0;
  min-width: 92rpx;
  height: 46rpx;
  margin: 0 0 0 auto;
  padding: 0 18rpx;
  border: 1rpx solid #dfe3e7;
  border-radius: 23rpx;
  background: #ffffff;
  color: #59636f;
  font-size: 21rpx;
  font-weight: 500;
  line-height: 44rpx;
}

.followup-btn::after {
  border: 0;
}

.followup-btn.done {
  border-color: #e5ebd0;
  background: #f7faed;
  color: #68783b;
}

.r-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.m-time {
  flex-shrink: 0;
  color: #98a1ad;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 23rpx;
  font-style: normal;
  letter-spacing: 1rpx;
}

.role-tag {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: 1rpx;
}

.rt-join {
  color: #a8b1bd;
}

.rt-lead {
  color: #212631;
}

.rt-owner {
  color: #7f620c;
}

.r-st {
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.st-up {
  background: #ffffff;
  color: #212631;
}

.st-done {
  background: #ffffff;
  color: #a8b1bd;
}

.st-miss {
  color: #b6bec8;
  padding-left: 0;
  padding-right: 0;
}

/* ============ 查看全部 ============ */

.all-link {
  margin: 24rpx 44rpx 0;
  font-size: 24rpx;
  color: #98a1ad;
  letter-spacing: 2rpx;
}

/* ============ 退出登录 ============ */

.logout {
  margin-top: 44rpx;
  padding-bottom: 60rpx;
  text-align: center;
  font-size: 26rpx;
  color: #b6bec8;
}

/* ============ 未登录态 ============ */

.avatar-empty {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #eef0f2;
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
}

.ae-head {
  position: absolute;
  left: 50%;
  top: 22rpx;
  transform: translateX(-50%);
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #c3c9d2;
}

.ae-body {
  position: absolute;
  left: 50%;
  bottom: -10rpx;
  transform: translateX(-50%);
  width: 76rpx;
  height: 52rpx;
  border-radius: 46rpx 46rpx 0 0;
  background: #c3c9d2;
}

.id-name-login {
  color: #212631;
}

.id-name-login-hover {
  opacity: 0.6;
}

/* ============ 未登录 · 邀请语 ============ */

.invite {
  margin: 40rpx 44rpx 0;
  font-size: 26rpx;
  color: #79838f;
  letter-spacing: 2rpx;
  line-height: 1.8;
  display: flex;
  flex-direction: column;
}

/* ============ 未登录 · 登录按钮 ============ */

.guest-login-area {
  margin: 56rpx 44rpx 0;
  padding-bottom: 64rpx;
}

.login-wrap {
  margin: 0;
}

.login-btn {
  width: 100% !important;
  height: 92rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #212631;
  color: #c9f24b;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
  border-radius: 999rpx;
  border: none;
  box-sizing: border-box;
  margin: 0;
}

.login-btn::after {
  border: none;
}

.login-btn[disabled] {
  background: #212631;
  color: rgba(201, 242, 75, 0.45);
}

.login-btn-hover {
  background: #3a4150;
}

.login-tip {
  display: block;
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.5;
  color: #a8b1bd;
}

/* ============ 未登录 · 活动空态 ============ */

.guest-sec-head {
  margin-top: 52rpx;
}

.ghost {
  position: relative;
  margin: 40rpx 32rpx 0;
  background: #f5f6f7;
  border-radius: 32rpx;
  padding: 52rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ghost-leaf {
  width: 40rpx;
  height: 26rpx;
  border-radius: 100% 8rpx 100% 8rpx;
  background: #c9f24b;
  transform: rotate(-16deg);
}

.ghost-text {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #a8b1bd;
  letter-spacing: 2rpx;
}

/* ============ 未登录 · 管理入口灰色 ============ */

.m-blk-dim {
  color: #b6bec8;
}
