.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 32rpx;
}

.profile-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #3370ff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 40rpx;
  color: #ffffff;
  font-weight: 500;
}

.profile-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.nickname {
  font-size: 32rpx;
  font-weight: 500;
  color: #2b2f36;
}

.member-type {
  font-size: 24rpx;
  color: #8f959e;
}

.menu-card {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 32rpx;
  background: transparent;
  border: none;
  text-align: left;
  font-size: 28rpx;
}

.menu-item::after {
  border: none;
}

.menu-text {
  color: #2b2f36;
}

.menu-text-danger {
  color: #f54a45;
}

.login-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-top: 200rpx;
}

.login-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #2b2f36;
}

.login-hint {
  font-size: 26rpx;
  color: #8f959e;
  margin-bottom: 40rpx;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #3370ff;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 12rpx;
  border: none;
}

.login-btn::after {
  border: none;
}
