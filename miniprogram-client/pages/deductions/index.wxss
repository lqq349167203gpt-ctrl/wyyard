@import '../notifications/index.wxss';

.page {
  min-height: 100vh;
  background: #f4f5f6;
  padding: 0;
}

.list {
  padding: 24rpx 28rpx 40rpx;
}

/* ===== 顶部已购项目 ===== */
.project-section {
  padding: 24rpx 28rpx 4rpx;
}

.project-sec {
  display: flex;
  align-items: center;
}

.project-sec-title {
  font-size: 21rpx;
  font-weight: 700;
  color: #a8b1bd;
  letter-spacing: 4rpx;
}

.project-sec-rule {
  flex: 1;
  height: 1rpx;
  margin-left: 20rpx;
  background: #e7eaee;
}

.project-cards {
  margin-top: 16rpx;
}

.project-card {
  position: relative;
  overflow: hidden;
  padding: 22rpx 28rpx 24rpx;
  background: #ffffff;
  border-radius: 28rpx;
}

.project-card + .project-card {
  margin-top: 16rpx;
}

.project-line-one {
  display: flex;
  align-items: center;
}

.project-name {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 700;
  color: #212631;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.project-remaining {
  flex-shrink: 0;
  margin-left: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.2;
  color: #212631;
}

.project-total {
  flex-shrink: 0;
  margin-left: 6rpx;
  font-size: 20rpx;
  color: #a8b1bd;
}

.project-line-two {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.project-type {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  font-size: 19rpx;
  font-weight: 600;
  line-height: 1.35;
  color: #5a6470;
  letter-spacing: 1rpx;
  background: #ffffff;
  border: 1rpx solid #e2e4e7;
  border-radius: 8rpx;
}

.project-validity {
  min-width: 0;
  margin-left: 12rpx;
  overflow: hidden;
  font-size: 21rpx;
  color: #a8b1bd;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.project-progress {
  position: absolute;
  bottom: 0;
  left: 0;
  height: 6rpx;
  background: #c9f24b;
}

.project-expired {
  margin-top: 24rpx;
}

.project-expired-trigger {
  display: flex;
  align-items: center;
  padding: 22rpx 28rpx;
  background: #eef0f2;
  border-radius: 28rpx;
}

.project-expired-title {
  flex-shrink: 0;
  font-size: 23rpx;
  font-weight: 600;
  color: #98a1ad;
}

.project-expired-names {
  min-width: 0;
  margin-left: 16rpx;
  overflow: hidden;
  font-size: 21rpx;
  color: #b6bec8;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.project-expired-arrow {
  flex-shrink: 0;
  width: 9rpx;
  height: 9rpx;
  margin-left: auto;
  margin-right: 3rpx;
  border-right: 2rpx solid #aeb6c0;
  border-bottom: 2rpx solid #aeb6c0;
  transform: rotate(-45deg);
  transition: transform 160ms ease;
}

.project-expired-arrow.is-expanded {
  transform: rotate(45deg);
}

.project-expired-cards {
  margin-top: 12rpx;
}

.project-card-expired .project-name,
.project-card-expired .project-remaining {
  color: #7f8792;
}

.project-card-expired .project-progress {
  background: #d9dde2;
}

/* ===== D2 卡片 ===== */
.card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 20rpx 28rpx;
}

.card + .card {
  margin-top: 12rpx;
}

/* 标签 */
.c-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dtag {
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  line-height: 1.35;
  flex-shrink: 0;
}

.dt-normal,
.dt-activity {
  border: 1rpx solid #d0dce8;
  color: #4a6a8a;
  background: #eef4fa;
}

.dt-manual {
  border: 1rpx solid #e8dcc8;
  background: #faf0cd;
  color: #7f620c;
}

.dt-project {
  border: 1rpx solid #e2e4e7;
  color: #5a6470;
  background: #ffffff;
}

/* 名称 + 扣次 */
.c-main {
  margin-top: 12rpx;
  display: flex;
  align-items: baseline;
}

.c-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: #212631;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.c-amt {
  flex-shrink: 0;
  margin-left: 20rpx;
  display: flex;
  align-items: baseline;
}

.c-amt-num {
  font-size: 36rpx;
  font-weight: 400;
  color: #212631;
}

.c-amt-unit {
  font-size: 22rpx;
  font-weight: 600;
  color: #79838f;
  margin-left: 4rpx;
}

/* 权益/内容 */
.c-why {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #79838f;
  line-height: 1.5;
}

.c-why-label {
  font-weight: 400;
  color: #a8b1bd;
  margin-right: 12rpx;
}

.c-why-text {
  color: #79838f;
}

/* 剩余 + 操作人 */
.c-foot {
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(33, 38, 49, 0.06);
  display: flex;
  align-items: center;
}

.c-remain {
  font-size: 22rpx;
  font-weight: 600;
  color: #3d5500;
}

.c-op {
  margin-left: auto;
  font-size: 21rpx;
  color: #a8b1bd;
}
