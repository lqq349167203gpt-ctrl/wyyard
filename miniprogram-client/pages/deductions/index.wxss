@import '../notifications/index.wxss';

.page {
  min-height: 100vh;
  background: #f4f5f6;
  padding: 0;
}

.list {
  padding: 24rpx 28rpx 40rpx;
}

/* ===== 卡次统计 ===== */
.entitlement-section {
  padding: 24rpx 28rpx 4rpx;
}

.section-heading {
  display: flex;
  align-items: center;
}

.section-title {
  flex-shrink: 0;
  font-size: 21rpx;
  font-weight: 700;
  color: #a8b1bd;
  letter-spacing: 4rpx;
}

.section-rule {
  flex: 1;
  height: 1rpx;
  margin-left: 20rpx;
  background: #e7eaee;
}

.entitlement-list {
  margin-top: 16rpx;
}

.entitlement-card {
  padding: 24rpx 28rpx;
  background: #ffffff;
  border-radius: 28rpx;
}

.entitlement-card + .entitlement-card {
  margin-top: 16rpx;
}

.entitlement-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.entitlement-title {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 12rpx;
}

.entitlement-type {
  flex-shrink: 0;
  font-size: 27rpx;
  font-weight: 700;
  color: #212631;
}

.entitlement-name {
  max-width: 180rpx;
  overflow: hidden;
  font-size: 22rpx;
  color: #79838f;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entitlement-summary {
  display: flex;
  flex-shrink: 0;
  flex-wrap: wrap;
  justify-content: flex-end;
  font-size: 21rpx;
  line-height: 34rpx;
  color: #8f959e;
}

.entitlement-value {
  margin-left: 4rpx;
  font-weight: 600;
  color: #212631;
}

.entitlement-divider {
  margin: 0 8rpx;
  color: #c8cdd3;
}

.entitlement-debt-inline {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #c4506a;
  text-align: right;
}

.membership-cards,
.debt-list {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f0f0f0;
}

.membership-card-row + .membership-card-row {
  margin-top: 16rpx;
}

.membership-card-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.membership-card-name {
  min-width: 0;
  overflow: hidden;
  font-size: 24rpx;
  color: #4e535a;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.membership-card-count {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #646a73;
}

.membership-card-count.is-voided {
  color: #c4506a;
}

.entitlement-validity {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #a8b1bd;
}

.entitlement-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
}

.entitlement-detail-name {
  min-width: 0;
  overflow: hidden;
  font-size: 23rpx;
  color: #4e535a;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entitlement-info .entitlement-validity {
  flex-shrink: 0;
  margin-top: 0;
}

.debt-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 150rpx 104rpx;
  align-items: center;
  gap: 10rpx;
  min-height: 42rpx;
  font-size: 21rpx;
}

.debt-name {
  overflow: hidden;
  color: #646a73;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.debt-date {
  color: #8f959e;
  text-align: right;
}

.debt-count {
  color: #c4506a;
  text-align: right;
}

.record-heading {
  margin-top: 28rpx;
  padding: 0 28rpx;
}

.record-count {
  flex-shrink: 0;
  margin-left: 14rpx;
  font-size: 20rpx;
  color: #a8b1bd;
}

/* ===== D2 卡片 ===== */
.card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 20rpx 28rpx;
}

.card + .card {
  margin-top: 12rpx;
}

/* 标签 */
.c-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dtag {
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  line-height: 1.35;
  flex-shrink: 0;
}

.dt-normal,
.dt-activity {
  border: 1rpx solid #d0dce8;
  color: #4a6a8a;
  background: #eef4fa;
}

.dt-manual {
  border: 1rpx solid #e8dcc8;
  background: #faf0cd;
  color: #7f620c;
}

.dt-project {
  border: 1rpx solid #e2e4e7;
  color: #5a6470;
  background: #ffffff;
}

/* 名称 + 扣次 */
.c-main {
  margin-top: 12rpx;
  display: flex;
  align-items: baseline;
}

.c-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: #212631;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.c-amt {
  flex-shrink: 0;
  margin-left: 20rpx;
  display: flex;
  align-items: baseline;
}

.c-amt-num {
  font-size: 36rpx;
  font-weight: 400;
  color: #212631;
}

.c-amt-unit {
  font-size: 22rpx;
  font-weight: 600;
  color: #79838f;
  margin-left: 4rpx;
}

/* 权益/内容 */
.c-why {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #79838f;
  line-height: 1.5;
}

.c-why-label {
  font-weight: 400;
  color: #a8b1bd;
  margin-right: 12rpx;
}

.c-why-text {
  color: #79838f;
}

/* 剩余 + 操作人 */
.c-foot {
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(33, 38, 49, 0.06);
  display: flex;
  align-items: center;
}

.c-remain {
  font-size: 22rpx;
  font-weight: 600;
  color: #3d5500;
}

.c-op {
  margin-left: auto;
  font-size: 21rpx;
  color: #a8b1bd;
}
