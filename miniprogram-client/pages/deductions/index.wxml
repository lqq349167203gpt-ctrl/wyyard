<view class="page">
  <view wx:if="{{loading}}" class="loading-box">
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:else>
    <view wx:if="{{purchaseSummary.length}}" class="entitlement-section">
      <view class="section-heading">
        <text class="section-title">卡次统计</text>
        <view class="section-rule"></view>
      </view>

      <view class="entitlement-list">
        <view class="entitlement-card" wx:for="{{purchaseSummary}}" wx:key="_key">
          <view class="entitlement-header">
            <view class="entitlement-title">
              <text class="entitlement-type">{{item.type}}</text>
              <text class="entitlement-name" wx:if="{{item.name && !item._isOfflineCourse}}">{{item.name}}</text>
            </view>
            <view class="entitlement-summary">
              <block wx:if="{{item._isOfflineCourse}}">
                <text>已上课</text>
                <text class="entitlement-value">{{item._attendedCount}}</text>
                <text>次</text>
              </block>
              <block wx:else>
                <text>当前剩余</text>
                <text class="entitlement-value">{{item._currentRemainingText}}</text>
                <text class="entitlement-divider">/</text>
                <text>总</text>
                <text class="entitlement-value">{{item._currentTotalText}}</text>
              </block>
            </view>
          </view>

          <text class="entitlement-debt-inline" wx:if="{{item._debtCount > 0}}">历史欠卡 {{item._debtCount}} 次</text>

          <view class="membership-cards" wx:if="{{item._cardItems.length > 0}}">
            <view class="membership-card-row" wx:for="{{item._cardItems}}" wx:for-item="card" wx:key="_key">
              <view class="membership-card-main">
                <text class="membership-card-name">{{card.name || '会员卡'}}</text>
                <text class="membership-card-count {{card.voided ? 'is-voided' : ''}}">{{card._countText}}</text>
              </view>
              <text class="entitlement-validity">{{card._validityText}}</text>
            </view>
          </view>

          <view class="entitlement-info" wx:elif="{{item.name || item.effective_date}}">
            <text class="entitlement-detail-name" wx:if="{{item.name && !item._isOfflineCourse}}">{{item.name}}</text>
            <text class="entitlement-validity">{{item._validityText}}</text>
          </view>

          <view class="debt-list" wx:if="{{item._debtCount > 0}}">
            <view class="debt-row" wx:for="{{item._debtActivities}}" wx:for-item="debt" wx:key="index">
              <text class="debt-name">{{debt.label || '活动'}}</text>
              <text class="debt-date">{{debt.date || '-'}}</text>
              <text class="debt-count">欠卡{{debt.count}}次</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="record-heading section-heading">
      <text class="section-title">销卡记录</text>
      <view class="section-rule"></view>
      <text class="record-count">{{items.length}} 条</text>
    </view>

    <view wx:if="{{items.length === 0}}" class="empty-box">
      <view class="e-icon">
        <view class="e-chime">
          <view class="e-string"></view>
          <view class="e-dome"></view>
          <view class="e-rim"></view>
          <view class="e-clap"></view>
          <view class="e-paper">
            <view class="e-paper-line"></view>
            <view class="e-paper-line short"></view>
          </view>
        </view>
        <view class="e-leaf e-leaf-a"></view>
        <view class="e-leaf e-leaf-b"></view>
      </view>
      <text class="e-title">暂无销卡记录</text>
      <text class="e-sub">还没有销卡记录</text>
    </view>

    <view wx:else class="list">
      <block wx:for="{{groups}}" wx:for-item="group" wx:key="day">
        <view class="g-head">
          <text class="g-t">{{group.day}}</text>
          <view class="g-rule"></view>
        </view>
        <view class="date-group-cards">
          <view wx:for="{{group.items}}" wx:for-item="record" wx:key="index" class="card">
            <!-- 标签 -->
            <view class="c-head">
              <text class="dtag dt-{{record.tag_tone}}">{{record.tag_text}}</text>
            </view>
            <!-- 名称 + 扣次 -->
            <view class="c-main">
              <text class="c-name">{{record.project_name}}</text>
              <view class="c-amt">
                <text class="c-amt-num">-{{record.count}}</text>
                <text class="c-amt-unit">次</text>
              </view>
            </view>
            <!-- 活动身份 -->
            <view wx:if="{{record.activity_role_text}}" class="c-why">
              <text class="c-why-label">活动身份</text>
              <text class="c-why-text">{{record.activity_role_text}}</text>
            </view>
            <!-- 权益/内容 -->
            <view wx:if="{{record.benefit_text || record.reason_text}}" class="c-why">
              <text class="c-why-label">{{record.tag_tone === 'manual' ? '内容' : '使用权益'}}</text>
              <text class="c-why-text">{{record.tag_tone === 'manual' ? record.reason_text : record.benefit_text}}</text>
            </view>
            <!-- 剩余 + 操作人 -->
            <view wx:if="{{record.remaining_text || record.created_by}}" class="c-foot">
              <text wx:if="{{record.remaining_text}}" class="c-remain">{{record.remaining_text}}</text>
              <text wx:if="{{record.created_by}}" class="c-op">操作人 · {{record.created_by}}</text>
            </view>
          </view>
        </view>
      </block>
    </view>
  </block>
</view>
