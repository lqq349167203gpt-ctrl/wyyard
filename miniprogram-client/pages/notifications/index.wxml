<view class="page">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-box">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{notifications.length === 0}}" class="empty-box">
    <view class="e-icon">
      <view class="e-chime">
        <view class="e-string"></view>
        <view class="e-dome"></view>
        <view class="e-rim"></view>
        <view class="e-clap"></view>
        <view class="e-paper">
          <view class="e-paper-line"></view>
          <view class="e-paper-line short"></view>
        </view>
      </view>
      <view class="e-leaf e-leaf-a"></view>
      <view class="e-leaf e-leaf-b"></view>
    </view>
    <text class="e-title">暂无消息</text>
    <text class="e-sub">风铃未响，有新消息会第一时间轻轻告诉你</text>
  </view>

  <!-- N2 按天分组通知列表 -->
  <view wx:else class="list">
    <block wx:for="{{groups}}" wx:key="day">
      <!-- 日期分组标题 -->
      <view class="g-head">
        <text class="g-t">{{item.day}}</text>
        <view class="g-rule"></view>
      </view>
      <!-- 该天的通知卡片 -->
      <view class="g-card">
        <view
          wx:for="{{item.items}}"
          wx:for-item="n"
          wx:key="id"
          class="row {{n.is_read ? 'read' : ''}}"
          bindtap="onTapItem"
          data-id="{{n.id}}"
        >
          <view class="r-l1">
            <text class="r-title">{{n.title}}</text>
            <view wx:if="{{!n.is_read}}" class="udot"></view>
            <text class="r-time">{{n.time_text}}</text>
          </view>
          <text class="r-text">{{n.content}}</text>
          <view wx:if="{{n.activity_date_text}}" class="r-activity-date">
            <text class="r-activity-date-label">活动日期</text>
            <text class="r-activity-date-value">{{n.activity_date_text}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>
