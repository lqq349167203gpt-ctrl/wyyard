.page {
  min-height: 100vh;
  background: #f4f5f6;
  padding: 28rpx;
  box-sizing: border-box;
}

.loading-box,
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.loading-text {
  font-size: 26rpx;
  color: #a8b1bd;
}

/* ===== 空状态 ===== */
.e-icon {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #f1f0ed;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.e-chime {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: -14rpx;
}

.e-string {
  width: 4rpx;
  height: 26rpx;
  border-radius: 2rpx;
  background: #c4cad2;
}

.e-dome {
  width: 76rpx;
  height: 54rpx;
  margin-top: 2rpx;
  background: linear-gradient(135deg, #d3d8df 0%, #bcc3cd 100%);
  border-radius: 38rpx 38rpx 10rpx 10rpx;
}

.e-rim {
  width: 88rpx;
  height: 10rpx;
  margin-top: -4rpx;
  border-radius: 5rpx;
  background: #b3bac4;
}

.e-clap {
  width: 12rpx;
  height: 12rpx;
  margin-top: 6rpx;
  border-radius: 50%;
  background: #a8b1bd;
}

.e-paper {
  width: 34rpx;
  height: 60rpx;
  margin-top: 3rpx;
  border-radius: 8rpx;
  background: #c9f24b;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 12rpx;
  box-sizing: border-box;
}

.e-paper-line {
  width: 16rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #3d5500;
  margin-bottom: 6rpx;
}

.e-paper-line.short {
  width: 10rpx;
}

.e-leaf {
  position: absolute;
  width: 22rpx;
  height: 15rpx;
  border-radius: 100% 4rpx 100% 4rpx;
}

.e-leaf-a {
  left: 34rpx;
  bottom: 34rpx;
  background: #c4cad2;
  transform: rotate(-24deg);
}

.e-leaf-b {
  right: 38rpx;
  bottom: 26rpx;
  background: #dde9ac;
  transform: rotate(18deg);
}

.e-title {
  margin-top: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #212631;
  letter-spacing: 2rpx;
}

.e-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #79838f;
  letter-spacing: 1rpx;
  line-height: 1.6;
  text-align: center;
}

/* ===== N2 按天分组 ===== */
.list {
  display: flex;
  flex-direction: column;
}

/* 日期分组标题 */
.g-head {
  display: flex;
  align-items: center;
  margin: 28rpx 8rpx 16rpx;
}

.g-head:first-child {
  margin-top: 4rpx;
}

.g-t {
  font-size: 22rpx;
  font-weight: 700;
  color: #a8b1bd;
  letter-spacing: 4rpx;
}

.g-rule {
  flex: 1;
  height: 1rpx;
  background: #e7eaee;
  margin-left: 20rpx;
}

/* 每天的通知卡片 */
.g-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 4rpx 28rpx;
}

/* 单条通知行 */
.row {
  padding: 22rpx 0 24rpx;
}

.row + .row {
  border-top: 1rpx solid rgba(33, 38, 49, 0.06);
}

/* 标题行: 标题 + 未读点 + 时间 */
.r-l1 {
  display: flex;
  align-items: center;
}

.r-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #212631;
  white-space: nowrap;
}

.read .r-title {
  color: #5a6470;
  font-weight: 600;
}

/* 未读绿点 */
.udot {
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
  background: #c9f24b;
  margin-left: 12rpx;
  flex-shrink: 0;
  box-shadow: 0 0 0 2rpx #212631;
}

.r-time {
  margin-left: auto;
  font-size: 21rpx;
  color: #a8b1bd;
  flex-shrink: 0;
  padding-left: 16rpx;
}

/* 正文 */
.r-text {
  display: block;
  width: 100%;
  box-sizing: border-box;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #454e59;
  white-space: pre-wrap;
  word-break: break-all;
  overflow-wrap: anywhere;
}

.read .r-text {
  color: #8a94a0;
}

.r-activity-date {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.r-activity-date-label {
  font-size: 20rpx;
  color: #8a94a0;
}

.r-activity-date-value {
  font-size: 22rpx;
  color: #454e59;
}

.read .r-activity-date-label,
.read .r-activity-date-value {
  color: #a8b1bd;
}

/* 底部操作人 */
.r-foot {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
}

.r-foot-op {
  margin-left: auto;
  font-size: 21rpx;
  color: #a8b1bd;
}
