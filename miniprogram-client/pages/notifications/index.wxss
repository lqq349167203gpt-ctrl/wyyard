.page {
  min-height: 100vh;
  background: #f4f5f6;
  padding: 28rpx;
  box-sizing: border-box;
}

.loading-box,
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.loading-text {
  font-size: 26rpx;
  color: #a8b1bd;
}

/* ===== 空状态:CSS 风铃(灰调铃身 + 青柠纸签) + 落叶 ===== */
.e-icon {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #f1f0ed;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

/* 风铃整体:挂绳 → 铃身 → 铃沿 → 铃锤 → 纸签 */
.e-chime {
  display: flex;
  flex-direction: column;
  align-items: center;
  /* 纸签垂在下方,视觉上移少许保持居中 */
  margin-top: -14rpx;
}

.e-string {
  width: 4rpx;
  height: 26rpx;
  border-radius: 2rpx;
  background: #c4cad2;
}

.e-dome {
  width: 76rpx;
  height: 54rpx;
  margin-top: 2rpx;
  background: linear-gradient(135deg, #d3d8df 0%, #bcc3cd 100%);
  border-radius: 38rpx 38rpx 10rpx 10rpx;
}

.e-rim {
  width: 88rpx;
  height: 10rpx;
  margin-top: -4rpx;
  border-radius: 5rpx;
  background: #b3bac4;
}

.e-clap {
  width: 12rpx;
  height: 12rpx;
  margin-top: 6rpx;
  border-radius: 50%;
  background: #a8b1bd;
}

/* 青柠纸签:风铃下的短册,品牌点缀色 */
.e-paper {
  width: 34rpx;
  height: 60rpx;
  margin-top: 3rpx;
  border-radius: 8rpx;
  background: #c9f24b;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 12rpx;
  box-sizing: border-box;
}

/* 纸签上的两行小字 */
.e-paper-line {
  width: 16rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #3d5500;
  margin-bottom: 6rpx;
}

.e-paper-line.short {
  width: 10rpx;
}

/* 院中落叶:两片安静的叶子 */
.e-leaf {
  position: absolute;
  width: 22rpx;
  height: 15rpx;
  border-radius: 100% 4rpx 100% 4rpx;
}

.e-leaf-a {
  left: 34rpx;
  bottom: 34rpx;
  background: #c4cad2;
  transform: rotate(-24deg);
}

.e-leaf-b {
  right: 38rpx;
  bottom: 26rpx;
  background: #dde9ac;
  transform: rotate(18deg);
}

.e-title {
  margin-top: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #212631;
  letter-spacing: 2rpx;
}

.e-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #79838f;
  letter-spacing: 1rpx;
  line-height: 1.6;
  text-align: center;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 4rpx rgba(33, 38, 49, 0.05);
}

.card.unread {
  border-left: 6rpx solid #f54a45;
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.dot-wrap {
  width: 20rpx;
  margin-right: 12rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #f54a45;
}

.card-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  color: #212631;
}

.card-time {
  font-size: 22rpx;
  color: #a8b1bd;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.card-content {
  font-size: 26rpx;
  color: #4a5568;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.card-footer {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.card-tag {
  font-size: 22rpx;
  color: #6b7280;
  background: #f4f5f6;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.card-operator {
  font-size: 22rpx;
  color: #a8b1bd;
}
