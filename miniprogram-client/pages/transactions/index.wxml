<view class="page">
  <view wx:if="{{loading}}" class="loading-box">
    <text class="loading-text">加载中...</text>
  </view>

  <view wx:elif="{{items.length === 0}}" class="empty-box">
    <view class="e-icon">
      <view class="e-chime">
        <view class="e-string"></view>
        <view class="e-dome"></view>
        <view class="e-rim"></view>
        <view class="e-clap"></view>
        <view class="e-paper">
          <view class="e-paper-line"></view>
          <view class="e-paper-line short"></view>
        </view>
      </view>
      <view class="e-leaf e-leaf-a"></view>
      <view class="e-leaf e-leaf-b"></view>
    </view>
    <text class="e-title">暂无交易记录</text>
    <text class="e-sub">还没有购买记录，去首页看看活动吧</text>
  </view>

  <view wx:else class="list">
    <block wx:for="{{groups}}" wx:for-item="group" wx:key="day">
      <view class="g-head">
        <text class="g-t">{{group.day}}</text>
        <view class="g-rule"></view>
      </view>
      <view class="date-group-cards">
        <view wx:for="{{group.items}}" wx:for-item="record" wx:key="index" class="card">
          <!-- 标签 -->
          <view class="c-head">
            <text class="ttag {{record.is_refund ? 'tt-refund' : 'tt-buy'}}">{{record.type}}</text>
          </view>
          <!-- 名称 + 金额 -->
          <view class="c-main">
            <text class="c-name">{{record.name}}</text>
            <text class="amt {{record.is_refund ? 'back' : ''}}">{{record.amount_text}}</text>
          </view>
          <!-- 有效期 + 经办 -->
          <view wx:if="{{record.validity_text || record.closer_name}}" class="c-foot">
            <text wx:if="{{record.validity_text}}" class="c-exp">{{record.validity_text}}</text>
            <text wx:if="{{record.closer_name}}" class="c-closer">经办 · {{record.closer_name}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>
