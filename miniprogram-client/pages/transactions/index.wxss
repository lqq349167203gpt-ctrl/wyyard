@import '../notifications/index.wxss';

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.card-type {
  font-size: 24rpx;
  color: #6b7280;
  background: #f4f5f6;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.card-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #212631;
}

.card-body {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.card-name {
  font-size: 28rpx;
  color: #212631;
  font-weight: 500;
}

.card-qty {
  font-size: 24rpx;
  color: #a8b1bd;
}

.card-footer {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.card-date {
  font-size: 22rpx;
  color: #a8b1bd;
}

.card-expiry {
  font-size: 22rpx;
  color: #a8b1bd;
}

.card-closer {
  font-size: 22rpx;
  color: #a8b1bd;
  margin-left: auto;
}
