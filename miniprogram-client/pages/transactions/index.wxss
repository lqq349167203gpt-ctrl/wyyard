@import '../notifications/index.wxss';

.page {
  min-height: 100vh;
  background: #f4f5f6;
  padding: 0;
}

.list {
  padding: 24rpx 28rpx 40rpx;
}

/* ===== T2 卡片（和销卡D2同结构） ===== */
.card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 20rpx 28rpx;
}

.card + .card {
  margin-top: 12rpx;
}

/* 标签 */
.c-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ttag {
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  line-height: 1.35;
  flex-shrink: 0;
}

.tt-buy {
  border: 1rpx solid #e2e4e7;
  color: #5a6470;
  background: #ffffff;
}

.tt-refund {
  background: #faf0cd;
  color: #7f620c;
}

/* 名称 + 金额 */
.c-main {
  margin-top: 12rpx;
  display: flex;
  align-items: baseline;
}

.c-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: #212631;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.amt {
  flex-shrink: 0;
  margin-left: 20rpx;
  font-size: 36rpx;
  font-weight: 400;
  color: #212631;
  white-space: nowrap;
}

.amt.back {
  color: #3d5500;
}

/* 到期 + 经办 */
.c-foot {
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(33, 38, 49, 0.06);
  display: flex;
  align-items: center;
}

.c-exp {
  font-size: 22rpx;
  color: #5a6470;
}

.c-closer {
  margin-left: auto;
  font-size: 21rpx;
  color: #a8b1bd;
}
