.page {
  min-height: 100vh;
  background: #ffffff;
  box-sizing: border-box;
}

/* ===== 透明自定义导航栏 ===== */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  box-sizing: border-box;
  background: transparent;
}

.custom-nav-inner {
  position: relative;
  display: flex;
  align-items: center;
}

.nav-back {
  position: absolute;
  left: 24rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #212631;
  border-bottom: 4rpx solid #212631;
  transform: rotate(45deg);
  margin-left: 6rpx;
}

/* ===== 加载 ===== */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60vh;
}

.loading-text {
  font-size: 26rpx;
  color: #a8b1bd;
}

/* ===== Hero:橱窗底衬 ===== */
.hero {
  position: relative;
  width: 100%;
  height: 660rpx;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(160deg, #e8ede6 0%, #f0f2ee 40%, #f5f3ef 100%);
  overflow: hidden;
}

.hero-bg-image {
  position: absolute;
  left: -60rpx;
  top: -60rpx;
  width: calc(100% + 120rpx);
  height: calc(100% + 120rpx);
  filter: blur(36rpx) saturate(1.1);
}

.hero-bg-veil {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.18);
}

.hero-fg {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 660rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-poster {
  width: 392rpx;
  height: 660rpx;
  max-width: 82%;
  border-radius: 24rpx;
  box-shadow: 0 28rpx 68rpx rgba(90, 60, 30, 0.22);
}

/* ===== 内容 sheet ===== */
.sheet {
  background: #fff;
  padding: 40rpx 44rpx 0;
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.sheet--overlap {
  position: relative;
  margin-top: -48rpx;
  border-radius: 48rpx 48rpx 0 0;
  z-index: 3;
}

/* ===== W1：标题、日期、时间双行信息 ===== */
.w1-title-line {
  line-height: 1.4;
}

.w1-title {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.4;
  color: #212631;
}

.tag-in {
  display: inline-block;
  padding: 5rpx 12rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.3;
}

.tag-gy {
  background: #faf0cd;
  color: #7f620c;
}

.tag-online {
  border: 1rpx solid #e2e4e7;
  background: #ffffff;
  color: #4a5158;
}

.w1-date {
  margin-top: 18rpx;
  font-size: 26rpx;
  color: #212631;
}

.w1-date-main {
  font-weight: 800;
}

.w1-week {
  color: #9aa3ac;
}

.w1-time {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.w1-time-tags {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.w1-time-value {
  font-family: Georgia, "Times New Roman", serif;
  font-style: italic;
  font-size: 32rpx;
  color: #3d5500;
  letter-spacing: 1rpx;
}

.w1-duration {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #a0a7ad;
}

/* ===== 署名行 ===== */
.byline {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
}

.leader-label {
  flex-shrink: 0;
  margin-right: 14rpx;
}

.b-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #212631;
  letter-spacing: 1rpx;
}

.b-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #d3d8de;
  margin: 0 16rpx;
  flex-shrink: 0;
}

.b-addr {
  font-size: 24rpx;
  color: #a8b1bd;
  letter-spacing: 1rpx;
}

.owner-line {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  min-width: 0;
}

.owner-line--standalone {
  margin-top: 28rpx;
}

.owner-label {
  flex-shrink: 0;
  padding: 5rpx 12rpx;
  border: 1rpx solid #e2e4e7;
  border-radius: 10rpx;
  background: #ffffff;
  color: #4a5158;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.3;
}

.owner-name {
  min-width: 0;
  margin-left: 14rpx;
  overflow: hidden;
  color: #454e59;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 分隔线:叶子 + 标题 + 横线 ===== */
.sec {
  margin-top: 52rpx;
  display: flex;
  align-items: center;
}

.ic-leaf {
  width: 28rpx;
  height: 20rpx;
  border-radius: 100% 8rpx 100% 8rpx;
  background: #c9f24b;
  transform: rotate(-16deg) translateY(-2rpx);
  margin-right: 16rpx;
  flex-shrink: 0;
}

.sec-t {
  font-size: 28rpx;
  font-weight: 800;
  color: #212631;
  letter-spacing: 4rpx;
  flex-shrink: 0;
}

.sec-r {
  flex: 1;
  height: 1rpx;
  background: #e6e9ec;
  margin-left: 24rpx;
}

/* ===== 活动介绍 ===== */
.intro {
  margin-top: 20rpx;
}

.intro-p {
  font-size: 26rpx;
  line-height: 1.9;
  color: #454e59;
  letter-spacing: 1rpx;
  white-space: pre-wrap;
  word-break: break-word;
}

.intro-p + .intro-p {
  margin-top: 16rpx;
}

/* ===== 参与者卡片 ===== */
.part {
  margin-top: 32rpx;
  background: #f5f6f7;
  border-radius: 32rpx;
  padding: 28rpx 32rpx;
}

.part-head {
  display: flex;
  align-items: baseline;
}

.part-t {
  font-size: 26rpx;
  font-weight: 800;
  color: #212631;
  letter-spacing: 2rpx;
}

.part-n {
  margin-left: auto;
  font-size: 22rpx;
  color: #a8b1bd;
}

.rnames {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: #79838f;
  letter-spacing: 1rpx;
}

.rname-me {
  color: #3d5500;
  font-weight: 700;
  border-bottom: 4rpx solid #c9f24b;
  padding-bottom: 2rpx;
}

/* ===== 底部报名区 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 44rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to bottom, rgba(255, 255, 255, 0), #ffffff 34%);
  z-index: 10;
}

.expired-notice {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  font-size: 28rpx;
  color: #a8b1bd;
  background: #f5f6f7;
  border-radius: 999rpx;
}

.signup-btn {
  display: block;
  width: 100% !important;
  height: 92rpx;
  line-height: 92rpx;
  padding: 0;
  margin: 0;
  background: #c9f24b;
  color: #3d5500;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
  border-radius: 999rpx;
  border: none;
  box-sizing: border-box;
}

.signup-btn::after {
  border: none;
}

.signup-btn[disabled] {
  background: #c9f24b;
  color: rgba(61, 85, 0, 0.4);
}

.signup-done {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  color: #3d5500;
  background: #c9f24b;
  border-radius: 999rpx;
}

.cancel-link {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b6bec8;
  letter-spacing: 2rpx;
}

.role-participation-note {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8f999f;
  letter-spacing: 2rpx;
}
