<view class="page">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading">
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:elif="{{activity}}">
    <!-- 日期时间行:左日期 + 右时间块(与首页卡片同款时间语言) -->
    <view class="hero">
      <view class="hero-left">
        <text class="date">{{activity.dateLabel}}</text>
        <text class="week">{{activity.weekday}}</text>
      </view>
      <view class="timeblock">
        <text wx:if="{{activity.timeStart}}" class="start">{{activity.timeStart}}</text>
        <text wx:else class="start start-tbd">时间待定</text>
        <text wx:if="{{activity.timeEnd}}" class="end">至 {{activity.timeEnd}}</text>
      </view>
    </view>

    <!-- 标签:只保留标题里没有的增量信息(公益/线上),不放类型标签避免与标题重复 -->
    <view class="tags" wx:if="{{activity.is_public_welfare || activity.isOnline}}">
      <text wx:if="{{activity.is_public_welfare}}" class="tag">公益</text>
      <text wx:if="{{activity.isOnline}}" class="tag">线上</text>
    </view>

    <!-- 标题 -->
    <view class="title">{{activity.name}}</view>

    <!-- 署名行:老师 + 地址并一行(紧贴标题) -->
    <view class="byline" wx:if="{{activity.teachers.length || activity.addressText}}">
      <view class="b-avatars" wx:if="{{activity.teachers.length}}">
        <view wx:for="{{activity.teachers}}" wx:key="index" class="b-avatar">{{item.initial}}</view>
      </view>
      <text wx:if="{{activity.teacherText}}" class="b-name">{{activity.teacherText}}</text>
      <text wx:if="{{activity.teachers.length}}" class="b-label">老师</text>
      <view wx:if="{{activity.teachers.length && activity.addressText}}" class="b-dot"></view>
      <text wx:if="{{activity.addressText}}" class="b-addr">{{activity.addressText}}</text>
    </view>

    <!-- 参与者:一行小字全部列出,自己加粗(紧贴署名行) -->
    <view class="roster" wx:if="{{activity.rosterList.length}}">
      <text class="rnames"><text wx:for="{{activity.rosterList}}" wx:key="index" class="{{item.is_me ? 'rname-me' : ''}}">{{item.name}}{{index < activity.rosterList.length - 1 ? '、' : ''}}</text> 已报名</text>
    </view>

    <!-- 活动简介:青柠小条引导,长文完整展示 -->
    <view class="intro" wx:if="{{activity.description}}">
      <view class="intro-head">
        <view class="bar"></view>
        <text class="label">活动介绍</text>
      </view>
      <text class="intro-body">{{activity.description}}</text>
    </view>
  </block>

  <!-- 底部报名按钮:黑底青柠,与首页选中态同语言 -->
  <view wx:if="{{activity}}" class="bottom-bar">
    <view wx:if="{{activity.expiredStatus === 'ended'}}" class="expired-notice">活动已结束，无法报名</view>
    <view wx:elif="{{activity.expiredStatus === 'ongoing'}}" class="expired-notice">活动进行中，无法报名</view>
    <block wx:elif="{{!signedUp}}">
      <button
        class="signup-btn"
        bindtap="onSignup"
        disabled="{{signingUp}}"
      >
        {{signingUp ? '报名中...' : '立即报名'}}
      </button>
    </block>
    <button
      wx:else
      class="signup-btn signup-btn-cancel"
      bindtap="onCancelSignup"
    >
      取消报名
    </button>
  </view>
</view>
