<view class="page">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-box">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{allItems.length === 0}}" class="empty-box">
    <view class="e-icon">
      <view class="e-chime">
        <view class="e-string"></view>
        <view class="e-dome"></view>
        <view class="e-rim"></view>
        <view class="e-clap"></view>
        <view class="e-paper">
          <view class="e-paper-line"></view>
          <view class="e-paper-line short"></view>
        </view>
      </view>
      <view class="e-leaf e-leaf-a"></view>
      <view class="e-leaf e-leaf-b"></view>
    </view>
    <text class="e-title">暂无活动记录</text>
    <text class="e-sub">还没有参加过活动，去首页看看吧</text>
  </view>

  <!-- 内容 -->
  <block wx:else>
    <!-- 记录摘要 -->
    <view class="summary">
      <view class="sum">
        <text class="sum-num">{{totalCount}}</text>
        <text class="sum-lab">场</text>
      </view>
      <view class="sum">
        <text class="sum-num">{{arrivedCount}}</text>
        <text class="sum-lab">已到场</text>
      </view>
      <view class="sum">
        <text class="sum-num">{{signedUpCount}}</text>
        <text class="sum-lab">报名中</text>
      </view>
      <view class="sum">
        <text class="sum-num">{{missedCount}}</text>
        <text class="sum-lab">未到场</text>
      </view>
    </view>

    <!-- 状态筛选 -->
    <view class="tabs">
      <text class="tab {{activeTab === 'all' ? 'on' : ''}}" bindtap="onTabTap" data-tab="all">全部</text>
      <text class="tab {{activeTab === 'signedup' ? 'on' : ''}}" bindtap="onTabTap" data-tab="signedup">报名中</text>
      <text class="tab {{activeTab === 'arrived' ? 'on' : ''}}" bindtap="onTabTap" data-tab="arrived">已到场</text>
      <text class="tab {{activeTab === 'missed' ? 'on' : ''}}" bindtap="onTabTap" data-tab="missed">未到场</text>
    </view>

    <!-- 月份分组 -->
    <block wx:for="{{groups}}" wx:key="month">
      <view class="mon-head">
        <text class="mon-title">{{item.month}} 月</text>
        <view class="mon-rule"></view>
        <text class="mon-note">{{item.totalCount}} 场</text>
      </view>

      <view class="days">
        <block wx:for="{{item.dateGroups}}" wx:for-item="dg" wx:key="date">
          <view class="day-card">
            <view class="d-head">
              <text class="d-chip {{dg.isPast ? 'past' : ''}} {{dg.chipTilt}}">{{dg.dateChip}}</text>
              <text wx:if="{{dg.items.length > 1}}" class="d-count">{{dg.items.length}} 场</text>
            </view>
            <view wx:for="{{dg.items}}" wx:for-item="act" wx:key="index" class="r2">
              <view class="r2-l1">
                <text class="r-name">{{act.displayName}}</text>
                <text class="r-st {{act.badgeClass}}">{{act.badge}}</text>
              </view>
              <view class="r2-l2">
                <text class="m-time {{act.timeUndecided ? 'undecided' : ''}}">{{act.timeRange}}</text>
                <text class="role-tag">· {{act.roleLabel}}</text>
                <text wx:if="{{act.membership_deduction_count > 0 && !act.is_public_welfare}}" class="role-tag"> · 扣卡{{act.membership_deduction_count}}次</text>
                <text
                  class="followup-btn {{act.has_followup ? 'done' : ''}}"
                  catchtap="onFollowupTap"
                  data-key="{{act.activity_key}}"
                >{{act.has_followup ? '已回访' : '写回访'}}</text>
              </view>
            </view>
          </view>
        </block>
      </view>
    </block>

    <view class="end-note">· 没有更多了 ·</view>
  </block>
</view>

<followup-editor
  visible="{{!!selectedFollowupActivity}}"
  activity="{{selectedFollowupActivity}}"
  bind:close="onFollowupClose"
  bind:saved="onFollowupSaved"
/>
