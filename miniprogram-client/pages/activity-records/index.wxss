@import "../../assets/fonts/playfair.wxss";

page {
  background: #f4f5f6;
}

.page {
  min-height: 100vh;
  background: #f4f5f6;
}

.loading-box,
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.loading-text {
  font-size: 26rpx;
  color: #a8b1bd;
}

/* ===== 空状态 ===== */
.e-icon {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #f1f0ed;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.e-chime {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: -14rpx;
}

.e-string {
  width: 4rpx;
  height: 26rpx;
  border-radius: 2rpx;
  background: #c4cad2;
}

.e-dome {
  width: 76rpx;
  height: 54rpx;
  margin-top: 2rpx;
  background: linear-gradient(135deg, #d3d8df 0%, #bcc3cd 100%);
  border-radius: 38rpx 38rpx 10rpx 10rpx;
}

.e-rim {
  width: 88rpx;
  height: 10rpx;
  margin-top: -4rpx;
  border-radius: 5rpx;
  background: #b3bac4;
}

.e-clap {
  width: 12rpx;
  height: 12rpx;
  margin-top: 6rpx;
  border-radius: 50%;
  background: #a8b1bd;
}

.e-paper {
  width: 34rpx;
  height: 60rpx;
  margin-top: 3rpx;
  border-radius: 8rpx;
  background: #c9f24b;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 12rpx;
  box-sizing: border-box;
}

.e-paper-line {
  width: 16rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #3d5500;
  margin-bottom: 6rpx;
}

.e-paper-line.short {
  width: 10rpx;
}

.e-leaf {
  position: absolute;
  width: 22rpx;
  height: 15rpx;
  border-radius: 100% 4rpx 100% 4rpx;
}

.e-leaf-a {
  left: 34rpx;
  bottom: 34rpx;
  background: #c4cad2;
  transform: rotate(-24deg);
}

.e-leaf-b {
  right: 38rpx;
  bottom: 26rpx;
  background: #dde9ac;
  transform: rotate(18deg);
}

.e-title {
  margin-top: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #212631;
  letter-spacing: 2rpx;
}

.e-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #79838f;
  letter-spacing: 1rpx;
  line-height: 1.6;
  text-align: center;
}

/* ===== 记录摘要 ===== */
.summary {
  margin: 24rpx 28rpx 0;
  background: #fff;
  border-radius: 32rpx;
  padding: 26rpx 0;
  display: flex;
}

.sum {
  flex: 1;
  text-align: center;
}

.sum + .sum {
  border-left: 1rpx solid #eceff1;
}

.sum-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #212631;
  line-height: 1;
  display: block;
}

.sum-lab {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #a8b1bd;
  letter-spacing: 2rpx;
  display: block;
}

/* ===== 状态筛选 ===== */
.tabs {
  margin: 24rpx 40rpx 0;
  display: flex;
  align-items: center;
  gap: 36rpx;
}

.tab {
  font-size: 25rpx;
  color: #98a1ad;
  padding-bottom: 8rpx;
}

.tab.on {
  color: #212631;
  font-weight: 800;
  border-bottom: 4rpx solid #c9f24b;
}

/* ===== 月份分组 ===== */
.mon-head {
  margin: 32rpx 40rpx 0;
  display: flex;
  align-items: center;
}

.mon-title {
  font-size: 26rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.mon-rule {
  flex: 1;
  height: 2rpx;
  background: #e7eaee;
  margin: 0 20rpx;
}

.mon-note {
  font-size: 21rpx;
  color: #a8b1bd;
}

/* ===== 活动卡片 ===== */
.days {
  margin: 16rpx 28rpx 0;
}

.day-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 22rpx 28rpx 12rpx;
  margin-top: 20rpx;
}

.d-head {
  display: flex;
  align-items: center;
  padding-bottom: 8rpx;
}

.d-chip {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  padding: 8rpx 20rpx;
  border-radius: 14rpx;
  background: #212631;
  color: #c9f24b;
}

.d-chip.past {
  background: #ffffff;
  color: #98a1ad;
}

.d-chip.tilt-l {
  transform: rotate(-1.2deg);
}

.d-chip.tilt-r {
  transform: rotate(1.2deg);
}

.d-count {
  margin-left: auto;
  font-size: 22rpx;
  color: #a8b1bd;
  letter-spacing: 2rpx;
}

/* ===== U1 双行活动清单 ===== */
.r2 {
  padding: 16rpx 0 18rpx;
}

.r2 + .r2 {
  border-top: 1rpx solid rgba(33, 38, 49, 0.06);
}

.r2-l1 {
  display: flex;
  align-items: center;
}

.r2-l2 {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
}

.followup-btn {
  flex-shrink: 0;
  margin-left: auto;
  font-size: 23rpx;
  font-weight: 600;
  color: #3d5500;
  letter-spacing: 0.5rpx;
}

.followup-btn.done {
  color: #b6bec8;
  font-weight: 400;
}

.r-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.m-time {
  flex-shrink: 0;
  color: #3d5500;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 23rpx;
  font-style: italic;
  letter-spacing: 0.5rpx;
}

.m-time.undecided {
  font-style: normal;
  font-family: inherit;
  color: #a8b1bd;
}

.role-tag {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #a8b1bd;
  letter-spacing: 0.5rpx;
}

.r-st {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.st-up {
  color: #3d5500;
  font-weight: 600;
}

.st-done {
  color: #a8b1bd;
  font-weight: 400;
}

.st-miss {
  color: #c3c9cf;
}

.st-withdrawn {
  color: #a14c5f;
}

/* ===== 底部 ===== */
.end-note {
  margin: 52rpx 0 60rpx;
  text-align: center;
  font-size: 22rpx;
  color: #c4cad2;
  letter-spacing: 4rpx;
}
