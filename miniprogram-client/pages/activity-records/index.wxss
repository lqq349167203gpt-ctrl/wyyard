@import "../../assets/fonts/playfair.wxss";

page {
  background: #fff;
}

.page {
  min-height: 100vh;
  background: #fff;
}

.loading-box,
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.loading-text {
  font-size: 26rpx;
  color: #a8b1bd;
}

/* ===== 空状态 ===== */
.e-icon {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #f1f0ed;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.e-chime {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: -14rpx;
}

.e-string {
  width: 4rpx;
  height: 26rpx;
  border-radius: 2rpx;
  background: #c4cad2;
}

.e-dome {
  width: 76rpx;
  height: 54rpx;
  margin-top: 2rpx;
  background: linear-gradient(135deg, #d3d8df 0%, #bcc3cd 100%);
  border-radius: 38rpx 38rpx 10rpx 10rpx;
}

.e-rim {
  width: 88rpx;
  height: 10rpx;
  margin-top: -4rpx;
  border-radius: 5rpx;
  background: #b3bac4;
}

.e-clap {
  width: 12rpx;
  height: 12rpx;
  margin-top: 6rpx;
  border-radius: 50%;
  background: #a8b1bd;
}

.e-paper {
  width: 34rpx;
  height: 60rpx;
  margin-top: 3rpx;
  border-radius: 8rpx;
  background: #c9f24b;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 12rpx;
  box-sizing: border-box;
}

.e-paper-line {
  width: 16rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #3d5500;
  margin-bottom: 6rpx;
}

.e-paper-line.short {
  width: 10rpx;
}

.e-leaf {
  position: absolute;
  width: 22rpx;
  height: 15rpx;
  border-radius: 100% 4rpx 100% 4rpx;
}

.e-leaf-a {
  left: 34rpx;
  bottom: 34rpx;
  background: #c4cad2;
  transform: rotate(-24deg);
}

.e-leaf-b {
  right: 38rpx;
  bottom: 26rpx;
  background: #dde9ac;
  transform: rotate(18deg);
}

.e-title {
  margin-top: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #212631;
  letter-spacing: 2rpx;
}

.e-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #79838f;
  letter-spacing: 1rpx;
  line-height: 1.6;
  text-align: center;
}

/* ===== 记录摘要 ===== */
.summary {
  width: 100%;
  padding: 24rpx 44rpx 0;
  box-sizing: border-box;
  display: flex;
  align-items: baseline;
}

.sum {
  display: flex;
  align-items: baseline;
}

.sum + .sum {
  margin-left: 32rpx;
}

.sum-num {
  font-family: "PlayfairNum", "Bodoni MT", "Bodoni 72", Didot, "Times New Roman", serif;
  font-size: 40rpx;
  font-weight: 400;
}

.sum-lab {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #a8b1bd;
  letter-spacing: 2rpx;
}

/* ===== 状态筛选 ===== */
.tabs {
  margin: 28rpx 44rpx 0;
  display: flex;
  align-items: center;
}

.tab {
  font-size: 24rpx;
  color: #a8b1bd;
  letter-spacing: 2rpx;
  padding: 8rpx 4rpx;
}

.tab + .tab {
  margin-left: 32rpx;
}

.tab.on {
  background: #212631;
  color: #c9f24b;
  font-weight: 700;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  letter-spacing: 2rpx;
}

/* ===== 月份分组 ===== */
.mon-head {
  margin: 48rpx 44rpx 0;
  display: flex;
  align-items: center;
}

.mon-title {
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.mon-rule {
  flex: 1;
  height: 2rpx;
  background: #eceff1;
  margin: 0 24rpx;
}

.mon-note {
  font-size: 22rpx;
  color: #a8b1bd;
  letter-spacing: 2rpx;
}

/* ===== 活动卡片 ===== */
.days {
  margin: 8rpx 32rpx 0;
}

.day-card {
  position: relative;
  background: #f8f9fa;
  border-radius: 32rpx;
  padding: 20rpx 28rpx 10rpx;
  overflow: hidden;
  margin-top: 20rpx;
}

.d-head {
  display: flex;
  align-items: center;
  padding-bottom: 8rpx;
}

.d-chip {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  padding: 8rpx 20rpx;
  border-radius: 14rpx;
  background: #212631;
  color: #c9f24b;
}

.d-chip.past {
  background: #ffffff;
  color: #98a1ad;
}

.d-chip.tilt-l {
  transform: rotate(-1.2deg);
}

.d-chip.tilt-r {
  transform: rotate(1.2deg);
}

.d-count {
  margin-left: auto;
  font-size: 22rpx;
  color: #a8b1bd;
  letter-spacing: 2rpx;
}

/* ===== U1 双行活动清单 ===== */
.r2 {
  padding: 16rpx 0 18rpx;
}

.r2 + .r2 {
  border-top: 1rpx solid rgba(33, 38, 49, 0.06);
}

.r2-l1 {
  display: flex;
  align-items: center;
}

.r2-l2 {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
}

.followup-btn {
  flex-shrink: 0;
  min-width: 92rpx;
  height: 46rpx;
  margin: 0 0 0 auto;
  padding: 0 18rpx;
  border: 1rpx solid #dfe3e7;
  border-radius: 23rpx;
  background: #ffffff;
  color: #59636f;
  font-size: 21rpx;
  font-weight: 500;
  line-height: 44rpx;
}

.followup-btn::after {
  border: 0;
}

.followup-btn.done {
  border-color: #e5ebd0;
  background: #f7faed;
  color: #68783b;
}

.r-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.m-time {
  flex-shrink: 0;
  color: #3d5500;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 23rpx;
  font-style: normal;
  letter-spacing: 1rpx;
}

.role-tag {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 4rpx 11rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: 1rpx;
}

.rt-join {
  border: 1rpx solid #e2e4e7;
  background: #ffffff;
  color: #a8b1bd;
}

.rt-lead {
  background: #212631;
  color: #c9f24b;
}

.rt-owner {
  background: #faf0cd;
  color: #7f620c;
}

.r-st {
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.st-up {
  background: #ffffff;
  color: #212631;
}

.st-done {
  background: #ffffff;
  color: #a8b1bd;
}

.st-miss {
  color: #b6bec8;
  padding-left: 0;
  padding-right: 0;
}

/* ===== 底部 ===== */
.end-note {
  margin: 52rpx 0 60rpx;
  text-align: center;
  font-size: 22rpx;
  color: #c4cad2;
  letter-spacing: 4rpx;
}
