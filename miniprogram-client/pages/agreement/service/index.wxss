.page {
  min-height: 100vh;
  background: #f4f5f6;
  padding: 28rpx;
  box-sizing: border-box;
}

.doc-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 44rpx 32rpx 52rpx;
  box-shadow: 0 2rpx 4rpx rgba(33, 38, 49, 0.05);
}

.doc-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #212631;
  text-align: center;
  letter-spacing: -0.01em;
}

.doc-date {
  display: block;
  margin-top: 16rpx;
  font-size: 20rpx;
  color: #a8b1bd;
  text-align: center;
}

.sec {
  margin-top: 40rpx;
}

.sec-h {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #212631;
  margin-bottom: 14rpx;
}

.sec-p {
  display: block;
  font-size: 24rpx;
  color: #79838f;
  line-height: 1.85;
  margin-bottom: 10rpx;
}

.doc-end {
  display: block;
  margin-top: 52rpx;
  text-align: center;
  font-size: 20rpx;
  color: #c4cad2;
}
