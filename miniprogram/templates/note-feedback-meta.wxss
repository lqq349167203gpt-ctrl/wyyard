.note-feedback-attribution { min-width: 0; color: #2b2f36; font-size: 22rpx; font-weight: 400; line-height: 1.5; }
.note-feedback-label { color: #a4abb4; }
.note-feedback-entry + .note-feedback-entry { margin-top: 12rpx; }
.note-feedback-content { display: block; white-space: pre-wrap; word-break: break-all; }
.note-feedback-summary { min-width: 0; flex: 1; }
.note-feedback-author { min-width: 0; flex: 1; }
.note-feedback-inline { display: flex; align-items: baseline; gap: 12rpx; }
