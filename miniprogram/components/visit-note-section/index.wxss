.note-card {
  margin-bottom: 20rpx;
  padding: 24rpx 28rpx;
  border-radius: 12rpx;
  background: #ffffff;
}

.note-header,
.note-meta,
.editor-header,
.editor-footer,
.section-label {
  display: flex;
  align-items: center;
}

.note-header,
.editor-header,
.editor-footer,
.section-label {
  justify-content: space-between;
}

.note-title {
  color: #8f959e;
  font-size: 28rpx;
  font-weight: 500;
}

.note-count {
  color: #8f959e;
  font-size: 22rpx;
}

/* 分区标签：纯文字，无装饰 */
.section-label {
  margin-top: 16rpx;
  margin-bottom: 8rpx;
}

.section-label.others {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.section-label-text {
  color: #8f959e;
  font-size: 24rpx;
  font-weight: 500;
}

.section-label-hint {
  color: #8f959e;
  font-size: 22rpx;
}

.clear-btn {
  color: #646a73;
}

/* 我填写的：普通输入框样式，整框可点进入编辑 */
.mine-box {
  padding: 16rpx;
  border: 1rpx solid #dee0e3;
  border-radius: 8rpx;
  background: #ffffff;
}

.mine-content {
  color: #2b2f36;
  font-size: 28rpx;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-all;
}

.mine-placeholder {
  color: #c0c4cc;
}

/* 别人填写的：只读平铺 */
.note-item {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.note-item:last-child {
  padding-bottom: 4rpx;
  border-bottom: 0;
}

.note-creator {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #4e535a;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.note-time {
  margin-left: 16rpx;
  color: #8f959e;
  font-size: 22rpx;
}

.note-content {
  display: block;
  margin-top: 4rpx;
  color: #2b2f36;
  font-size: 28rpx;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-all;
}

.note-loading {
  padding: 24rpx 0 8rpx;
  color: #b0b5bb;
  font-size: 28rpx;
  text-align: center;
}

/* 编辑底部弹层 */
.editor-mask {
  position: fixed;
  z-index: 200;
  inset: 0;
  background: rgba(0, 0, 0, 0.35);
}

.editor-panel {
  position: fixed;
  z-index: 201;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: #ffffff;
}

.editor-header {
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.editor-title {
  color: #1f2329;
  font-size: 30rpx;
  font-weight: 500;
}

.editor-close {
  color: #8f959e;
  font-size: 28rpx;
}

.editor-input {
  box-sizing: border-box;
  width: calc(100% - 56rpx);
  height: 220rpx;
  margin: 28rpx;
  padding: 20rpx;
  border: 1rpx solid #dee0e3;
  border-radius: 8rpx;
  color: #2b2f36;
  font-size: 30rpx;
  line-height: 1.6;
}

.editor-footer {
  padding: 0 28rpx 28rpx;
}

.editor-hint {
  color: #8f959e;
  font-size: 24rpx;
}

.editor-submit {
  width: 120rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 8rpx;
  background: #3370ff;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 64rpx;
}

.editor-submit::after {
  border: 0;
}

.editor-submit[disabled] {
  background: #c9cdd4;
  color: #ffffff;
}
