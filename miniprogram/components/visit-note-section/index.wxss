.note-card {
  margin-bottom: 28rpx;
  padding: 28rpx 28rpx;
  border-radius: 12rpx;
  background: #ffffff;
}

.feedback-field { display: flex; align-items: center; gap: 16rpx; padding: 14rpx 28rpx 0; color: #646a73; font-size: 26rpx; }
.feedback-label { display: flex; flex-shrink: 0; align-items: center; gap: 8rpx; }
.feedback-label-dot { width: 12rpx; height: 12rpx; flex-shrink: 0; border-radius: 50%; background: #f4dc84; }
.feedback-field picker { flex: 0 1 260rpx; min-width: 0; }
.feedback-picker { display: flex; align-items: center; justify-content: space-between; height: 58rpx; box-sizing: border-box; padding: 0 16rpx; border: 1rpx solid #e1e4e7; border-radius: 8rpx; background: #fcfcfc; color: #2b2f36; font-size: 26rpx; }
.feedback-picker-text { flex: 1; min-width: 0; overflow: hidden; text-align: left; text-overflow: ellipsis; white-space: nowrap; }
.feedback-picker-arrow { flex-shrink: 0; width: 0; height: 0; margin-left: 12rpx; border-top: 7rpx solid #9aa1a9; border-right: 7rpx solid transparent; border-left: 7rpx solid transparent; }

.note-header,
.note-meta,
.editor-header,
.editor-footer,
.section-label {
  display: flex;
  align-items: center;
}

.note-header,
.editor-header,
.editor-footer,
.section-label {
  justify-content: space-between;
}

.note-title {
  color: #8f959e;
  font-size: 28rpx;
  font-weight: 500;
}

.note-count {
  color: #8f959e;
  font-size: 22rpx;
}

/* 分区标签：纯文字，无装饰 */
.section-label {
  margin-top: 20rpx;
  margin-bottom: 12rpx;
}

.section-label.others {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.section-label-text {
  color: #8f959e;
  font-size: 24rpx;
  font-weight: 500;
}

.section-label-hint {
  color: #a4abb4;
  font-size: 22rpx;
}

.clear-btn {
  color: #646a73;
}

/* 我填写的：普通输入框样式，整框可点进入编辑 */
.mine-box {
  padding: 16rpx;
  border: 1rpx solid #dee0e3;
  border-radius: 8rpx;
  background: #ffffff;
}

.mine-content {
  color: #2b2f36;
  font-size: 28rpx;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-all;
}

.mine-placeholder {
  color: #c0c4cc;
}

/* 别人填写的：只读平铺 */
.note-item {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.note-item:last-child {
  padding-bottom: 4rpx;
  border-bottom: 0;
}

.note-creator {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #8f959e;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.note-time {
  color: #a4abb4;
  font-size: 22rpx;
}
.note-meta-right { display: flex; align-items: center; gap: 14rpx; margin-left: auto; flex-shrink: 0; color: #a4abb4; font-size: 22rpx; text-align: right; }

.note-content {
  display: block;
  margin-top: 10rpx;
  color: #2b2f36;
  font-size: 28rpx;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-all;
}

.note-loading {
  padding: 24rpx 0 8rpx;
  color: #b0b5bb;
  font-size: 28rpx;
  text-align: center;
}

/* 编辑底部弹层 */
.editor-mask {
  position: fixed;
  z-index: 200;
  inset: 0;
  background: rgba(31, 35, 41, 0.34);
}

.editor-panel {
  position: fixed;
  z-index: 201;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  max-height: 82vh;
  box-sizing: border-box;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
  border-radius: 16rpx 16rpx 0 0;
  background: #ffffff;
}

.editor-body {
  flex: 0 1 auto;
  min-height: 0;
  max-height: calc(82vh - 300rpx);
}

.editor-header {
  flex-shrink: 0;
  padding: 26rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.editor-title {
  color: #1f2329;
  font-size: 31rpx;
  font-weight: 500;
}

.editor-close {
  color: #3370ff;
  font-size: 27rpx;
}

.editor-header-actions,
.previous-meta {
  display: flex;
  align-items: center;
}

.editor-header-actions {
  gap: 28rpx;
}

.previous-toggle,
.previous-append {
  color: #3370ff;
  font-size: 24rpx;
}

.previous-box {
  margin: 24rpx 28rpx 0;
  padding: 16rpx 20rpx;
  border: 1rpx solid #dce5f8;
  border-radius: 8rpx;
  background: #f7f9fc;
}

.previous-meta {
  justify-content: space-between;
  margin-bottom: 8rpx;
  color: #8f959e;
  font-size: 22rpx;
}

.previous-content {
  display: block;
  color: #4e535a;
  font-size: 26rpx;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-all;
}

.previous-empty {
  color: #8f959e;
  font-size: 24rpx;
}

.previous-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  color: #c4506a;
  font-size: 24rpx;
}

.previous-retry {
  flex-shrink: 0;
  color: #3370ff;
}

.editor-input {
  box-sizing: border-box;
  width: calc(100% - 56rpx);
  height: 260rpx;
  margin: 12rpx 28rpx 20rpx;
  padding: 18rpx;
  border: 0;
  border-radius: 8rpx;
  background: #f5f6f7;
  color: #2b2f36;
  font-size: 28rpx;
  line-height: 1.6;
}

.editor-footer {
  flex-shrink: 0;
  padding: 16rpx 28rpx 26rpx;
  background: #ffffff;
}

.editor-hint {
  color: #8f959e;
  font-size: 22rpx;
}

.editor-submit {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 230rpx;
  height: 72rpx;
  box-sizing: border-box;
  margin-left: auto;
  border-radius: 8rpx;
  background: #3370ff;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1;
}

.editor-submit-disabled {
  opacity: 0.7;
}

/* 跟进安排：与 PC 一致，标题和控件横排，两项共用一行。 */
.attribution-action { margin-left: 8rpx; color: #a4abb4; font-weight: 400; }
.attribution-label { color: #a4abb4; font-weight: 400; }
.own-heading, .note-person-plan { display: flex; flex: 1; min-width: 0; align-items: baseline; flex-wrap: wrap; gap: 6rpx 12rpx; }
.own-heading { flex-direction: column; align-items: stretch; }
.own-note-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6rpx 12rpx; color: #2b2f36; font-size: 22rpx; }
.follow-up-label, .follow-up-meta { flex-wrap: wrap; gap: 8rpx 12rpx; }
.plan-meta { flex-basis: 100%; width: 100%; color: #2b2f36; font-size: 22rpx; font-weight: 400; line-height: 1.5; }
.note-person-plan .note-creator { flex: 0 1 auto; max-width: 220rpx; color: #2b2f36; }
.editor-section-label { margin: 12rpx 28rpx 12rpx; color: #8f959e; font-size: 24rpx; }
.plan-fields { display: flex; align-items: center; gap: 20rpx; margin: 0 28rpx 8rpx; }
.plan-field { display: flex; flex: 1; min-width: 0; align-items: center; gap: 12rpx; }
.plan-label { width: 104rpx; flex-shrink: 0; color: #646a73; font-size: 24rpx; white-space: nowrap; }
.feedback-field-plan { width: calc(50% - 38rpx); margin: 0 28rpx; padding: 14rpx 0 0; gap: 12rpx; font-size: 24rpx; }
.feedback-field-plan .feedback-label { width: 104rpx; }
.feedback-field-plan picker { flex: 1; min-width: 0; margin-left: 0; }
.feedback-field-plan .feedback-picker { height: 52rpx; font-size: 24rpx; }
.plan-control { display: flex; flex: 1; min-width: 0; height: 52rpx; align-items: center; box-sizing: border-box; border: 1rpx solid #dee0e3; border-radius: 8rpx; background: #fff; }
.plan-input { flex: 1; width: 0; min-width: 0; height: 50rpx; padding: 0 12rpx; color: #2b2f36; font-size: 24rpx; line-height: 50rpx; }
.plan-clear { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 30rpx; height: 50rpx; padding-right: 4rpx; color: #a8b1bd; font-size: 28rpx; }
.plan-date-control picker { flex: 1; min-width: 0; }
.plan-date-value { padding: 0 10rpx; color: #2b2f36; font-size: 24rpx; line-height: 50rpx; white-space: nowrap; }
.plan-placeholder { color: #c0c4cc; }
.plan-search-results { margin: 0 28rpx 16rpx; padding: 4rpx 0; border: 1rpx solid #e8eaed; border-radius: 8rpx; background: #fff; }
.plan-person-option { display: flex; height: 64rpx; box-sizing: border-box; align-items: center; gap: 16rpx; padding: 12rpx 20rpx; color: #2b2f36; font-size: 26rpx; line-height: 40rpx; }
.plan-person-name { color: #8f959e; font-size: 22rpx; }
.plan-search-state { padding: 14rpx 20rpx; color: #a8b1bd; font-size: 22rpx; line-height: 1.5; }

/* 邀约详情中的署名与日期增大一号，不影响编辑页共用样式。 */
.enlarged-meta .section-label-hint,
.enlarged-meta .own-note-meta,
.enlarged-meta .plan-meta,
.enlarged-meta .note-creator,
.enlarged-meta .note-time,
.enlarged-meta .note-meta-right {
  font-size: 24rpx;
}
.need-tags-section { margin: 24rpx 28rpx 28rpx; }
.note-display-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin: 8rpx 0; }
.note-display-tag { max-width: 100%; box-sizing: border-box; padding: 2rpx 12rpx; border: 1rpx solid #dce5f2; border-radius: 8rpx; background: #f2f6fc; color: #526886; font-size: 24rpx; line-height: 34rpx; word-break: break-all; }
.need-tags-label { display: block; margin-bottom: 16rpx; font-size: 24rpx; color: #646a73; }
.need-tags-options { display: flex; flex-wrap: wrap; gap: 16rpx; }
.need-tag { padding: 10rpx 20rpx; border: 1rpx solid #e5e7eb; border-radius: 8rpx; background: #fff; color: #646a73; font-size: 24rpx; }
.need-tag-selected { border-color: #adc4f5; background: #f2f6ff; color: #3370ff; }
.need-tags-state { display: block; margin-top: 12rpx; font-size: 22rpx; color: #a8b1bd; }
