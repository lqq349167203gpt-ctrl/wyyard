<view wx:if="{{canView}}" class="note-card {{enlargedMeta ? 'enlarged-meta' : ''}}">
  <view class="note-header">
    <text class="note-title">{{title}}</text>
    <text class="note-count" wx:if="{{personCount && !privateToCreator}}">{{personCount}}条记录</text>
  </view>

  <!-- 我填写的 -->
  <view class="section-label" wx:if="{{loadError}}" bindtap="loadNotes">{{loadError}} · 点击重试</view>
  <view class="section-label {{category === 'follow_up' ? 'follow-up-label' : ''}}">
    <view class="own-heading">
      <text class="section-label-text">我填写的</text>
      <view class="own-note-meta" wx:if="{{myNote}}">
        <text><text class="attribution-label">反馈：</text>{{myNote.feedbackText}}</text>
        <text class="plan-meta" wx:if="{{category === 'follow_up' && (myNote.next_follow_up_person || myNote.next_follow_up_date)}}"><text class="attribution-label">下次跟进：</text>{{myNote.next_follow_up_person}}<text wx:if="{{myNote.next_follow_up_person && myNote.next_follow_up_date}}"> </text>{{myNote.followUpDateText}}</text>
      </view>
    </view>
    <text class="section-label-hint" wx:if="{{myNote}}">{{myNote.timeText}}<text class="attribution-action">更新</text> · {{myNote.creatorText}}<text class="attribution-action">创建</text><text wx:if="{{!readOnly}}"> · <text class="clear-btn" bindtap="onClearMine">清空</text></text></text>
  </view>
  <view class="mine-box" bindtap="onAdd">
    <view class="note-display-tags" wx:if="{{category === 'visit_need' && showNeedTags && myNote.need_tags.length}}">
      <text class="note-display-tag" wx:for="{{myNote.need_tags}}" wx:for-item="tag" wx:key="id">{{tag.name}}</text>
    </view>
    <text wx:if="{{!myNote || (showDetail && myNote.content)}}" class="mine-content {{myNote ? '' : 'mine-placeholder'}}">{{myNote ? myNote.content : (readOnly ? '暂无记录' : (privateToCreator ? '填写' + title + '…' : '写下你观察到的' + title + '…'))}}</text>
  </view>

  <!-- 别人填写的 -->
  <block wx:if="{{otherNotes.length && !privateToCreator}}">
    <view class="section-label others">
      <text class="section-label-text">别人填写的</text>
    </view>
    <view class="note-item" wx:for="{{otherNotes}}" wx:key="id">
      <view class="note-meta {{category === 'follow_up' ? 'follow-up-meta' : ''}}">
        <view class="note-person-plan"><text class="note-creator"><text class="attribution-label">反馈：</text>{{item.feedbackText}}</text><text class="plan-meta" wx:if="{{category === 'follow_up' && (item.next_follow_up_person || item.next_follow_up_date)}}"><text class="attribution-label">下次跟进：</text>{{item.next_follow_up_person}}<text wx:if="{{item.next_follow_up_person && item.next_follow_up_date}}"> </text>{{item.followUpDateText}}</text></view>
        <view class="note-meta-right"><text class="note-time">{{item.timeText}}</text><text>{{item.creatorText}}<text class="attribution-action">创建</text></text></view>
      </view>
      <view class="note-display-tags" wx:if="{{category === 'visit_need' && showNeedTags && item.need_tags.length}}">
        <text class="note-display-tag" wx:for="{{item.need_tags}}" wx:for-item="tag" wx:key="id">{{tag.name}}</text>
      </view>
      <text wx:if="{{showDetail && item.content}}" class="note-content">{{item.content}}</text>
    </view>
  </block>

  <view class="note-loading" wx:if="{{loading && !myNote && !otherNotes.length}}">加载中...</view>
</view>

<!-- 编辑底部弹层 -->
<view class="editor-mask" wx:if="{{editorOpen && !readOnly}}" bindtap="onEditorClose" catchtouchmove="noop"></view>
<view class="editor-panel" wx:if="{{editorOpen && !readOnly}}">
  <view class="editor-header">
    <text class="editor-title">我填写的{{title}}</text>
    <view class="editor-header-actions">
      <text class="previous-toggle" wx:if="{{category === 'visit_need' && showDetail && customerId}}" bindtap="onToggleVisitPurpose">{{visitPurposeOpen ? '收起到访目的' : '引用到访目的'}}</text>
      <text class="previous-toggle" wx:if="{{category === 'visit_need' && showDetail && customerId}}" bindtap="onTogglePrevious">{{previousOpen ? '收起上次需求' : '引用上次需求'}}</text>
      <text class="editor-close" bindtap="onEditorClose">关闭</text>
    </view>
  </view>
  <scroll-view class="editor-body" scroll-y>
  <view class="feedback-field feedback-field-plan">
    <view class="feedback-label"><view class="feedback-label-dot"></view><text>反馈人</text></view>
    <picker range="{{feedbackOptions}}" range-key="name" value="{{feedbackIndex}}" bindchange="onFeedbackChange">
      <view class="feedback-picker"><text class="feedback-picker-text">{{feedbackOptions[feedbackIndex].name || '选择反馈人'}}</text><view class="feedback-picker-arrow"></view></view>
    </picker>
  </view>
  <view wx:if="{{category === 'visit_need' && showNeedTags}}" class="need-tags-section">
    <text class="need-tags-label">来访标签（可多选）</text>
    <view class="need-tags-options">
      <text wx:for="{{needTagOptions}}" wx:key="id" class="need-tag {{item.selected ? 'need-tag-selected' : ''}}" data-id="{{item.id}}" bindtap="onToggleNeedTag">{{item.name}}</text>
    </view>
    <text wx:if="{{needTagsLoading}}" class="need-tags-state">加载中…</text>
    <text wx:elif="{{needTagsError}}" class="need-tags-state" bindtap="loadNeedTags">{{needTagsError}} · 点击重试</text>
    <text wx:elif="{{!needTagOptions.length}}" class="need-tags-state">暂未配置公共来访需求</text>
  </view>
  <block wx:if="{{category === 'follow_up'}}">
    <view class="plan-fields">
      <view class="plan-field plan-person-field">
        <text class="plan-label">下次跟进</text>
        <view class="plan-control plan-person-control">
          <input class="plan-input" value="{{followUpSearchOpen ? followUpSearch : nextFollowUpPerson}}" placeholder="搜索昵称" placeholder-style="color:#c0c4cc" bindfocus="onFollowUpSearchFocus" bindinput="onFollowUpSearchInput" bindconfirm="onFollowUpSearchConfirm" confirm-type="search" cursor-spacing="20" />
          <view class="plan-clear" wx:if="{{nextFollowUpPerson || followUpSearch}}" catchtap="onClearFollowUpPerson">×</view>
        </view>
      </view>
      <view class="plan-field plan-date-field">
        <text class="plan-label">跟进时间</text>
        <view class="plan-control plan-date-control">
          <picker mode="date" value="{{nextFollowUpDate || datePickerToday}}" bindchange="onFollowUpDateChange" bindtap="onCloseFollowUpSearch">
            <view class="plan-date-value {{nextFollowUpDate ? '' : 'plan-placeholder'}}">{{nextFollowUpDateText || '选择日期'}}</view>
          </picker>
          <view class="plan-clear" wx:if="{{nextFollowUpDate}}" catchtap="onClearFollowUpDate">×</view>
        </view>
      </view>
    </view>
    <view class="plan-search-results" wx:if="{{followUpSearchOpen}}">
      <view class="plan-search-state" wx:if="{{followUpPeopleLoading}}">人员加载中…</view>
      <view class="plan-search-state" wx:elif="{{followUpPeopleError}}" bindtap="loadFollowUpPeople">{{followUpPeopleError}} · 点击重试</view>
      <scroll-view class="plan-results-scroll" scroll-y style="height:{{followUpMatches.length > 4 ? 320 : followUpMatches.length * 80}}rpx" wx:elif="{{followUpMatches.length}}">
        <view class="plan-person-option" wx:for="{{followUpMatches}}" wx:key="id" data-id="{{item.id}}" catchtap="onSelectFollowUpPerson"><text>{{item.nickname}}</text><text class="plan-person-name" wx:if="{{item.name && item.name !== item.nickname}}">{{item.name}}</text><text class="search-person-phone" wx:if="{{item.phone_masked || item.phone_suffix}}">{{item.phone_masked || ('****' + item.phone_suffix)}}</text></view>
      </scroll-view>
      <view class="plan-search-state" wx:else>暂无匹配人员</view>
      <view class="plan-search-state" wx:if="{{!followUpPeopleLoading && !followUpPeopleError && followUpMatchCount > 50}}">共{{followUpMatchCount}}位，继续输入可缩小范围</view>
    </view>
  </block>
  <view class="previous-box" wx:if="{{category === 'visit_need' && visitPurposeOpen}}">
    <text class="previous-empty" wx:if="{{visitPurposeLoading}}">正在加载到访目的…</text>
    <view class="previous-error" wx:elif="{{visitPurposeError}}" bindtap="loadVisitPurpose">
      <text>{{visitPurposeError}}</text>
      <text class="previous-retry">点击重试</text>
    </view>
    <block wx:elif="{{visitPurpose}}">
      <view class="previous-meta">
        <text>客户详情中的到访目的</text>
        <text class="previous-append" bindtap="onAppendVisitPurpose">带入本次</text>
      </view>
      <text class="previous-content">{{visitPurpose}}</text>
    </block>
    <text class="previous-empty" wx:else>暂无可引用的到访目的</text>
  </view>
  <view class="previous-box" wx:if="{{category === 'visit_need' && previousOpen}}">
    <text class="previous-empty" wx:if="{{previousLoading}}">正在加载上次需求…</text>
    <view class="previous-error" wx:elif="{{previousError}}" bindtap="loadPreviousNeed">
      <text>{{previousError}}</text>
      <text class="previous-retry">点击重试</text>
    </view>
    <block wx:elif="{{previousNeed}}">
      <view class="previous-meta">
        <text>{{previousNeed.visit_date}} 的来访需求</text>
        <text class="previous-append" bindtap="onAppendPrevious">带入本次</text>
      </view>
      <text class="previous-content">{{previousNeed.content}}</text>
    </block>
    <text class="previous-empty" wx:else>暂无可引用的历史需求</text>
  </view>
  <textarea
    wx:if="{{showDetail}}"
    class="editor-input"
    value="{{editorValue}}"
    placeholder="{{privateToCreator ? '填写' + title + '…' : '写下你观察到的' + title + '…'}}"
    placeholder-style="color:#b7bdc6"
    maxlength="5000"
    adjust-position="{{true}}"
    cursor-spacing="20"
    fixed="{{true}}"
    bindinput="onEditorInput"
    bindfocus="onCloseFollowUpSearch"
    confirm-type="done"
    bindconfirm="onSubmit"
  />
  </scroll-view>
  <view class="editor-footer">
    <text class="editor-hint">{{editorValue.length}} / 5000</text>
    <view class="editor-submit {{saving || (!editorValue && !needTagIds.length && !(category === 'visit_need' && myNote)) ? 'editor-submit-disabled' : ''}}" bindtap="onSubmit">{{saving ? '保存中' : '保存'}}</view>
  </view>
</view>
