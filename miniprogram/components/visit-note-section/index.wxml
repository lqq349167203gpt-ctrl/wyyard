<view class="note-card">
  <view class="note-header">
    <text class="note-title">{{title}}</text>
    <text class="note-count" wx:if="{{personCount && !privateToCreator}}">{{personCount}}人已填写</text>
  </view>

  <!-- 我填写的 -->
  <view class="section-label">
    <text class="section-label-text">我填写的</text>
    <text class="section-label-hint" wx:if="{{myNote}}">{{myNote.timeText}} 更新 · <text class="clear-btn" bindtap="onClearMine">清空</text></text>
  </view>
  <view class="mine-box" bindtap="onAdd">
    <text class="mine-content {{myNote ? '' : 'mine-placeholder'}}">{{myNote ? myNote.content : (privateToCreator ? '填写' + title + '…' : '写下你观察到的' + title + '…')}}</text>
  </view>

  <!-- 别人填写的 -->
  <block wx:if="{{otherNotes.length && !privateToCreator}}">
    <view class="section-label others">
      <text class="section-label-text">别人填写的</text>
    </view>
    <view class="note-item" wx:for="{{otherNotes}}" wx:key="id">
      <view class="note-meta">
        <text class="note-creator">{{item.created_by || '历史记录'}}</text>
        <text class="note-time">{{item.timeText}}</text>
      </view>
      <text class="note-content">{{item.content}}</text>
    </view>
  </block>

  <view class="note-loading" wx:if="{{loading && !myNote && !otherNotes.length}}">加载中...</view>
</view>

<!-- 编辑底部弹层 -->
<view class="editor-mask" wx:if="{{editorOpen}}" bindtap="onEditorClose" catchtouchmove="noop"></view>
<view class="editor-panel" wx:if="{{editorOpen}}">
  <view class="editor-header">
    <text class="editor-title">我填写的{{title}}</text>
    <text class="editor-close" bindtap="onEditorClose">取消</text>
  </view>
  <textarea
    class="editor-input"
    value="{{editorValue}}"
    placeholder="{{privateToCreator ? '填写' + title + '…' : '写下你观察到的' + title + '…'}}"
    placeholder-style="color:#c0c4cc"
    maxlength="5000"
    focus="{{editorOpen}}"
    bindinput="onEditorInput"
    confirm-type="done"
    bindconfirm="onSubmit"
  />
  <view class="editor-footer">
    <text class="editor-hint">{{editorValue.length}} / 5000</text>
    <button class="editor-submit" bindtap="onSubmit" loading="{{saving}}" disabled="{{saving || !editorValue}}">保存</button>
  </view>
</view>
