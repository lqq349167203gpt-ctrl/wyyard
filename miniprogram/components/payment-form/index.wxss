/* 全部自包含样式，pf- 前缀避免冲突 */

.pf-container {
  padding: 24rpx 32rpx;
  background-color: #f7f8fa;
}

.pf-card {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.pf-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f1f2;
}

.pf-row-last {
  border-bottom: none;
}

.pf-label {
  min-width: 200rpx;
  font-size: 28rpx;
  color: #4e535a;
  flex-shrink: 0;
  white-space: nowrap;
}

.pf-input {
  flex: 1;
  font-size: 28rpx;
  color: #1f2329;
  text-align: right;
}

.pf-picker {
  flex: 1;
  min-width: 0;
}

.pf-value {
  flex: 1;
  font-size: 28rpx;
  color: #1f2329;
  text-align: right;
}

.pf-placeholder {
  color: #b0b5bb;
}

.pf-value-wrap {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 1;
  min-width: 0;
}

.pf-clear {
  font-size: 30rpx;
  color: #b0b5bb;
  padding: 8rpx 16rpx;
  flex-shrink: 0;
}

/* 时长行 */
.pf-dur {
  display: flex;
  align-items: center;
  flex: 1;
}

.pf-dur-input {
  width: 140rpx;
  flex: none;
  text-align: right;
  margin-left: 180rpx;
}

.pf-dur-sep {
  width: 1rpx;
  height: 28rpx;
  background-color: #e8eaed;
  margin: 0 20rpx;
  flex-shrink: 0;
}

.pf-dur .pf-picker {
  flex: 1;
  min-width: 0;
  max-width: 140rpx;
}

.pf-dur .pf-value {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 提交按钮 */
.pf-btns {
  display: flex;
  gap: 32rpx;
  margin-top: 48rpx;
  padding: 0 28rpx 20rpx;
}

.pf-submit {
  flex: 1;
  background-color: #3370ff;
  color: #ffffff;
  border-radius: 8rpx;
  font-size: 32rpx;
  font-weight: 500;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  text-align: center;
  border: none;
}

.pf-submit::after {
  border: none;
}

/* 搜索弹窗 */
.pf-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.pf-popup {
  position: fixed;
  left: 0;
  right: 0;
  top: 96rpx;
  bottom: 0;
  background-color: #ffffff;
  border-radius: 0 0 24rpx 24rpx;
  z-index: 101;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.pf-popup-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f1f2;
}

.pf-popup-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1f2329;
}

.pf-popup-close {
  font-size: 28rpx;
  color: #8f959e;
  padding: 8rpx;
}

.pf-popup-search {
  padding: 16rpx 32rpx;
}

.pf-popup-input {
  height: 72rpx;
  background-color: #f2f3f5;
  border-radius: 12rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}

.pf-popup-list {
  flex: 1;
  height: 0;
}

.pf-popup-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f5f6f7;
  font-size: 30rpx;
  color: #1f2329;
}

.pf-popup-check {
  color: #3370ff;
  font-size: 32rpx;
  font-weight: bold;
}

.pf-popup-item:active {
  background-color: #f7f8fa;
}

.pf-popup-empty {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
  color: #b0b5bb;
  font-size: 28rpx;
}

/* 成交人列表 */
.pf-closer-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f1f2;
  gap: 12rpx;
}

.pf-closer-tag {
  font-size: 24rpx;
  color: #3370ff;
  background-color: #f0f5ff;
  padding: 6rpx 16rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.pf-closer-amount {
  flex: 1;
  font-size: 28rpx;
  color: #1f2329;
  text-align: right;
}

.pf-closer-unit {
  font-size: 24rpx;
  color: #8f959e;
  flex-shrink: 0;
}

.pf-closer-del {
  font-size: 24rpx;
  color: #b0b5bb;
  padding: 8rpx;
  flex-shrink: 0;
}

.pf-closer-total {
  padding: 16rpx 0;
  font-size: 24rpx;
  color: #8f959e;
  text-align: right;
}

/* 有效期行（线下落地课程）：数字输入框 + "个月" */
.pf-inline {
  display: flex;
  align-items: center;
  flex: 1;
  justify-content: flex-end;
}

.pf-input-short {
  width: 120rpx;
  flex: none;
  text-align: right;
}

.pf-suffix {
  font-size: 28rpx;
  color: #1f2329;
  margin-left: 8rpx;
  flex-shrink: 0;
}
