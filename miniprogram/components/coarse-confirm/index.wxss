.coarse-mask {
  position: fixed;
  z-index: 400;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(20, 24, 31, 0.45);
}

.coarse-dialog {
  position: fixed;
  top: 50%;
  left: 50%;
  z-index: 401;
  width: 600rpx;
  max-width: 86vw;
  padding: 40rpx 36rpx 28rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 16rpx 48rpx rgba(31, 35, 41, 0.18);
  transform: translate(-50%, -50%);
}

.coarse-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1f2329;
}

.coarse-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #8f959e;
}

.coarse-list {
  max-height: 360rpx;
  margin-top: 24rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
}

.coarse-item {
  display: flex;
  flex-direction: column;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #eceef1;
}

.coarse-item:last-child {
  border-bottom: none;
}

.coarse-item-name {
  font-size: 28rpx;
  color: #1f2329;
}

.coarse-item-meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8f959e;
}

.coarse-hint {
  margin-top: 24rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #4e535a;
}

.coarse-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.coarse-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 84rpx;
  text-align: center;
}

.coarse-btn-cancel {
  border: 1rpx solid #dee0e3;
  background: #fff;
  color: #4e535a;
}

.coarse-btn-ok {
  background: #3370ff;
  color: #fff;
}
