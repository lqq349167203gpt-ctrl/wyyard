<view class="picker">
  <!-- 已选中客户 -->
  <view class="selected" wx:if="{{value}}">
    <text class="selected-name">{{value.nickname}}</text>
    <member-labels wx:if="{{value.member_type || value.card_status}}" identity="{{value.member_type}}" status="{{value.card_status}}" tone="{{value.card_status_tone}}" />
    <text class="selected-count" wx:if="{{value.visit_count}}">第{{value.visit_count}}次</text>
    <view class="clear-btn" bindtap="onClear">✕</view>
  </view>

  <!-- 搜索输入 -->
  <view class="search-box" wx:if="{{!value}}">
    <input
      class="search-input"
      placeholder="搜索姓名或昵称"
      value="{{keyword}}"
      bindinput="onInput"
      bindfocus="onFocus"
      bindblur="onBlur"
      confirm-type="search"
    />
  </view>

  <!-- 搜索结果下拉 -->
  <view wx:if="{{searchError}}" class="search-box" bindtap="retrySearch">{{searchError}}</view>
  <view class="dropdown" wx:if="{{showDropdown && !searchError}}">
    <view class="dropdown-loading" wx:if="{{searching}}">
      <text>搜索中...</text>
    </view>
    <view class="search-match-count" wx:if="{{!searching && results.length}}">匹配 {{results.length}} 人</view>
    <view
      wx:for="{{results}}"
      wx:key="id"
      class="dropdown-item"
      bindtap="onSelect"
      data-customer="{{item}}"
    >
      <view class="search-person-copy"><text class="item-name">{{item.nickname}}<text class="search-person-name" wx:if="{{item.name && item.name !== item.nickname}}">（{{item.name}}）</text></text><text class="search-person-phone" wx:if="{{item.phone_masked || item.phone_suffix}}">{{item.phone_masked || ('****' + item.phone_suffix)}}</text></view>
    </view>
    <view class="dropdown-empty" wx:if="{{!searching && results.length === 0}}">
      <text>无匹配结果</text>
    </view>
  </view>
</view>
