.picker {
  position: relative;
}

.selected {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background-color: #f0f5ff;
  border-radius: 8rpx;
  border: 1rpx solid #d0e0ff;
}

.selected-name {
  font-size: 28rpx;
  color: #1f2329;
  font-weight: 500;
}

.selected-type {
  font-size: 22rpx;
  color: #3370ff;
  background-color: #ffffff;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-left: 12rpx;
}

.selected-count {
  font-size: 22rpx;
  color: #8f959e;
  margin-left: 12rpx;
}

.clear-btn {
  margin-left: auto;
  font-size: 28rpx;
  color: #8f959e;
  padding: 8rpx;
}

.search-box {
  position: relative;
}

.search-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  border: 1rpx solid #e8eaed;
  border-radius: 8rpx;
  box-sizing: border-box;
  background-color: #fafbfc;
}

.dropdown {
  position: absolute;
  top: calc(100% + 8rpx);
  left: 0;
  right: 0;
  background-color: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
  max-height: 400rpx;
  overflow-y: auto;
}

.dropdown-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f0f1f2;
}

.dropdown-item:last-child {
  border-bottom: none;
}

.dropdown-item:active {
  background-color: #f7f8fa;
}

.item-name {
  font-size: 28rpx;
  color: #1f2329;
}

.item-type {
  font-size: 22rpx;
  color: #3370ff;
  background-color: #f0f5ff;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  margin-left: 12rpx;
}

.item-count {
  font-size: 22rpx;
  color: #8f959e;
  margin-left: 12rpx;
}

.dropdown-loading,
.dropdown-empty {
  padding: 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8f959e;
}
