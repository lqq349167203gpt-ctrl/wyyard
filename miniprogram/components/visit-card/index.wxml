<view class="card {{editMode ? 'editing' : ''}} {{editable ? '' : 'read-only'}} {{visit.cancelled ? 'cancelled' : ''}} {{isLast ? 'last' : ''}}" bindtap="onCardTap" bindlongpress="onCardLongPress">
  <view class="card-main">
    <!-- 编辑模式：上下移动按钮 -->
    <view class="move-btns" wx:if="{{editMode && sortable}}">
      <view class="move-btn {{canMoveUp ? '' : 'disabled'}}" catchtap="onMoveUp">
        <text>▲</text>
      </view>
      <view class="move-btn {{canMoveDown ? '' : 'disabled'}}" catchtap="onMoveDown">
        <text>▼</text>
      </view>
    </view>
    <view class="card-info">
      <view class="row-top">
        <view class="name-area">
          <text class="nickname {{visit.cancelled ? 'cancelled' : ''}}">{{visit.nickname}}</text>
          <text class="new-customer-tag" wx:if="{{visit.is_new_customer}}">新</text>
          <text class="leader-tag" wx:if="{{visit.is_leader}}">组长</text>
          <text class="member-tag" wx:if="{{leaderName}}">{{leaderName}}组员</text>
          <member-labels identity="{{visit.member_type}}" status="{{visit.card_status}}" tone="{{visit.card_status_tone}}" /><text class="member-summary" wx:if="{{remainingText}}">{{remainingText}}</text>
        </view>
        <view
          class="arrival-badge {{visit.arrived ? 'arrived' : 'todo'}} {{arrivalEditable ? '' : 'disabled'}}"
          wx:if="{{!editMode && !visit.cancelled}}"
          catchtap="onArrivalToggleTap"
        >
          <text>{{visit.arrived ? '已到店' : '未到店'}}</text>
        </view>
        <text class="cancelled-tag" wx:if="{{!editMode && visit.cancelled}}">已取消</text>
      </view>
      <view class="row-meta">
        <text>预计 {{visit.visit_time || '-'}}</text>
        <text class="meta-sep">·</text>
        <text>到店 {{visit.arrived_count || 0}} 次</text>
      </view>
      <view class="visit-details">
        <view class="needs-row" wx:if="{{visit.cancelled && visit.cancel_reason}}">
          <text class="needs-label">取消原因</text>
          <text class="needs-content">{{visit.cancel_reason}}</text>
        </view>
        <view class="needs-row" wx:if="{{noteVisibility.visit_need}}">
          <text class="needs-label">来访需求</text>
          <view class="needs-content" wx:if="{{hasStructuredNeeds && needEntries.length}}">
            <view class="need-entry" wx:for="{{needEntries}}" wx:key="id" wx:for-item="note">
              <text>{{note.author}}：</text>
              <text class="need-display-tag" wx:for="{{note.tags}}" wx:key="id" wx:for-item="tag">{{tag.name}}</text>
              <text class="need-detail" wx:if="{{note.content}}">{{note.content}}</text>
            </view>
          </view>
          <text class="needs-content {{hasStructuredNeeds || !visit.needs ? 'empty' : ''}}" wx:else>{{hasStructuredNeeds ? '-' : (visit.needs || '-')}}</text>
        </view>
        <view class="needs-row" wx:if="{{visit.receptionist}}">
          <text class="needs-label">接待人</text>
          <text class="needs-content {{visit.receptionist ? '' : 'empty'}}">{{visit.receptionist || '-'}}</text>
        </view>
        <view class="needs-row">
          <text class="needs-label">目标</text>
          <text class="needs-content {{visit.goal ? '' : 'empty'}}">{{visit.goal || '-'}}</text>
        </view>
      </view>
      <view class="card-actions">
        <view class="action-list" wx:if="{{!editMode}}">
          <text class="action-btn" wx:if="{{cancelable && !visit.arrived}}" catchtap="onCancelVisitTap">{{visit.cancelled ? '恢复' : '取消'}}</text>
          <text class="action-btn outlined-action" catchtap="onProfileTap">资料</text>
          <text class="action-btn outlined-action delete-btn" wx:if="{{editable && !visit.cancelled}}" catchtap="onDeleteTap">删除</text>
        </view>
      </view>
    </view>
  </view>
</view>
