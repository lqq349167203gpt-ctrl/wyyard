.card {
  background-color: #ffffff;
  border-bottom: 2rpx solid #f2f3f5;
}

.card.last {
  border-bottom: none;
}

.card.editing {
  background-color: #f9fbff;
}

.card.read-only {
  background-color: #fbfbfc;
}

.card.cancelled {
  background-color: #fafbfc;
}

.card.cancelled .nickname,
.card.cancelled .row-meta,
.card.cancelled .needs-row {
  color: #b0b5bb;
}

.card.cancelled .needs-content { color: #b0b5bb; }

.card.read-only .nickname {
  color: #8f959e;
}

.card-main {
  display: flex;
  align-items: flex-start;
  padding: 30rpx 34rpx 26rpx;
}

.move-btns {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.move-btn {
  width: 48rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f2f3f5;
  border-radius: 12rpx;
}

.move-btn text {
  font-size: 18rpx;
  color: #4e535a;
  line-height: 1;
}

.move-btn.disabled {
  opacity: 0.3;
}

.card-info {
  flex: 1;
  min-width: 0;
}

.row-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.name-area {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}

.nickname {
  font-size: 30rpx;
  font-weight: 500;
  color: #1f2329;
  line-height: 1.5;
}

.nickname.cancelled {
  color: #b0b5bd;
}

.leader-tag {
  font-size: 20rpx;
  color: #3370ff;
  background-color: #eef3ff;
  padding: 2rpx 14rpx;
  border-radius: 16rpx;
  line-height: 30rpx;
  font-weight: 500;
}

.member-tag {
  font-size: 20rpx;
  color: #646a73;
  background-color: #f2f3f5;
  padding: 2rpx 14rpx;
  border-radius: 16rpx;
  line-height: 30rpx;
}

.member-summary {
  max-width: 260rpx;
  overflow: hidden;
  padding: 2rpx 14rpx;
  border-radius: 16rpx;
  background-color: #f2f3f5;
  color: #646a73;
  font-size: 20rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.readonly-mark {
  font-size: 20rpx;
  color: #8f959e;
  background-color: #f2f3f5;
  padding: 2rpx 14rpx;
  border-radius: 16rpx;
  line-height: 30rpx;
}

.row-meta {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-top: 12rpx;
  color: #8f959e;
  font-size: 22rpx;
}

.meta-sep {
  color: #ccd3da;
}

.visit-details {
  margin-top: 26rpx;
  padding-top: 30rpx;
  border-top: 2rpx solid #f9fafb;
}

.needs-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  font-size: 24rpx;
  color: #646a73;
  line-height: 37rpx;
}

.needs-row + .needs-row {
  margin-top: 24rpx;
}

.needs-label {
  width: 130rpx;
  color: #9aa1a9;
  flex: 0 0 130rpx;
}

.needs-content {
  flex: 1;
  min-width: 0;
  color: #33393f;
  word-break: break-all;
}

.needs-content.empty {
  color: #b0b5bb;
}

.arrival-badge {
  flex-shrink: 0;
  min-width: 100rpx;
  box-sizing: border-box;
  padding: 10rpx 18rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 32rpx;
  text-align: center;
}

.arrival-badge.todo {
  color: #ffffff;
  background-color: #3370ff;
}

.arrival-badge.arrived {
  color: #3370ff;
  background-color: #eef3ff;
  font-weight: 400;
}

.arrival-badge.disabled {
  color: #b0b5bb;
  background-color: #f2f3f5;
}

.cancelled-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #8f959e;
  background-color: #f2f3f5;
  padding: 2rpx 14rpx;
  border-radius: 16rpx;
  line-height: 30rpx;
}

.card-actions {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #f9fafb;
}

.creator-text {
  min-width: 0;
  overflow: hidden;
  color: #8f959e;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-list {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-left: auto;
  padding-left: 18rpx;
  flex-shrink: 0;
}

.action-btn {
  font-size: 24rpx;
  color: #646a73;
  padding: 4rpx 0;
}

.outlined-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  height: 52rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dcdfe4;
  border-radius: 8rpx;
  background-color: #ffffff;
  font-size: 22rpx;
}

.outlined-action:active {
  opacity: 0.78;
}

.delete-btn {
  color: #d97070;
  border-color: #e7b9c2;
}
