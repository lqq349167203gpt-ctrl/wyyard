.card {
  background-color: #ffffff;
  border-radius: 8rpx;
  margin: 0 24rpx 16rpx;
  overflow: hidden;
  border: 1rpx solid #ebedf0;
}

.card.editing {
  background-color: #fafbfc;
}

.card.read-only {
  border-color: #ebedf0;
}

.card.cancelled {
  background-color: #fafbfc;
}

.card.cancelled .nickname,
.card.cancelled .row-meta,
.card.cancelled .needs-row {
  color: #b0b5bb;
}

.card-main {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 28rpx;
}

.move-btns {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.move-btn {
  width: 44rpx;
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f2f3f5;
  border-radius: 6rpx;
}

.move-btn text {
  font-size: 20rpx;
  color: #4e535a;
  line-height: 1;
}

.move-btn.disabled {
  opacity: 0.3;
}

.card-info {
  flex: 1;
  min-width: 0;
}

.row-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.name-area {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.nickname {
  font-size: 30rpx;
  font-weight: 500;
  color: #1f2329;
  line-height: 1.6;
}

.nickname.cancelled {
  color: #b0b5bd;
}

.leader-tag {
  font-size: 21rpx;
  color: #3370ff;
  background-color: rgba(51, 112, 255, 0.09);
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  line-height: 1.6;
}

.member-tag {
  font-size: 21rpx;
  color: #646a73;
  background-color: #f2f3f5;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  line-height: 1.6;
}

.member-summary {
  font-size: 21rpx;
  color: #646a73;
  background-color: #f2f3f5;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  line-height: 1.6;
}

.readonly-mark {
  font-size: 21rpx;
  color: #8f959e;
  border: 1rpx solid #dcdfe4;
  padding: 1rpx 11rpx;
  border-radius: 6rpx;
  line-height: 1.6;
}

.row-meta {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #646a73;
}

.meta-sep {
  color: #ccd3da;
}

.needs-row {
  display: flex;
  align-items: flex-start;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #646a73;
  line-height: 1.6;
}

.needs-label {
  color: #8f959e;
  flex-shrink: 0;
  margin-right: 8rpx;
}

.needs-content {
  flex: 1;
  min-width: 0;
  word-break: break-all;
}

.arrival-badge {
  flex-shrink: 0;
  font-size: 24rpx;
  border-radius: 8rpx;
  padding: 10rpx 28rpx;
  font-weight: 500;
  line-height: 1.5;
}

.arrival-badge.todo {
  color: #ffffff;
  background-color: #3370ff;
}

.arrival-badge.arrived {
  color: #3370ff;
  background-color: rgba(51, 112, 255, 0.09);
  font-weight: 400;
}

.arrival-badge.disabled {
  color: #b0b5bb;
  background-color: #f2f3f5;
}

.cancelled-tag {
  flex-shrink: 0;
  font-size: 21rpx;
  color: #8f959e;
  background-color: #f2f3f5;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  line-height: 1.6;
}

.card-actions {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f6f7;
}

.creator-text {
  color: #8f959e;
  font-size: 22rpx;
}

.action-list {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-left: auto;
}

.action-btn {
  font-size: 24rpx;
  color: #646a73;
  padding: 4rpx 0;
}

.delete-btn {
  color: #d97070;
}
