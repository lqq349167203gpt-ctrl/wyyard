<view class="page">
  <view class="editor-body">
    <textarea
      class="editor-textarea"
      value="{{text}}"
      bindinput="onInput"
      placeholder="输入{{label}}..."
      placeholder-class="editor-placeholder"
      focus="{{true}}"
      adjust-position="{{true}}"
      hold-keyboard="{{true}}"
      maxlength="-1"
    />
  </view>
  <view class="footer">
    <text class="char-count">{{text.length}} 字</text>
    <view class="save-btn" bindtap="onSave">
      <text>完成</text>
    </view>
  </view>
</view>
