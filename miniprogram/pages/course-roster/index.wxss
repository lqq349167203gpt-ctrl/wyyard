page{background:#f5f6f8;color:#1f2329}.page{padding:24rpx 28rpx calc(150rpx + env(safe-area-inset-bottom))}.course-head{display:flex;flex-direction:column;gap:10rpx;margin-bottom:24rpx}.course-name{font-size:32rpx;font-weight:500}.meta,.count{color:#8f959e;font-size:24rpx}.tools{display:flex;align-items:center;gap:20rpx}.search{flex:1;min-width:0;background:#fff;border-radius:8rpx;padding:18rpx 22rpx;font-size:28rpx}.toggle{font-size:24rpx;color:#646a73;padding:16rpx 0}.count{padding:20rpx 0}.person{padding:28rpx;background:#fff;border-radius:12rpx;margin-bottom:20rpx}.person-top,.person-choice,.person-bottom{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.person-choice{justify-content:flex-start;min-height:52rpx}.check{width:32rpx;height:32rpx;border:1rpx solid #d0d3d6;border-radius:6rpx;text-align:center;line-height:32rpx;font-size:24rpx}.checked{background:#3370ff;border-color:#3370ff;color:#fff}.name{font-size:32rpx;font-weight:500}.status{font-size:24rpx;color:#8f959e}.attended{color:#538169}.identity{font-size:24rpx;color:#8f959e;margin-top:8rpx}.needs{font-size:28rpx;line-height:1.65;margin-top:24rpx;white-space:pre-wrap;word-break:break-all}.tags{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:14rpx}.tag{font-size:22rpx;color:#646a73;background:#f1f3f5;padding:6rpx 12rpx;border-radius:6rpx}.person-bottom{margin-top:24rpx}.profile{font-size:24rpx;padding:14rpx 0;color:#646a73}.record{font-size:24rpx;line-height:1.4;padding:14rpx 22rpx;background:#fff;border:1rpx solid #dee0e3;margin:0}.record::after,button::after{border:0}.actions{position:fixed;bottom:0;left:0;right:0;padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #e8eaed;display:flex;gap:20rpx}.actions button{flex:1;min-width:0;font-size:28rpx;background:#f5f6f8}.actions .primary{background:#3370ff;color:#fff}.withdrawn .name{color:#8f959e}.empty,.error{text-align:center;color:#8f959e;padding:80rpx 20rpx;font-size:28rpx}.error{co