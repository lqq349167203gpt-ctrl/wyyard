.page {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding: 24rpx 32rpx;
}

/* 用户信息卡 */
.profile-card {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #f0f5ff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
}

.avatar-text {
  font-size: 44rpx;
  font-weight: 600;
  color: #3370ff;
}

.profile-info {
  display: flex;
  flex-direction: column;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2329;
}

.profile-role {
  font-size: 26rpx;
  color: #8f959e;
  margin-top: 8rpx;
}

/* 信息列表 */
.info-card {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 8rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}

.info-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f1f2;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #8f959e;
  width: 140rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: #1f2329;
  flex: 1;
}

/* 退出按钮 */
.logout-area {
  margin-top: 60rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 500;
  background-color: #ffffff;
  color: #d94040;
  border-radius: 12rpx;
  border: none;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}

.logout-btn::after {
  border: none;
}
