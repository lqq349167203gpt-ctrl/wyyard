.page {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
}

/* 用户信息卡 */
.profile-card {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #f0f5ff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
}

.avatar-text {
  font-size: 44rpx;
  font-weight: 600;
  color: #3370ff;
}

.profile-info {
  display: flex;
  flex-direction: column;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2329;
}

.profile-role {
  font-size: 26rpx;
  color: #8f959e;
  margin-top: 8rpx;
}

/* 功能入口 */
.menu-card {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 0 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #f0f1f2;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-label {
  font-size: 30rpx;
  color: #1f2329;
}

.menu-arrow {
  font-size: 32rpx;
  color: #c0c4cc;
}

/* 退出按钮 */
.logout-area {
  margin-top: auto;
  padding-bottom: 60rpx;
}

.logout-btn {
  height: 108rpx;
  font-size: 30rpx;
  font-weight: 400;
  background-color: #ffffff;
  color: #1f2329;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}
