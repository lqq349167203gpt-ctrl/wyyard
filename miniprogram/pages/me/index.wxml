<view class="page" wx:if="{{user}}">
  <!-- 用户信息卡 -->
  <view class="profile-card">
    <view class="avatar">
      <text class="avatar-text">{{user.owner[0] || '?'}}</text>
    </view>
    <view class="profile-info">
      <text class="profile-name">{{user.owner}}</text>
      <text class="profile-role">{{role}}</text>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="menu-card">
    <view class="menu-item" bindtap="onPaymentTap" wx:if="{{canPayment}}">
      <text class="menu-label">付费项目</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onExpensesTap" wx:if="{{canExpenses}}">
      <text class="menu-label">支出</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onCommRecordsTap" wx:if="{{canCommRecords}}">
      <text class="menu-label">沟通记录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onDailyReportTap" wx:if="{{canDailyReport}}">
      <text class="menu-label">每日报表</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onCustomerTagsTap" wx:if="{{canCustomerTags}}">
      <text class="menu-label">客户标签</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onCustomAnalysisTap" wx:if="{{canCustomAnalysis}}">
      <text class="menu-label">自定义筛选</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出按钮 -->
  <view class="logout-area">
    <view class="logout-btn" bindtap="onLogout">退出登录</view>
  </view>
</view>
