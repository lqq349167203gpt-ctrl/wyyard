<view class="page">
  <view class="mode-tabs">
    <view class="mode-tab {{mode === 'course' ? 'active' : ''}}" data-mode="course" bindtap="onMode">课表</view>
    <view class="mode-tab {{mode === 'visit' ? 'active' : ''}}" data-mode="visit" bindtap="onMode">邀约</view>
  </view>

  <view class="filter-card">
    <view class="filter-row">
      <text class="filter-label">时间</text>
      <view class="presets">
        <view class="preset {{timePreset === item.value ? 'active' : ''}}" wx:for="{{timePresets}}" wx:key="value" data-key="{{item.value}}" bindtap="onTimePresetTap">{{item.label}}</view>
      </view>
    </view>
    <view class="filter-row">
      <text class="filter-label">自定义</text>
      <picker class="filter-control" mode="date" value="{{dateFrom}}" end="{{dateTo}}" bindchange="onDateFrom">
        <view class="filter-value">{{dateFrom}}</view>
      </picker>
      <text class="filter-sep">~</text>
      <picker class="filter-control" mode="date" value="{{dateTo}}" start="{{dateFrom}}" bindchange="onDateTo">
        <view class="filter-value">{{dateTo}}</view>
      </picker>
    </view>
    <view class="filter-row" wx:if="{{mode === 'course'}}">
      <text class="filter-label">空间</text>
      <picker class="filter-control" range="{{spaces}}" range-key="name" value="{{spaceIndex}}" bindchange="onSpace">
        <view class="filter-value">{{spaces[spaceIndex].name}}</view>
      </picker>
    </view>
    <view class="filter-row">
      <text class="filter-label">状态</text>
      <view class="seg">
        <view class="seg-item {{filterIndex === index ? 'active' : ''}}" wx:for="{{filters}}" wx:key="value" data-index="{{index}}" bindtap="onFilter">{{item.label}}</view>
      </view>
    </view>
  </view>

  <view class="summary" wx:if="{{summary}}">共 {{summary.day_count}} 天 · {{summary.unchecked_day_count}} 天未核对 · 缺信息 {{summary.missing_count}} 条</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view class="day-card" wx:for="{{days}}" wx:key="date" wx:for-item="day" wx:for-index="di">
    <view class="day-head">
      <view class="day-info">
        <text class="day-date">{{day.dateText}}</text>
        <text class="day-state {{day.checked ? 'done' : ''}}">{{day.checked ? '已核对' : '未核对'}}{{day.checked && day.operator ? ' · ' + day.operator : ''}}</text>
      </view>
      <text class="day-action" data-day="{{di}}" bindtap="toggleCheckDay">{{day.checked ? '解锁' : '核对'}}</text>
    </view>

    <view class="rec" wx:for="{{day.rows}}" wx:key="id" wx:for-item="row" wx:for-index="ri">
      <!-- 方案 C：课程名/客户名在最上面，下面才是 时间·类型·方式·扣卡 -->
      <view class="rec-head">
        <text class="rec-status {{row.statusClass}}" wx:if="{{row.statusText}}">{{row.statusText}}</text>
        <text class="rec-title">{{row.title}}</text>
        <text class="rec-tag" wx:if="{{row.titleMissing}}">{{row.titleMissing}}</text>
        <text class="rec-statustag" wx:if="{{row.statusTag}}">{{row.statusTag}}</text>
        <text class="rec-edit" data-id="{{row.id}}" data-date="{{day.date}}" data-checked="{{day.checked}}" bindtap="goEdit">编辑</text>
      </view>
      <text class="rec-headline" wx:if="{{row.headline}}">{{row.headline}}</text>
      <view class="rec-fields">
        <view class="rec-field" wx:for="{{row.fields}}" wx:key="label" wx:for-item="cell">
          <text class="rec-field-label">{{cell.label}}</text>
          <text class="rec-tag" wx:if="{{cell.missing}}">{{cell.missingLabel}}</text>
          <view class="rec-empty-line" wx:elif="{{cell.empty}}"></view>
          <text class="rec-field-value" wx:else>{{cell.value}}</text>
        </view>
      </view>
      <view class="rec-people" wx:if="{{row.peopleText || row.peopleMissing}}">
        <view class="rec-people-line">
          <view class="rec-people-icon"></view>
          <text class="rec-tag" wx:if="{{row.peopleMissing}}">无参与人</text>
          <text class="rec-people-text" wx:else>{{row.peopleText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}">加载中…</view>
  <view class="empty" wx:if="{{!loading && !days.length && !error}}">所选条件下没有要核对的记录</view>

  <view class="mask" wx:if="{{detail}}" bindtap="closeDetail"></view>
  <view class="sheet" wx:if="{{detail}}">
    <view class="sheet-head">
      <text class="sheet-title">{{detail.title}}</text>
      <text class="sheet-close" bindtap="closeDetail">关闭</text>
    </view>
    <scroll-view class="sheet-body" scroll-y>
      <text class="sheet-sub">{{detail.dateText}} · {{detail.checked ? '已核对' : '未核对'}}{{detail.checked && detail.operator ? ' · ' + detail.operator : ''}}</text>
      <text class="sheet-tip">核对是按「当天」整体核对的，在列表的日期那一行点「核对当天」。</text>
      <view class="field" wx:for="{{detail.fields}}" wx:key="label">
        <text class="field-label">{{item.label}}</text>
        <text class="field-value">{{item.value}}</text>
      </view>
    </scroll-view>
    <view class="sheet-actions">
      <text class="sheet-button primary" bindtap="goEdit">去编辑</text>
    </view>
  </view>
</view>
