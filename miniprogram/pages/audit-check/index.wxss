.page { min-height: 100vh; background: #f5f6f8; padding: 24rpx; box-sizing: border-box; color: #1f2329; font-size: 26rpx; overflow-x: hidden; }

/* 模式切换（课表 / 邀约）：和课程记录的页签同一套 */
.mode-tabs { display: flex; background: #fff; border-radius: 12rpx; padding: 0 28rpx; margin-bottom: 12rpx; }
.mode-tab { position: relative; flex: 1; padding: 24rpx 0 22rpx; text-align: center; font-size: 28rpx; color: #646a73; }
.mode-tab.active { color: #3370ff; font-weight: 500; }
.mode-tab.active::after { content: ""; position: absolute; left: 50%; transform: translateX(-50%); width: 52rpx; bottom: 0; height: 6rpx; border-radius: 6rpx 6rpx 0 0; background: #3370ff; }

/* 筛选 */
.filter-card { background: #fff; border-radius: 12rpx; padding: 20rpx 28rpx 24rpx; margin-bottom: 12rpx; box-sizing: border-box; box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04); }
.filter-row { display: flex; align-items: center; gap: 12rpx; min-height: 64rpx; }
.filter-label { flex-shrink: 0; width: 128rpx; font-size: 24rpx; color: #8f959e; }
.filter-control { flex: 1; min-width: 0; }
.filter-value { height: 60rpx; line-height: 58rpx; padding: 0 16rpx; box-sizing: border-box; border: 1rpx solid #e8eaed; border-radius: 8rpx; font-size: 23rpx; color: #2b2f36; }
.filter-sep { flex-shrink: 0; font-size: 21rpx; color: #8f959e; }
.date-range { display: flex; align-items: center; flex: 0 1 380rpx; width: 380rpx; max-width: 100%; min-width: 0; margin-left: auto; }
.date-control { flex: 1; min-width: 0; }
.date-value { display: flex; align-items: center; justify-content: space-between; height: 56rpx; line-height: 56rpx; padding: 0; border: 0; font-size: 24rpx; }
.date-value text { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.date-arrow { flex-shrink: 0; width: 0; height: 0; margin-left: 12rpx; border-left: 7rpx solid transparent; border-right: 7rpx solid transparent; border-top: 7rpx solid #b7bbc0; }
.status-picker { flex: 0 1 380rpx; width: 380rpx; max-width: 100%; min-width: 0; margin-left: auto; }
.status-value { display: flex; align-items: center; justify-content: flex-end; height: 56rpx; gap: 12rpx; color: #2b2f36; font-size: 24rpx; }

.summary { padding: 4rpx 8rpx 12rpx; font-size: 22rpx; color: #8f959e; }
.error { padding: 12rpx 8rpx; color: #c4506a; font-size: 24rpx; }

/* 按天分组 */
.day-card { margin-bottom: 16rpx; border: 1rpx solid #eceef0; border-radius: 12rpx; overflow: hidden; background: #fff; box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04); }
.day-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 14rpx 18rpx; background: #fafbfc; border-bottom: 1rpx solid #f2f3f5; }
.day-info { display: flex; align-items: baseline; gap: 12rpx; min-width: 0; }
/* 蓝框白底蓝字（和 PC 的按钮文案一致：确认核对 / 解锁） */
.day-action { flex-shrink: 0; padding: 0 16rpx; height: 48rpx; line-height: 46rpx; font-size: 22rpx; border: 1rpx solid #3370ff; border-radius: 8rpx; background: #fff; color: #3370ff; }
.day-date { font-size: 24rpx; font-weight: 500; color: #2b2f36; }
/* 核对状态：19rpx 彩色小字 */
.day-state { font-size: 19rpx; line-height: 1.4; color: #c98a2e; }
.day-state.done { color: #6bb392; }
.row { display: flex; align-items: center; gap: 12rpx; padding: 18rpx; border-bottom: 1rpx solid #f5f6f7; }
.row:last-child { border-bottom: none; }
.row-main { flex: 1; min-width: 0; }
.row-line1 { display: flex; align-items: center; gap: 10rpx; }
.row-title { flex-shrink: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 26rpx; font-weight: 500; color: #1f2329; }
.row-badge { flex-shrink: 0; padding: 2rpx 10rpx; border-radius: 6rpx; background: #fff4e8; font-size: 20rpx; color: #c98a2e; }
.row-sub { display: block; margin-top: 6rpx; font-size: 22rpx; line-height: 1.5; color: #8f959e; word-break: break-all; }
.row-people { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-top: 4rpx; font-size: 22rpx; line-height: 1.5; color: #4e535a; word-break: break-all; }
.row-arrow { flex-shrink: 0; color: #c9cdd4; font-size: 28rpx; }

.loading, .empty { padding: 80rpx 24rpx; text-align: center; color: #8f959e; font-size: 24rpx; }

/* 详情弹层 */
.mask { position: fixed; inset: 0; z-index: 200; background: rgba(31,35,41,.34); }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 201; display: flex; flex-direction: column; height: 78vh; border-radius: 16rpx 16rpx 0 0; background: #fff; padding-bottom: env(safe-area-inset-bottom); }
.sheet-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 24rpx 28rpx; border-bottom: 1rpx solid #f0f0f0; }
.sheet-title { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 28rpx; font-weight: 500; }
.sheet-close { flex-shrink: 0; font-size: 25rpx; color: #3370ff; }
.sheet-body { flex: 1 1 0; min-height: 0; max-height: 64vh; padding: 20rpx 28rpx; box-sizing: border-box; }
.sheet-sub { display: block; margin-bottom: 12rpx; font-size: 22rpx; color: #8f959e; }
.sheet-tip { display: block; margin-bottom: 12rpx; font-size: 21rpx; color: #a8b0ba; }
.field { display: flex; align-items: flex-start; gap: 12rpx; padding: 12rpx 0; border-bottom: 1rpx solid #f5f6f7; }
.field-label { flex-shrink: 0; width: 150rpx; font-size: 23rpx; color: #9aa1a9; }
.field-value { flex: 1; min-width: 0; font-size: 25rpx; line-height: 1.6; color: #2b2f36; word-break: break-all; }
.sheet-actions { display: flex; gap: 20rpx; padding: 20rpx 28rpx 26rpx; border-top: 1rpx solid #f0f0f0; }
.sheet-button { display: flex; align-items: center; justify-content: center; flex: 1 1 0; width: 0; height: 72rpx; border-radius: 8rpx; border: 1rpx solid #dfe2e6; font-size: 25rpx; font-weight: 500; color: #646a73; background: #fff; }
.sheet-button.primary { border-color: #3370ff; background: #3370ff; color: #fff; }
.sheet-button.disabled { opacity: .6; }

/* 记录卡片（方案 C）：课程名在最上 → 自解释行 → 字段 → 参与人 */
.rec { padding: 20rpx 22rpx; border-bottom: 1rpx solid #f2f3f5; }
.rec:last-child { border-bottom: none; }
.rec-head { display: flex; align-items: center; gap: 10rpx; }
.rec-title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 25rpx; font-weight: 500; color: #1f2329; }
.rec-tag { flex-shrink: 0; padding: 0 12rpx; border-radius: 6rpx; background: #fff1ec; font-size: 22rpx; line-height: 1.5; color: #d4380d; }
.rec-edit { display: flex; flex-shrink: 0; align-items: center; justify-content: center; min-width: 88rpx; height: 52rpx; box-sizing: border-box; padding: 0 14rpx; border: 1rpx solid #e8eaed; border-radius: 8rpx; font-size: 22rpx; color: #4e535a; }
.rec-headline { display: block; margin-top: 6rpx; font-size: 23rpx; line-height: 1.5; color: #8f959e; word-break: break-all; }
.rec-fields { margin-top: 10rpx; }
.rec-field { display: flex; align-items: flex-start; gap: 12rpx; padding: 4rpx 0; }
.rec-field-label { flex-shrink: 0; width: 110rpx; font-size: 24rpx; line-height: 1.5; color: #9aa1a9; }
.rec-field-value { flex: 1; min-width: 0; font-size: 24rpx; line-height: 1.5; color: #2b2f36; word-break: break-all; }
/* 参与人：浅灰底块，不再加分隔横线（和方案 C 一致） */
.rec-people { margin-top: 12rpx; }
.rec-people-line { display: flex; align-items: flex-start; gap: 10rpx; padding: 14rpx 16rpx; border-radius: 8rpx; background: #f7f8fa; }
.rec-people-icon { flex-shrink: 0; width: 30rpx; height: 30rpx; margin-top: 2rpx; background-repeat: no-repeat; background-position: center; background-size: 100% 100%; background-image: url("data:image/svg+xml;base64,"); }
.rec-people-text { flex: 1; min-width: 0; font-size: 24rpx; line-height: 1.65; color: #2b2f36; word-break: break-all; }


/* 未发布：标题行上的小标签（已发布不显示，不占地方） */
.rec-statustag { flex-shrink: 0; padding: 2rpx 10rpx; border-radius: 6rpx; border: 1rpx solid #e8eaed; font-size: 20rpx; color: #8f959e; }

/* 邀约：到场/取消状态胶囊（名字左边） */
.rec-status { flex-shrink: 0; padding: 3rpx 12rpx; border-radius: 999rpx; font-size: 21rpx; line-height: 1.5; }
.rec-status.ok { background: #e8f6ef; color: #2f8f63; }
.rec-status.wait { background: #f2f3f5; color: #8f959e; }
.rec-status.cancel { background: #fdeeee; color: #c94b55; }

.rec-empty-line { flex-shrink: 0; width: 12rpx; height: 2rpx; margin-top: 17rpx; border-radius: 2rpx; background: #e5e8eb; }

/* 时间快捷项与课程记录的周期行一致。 */
.presets { display: flex; flex: 0 1 380rpx; width: 380rpx; max-width: 100%; min-width: 0; justify-content: space-between; margin-left: auto; padding-right: 30rpx; box-sizing: border-box; }
.preset { display: flex; align-items: center; justify-content: center; height: 56rpx; box-sizing: border-box; padding: 0; font-size: 24rpx; color: #8f959e; }
.preset.active { color: #2b2f36; font-weight: 400; }
