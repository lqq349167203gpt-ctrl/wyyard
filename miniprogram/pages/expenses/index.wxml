<view class="page">
  <view class="no-permission" wx:if="{{!hasPagePermission}}">
    <text class="no-permission-text">无权限访问此页面</text>
  </view>

  <block wx:else>
    <view class="filter-wrap">
      <view class="date-filter">
        <picker mode="date" value="{{dateFrom}}" end="{{dateTo}}" bindchange="onDateFromChange">
          <view class="date-value {{dateFrom ? '' : 'date-placeholder'}}">{{dateFrom || '开始日期'}}</view>
        </picker>
        <text class="date-separator">~</text>
        <picker mode="date" value="{{dateTo}}" start="{{dateFrom}}" bindchange="onDateToChange">
          <view class="date-value {{dateTo ? '' : 'date-placeholder'}}">{{dateTo || '结束日期'}}</view>
        </picker>
      </view>
      <text class="clear-filter" wx:if="{{dateFrom || dateTo}}" bindtap="onClearDateFilter">清空</text>
    </view>

    <view class="summary-bar" wx:if="{{initialized}}">
      <text class="summary-label">全部支出</text>
      <text class="summary-count">{{total}} 笔</text>
    </view>

    <view class="list" wx:if="{{list.length > 0}}">
      <view class="expense-card" wx:for="{{list}}" wx:key="id" bindtap="onItemTap" data-item="{{item}}">
        <view class="card-head">
          <text class="content">{{item.purchase_content}}</text>
          <text class="amount">-¥{{item._amount}}</text>
        </view>
        <view class="card-meta">
          <text class="time">{{item._time}}</text>
          <text class="platform">{{item.platform}}</text>
        </view>
        <view class="notes-row" wx:if="{{item.notes}}">
          <text class="notes">{{item.notes}}</text>
        </view>
        <view class="creator-row">
          <text class="creator-label">创建人</text>
          <text class="creator">{{item.created_by || '-'}}</text>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{initialized && !loading && list.length === 0}}">
      <view class="empty-line"></view>
      <text class="empty-text">暂无支出记录</text>
    </view>

    <view class="loading" wx:if="{{loading}}">
      <text class="loading-text">{{list.length ? '正在加载更多...' : '加载中...'}}</text>
    </view>

    <view class="list-end" wx:if="{{initialized && list.length > 0 && !hasMore && !loading}}">已显示全部记录</view>

    <view class="fab" bindtap="onAddTap">
      <text class="fab-text">+</text>
    </view>
  </block>
</view>
