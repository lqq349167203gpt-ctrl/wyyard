.checkin-page { padding: 36rpx 28rpx; font-size: 28rpx; color: #2b2f36; }
.intro { padding: 16rpx 8rpx 32rpx; }
.title { font-size: 34rpx; font-weight: 600; margin-bottom: 16rpx; }
.muted { font-size: 24rpx; color: #98a1ad; line-height: 1.7; }
.scan-button, .confirm-button { display: flex; justify-content: center; align-items: center; height: 88rpx; padding: 0; border-radius: 16rpx; background: #3370ff; color: #fff; font-size: 28rpx; font-weight: 400; }
.scan-button::after, .confirm-button::after { border: none; }
.record { background: #fff; border-radius: 20rpx; padding: 32rpx; margin-top: 28rpx; }
.nickname { font-size: 32rpx; font-weight: 500; margin-bottom: 24rpx; }
.field { display: flex; gap: 24rpx; margin-top: 24rpx; line-height: 1.6; }
.field text:first-child { flex-shrink: 0; width: 128rpx; color: #98a1ad; font-size: 26rpx; }
.field text:last-child { flex: 1; font-size: 26rpx; }
.note { margin: 28rpx 0; color: #98a1ad; font-size: 24rpx; line-height: 1.7; }
.error { margin-top: 24rpx; color: #ad8757; font-size: 26rpx; line-height: 1.6; }
.result { margin-top: 32rpx; padding-top: 24rpx; border-top: 1rpx solid #f0f1f2; color: #79838f; font-size: 26rpx; }
