.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f8fa;
  padding: 20rpx 20rpx 48rpx;
}

.top-card,
.summary-card,
.records-card {
  margin-bottom: 12rpx;
  border-radius: 12rpx;
  background: #ffffff;
}

.top-card {
  padding: 28rpx 28rpx 24rpx;
}

.tabs {
  display: flex;
  align-items: center;
  height: 64rpx;
  margin-bottom: 26rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.tab {
  position: relative;
  height: 64rpx;
  margin-right: 44rpx;
  color: #4e535a;
  font-size: 28rpx;
  line-height: 58rpx;
}

.tab.active {
  color: #3370ff;
}

.tab.active::after {
  position: absolute;
  right: 0;
  bottom: -1rpx;
  left: 0;
  height: 5rpx;
  border-radius: 4rpx 4rpx 0 0;
  background: #3370ff;
  content: '';
}

.filter-row {
  display: flex;
  align-items: center;
  min-height: 64rpx;
  margin-top: 14rpx;
}

.filter-row:first-of-type {
  margin-top: 0;
}

.filter-row.align-start {
  align-items: flex-start;
}

.filter-label {
  width: 150rpx;
  flex-shrink: 0;
  color: #8f959e;
  font-size: 24rpx;
}

.filter-picker {
  min-width: 260rpx;
  flex: 1;
}

.follow-filter-picker {
  min-width: 190rpx;
  margin-left: 12rpx;
}

.days-field {
  display: flex;
  width: 150rpx;
  height: 60rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  align-items: center;
  border: 1rpx solid #dee0e3;
  border-radius: 8rpx;
  background: #fff;
}

.days-input {
  width: 96rpx;
  height: 58rpx;
  box-sizing: border-box;
  padding: 0 8rpx 0 16rpx;
  color: #2b2f36;
  font-size: 24rpx;
  line-height: 58rpx;
  text-align: right;
}

.days-unit {
  padding-right: 14rpx;
  color: #8f959e;
  font-size: 22rpx;
}

.picker-value,
.date-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 60rpx;
  box-sizing: border-box;
  border: 1rpx solid #dee0e3;
  border-radius: 8rpx;
  padding: 0 20rpx;
  color: #2b2f36;
  font-size: 24rpx;
}

.picker-arrow {
  flex-shrink: 0;
  width: 18rpx;
  height: 18rpx;
  margin-left: 8rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
  background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0naHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmcnIHZpZXdCb3g9JzAgMCAyNCAyNCcgZmlsbD0nbm9uZScgc3Ryb2tlPScjOGY5NTllJyBzdHJva2Utd2lkdGg9JzIuNicgc3Ryb2tlLWxpbmVjYXA9J3JvdW5kJyBzdHJva2UtbGluZWpvaW49J3JvdW5kJz48cGF0aCBkPSdNNiA5bDYgNiA2LTYnLz48L3N2Zz4=");
}

.picker-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.date-range {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
}

.date-picker {
  min-width: 0;
  flex: 1;
}

.date-value {
  justify-content: center;
  padding: 0 10rpx;
  font-size: 22rpx;
}

.date-separator {
  margin: 0 12rpx;
  color: #8f959e;
  font-size: 22rpx;
}

.course-presets {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-wrap: wrap;
  gap: 10rpx;
}

.course-preset {
  display: flex;
  height: 52rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #dee0e3;
  border-radius: 7rpx;
  background: #fff;
  padding: 0 18rpx;
  color: #646a73;
  font-size: 22rpx;
}

.course-preset.active {
  border-color: #3370ff;
  background: #3370ff;
  color: #ffffff;
  font-weight: 500;
}

.definition-group {
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.definition-option {
  display: flex;
  align-items: center;
  color: #646a73;
  font-size: 24rpx;
}

.check-box {
  display: flex;
  width: 28rpx;
  height: 28rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  margin-right: 10rpx;
  border: 1rpx solid #c9cdd4;
  border-radius: 5rpx;
  color: #ffffff;
  font-size: 20rpx;
}

.definition-option.active .check-box {
  border-color: #3370ff;
  background: #3370ff;
}

.summary-card {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  padding: 24rpx 28rpx;
}

.summary-item {
  min-width: 0;
  border: 1rpx solid #e8eaed;
  border-radius: 6rpx;
  padding: 18rpx 16rpx;
}

.summary-label {
  display: block;
  min-height: 56rpx;
  color: #646a73;
  font-size: 22rpx;
  line-height: 28rpx;
}

.summary-value {
  color: #1f2329;
  font-size: 34rpx;
  font-weight: 500;
}

.summary-unit {
  margin-left: 6rpx;
  color: #8f959e;
  font-size: 20rpx;
}

.records-card {
  padding: 26rpx 28rpx;
}

.records-head,
.record-primary,
.records-actions,
.record-meta,
.participant-summary,
.teacher-line,
.name-line {
  display: flex;
  align-items: center;
}

.records-head {
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.records-title {
  color: #4e535a;
  font-size: 24rpx;
  font-weight: 500;
}

.records-actions {
  gap: 12rpx;
}

.outline-button {
  display: flex;
  width: auto;
  min-width: 92rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  border: 1rpx solid #dee0e3;
  border-radius: 8rpx;
  background: #ffffff;
  padding: 0 20rpx;
  color: #4e535a;
  font-size: 22rpx;
  line-height: 54rpx;
}

.outline-button.disabled {
  color: #b7bdc6;
  opacity: 0.7;
}

.course-record,
.follow-record {
  padding: 24rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

/* 课程记录 / 复盘记录 子页签 */
.course-view-tabs {
  display: flex;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 0 28rpx;
  margin-bottom: 12rpx;
}

.course-view-tab {
  flex: 1;
  position: relative;
  padding: 24rpx 0 22rpx;
  text-align: center;
  font-size: 28rpx;
  color: #646a73;
}

.course-view-tab.active {
  color: #3370ff;
  font-weight: 500;
}

.course-view-tab.active::after {
  content: "";
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  width: 52rpx;
  bottom: 0;
  height: 6rpx;
  border-radius: 6rpx 6rpx 0 0;
  background: #3370ff;
}

/* 复盘内容：默认两行缩略，展开看全文 */
.review-block {
  margin-top: 12rpx;
}

.review-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.review-toggle {
  color: #3370ff;
  font-size: 24rpx;
}

.review-text {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 6rpx;
  color: #4e535a;
  font-size: 26rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.review-text.expanded {
  display: block;
  overflow: visible;
  -webkit-line-clamp: 0;
}

.record-primary {
  min-width: 0;
  justify-content: space-between;
}

.course-name,
.customer-name {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #2b2f36;
  font-size: 27rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-type,
.distance {
  margin-left: 18rpx;
  flex-shrink: 0;
  color: #8f959e;
  font-size: 22rpx;
}

.distance.overdue {
  color: #c4506a;
}

.record-meta {
  flex-wrap: wrap;
  gap: 10rpx 20rpx;
  margin-top: 10rpx;
  color: #8f959e;
  font-size: 22rpx;
}

.teacher-line,
.name-line {
  align-items: flex-start;
  margin-top: 18rpx;
}

.detail-label {
  width: 140rpx;
  flex-shrink: 0;
  color: #8f959e;
  font-size: 22rpx;
  line-height: 36rpx;
}

.detail-value {
  min-width: 0;
  flex: 1;
  color: #4e535a;
  font-size: 24rpx;
  line-height: 36rpx;
}

.participant-summary {
  gap: 28rpx;
  margin-top: 18rpx;
  color: #4e535a;
  font-size: 23rpx;
}

.name-list {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-wrap: wrap;
  gap: 10rpx 12rpx;
}

.person-name {
  border-radius: 5rpx;
  background: #f5f6f7;
  padding: 4rpx 10rpx;
  color: #4e535a;
  font-size: 22rpx;
  line-height: 30rpx;
}

.empty-dash {
  /* 空值不写「—」，用一条很短的浅灰横线占位（和自定义筛选一致） */
  display: inline-block;
  width: 12rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background-color: #e5e8eb;
  font-size: 0;
  vertical-align: middle;
}

.note-block {
  margin-top: 18rpx;
  border-left: 3rpx solid #e1e4e7;
  padding-left: 16rpx;
}

.note-title,
.note-time {
  display: block;
}

.note-title {
  margin-bottom: 6rpx;
  color: #8f959e;
  font-size: 21rpx;
}

.note-content {
  display: -webkit-box;
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #4e535a;
  font-size: 24rpx;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: pre-wrap;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.note-entry {
  display: flex;
  min-width: 0;
  align-items: baseline;
  gap: 14rpx;
}

.note-author {
  max-width: 150rpx;
  flex-shrink: 0;
  overflow: hidden;
  color: #8f959e;
  font-size: 22rpx;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.note-content.expanded {
  display: block;
  overflow: visible;
  -webkit-line-clamp: unset;
}

.note-time {
  margin-top: 6rpx;
  color: #b7bdc6;
  font-size: 20rpx;
}

.loading,
.empty {
  padding: 100rpx 0;
  color: #8f959e;
  font-size: 24rpx;
  text-align: center;
}

.load-more {
  padding: 24rpx 0 4rpx;
  color: #b7bdc6;
  font-size: 21rpx;
  text-align: center;
}

/* ---- 课程记录 → 参与者 页签 ---- */
.p-count { padding: 4rpx 0 8rpx; font-size: 22rpx; color: #8f959e; }
.p-record { padding: 18rpx 18rpx; border-bottom: 1rpx solid #f5f6f7; }
.p-head { display: flex; align-items: center; gap: 12rpx; }
.p-date { flex-shrink: 0; font-size: 23rpx; color: #8f959e; }
.p-title { display: flex; align-items: center; gap: 8rpx; flex: 1; min-width: 0; }
.p-name { flex-shrink: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 27rpx; font-weight: 500; color: #1f2329; }
.p-identity { flex-shrink: 0; padding: 2rpx 10rpx; border-radius: 6rpx; background: #f2f3f5; font-size: 20rpx; line-height: 1.5; color: #646a73; }
.p-course { display: block; margin-top: 6rpx; font-size: 24rpx; color: #4e535a; }
.p-field { display: flex; align-items: flex-start; gap: 12rpx; margin-top: 14rpx; }
.p-field-label { flex-shrink: 0; width: 168rpx; font-size: 23rpx; color: #9aa1a9; }
.p-field-value { flex: 1; min-width: 0; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; font-size: 25rpx; line-height: 1.6; color: #2b2f36; word-break: break-all; }
.p-field-input { flex: 1; min-width: 0; height: 60rpx; line-height: 58rpx; padding: 0 16rpx; box-sizing: border-box; border: 1rpx solid #e1e4e7; border-radius: 8rpx; background: #ffffff; font-size: 23rpx; color: #9aa1a9; }

/* 参与者页签：填写弹层（和「客户跟进」页同一套） */
.sheet-mask { position: fixed; inset: 0; z-index: 200; background: rgba(31,35,41,.34); }
.edit-sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 201; display: flex; flex-direction: column; max-height: 82vh; border-radius: 16rpx 16rpx 0 0; background: #fff; padding-bottom: env(safe-area-inset-bottom); }
.sheet-head { display: flex; align-items: center; justify-content: space-between; padding: 26rpx 30rpx; border-bottom: 1rpx solid #f0f0f0; }
.sheet-title { font-size: 28rpx; font-weight: 500; }
.sheet-close { font-size: 25rpx; color: #3370ff; }
.edit-body { flex: 1; min-height: 0; padding: 24rpx 30rpx 8rpx; box-sizing: border-box; }
.edit-subtitle { display: block; font-size: 22rpx; line-height: 1.6; color: #8f959e; }
.edit-reference { margin-top: 16rpx; padding: 16rpx; border-radius: 8rpx; background: #f7f8fa; }
.edit-reference-title { display: block; font-size: 21rpx; color: #8f959e; }
.edit-reference-text { display: block; margin-top: 8rpx; font-size: 23rpx; line-height: 1.6; color: #4e535a; word-break: break-all; }
.edit-label { display: block; margin-top: 20rpx; font-size: 22rpx; color: #8f959e; }
.edit-input { width: 100%; height: 38vh; margin-top: 12rpx; padding: 18rpx; box-sizing: border-box; border-radius: 8rpx; background: #f5f6f7; font-size: 25rpx; line-height: 1.6; }
.edit-actions { display: flex; gap: 20rpx; padding: 20rpx 30rpx 26rpx; }
.edit-button { display: flex; align-items: center; justify-content: center; flex: 1 1 0; width: 0; height: 72rpx; border-radius: 8rpx; border: 1rpx solid #dfe2e6; font-size: 25rpx; font-weight: 500; color: #646a73; background: #fff; }
.edit-button.confirm { border-color: #3370ff; background: #3370ff; color: #fff; }
.edit-button.disabled { opacity: .6; }

/* 参与者页签的昵称搜索框：和上面的下拉框同一套外观 */
/* 输入框用 width:0 + flex:1，长内容不会把这一行顶出屏幕 */
.filter-input { flex: 1; width: 0; min-width: 0; height: 64rpx; padding: 0 20rpx; box-sizing: border-box; border: 1rpx solid #e8eaed; border-radius: 8rpx; background: #fff; font-size: 26rpx; color: #2b2f36; }
.filter-input-placeholder { color: #b0b5bb; font-size: 26rpx; }

/* 参与者：按课程分组 */
.p-group { margin-bottom: 16rpx; border: 1rpx solid #eceef0; border-radius: 12rpx; overflow: hidden; background: #fff; }
.p-group-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 14rpx 18rpx; background: #fafbfc; border-bottom: 1rpx solid #f2f3f5; }
.p-group-course { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 24rpx; font-weight: 500; color: #2b2f36; }
.p-group-count { flex-shrink: 0; font-size: 21rpx; color: #8f959e; }
.p-same-count { flex-shrink: 0; font-size: 21rpx; color: #8f959e; }

.p-group-title { display: flex; align-items: baseline; gap: 10rpx; min-width: 0; }
.p-group-label { flex-shrink: 0; font-size: 21rpx; color: #9aa1a9; }
