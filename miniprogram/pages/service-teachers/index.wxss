.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f8fa;
  padding: 20rpx 20rpx 48rpx;
}

.top-card,
.summary-card,
.records-card {
  margin-bottom: 12rpx;
  border-radius: 12rpx;
  background: #ffffff;
}

.top-card {
  padding: 28rpx 28rpx 24rpx;
}

.tabs {
  display: flex;
  align-items: center;
  height: 64rpx;
  margin-bottom: 26rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.tab {
  position: relative;
  height: 64rpx;
  margin-right: 44rpx;
  color: #4e535a;
  font-size: 28rpx;
  line-height: 58rpx;
}

.tab.active {
  color: #3370ff;
}

.tab.active::after {
  position: absolute;
  right: 0;
  bottom: -1rpx;
  left: 0;
  height: 5rpx;
  border-radius: 4rpx 4rpx 0 0;
  background: #3370ff;
  content: '';
}

.filter-row {
  display: flex;
  align-items: center;
  min-height: 64rpx;
  margin-top: 14rpx;
}

.filter-row:first-of-type {
  margin-top: 0;
}

.filter-row.align-start {
  align-items: flex-start;
}

.filter-label {
  width: 150rpx;
  flex-shrink: 0;
  color: #8f959e;
  font-size: 24rpx;
}

.filter-picker {
  min-width: 260rpx;
  flex: 1;
}

.follow-filter-picker {
  min-width: 190rpx;
  margin-left: 12rpx;
}

.days-field {
  display: flex;
  width: 150rpx;
  height: 60rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  align-items: center;
  border: 1rpx solid #dee0e3;
  border-radius: 8rpx;
  background: #fff;
}

.days-input {
  width: 96rpx;
  height: 58rpx;
  box-sizing: border-box;
  padding: 0 8rpx 0 16rpx;
  color: #2b2f36;
  font-size: 24rpx;
  line-height: 58rpx;
  text-align: right;
}

.days-unit {
  padding-right: 14rpx;
  color: #8f959e;
  font-size: 22rpx;
}

.picker-value,
.date-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 60rpx;
  box-sizing: border-box;
  border: 1rpx solid #dee0e3;
  border-radius: 8rpx;
  padding: 0 20rpx;
  color: #2b2f36;
  font-size: 24rpx;
}

.picker-arrow {
  margin-left: 16rpx;
  color: #8f959e;
}

.date-range {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
}

.date-picker {
  min-width: 0;
  flex: 1;
}

.date-value {
  justify-content: center;
  padding: 0 10rpx;
  font-size: 22rpx;
}

.date-separator {
  margin: 0 12rpx;
  color: #8f959e;
  font-size: 22rpx;
}

.course-presets {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-wrap: wrap;
  gap: 10rpx;
}

.course-preset {
  display: flex;
  height: 52rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #dee0e3;
  border-radius: 7rpx;
  background: #fff;
  padding: 0 18rpx;
  color: #646a73;
  font-size: 22rpx;
}

.course-preset.active {
  border-color: #adc6ff;
  background: #f0f5ff;
  color: #3370ff;
}

.definition-group {
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.definition-option {
  display: flex;
  align-items: center;
  color: #646a73;
  font-size: 24rpx;
}

.check-box {
  display: flex;
  width: 28rpx;
  height: 28rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  margin-right: 10rpx;
  border: 1rpx solid #c9cdd4;
  border-radius: 5rpx;
  color: #ffffff;
  font-size: 20rpx;
}

.definition-option.active .check-box {
  border-color: #3370ff;
  background: #3370ff;
}

.summary-card {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  padding: 24rpx 28rpx;
}

.summary-item {
  min-width: 0;
  border: 1rpx solid #e8eaed;
  border-radius: 6rpx;
  padding: 18rpx 16rpx;
}

.summary-label {
  display: block;
  min-height: 56rpx;
  color: #646a73;
  font-size: 22rpx;
  line-height: 28rpx;
}

.summary-value {
  color: #1f2329;
  font-size: 34rpx;
  font-weight: 500;
}

.summary-unit {
  margin-left: 6rpx;
  color: #8f959e;
  font-size: 20rpx;
}

.records-card {
  padding: 26rpx 28rpx;
}

.records-head,
.record-primary,
.records-actions,
.record-meta,
.participant-summary,
.teacher-line,
.name-line {
  display: flex;
  align-items: center;
}

.records-head {
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.records-title {
  color: #4e535a;
  font-size: 24rpx;
  font-weight: 500;
}

.records-actions {
  gap: 12rpx;
}

.outline-button {
  display: flex;
  width: auto;
  min-width: 92rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  border: 1rpx solid #dee0e3;
  border-radius: 8rpx;
  background: #ffffff;
  padding: 0 20rpx;
  color: #4e535a;
  font-size: 22rpx;
  line-height: 54rpx;
}

.outline-button.disabled {
  color: #b7bdc6;
  opacity: 0.7;
}

.course-record,
.follow-record {
  padding: 24rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.record-primary {
  min-width: 0;
  justify-content: space-between;
}

.course-name,
.customer-name {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #2b2f36;
  font-size: 27rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-type,
.distance {
  margin-left: 18rpx;
  flex-shrink: 0;
  color: #8f959e;
  font-size: 22rpx;
}

.distance.overdue {
  color: #c4506a;
}

.record-meta {
  flex-wrap: wrap;
  gap: 10rpx 20rpx;
  margin-top: 10rpx;
  color: #8f959e;
  font-size: 22rpx;
}

.teacher-line,
.name-line {
  align-items: flex-start;
  margin-top: 18rpx;
}

.detail-label {
  width: 140rpx;
  flex-shrink: 0;
  color: #8f959e;
  font-size: 22rpx;
  line-height: 36rpx;
}

.detail-value {
  min-width: 0;
  flex: 1;
  color: #4e535a;
  font-size: 24rpx;
  line-height: 36rpx;
}

.participant-summary {
  gap: 28rpx;
  margin-top: 18rpx;
  color: #4e535a;
  font-size: 23rpx;
}

.name-list {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-wrap: wrap;
  gap: 10rpx 12rpx;
}

.person-name {
  border-radius: 5rpx;
  background: #f5f6f7;
  padding: 4rpx 10rpx;
  color: #4e535a;
  font-size: 22rpx;
  line-height: 30rpx;
}

.empty-dash {
  color: #d0d3d6;
  font-size: 24rpx;
}

.note-block {
  margin-top: 18rpx;
  border-left: 3rpx solid #e1e4e7;
  padding-left: 16rpx;
}

.note-title,
.note-time {
  display: block;
}

.note-title {
  margin-bottom: 6rpx;
  color: #8f959e;
  font-size: 21rpx;
}

.note-content {
  display: -webkit-box;
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #4e535a;
  font-size: 24rpx;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: pre-wrap;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.note-entry {
  display: flex;
  min-width: 0;
  align-items: baseline;
  gap: 14rpx;
}

.note-author {
  max-width: 150rpx;
  flex-shrink: 0;
  overflow: hidden;
  color: #8f959e;
  font-size: 22rpx;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.note-content.expanded {
  display: block;
  overflow: visible;
  -webkit-line-clamp: unset;
}

.note-time {
  margin-top: 6rpx;
  color: #b7bdc6;
  font-size: 20rpx;
}

.loading,
.empty {
  padding: 100rpx 0;
  color: #8f959e;
  font-size: 24rpx;
  text-align: center;
}

.load-more {
  padding: 24rpx 0 4rpx;
  color: #b7bdc6;
  font-size: 21rpx;
  text-align: center;
}
