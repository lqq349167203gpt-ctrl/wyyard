.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #f5f6f8;
  padding: 20rpx 20rpx 48rpx;
}

.page.course-records-page {
  padding-right: 20rpx;
  padding-left: 20rpx;
}

.top-card,
.summary-card,
.records-card {
  margin-bottom: 12rpx;
  border-radius: 12rpx;
  background: #ffffff;
}

.top-card {
  padding: 28rpx 28rpx 24rpx;
}

.tabs {
  display: flex;
  align-items: center;
  height: 64rpx;
  margin-bottom: 26rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.tab {
  position: relative;
  height: 64rpx;
  margin-right: 44rpx;
  color: #4e535a;
  font-size: 28rpx;
  line-height: 58rpx;
}

.tab.active {
  color: #3370ff;
}

.tab.active::after {
  position: absolute;
  right: 0;
  bottom: -1rpx;
  left: 0;
  height: 5rpx;
  border-radius: 4rpx 4rpx 0 0;
  background: #3370ff;
  content: '';
}

.filter-row {
  display: flex;
  align-items: center;
  min-height: 64rpx;
  margin-top: 14rpx;
}

.filter-row:first-of-type {
  margin-top: 0;
}

.filter-row.align-start {
  align-items: flex-start;
}

.filter-label {
  width: 150rpx;
  flex-shrink: 0;
  color: #8f959e;
  font-size: 24rpx;
  line-height: 1.25;
}

.filter-picker {
  min-width: 260rpx;
  flex: 1;
}

.follow-filter-picker {
  min-width: 190rpx;
  margin-left: 12rpx;
}

.days-field {
  display: flex;
  width: 150rpx;
  height: 60rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  align-items: center;
  border: 1rpx solid #dee0e3;
  border-radius: 8rpx;
  background: #fff;
}

.days-input {
  width: 96rpx;
  height: 58rpx;
  box-sizing: border-box;
  padding: 0 8rpx 0 16rpx;
  color: #2b2f36;
  font-size: 24rpx;
  line-height: 58rpx;
  text-align: right;
}

.days-unit {
  padding-right: 14rpx;
  color: #8f959e;
  font-size: 22rpx;
}

.picker-value,
.date-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 60rpx;
  box-sizing: border-box;
  border: 1rpx solid #dee0e3;
  border-radius: 8rpx;
  padding: 0 20rpx;
  color: #2b2f36;
  font-size: 24rpx;
}

.course-filter-value,
.course-date-value {
  height: 56rpx;
  border: none;
}

.course-primary-filter-value {
  width: 100%;
  box-sizing: border-box;
  justify-content: flex-end;
  padding-right: 0;
  padding-left: 0;
}

.course-primary-filter-value .picker-text {
  flex: 0 1 auto;
  max-width: 100%;
  text-align: right;
}

.course-date-value {
  justify-content: space-between;
  padding-right: 0;
  padding-left: 0;
}

.course-filter-row {
  align-items: center;
  margin-top: 0;
}

.course-filter-row .filter-label {
  width: 128rpx;
}

.participant-filter-input {
  padding-right: 0;
  padding-left: 0;
  text-align: right;
}

.participant-filter-toggle {
  display: flex;
  min-height: 54rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  margin-top: 8rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid #f0f1f2;
  color: #9aa1a9;
  font-size: 22rpx;
}

.participant-filter-active { color: #8f959e; font-size: 19rpx; }
.participant-filter-chevron {
  width: 0;
  height: 0;
  border-top: 6rpx solid #c5c9ce;
  border-right: 6rpx solid transparent;
  border-left: 6rpx solid transparent;
}
.participant-filter-chevron.expanded { transform: rotate(180deg); }

.picker-arrow {
  flex-shrink: 0;
  width: 18rpx;
  height: 18rpx;
  margin-left: 8rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
  background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0naHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmcnIHZpZXdCb3g9JzAgMCAyNCAyNCcgZmlsbD0nbm9uZScgc3Ryb2tlPScjOGY5NTllJyBzdHJva2Utd2lkdGg9JzIuNicgc3Ryb2tlLWxpbmVjYXA9J3JvdW5kJyBzdHJva2UtbGluZWpvaW49J3JvdW5kJz48cGF0aCBkPSdNNiA5bDYgNiA2LTYnLz48L3N2Zz4=");
}

.course-picker-arrow {
  width: 0;
  height: 0;
  margin-left: 16rpx;
  opacity: 0.5;
  border: 0;
  border-right: 7rpx solid transparent;
  border-bottom: 0;
  border-left: 7rpx solid transparent;
  border-top: 7rpx solid #8f959e;
  background: none;
  background-image: none;
}

.picker-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.date-range {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
}

.course-date-range {
  width: 380rpx;
  max-width: 100%;
  flex: 0 1 380rpx;
  margin-left: auto;
}

.date-picker {
  min-width: 0;
  flex: 1;
}

.date-value {
  justify-content: center;
  padding: 0 10rpx;
  font-size: 24rpx;
  line-height: 1;
}

.date-value.course-date-value {
  justify-content: space-between;
  padding: 0;
}

.date-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.date-separator {
  margin: 0 12rpx;
  color: #8f959e;
  font-size: 24rpx;
  line-height: 1;
}

.course-presets {
  display: flex;
  min-width: 0;
  width: 380rpx;
  max-width: 100%;
  flex: 0 1 380rpx;
  flex-wrap: nowrap;
  justify-content: space-between;
  gap: 0;
  margin-left: auto;
  padding-right: 30rpx;
  box-sizing: border-box;
}

.course-preset {
  display: flex;
  height: 56rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border: 1rpx solid transparent;
  border-radius: 8rpx;
  background: transparent;
  padding: 0 18rpx;
  color: #8f959e;
  font-size: 24rpx;
}

.course-preset.active {
  border-color: transparent;
  background: transparent;
  color: #2b2f36;
  font-weight: 400;
}

.course-presets .course-preset {
  height: 56rpx;
  min-height: 56rpx;
  box-sizing: border-box;
  padding: 0;
  font-size: 24rpx;
}

.definition-group {
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.definition-option {
  display: flex;
  align-items: center;
  color: #646a73;
  font-size: 24rpx;
}

.check-box {
  display: flex;
  width: 28rpx;
  height: 28rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  margin-right: 10rpx;
  border: 1rpx solid #c9cdd4;
  border-radius: 5rpx;
  color: #ffffff;
  font-size: 20rpx;
}

.definition-option.active .check-box {
  border-color: #3370ff;
  background: #3370ff;
}

.summary-card {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  margin-bottom: 0;
  border-radius: 12rpx 12rpx 0 0;
  padding: 20rpx 28rpx;
}

.records-card.with-summary {
  padding-top: 0;
  border-top: 1rpx solid #f0f0f0;
  border-top-left-radius: 0;
  border-top-right-radius: 0;
}

.summary-item {
  position: relative;
  min-width: 0;
  border: 0;
  padding: 12rpx 16rpx;
  text-align: center;
}

.summary-item + .summary-item::before {
  position: absolute;
  top: 50%;
  left: 0;
  width: 1rpx;
  height: 32rpx;
  transform: translateY(-50%);
  background: #e8eaed;
  content: '';
}

.summary-label {
  display: block;
  min-height: 0;
  color: #646a73;
  font-size: 20rpx;
  line-height: 1.4;
  text-align: center;
}

.summary-value {
  color: #1f2329;
  font-size: 40rpx;
  font-weight: 500;
}

.summary-value-row {
  margin-top: 8rpx;
}

.summary-unit {
  margin-left: 6rpx;
  color: #8f959e;
  font-size: 20rpx;
}

.records-card {
  padding: 26rpx 28rpx;
}

.records-card.participant-list {
  padding: 0;
  border-radius: 0;
  background: transparent;
}

.course-records-page .summary-card {
  margin-bottom: 16rpx;
  border-radius: 12rpx;
}

.course-view-tabs,
.course-view-tabs + .top-card,
.course-records-page .summary-card {
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}

.course-records-page .summary-value {
  font-size: 42rpx;
}

.records-card.course-list {
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}

/* 复盘记录：标题下面不再使用总底框，每条课程独立成卡。 */
.records-card.review-list {
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.records-head.reviews-records-head {
  min-height: 72rpx;
  margin: 0;
  padding: 0 4rpx 12rpx;
  background: transparent;
}

.records-head.reviews-records-head .records-title {
  color: #39424b;
  font-size: 28rpx;
  font-weight: 600;
}

.records-head.reviews-records-head .outline-button {
  min-width: 80rpx;
  height: 48rpx;
  padding: 0 18rpx;
  font-size: 22rpx;
  line-height: 46rpx;
}

.review-list .course-record {
  margin: 0 0 12rpx;
  overflow: hidden;
  padding: 0;
  border: 1rpx solid #ebedf0;
  border-radius: 20rpx;
  background: #ffffff;
}

.review-list .course-record:first-of-type {
  border-top: 1rpx solid #ebedf0;
}

.review-course-head {
  position: relative;
  padding: 24rpx 24rpx 20rpx;
}

.review-course-head::after {
  content: "";
  position: absolute;
  right: 0;
  bottom: 0;
  left: 28rpx;
  height: 2rpx;
  background: #f8f9fa;
}

.review-course-body {
  padding: 8rpx 28rpx 30rpx;
}

.review-course-head .course-name {
  color: #1f2329;
  font-size: 28rpx;
  font-weight: 600;
}

.review-course-head .record-meta {
  margin-top: 10rpx;
}

.review-list .teacher-line,
.review-list .name-line {
  margin-top: 20rpx;
}

.review-list .detail-label {
  width: 130rpx;
  color: #9aa1a9;
  font-size: 24rpx;
  line-height: 32rpx;
}

.review-list .detail-value,
.review-list .person-name {
  color: #33393f;
  font-size: 24rpx;
  line-height: 32rpx;
}

.review-list .name-list {
  gap: 0;
}

.review-list .person-name {
  margin: 0 10rpx 0 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
}

.records-head,
.record-primary,
.records-actions,
.record-meta,
.participant-summary,
.teacher-line,
.name-line {
  display: flex;
  align-items: center;
}

.records-head {
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.records-head.participants-records-head {
  min-height: 86rpx;
  margin: 0;
  padding: 0;
  background: transparent;
}

.records-head.participants-records-head .records-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #39424b;
}

.records-title-group {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
}

.records-title-mark {
  width: 12rpx;
  height: 12rpx;
  flex: 0 0 auto;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #f4dc84;
  transform: translateX(2rpx);
}

.p-count-inline {
  min-width: 0;
  overflow: hidden;
  margin-left: 12rpx;
  color: #8f959e;
  font-size: 21rpx;
  font-weight: 400;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.records-head.participants-records-head .outline-button {
  min-width: 80rpx;
  height: 48rpx;
  padding: 0 18rpx;
  font-size: 21rpx;
  line-height: 46rpx;
}

.records-head.course-records-head {
  min-height: 86rpx;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
}

.records-title {
  color: #4e535a;
  font-size: 24rpx;
  font-weight: 500;
}

.records-head.course-records-head .records-title {
  color: #39424b;
  font-size: 28rpx;
  font-weight: 600;
}

.records-head.course-records-head .outline-button {
  min-width: 80rpx;
  height: 48rpx;
  padding: 0 18rpx;
  font-size: 22rpx;
  line-height: 46rpx;
}

.records-actions {
  gap: 12rpx;
}

.outline-button {
  display: flex;
  width: auto;
  min-width: 92rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  border: 1rpx solid #dee0e3;
  border-radius: 8rpx;
  background: #ffffff;
  padding: 0 20rpx;
  color: #4e535a;
  font-size: 22rpx;
  line-height: 54rpx;
}

.outline-button.disabled {
  color: #b7bdc6;
  opacity: 0.7;
}

.course-record,
.follow-record {
  padding: 24rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.course-records-page .course-record-card {
  margin: 0 0 12rpx;
  padding: 0;
  border: 0;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.course-records-page .course-card-head {
  position: relative;
  background: #ffffff;
  padding: 24rpx 28rpx 20rpx;
}

.course-records-page .course-card-head::after {
  content: "";
  position: absolute;
  right: 0;
  bottom: 0;
  left: 28rpx;
  height: 2rpx;
  background: #f8f9fa;
}

.course-records-page .course-head-title {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 8rpx;
  overflow: hidden;
  color: #1f2329;
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
}

.course-head-date,
.course-head-separator {
  flex: none;
}

.course-head-name {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-records-page .course-head-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
}

.course-records-page .course-head-time,
.course-records-page .course-record-card .course-type {
  color: #8f959e;
  font-size: 22rpx;
  line-height: 32rpx;
}

.course-head-meta-separator {
  color: #a5abb2;
  font-size: 22rpx;
}

.course-records-page .course-record-card .course-type {
  margin-left: 0;
  white-space: nowrap;
}

.course-records-page .course-card-body {
  padding: 8rpx 28rpx 30rpx;
}

.course-records-page .course-record-card .teacher-line,
.course-records-page .course-record-card .name-line {
  margin-top: 20rpx;
}

.course-records-page .course-record-card .detail-label {
  width: 130rpx;
  color: #9aa1a9;
  font-size: 24rpx;
}

.course-records-page .course-record-card .detail-value,
.course-records-page .course-record-card .person-name {
  color: #33393f;
  font-size: 24rpx;
  line-height: 32rpx;
}

.course-records-page .course-record-card .empty-dash {
  align-self: center;
}

.course-records-page .course-record-card .name-list {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-wrap: wrap;
  gap: 0;
}

.course-records-page .course-record-card .person-name {
  margin: 0 10rpx 0 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
}

/* 课程记录 / 复盘记录 子页签 */
.course-view-tabs {
  display: flex;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 0 28rpx;
  margin-bottom: 12rpx;
}

.course-view-tab {
  flex: 1;
  position: relative;
  padding: 24rpx 0 22rpx;
  text-align: center;
  font-size: 28rpx;
  color: #646a73;
}

.course-view-tab.active {
  color: #3370ff;
  font-weight: 500;
}

.course-view-tab.active::after {
  content: "";
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  width: 52rpx;
  bottom: 0;
  height: 6rpx;
  border-radius: 6rpx 6rpx 0 0;
  background: #3370ff;
}

/* 复盘内容：默认两行缩略，展开看全文 */
.review-block {
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 14rpx;
  background: #f7f8fa;
}

.review-block .detail-label {
  color: #646a73;
  font-weight: 500;
}

.review-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.review-toggle {
  color: #3370ff;
  font-size: 24rpx;
}

.review-text {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 12rpx;
  color: #4e535a;
  font-size: 26rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
}

.review-text.expanded {
  display: block;
  overflow: visible;
  -webkit-line-clamp: 0;
}

.record-primary {
  min-width: 0;
  justify-content: space-between;
}

.course-name,
.customer-name {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #2b2f36;
  font-size: 27rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-type,
.distance {
  margin-left: 18rpx;
  flex-shrink: 0;
  color: #8f959e;
  font-size: 22rpx;
}

.distance.overdue {
  color: #c4506a;
}

.record-meta {
  flex-wrap: wrap;
  gap: 10rpx 20rpx;
  margin-top: 10rpx;
  color: #8f959e;
  font-size: 22rpx;
}

.record-meta-separator {
  color: #a0a7af;
}

.teacher-line,
.name-line {
  align-items: flex-start;
  margin-top: 18rpx;
}

.detail-label {
  width: 140rpx;
  flex-shrink: 0;
  color: #8f959e;
  font-size: 22rpx;
  line-height: 36rpx;
}

.detail-value {
  min-width: 0;
  flex: 1;
  color: #4e535a;
  font-size: 24rpx;
  line-height: 36rpx;
}

.participant-summary {
  gap: 28rpx;
  margin-top: 18rpx;
  color: #4e535a;
  font-size: 23rpx;
}

.name-list {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-wrap: wrap;
  gap: 10rpx 12rpx;
}

.person-name {
  border-radius: 5rpx;
  background: #f5f6f7;
  padding: 4rpx 10rpx;
  color: #4e535a;
  font-size: 22rpx;
  line-height: 30rpx;
}


.empty-dash {
  /* 空值不写「—」，用一条很短的浅灰横线占位（和自定义筛选一致） */
  display: inline-block;
  width: 12rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background-color: #e5e8eb;
  font-size: 0;
  vertical-align: middle;
}

.note-block {
  margin-top: 18rpx;
  border-left: 3rpx solid #e1e4e7;
  padding-left: 16rpx;
}

.note-title,
.note-time {
  display: block;
}

.note-title {
  margin-bottom: 6rpx;
  color: #8f959e;
  font-size: 21rpx;
}

.note-content {
  display: -webkit-box;
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #4e535a;
  font-size: 24rpx;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: pre-wrap;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.note-entry {
  display: flex;
  min-width: 0;
  align-items: baseline;
  gap: 14rpx;
}

.note-author {
  max-width: 150rpx;
  flex-shrink: 0;
  overflow: hidden;
  color: #8f959e;
  font-size: 22rpx;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.note-content.expanded {
  display: block;
  overflow: visible;
  -webkit-line-clamp: unset;
}

.note-time {
  margin-top: 6rpx;
  color: #b7bdc6;
  font-size: 20rpx;
}

.loading,
.empty {
  padding: 100rpx 0;
  color: #8f959e;
  font-size: 24rpx;
  text-align: center;
}

.load-more {
  padding: 24rpx 0 4rpx;
  color: #b7bdc6;
  font-size: 21rpx;
  text-align: center;
}

/* ---- 课程记录 → 参与者 页签 ---- */
.p-record { padding: 22rpx 24rpx 24rpx; border-bottom: 1rpx solid #f0f1f2; }
.p-head { display: flex; align-items: center; gap: 12rpx; }
.p-date { flex-shrink: 0; font-size: 24rpx; color: #8f959e; }
.p-title { display: flex; align-items: center; gap: 0; flex: 1; min-width: 0; }
.p-name { flex-shrink: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 27rpx; font-weight: 600; color: #2b2f36; }
.p-role { flex-shrink: 0; margin-left: 10rpx; padding: 4rpx 10rpx; border: 1rpx solid #f1e2d2; border-radius: 6rpx; background: #fffaf5; font-size: 20rpx; line-height: 1.5; color: #a8794f; }
.p-identity { flex-shrink: 0; margin-left: 10rpx; padding: 4rpx 12rpx; border-radius: 6rpx; background: #f2f3f5; font-size: 21rpx; line-height: 1.5; color: #737b85; }
.p-course { display: block; margin-top: 6rpx; font-size: 25rpx; color: #4e535a; }
.p-field { display: flex; align-items: flex-start; gap: 16rpx; margin-top: 12rpx; }
.p-field.p-field-empty { align-items: center; }
.p-field-label { flex-shrink: 0; width: 130rpx; font-size: 23rpx; line-height: 1.5; color: #9aa1a9; }
.p-field-value { flex: 1; min-width: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 23rpx; line-height: 1.5; color: #505963; word-break: break-all; white-space: pre-wrap; }
.p-field-input { display: block; flex: 1; min-width: 0; padding: 10rpx 10rpx; box-sizing: border-box; border: 1rpx solid #e1e4e7; border-radius: 8rpx; background: #fff; font-size: 23rpx; line-height: 1.5; color: #a0a7af; }

/* 参与者页签：填写弹层（和「客户跟进」页同一套） */
.sheet-mask { position: fixed; inset: 0; z-index: 200; background: rgba(31,35,41,.34); }
.edit-sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 201; display: flex; flex-direction: column; max-height: 82vh; box-sizing: border-box; overflow: hidden; border-radius: 16rpx 16rpx 0 0; background: #fff; padding-bottom: env(safe-area-inset-bottom); }
.sheet-head { display: flex; flex-shrink: 0; align-items: center; justify-content: space-between; padding: 26rpx 30rpx; border-bottom: 1rpx solid #f0f0f0; }
.sheet-title { font-size: 31rpx; font-weight: 500; }
.sheet-close { font-size: 27rpx; color: #3370ff; }
.edit-body { flex: 0 1 auto; height: auto; min-height: 0; max-height: calc(82vh - 220rpx); padding: 24rpx 30rpx 8rpx; box-sizing: border-box; }
.edit-sheet-reference .edit-body { flex: 0 1 auto; height: auto; max-height: calc(82vh - 300rpx); }
.edit-sheet-compact .edit-body { padding-bottom: 0; }
.edit-sheet-compact .edit-body-compact { max-height: none; }
.edit-subtitle { display: block; font-size: 25rpx; line-height: 1.6; color: #8f959e; }
.reference-entry { padding: 8rpx 0; border-bottom: 1rpx solid #eceef0; }
.reference-entry:last-child { border-bottom: 0; }
.reference-meta { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; font-size: 24rpx; }
.reference-author { min-width: 0; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #8f959e; }
.reference-right { display: flex; flex-shrink: 0; align-items: center; gap: 12rpx; max-width: 70%; color: #8f959e; text-align: right; }
.reference-right text:first-child { flex-shrink: 0; }
.reference-right text:last-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.edit-reference { margin-top: 16rpx; padding: 16rpx; border-radius: 8rpx; background: #f7f8fa; }
.edit-reference-title { display: block; font-size: 24rpx; color: #8f959e; }
.edit-reference-text { display: block; margin-top: 8rpx; font-size: 27rpx; line-height: 1.6; color: #4e535a; word-break: break-all; white-space: pre-wrap; }
.edit-label { display: block; margin-top: 28rpx; font-size: 24rpx; color: #8f959e; }
.feedback-field { display: flex; align-items: center; gap: 16rpx; margin-top: 6rpx; color: #646a73; font-size: 26rpx; }
.feedback-label { display: flex; flex-shrink: 0; align-items: center; gap: 8rpx; }
.feedback-label-dot { width: 12rpx; height: 12rpx; flex-shrink: 0; border-radius: 50%; background: #f4dc84; }
.feedback-field picker { flex: 0 1 200rpx; min-width: 0; margin-left: auto; }
.feedback-picker { display: flex; align-items: center; justify-content: space-between; height: 58rpx; box-sizing: border-box; padding: 0 16rpx; border: 1rpx solid #e1e4e7; border-radius: 8rpx; background: #fcfcfc; color: #2b2f36; font-size: 26rpx; }
.feedback-picker-text { flex: 1; min-width: 0; overflow: hidden; text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.feedback-picker-arrow { flex-shrink: 0; width: 0; height: 0; margin-left: 12rpx; border-top: 7rpx solid #9aa1a9; border-right: 7rpx solid transparent; border-left: 7rpx solid transparent; }
.edit-input { width: 100%; height: 260rpx; margin-top: 12rpx; margin-bottom: 20rpx; padding: 18rpx; box-sizing: border-box; border-radius: 8rpx; background: #f5f6f7; font-size: 28rpx; line-height: 1.6; }
.edit-input-placeholder { color: #b7bdc6; }
.edit-actions { display: flex; flex-shrink: 0; gap: 20rpx; padding: 20rpx 30rpx 26rpx; }
.edit-sheet-reference .edit-actions { position: relative; z-index: 1; background: #fff; }
.edit-sheet-compact .edit-actions { padding-top: 12rpx; }
.edit-button { display: flex; align-items: center; justify-content: center; flex: 1 1 0; width: 0; height: 72rpx; border-radius: 8rpx; border: 1rpx solid #dfe2e6; font-size: 27rpx; font-weight: 500; color: #646a73; background: #fff; }
.edit-button.confirm { border-color: #3370ff; background: #3370ff; color: #fff; }
.edit-button.disabled { opacity: .6; }

/* 参与者页签的昵称搜索框：和上面的下拉框同一套外观 */
/* 输入框用 width:0 + flex:1，长内容不会把这一行顶出屏幕 */
.filter-input { flex: 1; width: 0; min-width: 0; height: 56rpx; padding: 0 20rpx; box-sizing: border-box; border: none; border-radius: 8rpx; background: transparent; font-size: 24rpx; color: #2b2f36; }
.filter-input-placeholder { color: #8f959e; font-size: 24rpx; }

/* 参与者：按课程分组 */
.p-group { margin-bottom: 12rpx; border: 1rpx solid #e9ecef; border-radius: 16rpx; overflow: hidden; background: #fff; }
.p-group-head { display: flex; min-height: 78rpx; box-sizing: border-box; align-items: center; justify-content: space-between; gap: 12rpx; padding: 0 24rpx; background: #fafbfc; border-bottom: 1rpx solid #eef0f2; }
.p-group .p-record:last-child { border-bottom: 0; }
.p-group-course { flex: 1 1 0; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 25rpx; font-weight: 600; color: #2b2f36; }
.p-group-meta { display: flex; max-width: 62%; flex: 0 0 auto; align-items: center; justify-content: flex-end; gap: 12rpx; }
.p-group-type { min-width: 0; overflow: hidden; color: #8f959e; font-size: 22rpx; text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.p-group-count { flex-shrink: 0; color: #9aa1a9; font-size: 22rpx; white-space: nowrap; }

/* 参与者页：筛选区与内容区文字统一轻微放大，尺寸只增加 1rpx（约 0.5px） */
.course-participants-page .filter-label,
.course-participants-page .picker-value,
.course-participants-page .course-date-value,
.course-participants-page .date-separator,
.course-participants-page .course-presets .course-preset,
.course-participants-page .participant-filter-input,
.course-participants-page .filter-input-placeholder {
  font-size: 24rpx;
}

.course-participants-page .records-head.participants-records-head .records-title { font-size: 28rpx; }
.course-participants-page .records-head.participants-records-head .outline-button { font-size: 22rpx; }
.course-participants-page .p-count-inline { font-size: 22rpx; }
.course-participants-page .p-date { font-size: 25rpx; }
.course-participants-page .p-name { font-size: 28rpx; }
.course-participants-page .p-role,
.course-participants-page .p-identity { font-size: 20rpx; }
.course-participants-page .p-group-course {
  color: #1f2329;
  font-size: 28rpx;
  font-weight: 600;
}
.course-participants-page .p-field-label {
  width: 130rpx;
  color: #9aa1a9;
  font-size: 24rpx;
  line-height: 32rpx;
}
.course-participants-page .p-field-value {
  color: #33393f;
  font-size: 24rpx;
  line-height: 32rpx;
}
.course-participants-page .p-field-input {
  color: #a0a7af;
  font-size: 22rpx;
  line-height: 32rpx;
}
.course-participants-page .p-field.p-field-empty { align-items: center; }
.course-participants-page .p-field-value { -webkit-line-clamp: 3; }

/* 参与者页：筛选行与列表内容的各处留白增加约 2px */
.course-participants-page .course-filter-row { min-height: 68rpx; }
.course-participants-page .top-card { margin-bottom: 16rpx; }
.course-participants-page .p-group {
  margin-bottom: 12rpx;
  border: 1rpx solid #ebedf0;
  border-radius: 16rpx;
  background: #ffffff;
}
.course-participants-page .p-group-head {
  position: relative;
  min-height: 0;
  padding: 24rpx 28rpx 20rpx;
  border-bottom: 0;
  background: #ffffff;
}
.course-participants-page .p-group-head::after {
  content: "";
  position: absolute;
  right: 0;
  bottom: 0;
  left: 28rpx;
  height: 2rpx;
  background: #f8f9fa;
}
.course-participants-page .p-group-type,
.course-participants-page .p-group-count {
  color: #8f959e;
  font-size: 22rpx;
}
.course-participants-page .p-record {
  position: relative;
  padding: 24rpx 28rpx;
  border-bottom: 0;
}
.course-participants-page .p-record::after {
  content: "";
  position: absolute;
  right: 0;
  bottom: 0;
  left: 28rpx;
  height: 2rpx;
  background: #f8f9fa;
}
.course-participants-page .p-group .p-record:last-child::after {
  display: none;
}
.course-participants-page .p-name {
  color: #1f2329;
  font-size: 28rpx;
  font-weight: 600;
}
.course-participants-page .p-field { margin-top: 20rpx; }
.course-participants-page .p-head + .p-field { margin-top: 20rpx; }
