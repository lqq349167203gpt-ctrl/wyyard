<page-meta page-style="{{showFilterPanel ? 'overflow:hidden;height:100vh;' : ''}}" />
<view class="page">
  <!-- 无权限 -->
  <view class="no-permission" wx:if="{{!hasPagePermission}}">
    <text class="no-permission-text">无权限访问此页面</text>
  </view>
  <block wx:else>
  <view class="toolbar-sticky">
    <!-- Tab 栏 -->
    <view class="tab-header">
      <scroll-view class="tab-bar" scroll-x enable-flex show-scrollbar="{{false}}" scroll-into-view="{{tabScrollIntoView}}" scroll-with-animation="{{true}}">
        <view
          wx:for="{{tabs}}"
          wx:key="key"
          id="payment-tab-{{item.key}}"
          class="tab-item {{activeTab === index ? 'active' : ''}}"
          data-index="{{index}}"
          bindtap="onTabChange"
        >
          <text>{{item.label}}</text>
        </view>
      </scroll-view>
      <view class="export-btn {{exporting ? 'disabled' : ''}}" wx:if="{{!searchMode}}" catchtap="onExportTap">
        <text>{{exporting ? '导出中' : '导出'}}</text>
      </view>
    </view>

    <!-- 搜索与筛选 -->
    <view class="search-bar">
      <view class="search-input-wrap" wx:if="{{searchMode}}">
        <view class="search-symbol"></view>
        <input
          class="search-input"
          placeholder="搜索客户昵称"
          placeholder-class="placeholder"
          value="{{keyword}}"
          focus="{{true}}"
          bindinput="onSearchInput"
          bindconfirm="onSearchConfirm"
          confirm-type="search"
        />
        <view class="search-clear" wx:if="{{keyword}}" bindtap="onClearKeyword"></view>
      </view>
      <view class="search-input-wrap search-entry" wx:else bindtap="onSearchTap" hover-class="search-entry-active" hover-stay-time="80">
        <view class="search-symbol"></view>
        <text class="search-entry-text">搜索客户昵称</text>
      </view>
      <view class="filter-btn {{showFilterPanel ? 'active' : ''}}" bindtap="onToggleFilterPanel">
        <text>筛选</text>
        <text class="filter-count" wx:if="{{filterCount > 0}}">{{filterCount}}</text>
        <view class="filter-toggle-arrow {{showFilterPanel ? 'open' : ''}}"></view>
      </view>
    </view>
  </view>

  <view class="dropdown-panel" wx:if="{{showFilterPanel}}">
    <view class="dropdown-mask" bindtap="onCloseFilterPanel"></view>
    <view class="dropdown-content filter-dropdown">
      <scroll-view class="filter-scroll" scroll-y="{{true}}" enable-flex="{{true}}" show-scrollbar="{{false}}">
        <view class="filter-body">
          <view class="filter-section">
            <view class="filter-section-title">创建人</view>
            <view class="tags-wrap">
              <view
                class="tag-item {{item.selected ? 'active' : ''}}"
                wx:for="{{creatorList}}"
                wx:key="name"
                bindtap="onToggleCreator"
                data-name="{{item.name}}"
              >
                <text>{{item.name}}</text>
              </view>
            </view>
            <view class="filter-section-empty" wx:if="{{creatorList.length === 0}}">暂无创建人数据</view>
          </view>

          <view class="filter-section" wx:if="{{subtypeField}}">
            <view class="filter-section-title">{{subtypeLabel}}</view>
            <view class="tags-wrap">
              <view
                class="tag-item {{item.selected ? 'active' : ''}}"
                wx:for="{{subtypeList}}"
                wx:key="name"
                bindtap="onToggleSubtype"
                data-name="{{item.name}}"
              >
                <text>{{item.name}}</text>
              </view>
            </view>
            <view class="filter-section-empty" wx:if="{{subtypeList.length === 0}}">暂无{{subtypeLabel}}数据</view>
          </view>
        </view>
      </scroll-view>

      <view class="filter-actions">
        <text class="filter-reset" bindtap="onResetFilter">重置</text>
        <text class="filter-confirm" bindtap="onConfirmFilter">确定</text>
      </view>
    </view>
  </view>

  <view class="search-welcome" wx:if="{{searchMode && !hasSearched && !loading}}">
    <view class="search-welcome-icon"><view class="search-symbol large"></view></view>
    <text class="search-welcome-title">搜索付费记录</text>
    <text class="search-welcome-hint">输入客户昵称，或点击右侧按创建人和项目类型筛选</text>
  </view>

  <view class="search-result-summary" wx:if="{{searchMode && hasSearched && !loading}}">
    <text class="search-result-title">搜索结果</text>
    <text class="search-result-count">共 {{total}} 条</text>
  </view>

  <!-- 列表 -->
  <view class="list" wx:if="{{items.length > 0}}">
    <view class="card" wx:for="{{items}}" wx:key="id" bindtap="onItemTap" data-item="{{item}}">
      <view class="card-main">
        <view class="card-row1">
          <text class="card-name">{{item.nickname}}</text>
          <text class="card-status" wx:if="{{item._status}}" style="color: {{item._statusColor}}; background-color: {{item._statusBg}}">{{item._status}}</text>
          <text class="card-price"><text class="card-currency">¥</text>{{item._priceText}}</text>
        </view>
        <view class="card-meta" wx:if="{{item._metaPrimary || item._creator}}">
          <text class="card-meta-item" wx:if="{{item._metaPrimary}}">{{item._metaPrimary}}</text>
          <text class="card-meta-separator" wx:if="{{item._metaPrimary && item._creator}}">·</text>
          <text class="card-meta-item" wx:if="{{item._creator}}">创建人 {{item._creator}}</text>
        </view>
        <view class="card-stat-strip" wx:if="{{item._purchaseCount !== '' || item._remaining !== '' || item._expiry}}">
          <text class="stat-item" wx:if="{{item._purchaseCount !== ''}}">购买<text class="stat-num">{{item._purchaseCount}}</text>次</text>
          <text class="stat-item" wx:if="{{item._remaining !== '' && item._remaining !== '不限'}}">剩余<text class="stat-num {{item._remaining === 0 || item._remaining === '0' ? 'danger' : ''}}">{{item._remaining}}</text>次</text>
          <text class="stat-item" wx:if="{{item._remaining === '不限'}}">剩余<text class="stat-num">不限</text></text>
          <text class="stat-item stat-to" wx:if="{{item._expiry}}">至 {{item._expiry}}</text>
        </view>
        <view class="card-row3" wx:if="{{item.notes}}">
          <text class="card-notes">备注：{{item.notes}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!loading && hasSearched && items.length === 0}}">
    <text class="empty-text">{{searchMode ? '没有找到匹配的付费记录' : (keyword || filterCount > 0 ? '没有符合条件的记录' : '暂无数据')}}</text>
    <text class="empty-hint" wx:if="{{searchMode}}">试试更短的昵称或调整筛选条件</text>
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text class="loading-text">{{searchMode ? '搜索中...' : '加载中...'}}</text>
  </view>

  <!-- 新增按钮 -->
  <view class="fab" wx:if="{{!searchMode}}" bindtap="onAddTap">
    <text class="fab-text">+</text>
  </view>

  <view class="export-mask" wx:if="{{exportDialogVisible}}" catchtap="onExportDialogClose">
    <view class="export-panel" catchtap="stopPropagation">
      <view class="export-panel-header">
        <text class="export-panel-title">导出付费记录</text>
        <text class="export-panel-desc">导出全部付费类型，并按成交日期从近到远排列</text>
      </view>

      <view class="export-panel-body">
        <view class="export-field">
          <text class="export-field-label">导出方式</text>
          <view class="export-range-options">
            <view
              wx:for="{{exportRangeOptions}}"
              wx:key="value"
              class="export-range-option {{exportRangeType === item.value ? 'active' : ''}}"
              data-type="{{item.value}}"
              bindtap="onExportRangeChange"
            >
              <text>{{item.label}}</text>
            </view>
          </view>
        </view>

        <view class="export-field">
          <text class="export-field-label" wx:if="{{exportRangeType === 'day'}}">选择日期</text>
          <text class="export-field-label" wx:if="{{exportRangeType === 'month'}}">选择月份</text>
          <text class="export-field-label" wx:if="{{exportRangeType === 'year'}}">选择年份</text>
          <text class="export-field-label" wx:if="{{exportRangeType === 'custom'}}">时间范围</text>

          <picker wx:if="{{exportRangeType === 'day'}}" mode="date" fields="day" value="{{exportDate}}" bindchange="onExportDateChange">
            <view class="export-picker">
              <text>{{exportDate}}</text>
              <view class="export-picker-arrow"></view>
            </view>
          </picker>
          <picker wx:if="{{exportRangeType === 'month'}}" mode="date" fields="month" value="{{exportMonth}}" bindchange="onExportMonthChange">
            <view class="export-picker">
              <text>{{exportMonth}}</text>
              <view class="export-picker-arrow"></view>
            </view>
          </picker>
          <picker wx:if="{{exportRangeType === 'year'}}" mode="date" fields="year" value="{{exportYear}}" bindchange="onExportYearChange">
            <view class="export-picker">
              <text>{{exportYear}}年</text>
              <view class="export-picker-arrow"></view>
            </view>
          </picker>
          <view class="export-custom-range" wx:if="{{exportRangeType === 'custom'}}">
            <picker class="export-custom-picker" mode="date" fields="day" value="{{exportDateFrom}}" bindchange="onExportDateFromChange">
              <view class="export-picker export-picker-half"><text>{{exportDateFrom}}</text></view>
            </picker>
            <text class="export-range-separator">~</text>
            <picker class="export-custom-picker" mode="date" fields="day" value="{{exportDateTo}}" bindchange="onExportDateToChange">
              <view class="export-picker export-picker-half"><text>{{exportDateTo}}</text></view>
            </picker>
          </view>
        </view>

        <view class="export-summary">
          <text>将导出全部付费类型 · {{exportRangeSummary}}</text>
        </view>
      </view>

      <view class="export-panel-footer">
        <view class="export-action secondary {{exporting ? 'disabled' : ''}}" bindtap="onExportDialogClose"><text>取消</text></view>
        <view class="export-action primary {{exporting ? 'disabled' : ''}}" bindtap="onExportConfirm"><text>{{exporting ? '导出中...' : '导出'}}</text></view>
      </view>
    </view>
  </view>
  </block>
</view>
