<view class="page">
  <!-- 无权限 -->
  <view class="no-permission" wx:if="{{!hasPagePermission}}">
    <text class="no-permission-text">无权限访问此页面</text>
  </view>
  <block wx:else>
  <!-- Tab 栏 -->
  <view class="tab-header">
    <scroll-view class="tab-bar" scroll-x enable-flex>
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="tab-item {{activeTab === index ? 'active' : ''}}"
        data-index="{{index}}"
        bindtap="onTabChange"
      >
        <text>{{item.label}}</text>
      </view>
    </scroll-view>
    <view class="export-btn {{exporting ? 'disabled' : ''}}" catchtap="onExportTap">
      <text>{{exporting ? '导出中' : '导出'}}</text>
    </view>
  </view>

  <!-- 列表 -->
  <view class="list" wx:if="{{items.length > 0}}">
    <view class="card" wx:for="{{items}}" wx:key="id" bindtap="onItemTap" data-item="{{item}}">
      <view class="card-main">
        <view class="card-row1">
          <text class="card-name">{{item.nickname}}</text>
          <text class="card-status" wx:if="{{item._status}}" style="color: {{item._statusColor}}">{{item._status}}</text>
          <text class="card-price">¥{{item._price}}</text>
        </view>
        <view class="card-row2">
          <text class="card-validity" wx:if="{{item._diagnosisTeacher}}">诊断：{{item._diagnosisTeacher}}</text>
          <text class="card-detail" wx:if="{{item._detail && !item._purchaseCount && !item._validity && !item._quantity && !item._duration}}">{{item._detail}}</text>
          <text class="card-validity" wx:if="{{item._validity}}">{{item._validity}}</text>
          <text class="card-validity" wx:if="{{item._quantity}}">{{item._quantity}}</text>
          <text class="card-validity" wx:if="{{item._duration}}">{{item._duration}}</text>
          <text class="card-count" wx:if="{{item._purchaseCount !== ''}}">购买: {{item._purchaseCount}}次</text>
          <text class="card-remaining" wx:if="{{item._remaining !== ''}}">剩余: {{item._remaining}}次</text>
          <text class="card-date" wx:if="{{item._effective}}">{{item._effective}} ~ {{item._expiry}}</text>
        </view>
        <view class="card-row3" wx:if="{{item.notes}}">
          <text class="card-notes">备注: {{item.notes}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!loading && items.length === 0}}">
    <text class="empty-text">暂无数据</text>
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 新增按钮 -->
  <view class="fab" bindtap="onAddTap">
    <text class="fab-text">+</text>
  </view>

  <view class="export-mask" wx:if="{{exportDialogVisible}}" catchtap="onExportDialogClose">
    <view class="export-panel" catchtap="stopPropagation">
      <view class="export-panel-header">
        <text class="export-panel-title">导出付费记录</text>
        <text class="export-panel-desc">导出全部付费类型，并按成交日期从近到远排列</text>
      </view>

      <view class="export-panel-body">
        <view class="export-field">
          <text class="export-field-label">导出方式</text>
          <view class="export-range-options">
            <view
              wx:for="{{exportRangeOptions}}"
              wx:key="value"
              class="export-range-option {{exportRangeType === item.value ? 'active' : ''}}"
              data-type="{{item.value}}"
              bindtap="onExportRangeChange"
            >
              <text>{{item.label}}</text>
            </view>
          </view>
        </view>

        <view class="export-field">
          <text class="export-field-label" wx:if="{{exportRangeType === 'day'}}">选择日期</text>
          <text class="export-field-label" wx:if="{{exportRangeType === 'month'}}">选择月份</text>
          <text class="export-field-label" wx:if="{{exportRangeType === 'year'}}">选择年份</text>
          <text class="export-field-label" wx:if="{{exportRangeType === 'custom'}}">时间范围</text>

          <picker wx:if="{{exportRangeType === 'day'}}" mode="date" fields="day" value="{{exportDate}}" bindchange="onExportDateChange">
            <view class="export-picker">
              <text>{{exportDate}}</text>
              <view class="export-picker-arrow"></view>
            </view>
          </picker>
          <picker wx:if="{{exportRangeType === 'month'}}" mode="date" fields="month" value="{{exportMonth}}" bindchange="onExportMonthChange">
            <view class="export-picker">
              <text>{{exportMonth}}</text>
              <view class="export-picker-arrow"></view>
            </view>
          </picker>
          <picker wx:if="{{exportRangeType === 'year'}}" mode="date" fields="year" value="{{exportYear}}" bindchange="onExportYearChange">
            <view class="export-picker">
              <text>{{exportYear}}年</text>
              <view class="export-picker-arrow"></view>
            </view>
          </picker>
          <view class="export-custom-range" wx:if="{{exportRangeType === 'custom'}}">
            <picker class="export-custom-picker" mode="date" fields="day" value="{{exportDateFrom}}" bindchange="onExportDateFromChange">
              <view class="export-picker export-picker-half"><text>{{exportDateFrom}}</text></view>
            </picker>
            <text class="export-range-separator">~</text>
            <picker class="export-custom-picker" mode="date" fields="day" value="{{exportDateTo}}" bindchange="onExportDateToChange">
              <view class="export-picker export-picker-half"><text>{{exportDateTo}}</text></view>
            </picker>
          </view>
        </view>

        <view class="export-summary">
          <text>将导出全部付费类型 · {{exportRangeSummary}}</text>
        </view>
      </view>

      <view class="export-panel-footer">
        <view class="export-action secondary {{exporting ? 'disabled' : ''}}" bindtap="onExportDialogClose"><text>取消</text></view>
        <view class="export-action primary {{exporting ? 'disabled' : ''}}" bindtap="onExportConfirm"><text>{{exporting ? '导出中...' : '导出'}}</text></view>
      </view>
    </view>
  </view>
  </block>
</view>
