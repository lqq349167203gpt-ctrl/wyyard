page{background:#f5f6f8;color:#1f2329}.page{padding:24rpx 28rpx calc(160rpx + env(safe-area-inset-bottom))}.course-title{font-size:28rpx;margin-bottom:22rpx}.course-title text{display:block;color:#8f959e;font-size:24rpx;margin-top:8rpx}.panel{padding:28rpx;background:#fff;border-radius:12rpx;margin-bottom:22rpx}.person-head,.field-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;flex-wrap:wrap}.name{font-size:36rpx;font-weight:500}.sub{color:#8f959e;font-size:24rpx}.links{display:flex;gap:18rpx;margin-top:24rpx}.links button,.links picker{flex:1;min-width:0}.links button,.link-button{font-size:26rpx;background:#fff;border:1rpx solid #dee0e3;border-radius:8rpx;text-align:center;padding:16rpx;line-height:1.4}.links button::after,button::after{border:0}.label{font-size:28rpx;font-weight:500}.need-text{font-size:28rpx;line-height:1.65;margin-top:16rpx;white-space:pre-wrap;word-break:break-all}.tags{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:14rpx}.tag{font-size:24rpx;background:#f1f3f5;color:#646a73;padding:6rpx 12rpx;border-radius:6rpx}.note-input{box-sizing:border-box;width:100%;min-height:150rpx;font-size:28rpx;line-height:1.65;padding:18rpx;border:1rpx solid #e8eaed;border-radius:8rpx;margin-top:20rpx;background:#fafbfc}.plan-row{display:flex;align-items:center;gap:16rpx;padding-top:22rpx;font-size:26rpx}.plan-row picker{flex:1;min-width:0}.plan-value{text-align:right;color:#646a73;padding:8rpx 0}.clear{color:#8f959e;font-size:24rpx;padding:8rpx 0}.other-notes{margin-top:24rpx;border-top:1rpx solid #eef0f2;padding-top:18rpx}.other-note{font-size:26rpx;white-space:pre-wrap;word-break:break-all;margin-top:14rpx}.other-note text{display:block}.actions{position:fixed;bottom:0;left:0;right:0;padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #e8eaed;display:flex;gap:20rpx}.actions button{flex:1;font-size:28rpx;min-width:0;background:#f5f6f8}.actions .primary{background:#3370ff;color:#fff}.empty,.error{padding:60rpx 20rpx;text-align:center;color:#8f959e;font-size:28rpx}.error{color:#b25b52}.readonly{font-size:24rpx;color:#8f959e;margin:20rpx 0}

.course-heading{display:flex;align-items:flex-start;gap:16rpx}.course-heading .course-title{flex:1;min-width:0;word-break:break-word}
