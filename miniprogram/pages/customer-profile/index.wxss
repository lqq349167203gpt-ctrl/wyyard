.container {
  min-height: 100vh;
  background-color: #f2f3f5;
  padding-bottom: 40rpx;
}

/* ============ Hero ============ */
.hero {
  background: #fff;
  padding: 32rpx 32rpx 0;
  border-bottom: 2rpx solid #ebedf0;
}

.hero-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hero-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #1f2329;
}

.hero-edit {
  margin-left: auto;
  font-size: 24rpx;
  color: #646a73;
  border: 2rpx solid #ebedf0;
  border-radius: 6rpx;
  padding: 8rpx 24rpx;
  flex-shrink: 0;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.hero-stats {
  display: flex;
  margin-top: 30rpx;
  padding: 24rpx 0 26rpx;
  border-top: 2rpx solid #ebedf0;
}

.hstat {
  flex: 1;
  min-width: 0;
}

.hstat + .hstat {
  border-left: 2rpx solid #ebedf0;
  padding-left: 28rpx;
}

.hstat-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
  display: block;
}

.hstat-num .unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #8f959e;
}

.hstat-num.date {
  font-size: 26rpx;
  font-weight: 400;
}

.hstat-num.date.empty {
  color: #b0b5bb;
}

.hstat-label {
  font-size: 21rpx;
  color: #8f959e;
  display: block;
  margin-top: 6rpx;
}

/* ============ Pills ============ */
.pill {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  font-size: 21rpx;
  font-weight: 500;
  border-radius: 6rpx;
  line-height: 1.6;
  flex-shrink: 0;
}

.pill-gray {
  background: #f2f3f5;
  color: #646a73;
}

.pill-blue {
  background: rgba(51, 112, 255, 0.09);
  color: #3370ff;
}

.pill-warn {
  background: rgba(217, 112, 112, 0.10);
  color: #d97070;
  font-weight: 600;
}

/* ============ 信息区 ============ */
.sec {
  margin-top: 20rpx;
  background: #fff;
  border-top: 2rpx solid #ebedf0;
  border-bottom: 2rpx solid #ebedf0;
}

.sec-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 32rpx 18rpx;
  font-size: 25rpx;
  font-weight: 700;
  color: #1f2329;
}

.sec-title::after {
  content: "";
  flex: 1;
  height: 2rpx;
  background: #ebedf0;
}

.kv {
  display: flex;
  padding: 14rpx 32rpx;
  font-size: 26rpx;
  align-items: baseline;
}

.kv .k {
  width: 128rpx;
  flex-shrink: 0;
  color: #8f959e;
  font-size: 24rpx;
}

.kv .v {
  color: #1f2329;
  min-width: 0;
  flex: 1;
  word-break: break-all;
}

.blk {
  padding: 16rpx 32rpx 20rpx;
}

.blk .k {
  font-size: 24rpx;
  color: #8f959e;
  display: block;
  margin-bottom: 8rpx;
}

.blk .v {
  font-size: 26rpx;
  line-height: 1.7;
  display: block;
  color: #1f2329;
  word-break: break-all;
}

.blk + .blk {
  border-top: 2rpx dashed #eef0f2;
}

/* ============ 记录区 ============ */
.record-section {
  margin-top: 20rpx;
  background: #fff;
}

.seg-wrap {
  background: #fff;
  padding: 20rpx 24rpx 0;
  border-bottom: 2rpx solid #ebedf0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.seg {
  display: flex;
  background: #f2f3f5;
  border-radius: 10rpx;
  padding: 4rpx;
  overflow-x: auto;
}

.seg-item {
  flex-shrink: 0;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  color: #646a73;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  white-space: nowrap;
}

.seg-item .n {
  font-size: 21rpx;
  color: #b0b5bb;
}

.seg-item.active {
  background: #fff;
  color: #1f2329;
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

.seg-item.active .n {
  color: #3370ff;
}

.seg-gap {
  height: 20rpx;
}

.rec-summary {
  display: flex;
  gap: 24rpx;
  padding: 18rpx 32rpx;
  font-size: 22rpx;
  color: #646a73;
  background: #fff;
  border-bottom: 2rpx solid #ebedf0;
}

.dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.dot-blue {
  background: #3370ff;
}

.dot-gray {
  background: #b0b5bb;
}

.dot-warn {
  background: #d97070;
}

.rec-list {
  background: #fff;
}

.rec {
  padding: 22rpx 32rpx;
  border-bottom: 2rpx solid #f5f6f7;
}

.rec:last-child {
  border-bottom: none;
}

.rec-head {
  display: flex;
  align-items: center;
}

.rec-date {
  font-size: 27rpx;
  font-weight: 700;
  color: #1f2329;
}

.rec-sub-date {
  font-size: 24rpx;
  color: #646a73;
}

.rec-head .pill {
  margin-left: auto;
}

.rec-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #1f2329;
}

.rec-name-gap {
  margin-top: 12rpx;
}

.rec-amt {
  margin-left: auto;
  font-size: 27rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.remain {
  color: #3370ff;
}

.rec-amt-meta {
  color: #8f959e;
  font-weight: 400;
}

.remain-used {
  color: #b0b5bb;
  font-weight: 400;
}

.rec-debt {
  color: #d97070;
}

.rec-debt-list {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 2rpx dashed #eef0f2;
}

.rec-debt-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 6rpx 0;
  font-size: 22rpx;
}

.rec-debt-name {
  flex: 1;
  min-width: 0;
  color: #646a73;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rec-debt-date {
  flex-shrink: 0;
  color: #8f959e;
}

.rec-debt-count {
  flex-shrink: 0;
  color: #d97070;
}

.rec-kv {
  display: flex;
  margin-top: 12rpx;
  font-size: 24rpx;
  align-items: baseline;
}

.rec-kv .k {
  width: 112rpx;
  flex-shrink: 0;
  color: #8f959e;
}

.rec-kv .v {
  color: #646a73;
  flex: 1;
  min-width: 0;
  line-height: 1.6;
  word-break: break-all;
}

.rec-sub {
  font-size: 24rpx;
  color: #646a73;
  margin-top: 12rpx;
  display: flex;
  gap: 10rpx;
  align-items: baseline;
}

.rec-sub .sep {
  color: #ccd3da;
}

.rec-body {
  font-size: 26rpx;
  color: #646a73;
  line-height: 1.6;
  margin-top: 12rpx;
  word-break: break-all;
}

.sec-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #8f959e;
  padding: 24rpx 32rpx 12rpx;
  letter-spacing: 0.02em;
}

.empty-hint {
  min-height: 400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #b0b5bb;
  text-align: center;
  background: #fff;
}

/* ============ 沟通记录 ============ */
.comm-compose {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 32rpx 16rpx;
  background: #fff;
}

.comm-input {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  height: 64rpx;
  padding: 0 20rpx;
  border: 2rpx solid #dee0e3;
  border-radius: 8rpx;
  background-color: #fff;
  color: #1f2329;
  font-size: 24rpx;
  line-height: 64rpx;
}

.comm-input-placeholder {
  color: #b0b5bb;
}

.comm-add-button {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 92rpx;
  min-width: 92rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border-radius: 6rpx;
  background-color: #3370ff;
  color: #fff;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1;
}

.comm-add-button.disabled {
  background-color: #e1e6f2;
  color: #a8b1c2;
}

.comm-add-button-hover {
  background-color: #285ecc;
}

.comm-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-left: auto;
}

.comm-creator {
  font-size: 22rpx;
  color: #8f959e;
}

.comm-delete {
  padding: 6rpx 0 6rpx 12rpx;
  color: #f54a45;
  font-size: 22rpx;
}

/* ============ 交易记录 ============ */
.pay-amount {
  color: #1f2329;
  font-weight: 700;
}

/* ============ 加载/错误 ============ */
.loading {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
  color: #8f959e;
  font-size: 28rpx;
}

.detail-error {
  display: flex;
  min-height: 100vh;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  background-color: #f2f3f5;
}

.detail-error-line {
  width: 48rpx;
  height: 2rpx;
  margin-bottom: 22rpx;
  background-color: #d8dadd;
}

.detail-error-text {
  color: #8f959e;
  font-size: 26rpx;
  text-align: center;
}

.detail-retry {
  margin-top: 28rpx;
  padding: 14rpx 28rpx;
  border-radius: 8rpx;
  background-color: #eef2f8;
  color: #3370ff;
  font-size: 25rpx;
}
