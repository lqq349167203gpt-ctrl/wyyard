.container {
  min-height: 100vh;
  box-sizing: border-box;
  background-color: #f7f8fa;
  padding: 0 0 80rpx;
}

/* ============ Hero ============ */
.hero {
  background: #f3f7ff;
  padding: 16rpx 40rpx 40rpx;
}

.hero-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.hero-name {
  font-size: 44rpx;
  font-weight: 500;
  color: #1f2329;
}

.hero-tag {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.75);
  color: #3370ff;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.5;
}

.hero-edit {
  margin-left: auto;
  font-size: 24rpx;
  color: #3370ff;
  padding: 12rpx 0 12rpx 20rpx;
  flex-shrink: 0;
}

.hero-sub {
  margin-top: 10rpx;
  color: #8f959e;
  font-size: 24rpx;
}

.hero-stats {
  display: flex;
  margin-top: 32rpx;
  padding: 24rpx 0;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.7);
}

.hstat {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.hstat + .hstat {
  border-left: 1rpx solid rgba(30, 40, 60, 0.08);
}

.hstat-num {
  font-size: 32rpx;
  font-weight: 500;
  color: #1f2329;
  display: block;
  font-variant-numeric: tabular-nums;
}

.hstat-num .unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #8f959e;
}

.hstat-num.date {
  font-size: 30rpx;
  letter-spacing: -1rpx;
}

.hstat-num.date.empty {
  color: #b0b5bb;
  font-size: 24rpx;
  letter-spacing: 0;
}

.hstat-label {
  font-size: 20rpx;
  color: #8f959e;
  display: block;
  margin-top: 6rpx;
  letter-spacing: 2rpx;
}

/* ============ Pills ============ */
.pill {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  font-size: 21rpx;
  font-weight: 500;
  border-radius: 999rpx;
  line-height: 1.6;
  flex-shrink: 0;
}

.pill-gray {
  background: #f2f3f5;
  color: #646a73;
}

.pill-blue {
  background: rgba(51, 112, 255, 0.09);
  color: #3370ff;
}

.pill-warn {
  background: rgba(217, 160, 90, 0.12);
  color: #b9792d;
}

.pill-withdrawn {
  background: rgba(196, 80, 106, 0.1);
  color: #c4506a;
}

/* ============ 信息区 ============ */
.sec {
  margin: 0;
  padding: 0;
}

.sec-title {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 28rpx 40rpx 14rpx;
  color: #646a73;
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.group-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #f4dc84;
  flex-shrink: 0;
}

.group-card {
  margin: 0 24rpx 8rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #fff;
}

.kv {
  display: flex;
  align-items: center;
  padding: 22rpx 32rpx;
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

.kv + .kv,
.kv + .tag-zone,
.blk + .blk {
  border-top: 1rpx solid #f1f2f4;
}

.kv .k {
  width: 128rpx;
  flex-shrink: 0;
  color: #8f959e;
  font-size: 24rpx;
}

.kv .v {
  color: #212631;
  min-width: 0;
  flex: 1;
  word-break: break-all;
}

.contact-actions {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 28rpx;
}

.contact-action {
  color: #3370ff;
  font-size: 24rpx;
  line-height: 44rpx;
}

.contact-action:active {
  opacity: 0.65;
}

.blk {
  padding: 22rpx 32rpx;
}

.blk .k {
  font-size: 24rpx;
  color: #8f959e;
  display: block;
  margin-bottom: 10rpx;
}

.blk .v {
  font-size: 24rpx;
  line-height: 1.6;
  display: block;
  color: #1f2329;
  word-break: break-all;
}

/* ============ 身份与状态 ============ */
.identity-value {
  font-size: 24rpx;
  font-weight: 400;
}

.mechanism {
  margin-left: auto;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #f4f6f8;
  color: #a8aeb6;
  font-size: 20rpx;
  white-space: nowrap;
}

.tag-zone {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 32rpx;
}

.tag-zone-label {
  width: 128rpx;
  flex-shrink: 0;
  color: #8f959e;
  font-size: 24rpx;
}

.identity-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  min-width: 0;
}

.identity-tag {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #f5f7ff;
  color: #3370ff;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 1.5;
}

/* ============ 记录区 ============ */
.record-section {
  margin-top: 12rpx;
}

.record-tabs-anchor {
  height: 1rpx;
  margin-bottom: -1rpx;
}

.seg-wrap {
  background: #f7f8fa;
  padding: 28rpx 24rpx 16rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.seg {
  display: flex;
  background: #f2f3f5;
  border-radius: 999rpx;
  padding: 6rpx;
  overflow-x: auto;
  scrollbar-width: none;
}

.seg::-webkit-scrollbar {
  width: 0;
  height: 0;
  display: none;
}

.seg-item {
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  font-size: 24rpx;
  color: #646a73;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  white-space: nowrap;
}

.seg-item .n {
  font-size: 21rpx;
  color: #b0b5bb;
}

.seg-item.active {
  background: #fff;
  color: #1f2329;
  font-weight: 500;
  box-shadow: none;
}

.seg-item.active .n {
  color: #3370ff;
}

.seg-gap {
  height: 0;
}

.tab-panel {
  min-height: calc(100vh - 160rpx);
  box-sizing: border-box;
  padding-bottom: 1rpx;
}

.rec-summary {
  display: flex;
  gap: 24rpx;
  padding: 8rpx 40rpx 20rpx;
  font-size: 22rpx;
  color: #8f959e;
}

.activity-rec-summary {
  flex-wrap: wrap;
  row-gap: 10rpx;
  margin-top: -16rpx;
  padding-top: 0;
}

.activity-summary-text {
  white-space: nowrap;
}

.activity-summary-count {
  color: #4e535a;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}

.activity-summary-text.withdrawn,
.activity-summary-text.withdrawn .activity-summary-count {
  color: #c4506a;
}

.dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.dot-blue {
  background: #3370ff;
}

.dot-gray {
  background: #b0b5bb;
}

.dot-warn {
  background: #d9a05a;
}

.rec-list {
  background: #fff;
  margin: 0 24rpx 8rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.rec {
  padding: 22rpx 32rpx;
}

.rec + .rec {
  border-top: 1rpx solid #f1f2f4;
}

.rec-head {
  display: flex;
  align-items: center;
}

.rec-date {
  font-size: 24rpx;
  font-weight: 400;
  color: #8f959e;
  font-variant-numeric: tabular-nums;
}

.rec-sub-date {
  font-size: 24rpx;
  color: #8f959e;
  font-variant-numeric: tabular-nums;
}

.rec-head .pill {
  margin-left: auto;
}

.rec-visit-meta {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.rec-head-visit .pill {
  margin-left: 0;
}

.rec-inviter {
  max-width: 210rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
  font-weight: 400;
  color: #8f959e;
}

.rec-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #1f2329;
}

.rec-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.rec-head-meta {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.rec-deduct {
  font-size: 24rpx;
  color: #646a73;
}

.rec-amt {
  margin-left: auto;
  font-size: 27rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.remain {
  color: #3370ff;
}

.rec-amt-meta {
  color: #8f959e;
  font-weight: 400;
}

.remain-used {
  color: #b0b5bb;
  font-weight: 400;
}

.rec-debt {
  color: #d97070;
}

.rec-debt-list {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 2rpx dashed #eef0f2;
}

.rec-debt-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 6rpx 0;
  font-size: 22rpx;
}

.rec-debt-name {
  flex: 1;
  min-width: 0;
  color: #646a73;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rec-debt-date {
  flex-shrink: 0;
  color: #8f959e;
}

.rec-debt-count {
  flex-shrink: 0;
  color: #d97070;
}

.rec-kv {
  display: flex;
  margin-top: 12rpx;
  font-size: 24rpx;
  align-items: baseline;
}

.rec-kv .k {
  width: 104rpx;
  flex-shrink: 0;
  color: #8f959e;
}

.rec-kv .v {
  color: #4e535a;
  flex: 1;
  min-width: 0;
  line-height: 1.6;
  word-break: break-all;
}

.rec-sub {
  font-size: 24rpx;
  color: #646a73;
  margin-top: 12rpx;
  display: flex;
  gap: 10rpx;
  align-items: baseline;
}

.rec-sub .sep {
  color: #ccd3da;
}

.rec-body {
  font-size: 26rpx;
  color: #646a73;
  line-height: 1.6;
  margin-top: 12rpx;
  word-break: break-all;
}

.sec-label {
  font-size: 22rpx;
  font-weight: 500;
  color: #8f959e;
  padding: 24rpx 32rpx 12rpx;
  letter-spacing: 0.02em;
}

.empty-hint {
  min-height: calc(100vh - 220rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #b0b5bb;
  text-align: center;
  background: #fff;
  margin: 0 24rpx 8rpx;
  border-radius: 24rpx;
}

/* ============ 沟通记录 ============ */
.comm-compose {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 24rpx 16rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #fff;
}

.comm-input {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  height: 64rpx;
  padding: 0 20rpx;
  border: 2rpx solid #dee0e3;
  border-radius: 12rpx;
  background-color: #fff;
  color: #1f2329;
  font-size: 24rpx;
  line-height: 64rpx;
}

.comm-input-placeholder {
  color: #b0b5bb;
}

.comm-add-button {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 92rpx;
  min-width: 92rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border-radius: 12rpx;
  background-color: #3370ff;
  color: #fff;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1;
}

.comm-add-button.disabled {
  background-color: #e1e6f2;
  color: #a8b1c2;
}

.comm-add-button-hover {
  background-color: #285ecc;
}

.comm-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-left: auto;
}

.comm-creator {
  font-size: 22rpx;
  color: #8f959e;
}

.comm-delete {
  padding: 6rpx 0 6rpx 12rpx;
  color: #f54a45;
  font-size: 22rpx;
}

/* ============ 交易记录 ============ */
.pay-amount {
  color: #1f2329;
  font-weight: 500;
}

/* ============ 加载/错误 ============ */
.loading {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
  color: #8f959e;
  font-size: 28rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f8fa;
}

.detail-error {
  display: flex;
  min-height: 100vh;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  background-color: #f7f8fa;
}

.detail-error-line {
  width: 48rpx;
  height: 2rpx;
  margin-bottom: 22rpx;
  background-color: #d8dadd;
}

.detail-error-text {
  color: #8f959e;
  font-size: 26rpx;
  text-align: center;
}

.detail-retry {
  margin-top: 28rpx;
  padding: 14rpx 28rpx;
  border-radius: 8rpx;
  background-color: #eef2f8;
  color: #3370ff;
  font-size: 25rpx;
}
