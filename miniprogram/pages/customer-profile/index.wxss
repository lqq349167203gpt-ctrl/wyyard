.container {
  padding: 24rpx 32rpx 40rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
  position: relative;
}

/* 头像区 */
.hero {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.edit-link {
  position: absolute;
  top: 24rpx;
  right: 32rpx;
}

.edit-link text {
  font-size: 26rpx;
  color: #8f959e;
}

.hero-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx;
}

.hero-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 8rpx;
}

.hero-name {
  font-size: 36rpx;
  font-weight: 400;
  color: #1f2329;
}

.hero-type {
  font-size: 24rpx;
  color: #646a73;
  background-color: #f0f1f2;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

.customer-tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.customer-tag {
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 4rpx 14rpx;
  border: 1rpx solid #e8eaed;
  border-radius: 6rpx;
  background-color: #f7f8fa;
  font-size: 22rpx;
  color: #646a73;
}

.hero-stats {
  display: flex;
  align-items: center;
  width: 100%;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f1f2;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

.stat-empty {
  height: 42rpx;
  display: flex;
  align-items: center;
}

.stat-label {
  font-size: 22rpx;
  color: #b0b5bb;
  margin-top: 6rpx;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background-color: #f0f1f2;
}

/* 通用卡片 */
.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.row {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f7f8fa;
}

.row:last-child {
  border-bottom: none;
}

.row-label {
  font-size: 26rpx;
  color: #8f959e;
  width: 130rpx;
  flex-shrink: 0;
}

.row-value {
  font-size: 26rpx;
  color: #1f2329;
  flex: 1;
  min-width: 0;
  word-break: break-all;
}

.row-value.break {
  word-break: break-all;
}

.row-value.empty-val {
  color: #d0d3d6;
}

.row-empty {
  align-self: stretch;
  display: flex;
  align-items: center;
}

.empty-line {
  width: 8rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background-color: #d0d3d6;
}

.empty-val {
  color: #d0d3d6;
}

.block {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f1f2;
}

.block:last-child {
  border-bottom: none;
}

.block-label {
  display: block;
  font-size: 22rpx;
  color: #8f959e;
  margin-bottom: 8rpx;
}

.block-value {
  display: block;
  font-size: 26rpx;
  color: #1f2329;
  line-height: 1.7;
  word-break: break-all;
}

.block-value.empty-val {
  color: #d0d3d6;
}

/* 记录区 */
.record-section {
  background-color: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

/* Tab 栏 */
.tab-bar {
  display: flex;
  overflow-x: auto;
  white-space: nowrap;
  background-color: #fafbfc;
  scrollbar-width: none;
}

.tab-bar::-webkit-scrollbar {
  display: none;
}

.tab-item {
  flex-shrink: 0;
  padding: 22rpx 28rpx;
  font-size: 26rpx;
  color: #8f959e;
  position: relative;
}

.tab-item.active {
  color: #3370ff;
  font-weight: 500;
  background-color: #ffffff;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 28rpx;
  right: 28rpx;
  height: 3rpx;
  background-color: #3370ff;
  border-radius: 2rpx;
}

/* Tab 内容 */
.tab-content {
  padding: 8rpx 32rpx 24rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #b0b5bb;
  text-align: center;
  padding: 48rpx 0;
}

/* 状态标签 */
.visit-status {
  font-size: 22rpx;
  color: #8f959e;
  background-color: #f0f1f2;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.visit-status.arrived {
  color: #3370ff;
  background-color: #f0f5ff;
}

/* 跟进点 */
.heal-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f7f8fa;
}

.heal-item:last-child {
  border-bottom: none;
}

.heal-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.heal-date {
  font-size: 26rpx;
  color: #1f2329;
  font-weight: 500;
}

.heal-row {
  display: flex;
  padding: 6rpx 0;
}

.heal-label {
  font-size: 24rpx;
  color: #8f959e;
  width: 130rpx;
  flex-shrink: 0;
}

.heal-value {
  font-size: 24rpx;
  color: #4e535a;
  flex: 1;
  min-width: 0;
  word-break: break-all;
  line-height: 1.6;
}

/* 沟通记录 */
.comm-compose {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 0 16rpx;
}

.comm-input {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  height: 64rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dee0e3;
  border-radius: 8rpx;
  background-color: #ffffff;
  color: #1f2329;
  font-size: 24rpx;
  line-height: 64rpx;
}

.comm-input-placeholder {
  color: #b0b5bb;
}

.comm-add-button {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 92rpx;
  min-width: 92rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border-radius: 6rpx;
  background-color: #3370ff;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1;
}

.comm-add-button.disabled {
  background-color: #e1e6f2;
  color: #a8b1c2;
}

.comm-add-button-hover {
  background-color: #285ecc;
}

.comm-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f7f8fa;
}

.comm-item:last-child {
  border-bottom: none;
}

.comm-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.comm-date {
  font-size: 24rpx;
  color: #8f959e;
}

.comm-creator {
  font-size: 22rpx;
  color: #8f959e;
}

.comm-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.comm-delete {
  padding: 6rpx 0 6rpx 12rpx;
  color: #f54a45;
  font-size: 22rpx;
}

.comm-content {
  font-size: 26rpx;
  color: #4e535a;
  line-height: 1.6;
  word-break: break-all;
}

/* 活动记录 */
.act-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f7f8fa;
}

.act-item:last-child {
  border-bottom: none;
}

.act-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.act-date {
  font-size: 26rpx;
  color: #1f2329;
}

.act-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

.act-tag.public {
  color: #8f959e;
  background-color: #f0f1f2;
}

.act-tag.absent {
  color: #8f959e;
  background-color: #f0f1f2;
}

.act-info {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
}

.act-name {
  font-size: 26rpx;
  color: #1f2329;
}

.act-detail {
  font-size: 24rpx;
  color: #8f959e;
}

.act-detail.deduction {
  margin-left: auto;
  color: #5d6673;
}

/* 卡次统计 */
.pur-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.pur-item:last-child {
  border-bottom: none;
}

.pur-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.pur-title {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 12rpx;
}

.pur-type {
  font-size: 24rpx;
  color: #8f959e;
  background-color: #f0f1f2;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

.pur-name {
  max-width: 180rpx;
  overflow: hidden;
  font-size: 24rpx;
  color: #646a73;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pur-summary {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  justify-content: flex-end;
  flex-shrink: 0;
  font-size: 22rpx;
  line-height: 34rpx;
  color: #8f959e;
}

.pur-summary-value {
  margin-left: 4rpx;
  color: #1f2329;
  font-weight: 500;
}

.pur-summary-divider {
  margin: 0 8rpx;
}

.pur-debt-inline {
  margin-left: 10rpx;
  color: #c4506a;
}

.pur-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
}

.pur-detail-name {
  min-width: 0;
  overflow: hidden;
  font-size: 24rpx;
  color: #4e535a;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pur-date {
  font-size: 22rpx;
  color: #8f959e;
}

.pur-card-list {
  margin-top: 14rpx;
  border-top: 1rpx solid #f0f0f0;
}

.pur-card-row {
  padding-top: 14rpx;
}

.pur-card-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.pur-card-name {
  min-width: 0;
  overflow: hidden;
  font-size: 24rpx;
  color: #4e535a;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pur-card-count {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #646a73;
}

.pur-card-row .pur-date {
  display: block;
  margin-top: 6rpx;
}

.pur-debt-list {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f0f0f0;
}

.pur-debt-title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: #c4506a;
  font-weight: 500;
}

.pur-debt-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 150rpx 104rpx;
  align-items: center;
  gap: 10rpx;
  min-height: 42rpx;
  font-size: 22rpx;
}

.pur-debt-name {
  overflow: hidden;
  color: #646a73;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pur-debt-date {
  color: #8f959e;
  text-align: right;
}

.pur-debt-count {
  color: #c4506a;
  text-align: right;
}

.pur-detail {
  font-size: 22rpx;
  color: #8f959e;
}

/* 线下落地课程 */
.ocr-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f7f8fa;
}

.ocr-item:last-child {
  border-bottom: none;
}

.ocr-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.ocr-date {
  font-size: 26rpx;
  color: #1f2329;
  font-weight: 500;
}

.ocr-teacher {
  font-size: 22rpx;
  color: #8f959e;
  background-color: #f0f1f2;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

.ocr-row {
  display: flex;
  padding: 6rpx 0;
}

.ocr-label {
  font-size: 24rpx;
  color: #8f959e;
  width: 130rpx;
  flex-shrink: 0;
}

.ocr-value {
  font-size: 24rpx;
  color: #4e535a;
  flex: 1;
  min-width: 0;
  word-break: break-all;
  line-height: 1.6;
}

/* 交易记录 */
.pay-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f7f8fa;
}

.pay-item:last-child {
  border-bottom: none;
}

.pay-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.pay-type {
  font-size: 24rpx;
  color: #8f959e;
  background-color: #f0f1f2;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

.pay-amount {
  font-size: 28rpx;
  color: #1f2329;
  font-weight: 600;
}

.pay-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 4rpx;
}

.pay-name {
  font-size: 26rpx;
  color: #1f2329;
}

.pay-meta {
  font-size: 22rpx;
  color: #8f959e;
}

.pay-dates {
  font-size: 22rpx;
  color: #b0b5bb;
}

.loading {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
  color: #8f959e;
  font-size: 28rpx;
}

.detail-error {
  display: flex;
  min-height: 100vh;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  background-color: #f7f8fa;
}

.detail-error-line {
  width: 48rpx;
  height: 2rpx;
  margin-bottom: 22rpx;
  background-color: #d8dadd;
}

.detail-error-text {
  color: #8f959e;
  font-size: 26rpx;
  text-align: center;
}

.detail-retry {
  margin-top: 28rpx;
  padding: 14rpx 28rpx;
  border-radius: 8rpx;
  background-color: #eef2f8;
  color: #3370ff;
  font-size: 25rpx;
}
