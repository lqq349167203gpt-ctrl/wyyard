<view class="container" wx:if="{{!loading && customer}}">

  <!-- Hero -->
  <view class="hero">
    <view class="hero-top">
      <text class="hero-name">{{customer.nickname || '-'}}</text>
      <view class="hero-edit" wx:if="{{!isViewOnly}}" bindtap="onEditTap">编辑</view>
    </view>
    <view class="hero-sub" wx:if="{{customer.name || genderAgeText}}">
      <text wx:if="{{customer.name}}">{{customer.name}}</text>
      <text wx:if="{{customer.name && genderAgeText}}"> · </text>
      <text wx:if="{{genderAgeText}}">{{genderAgeText}}</text>
    </view>
    <view class="hero-stats">
      <view class="hstat">
        <text class="hstat-num">{{customer.visit_count || 0}}<text class="unit"> 次</text></text>
        <text class="hstat-label">到店</text>
      </view>
      <view class="hstat">
        <text class="hstat-num">{{totalPaymentText}}</text>
        <text class="hstat-label">消费</text>
      </view>
      <view class="hstat">
        <text class="hstat-num date" wx:if="{{firstVisit}}">{{firstVisit}}</text>
        <text class="hstat-num date empty" wx:else>未到访</text>
        <text class="hstat-label">首次到访</text>
      </view>
    </view>
  </view>

  <!-- 身份与状态 -->
  <view class="sec identity-sec">
    <view class="sec-title">身份与状态</view>
    <view class="kv">
      <text class="k">会员身份</text>
      <text class="v identity-value">{{customer.member_type || ''}}</text>
      <text class="mechanism">系统判定</text>
    </view>
    <view class="kv">
      <text class="k">服务老师</text>
      <text class="v identity-value">{{healerText || ''}}</text>
      <text class="mechanism">人工分配</text>
    </view>
    <view class="kv">
      <text class="k">跟进阶段</text>
      <text class="v identity-value">{{customer.follow_up_status || '未配置'}}</text>
      <text class="mechanism">人工设置</text>
    </view>
    <view class="tag-zone">
      <text class="tag-zone-label">客户标签</text>
      <view class="identity-tags" wx:if="{{customerTags.length > 0}}">
        <text class="identity-tag" wx:for="{{customerTags}}" wx:key="id">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="sec">
    <view class="sec-title">基本信息</view>
    <view class="kv">
      <text class="k">电话</text>
      <text class="v">{{customer.phone}}</text>
      <view class="contact-actions" wx:if="{{customer.phone}}">
        <text class="contact-action" wx:if="{{customer.contact_permissions.phone.view && !revealedContacts.phone}}" bindtap="onContactView" data-field="phone">查看</text>
        <text class="contact-action" wx:if="{{customer.contact_permissions.phone.copy}}" bindtap="onContactCopy" data-field="phone">复制</text>
      </view>
    </view>
    <view class="kv">
      <text class="k">微信</text>
      <text class="v">{{customer.wechat}}</text>
      <view class="contact-actions" wx:if="{{customer.wechat}}">
        <text class="contact-action" wx:if="{{customer.contact_permissions.wechat.view && !revealedContacts.wechat}}" bindtap="onContactView" data-field="wechat">查看</text>
        <text class="contact-action" wx:if="{{customer.contact_permissions.wechat.copy}}" bindtap="onContactCopy" data-field="wechat">复制</text>
      </view>
    </view>
    <view class="kv" wx:if="{{!customerAccessPermissions || customerAccessPermissions.sensitive_fields.work_info}}">
      <text class="k">工作</text>
      <text class="v">{{workText}}</text>
    </view>
  </view>

  <!-- 来源归属 -->
  <view class="sec">
    <view class="sec-title">来源归属</view>
    <view class="kv">
      <text class="k">引流人</text>
      <text class="v">{{customer.referrer}}</text>
    </view>
    <view class="kv">
      <text class="k">引流日期</text>
      <text class="v">{{customer.referral_date}}</text>
    </view>
    <view class="kv">
      <text class="k">承接人</text>
      <text class="v">{{customer.referrer_handler}}</text>
    </view>
    <view class="kv">
      <text class="k">流量来源</text>
      <text class="v">{{customer.traffic_source}}</text>
    </view>
    <view class="kv">
      <text class="k">{{trafficDetailLabel}}</text>
      <text class="v">{{customer.traffic_source_detail}}</text>
    </view>
  </view>

  <!-- 疗愈信息 -->
  <view class="sec" wx:if="{{!customerAccessPermissions || customerAccessPermissions.sensitive_fields.visit_purpose || customerAccessPermissions.sensitive_fields.trauma_history || customerAccessPermissions.sensitive_fields.current_block || customerAccessPermissions.sensitive_fields.other_info}}">
    <view class="sec-title">疗愈信息</view>
    <view class="blk" wx:if="{{!customerAccessPermissions || customerAccessPermissions.sensitive_fields.visit_purpose}}">
      <text class="k">到访目的</text>
      <text class="v">{{customer.tags}}</text>
    </view>
    <view class="blk" wx:if="{{!customerAccessPermissions || customerAccessPermissions.sensitive_fields.trauma_history}}">
      <text class="k">创伤经历</text>
      <text class="v">{{customer.basic_info}}</text>
    </view>
    <view class="blk" wx:if="{{!customerAccessPermissions || customerAccessPermissions.sensitive_fields.current_block}}">
      <text class="k">当下卡点</text>
      <text class="v">{{customer.assessment || customer.core_situation}}</text>
    </view>
    <view class="blk" wx:if="{{!customerAccessPermissions || customerAccessPermissions.sensitive_fields.other_info}}">
      <text class="k">其他信息</text>
      <text class="v">{{customer.other_info}}</text>
    </view>
  </view>

  <!-- 记录区 -->
  <view class="record-section">
    <!-- 分段控件 -->
    <view class="seg-wrap">
      <view class="seg">
        <view
          wx:for="{{tabs}}" wx:key="key" wx:for-item="tab"
          class="seg-item {{activeTab === tab.key ? 'active' : ''}}"
          bindtap="onTabChange"
          data-key="{{tab.key}}"
        >
          <text>{{tab.label}}</text>
          <text class="n" wx:if="{{tab.count > 0}}">{{tab.count}}</text>
        </view>
      </view>
      <view class="seg-gap"></view>
    </view>

    <!-- 跟进点 -->
    <view wx:if="{{activeTab === 'healing'}}">
      <view wx:if="{{healingRecords.length === 0}}" class="empty-hint">暂无记录</view>
      <view class="rec-summary" wx:if="{{healingRecords.length > 0}}">
        <text><text class="dot dot-blue"></text>已到店 {{arrivedCount}}</text>
        <text><text class="dot dot-gray"></text>未到店 {{absentCount}}</text>
        <text><text class="dot dot-warn"></text>已取消 {{cancelledCount}}</text>
      </view>
      <view class="rec-list" wx:if="{{healingRecords.length > 0}}">
        <view class="rec" wx:for="{{healingRecords}}" wx:key="id">
          <view class="rec-head rec-head-visit">
            <text class="rec-sub-date">{{item.visit_date}}</text>
            <view class="rec-visit-meta">
              <text class="pill {{item.cancelled ? 'pill-warn' : (item.arrived ? 'pill-blue' : 'pill-gray')}}">{{item.cancelled ? '已取消' : (item.arrived ? '已到店' : '未到店')}}</text>
              <text class="rec-inviter" wx:if="{{item.referrer_handler}}">邀约人：{{item.referrer_handler}}</text>
            </view>
          </view>
          <view class="rec-kv" wx:if="{{item.needs}}">
            <text class="k">来访需求</text>
            <text class="v">{{item.needs}}</text>
          </view>
          <view class="rec-kv" wx:if="{{item.feedback || item.experience}}">
            <text class="k">客户信息</text>
            <text class="v">{{item.feedback || item.experience}}</text>
          </view>
          <view class="rec-kv" wx:if="{{item.growth_record}}">
            <text class="k">跟进点</text>
            <text class="v">{{item.growth_record}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 沟通记录 -->
    <view wx:if="{{activeTab === 'communication'}}">
      <view class="comm-compose" wx:if="{{!isViewOnly}}">
        <input
          class="comm-input"
          value="{{commContent}}"
          placeholder="输入本次沟通内容"
          placeholder-class="comm-input-placeholder"
          maxlength="5000"
          bindinput="onCommunicationInput"
          confirm-type="send"
          bindconfirm="onAddCommunication"
        />
        <view
          class="comm-add-button {{!commContent || commSaving ? 'disabled' : ''}}"
          bindtap="onAddCommunication"
          hover-class="comm-add-button-hover"
          hover-stay-time="80"
        >{{commSaving ? '...' : '新增'}}</view>
      </view>
      <view wx:if="{{commRecords.length === 0}}" class="empty-hint">暂无记录</view>
      <view class="rec-list" wx:if="{{commRecords.length > 0}}">
        <view class="rec" wx:for="{{commRecords}}" wx:key="id">
          <view class="rec-head">
            <text class="rec-date">{{item._dateStr}}</text>
            <view class="comm-meta">
              <text class="comm-creator">{{item.creator || ''}}</text>
              <text wx:if="{{item.can_delete && !isViewOnly}}" class="comm-delete" data-id="{{item.id}}" catchtap="onDeleteCommunication">删除</text>
            </view>
          </view>
          <view class="rec-body">{{item.content}}</view>
        </view>
      </view>
    </view>

    <!-- 活动记录 -->
    <view wx:if="{{activeTab === 'activities'}}">
      <view wx:if="{{activities.length === 0}}" class="empty-hint">暂无记录</view>
      <view class="rec-list" wx:if="{{activities.length > 0}}">
        <view class="rec" wx:for="{{activities}}" wx:key="index">
          <view class="rec-head">
            <text class="rec-sub-date">{{item.date}}</text>
            <view class="rec-head-meta">
              <text class="pill pill-withdrawn" wx:if="{{item.withdrawn}}">已退课</text>
              <text class="pill pill-warn" wx:elif="{{item.notArrived}}">未参与</text>
              <text class="rec-deduct" wx:if="{{item.deduction_summary && !item.notArrived}}">{{item.deduction_summary}}</text>
            </view>
          </view>
          <view class="rec-name-row">
            <text class="rec-name">{{item.name || '-'}}</text>
            <text class="pill pill-blue" wx:if="{{item.is_public_welfare}}">公益</text>
          </view>
          <view class="rec-sub" wx:if="{{item.role || item.host}}">
            <text wx:if="{{item.role}}">角色：{{item.role}}</text>
            <text class="sep" wx:if="{{item.role && item.host}}">·</text>
            <text wx:if="{{item.host}}">课程老师：{{item.host}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 卡次统计 -->
    <view wx:if="{{activeTab === 'purchase'}}">
      <view wx:if="{{purchaseSummary.length === 0}}" class="empty-hint">暂无记录</view>
      <block wx:else>
        <view class="sec-label">卡次统计</view>
        <view class="rec-list">
          <view class="rec" wx:for="{{purchaseSummary}}" wx:key="_key">
            <view class="rec-head">
              <text class="rec-name">{{item._displayName}}</text>
              <view class="rec-amt">
                <block wx:if="{{item._specialText}}">
                  <text class="{{item._specialCls}}">{{item._specialText}}</text>
                </block>
                <block wx:else>
                  <text class="remain">{{item._remainingNum}}</text>
                  <text class="rec-amt-meta"> / {{item._totalText}}</text>
                </block>
              </view>
            </view>
            <view class="rec-sub" wx:if="{{item._dateRange || (item._showDebt && item._debtCount > 0)}}">
              <text wx:if="{{item._dateRange}}">{{item._dateRange}}</text>
              <text class="sep" wx:if="{{item._dateRange && item._showDebt && item._debtCount > 0}}">·</text>
              <text class="rec-debt" wx:if="{{item._showDebt && item._debtCount > 0}}">历史欠卡{{item._debtCount}}次</text>
            </view>
            <view class="rec-debt-list" wx:if="{{item._showDebt && item._debtActivities.length > 0}}">
              <view class="rec-debt-row" wx:for="{{item._debtActivities}}" wx:for-item="debt" wx:key="index">
                <text class="rec-debt-name">{{debt.label || '活动'}}</text>
                <text class="rec-debt-date">{{debt.date || '-'}}</text>
                <text class="rec-debt-count">欠卡{{debt.count}}次</text>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>

    <!-- 客户回访 -->
    <view wx:if="{{activeTab === 'followups'}}">
      <view wx:if="{{activityFollowups.length === 0}}" class="empty-hint">暂无记录</view>
      <view class="rec-list" wx:if="{{activityFollowups.length > 0}}">
        <view class="rec" wx:for="{{activityFollowups}}" wx:key="id">
          <view class="rec-head">
            <text class="rec-name">{{item.activity_name || '活动回访'}}</text>
            <text class="rec-sub-date">{{item.activity_date || '-'}}</text>
          </view>
          <view class="rec-sub" wx:if="{{item.activity_category || item.teacher}}">
            <text wx:if="{{item.activity_category}}">{{item.activity_category}}</text>
            <text class="sep" wx:if="{{item.activity_category && item.teacher}}">·</text>
            <text wx:if="{{item.teacher}}">{{item.teacher}}</text>
          </view>
          <view class="rec-body">{{item.content || '-'}}</view>
        </view>
      </view>
    </view>

    <!-- 线下落地课程 -->
    <view wx:if="{{activeTab === 'offline_course'}}">
      <view wx:if="{{offlineCourseRecords.length === 0}}" class="empty-hint">暂无记录</view>
      <view class="rec-list" wx:if="{{offlineCourseRecords.length > 0}}">
        <view class="rec" wx:for="{{offlineCourseRecords}}" wx:key="id">
          <view class="rec-head">
            <text class="rec-date">{{item.record_date || '-'}}</text>
            <text class="pill pill-gray" wx:if="{{item.teacher}}">{{item.teacher}}</text>
          </view>
          <view class="rec-kv" wx:if="{{item.content}}">
            <text class="k">上课内容</text>
            <text class="v">{{item.content}}</text>
          </view>
          <view class="rec-kv" wx:if="{{item.result}}">
            <text class="k">上课结果</text>
            <text class="v">{{item.result}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 交易记录 -->
    <view wx:if="{{activeTab === 'payment'}}">
      <view wx:if="{{paymentRecords.length === 0}}" class="empty-hint">暂无记录</view>
      <view class="rec-list" wx:if="{{paymentRecords.length > 0}}">
        <view class="rec" wx:for="{{paymentRecords}}" wx:key="index">
          <view class="rec-head">
            <text class="rec-name">{{item.type}}</text>
            <text class="rec-amt pay-amount">¥{{item.amount}}</text>
          </view>
          <view class="rec-sub" wx:if="{{item.name || item.quantity || item.closer_name}}">
            <text wx:if="{{item.name}}">{{item.name}}</text>
            <text class="sep" wx:if="{{item.name && item.quantity}}">·</text>
            <text wx:if="{{item.quantity}}">x{{item.quantity}}</text>
            <text class="sep" wx:if="{{(item.name || item.quantity) && item.closer_name}}">·</text>
            <text wx:if="{{item.closer_name}}">{{item.closer_name}}</text>
          </view>
          <view class="rec-sub" wx:if="{{item.effective_date || item.expiry_date}}">
            <text>{{item.effective_date || '-'}} ~ {{item.expiry_date || '不限'}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>

<view class="loading" wx:if="{{loading}}">
  <text>加载中...</text>
</view>

<view class="detail-error" wx:if="{{!loading && !customer}}">
  <view class="detail-error-line"></view>
  <text class="detail-error-text">{{loadError || '客户资料加载失败'}}</text>
  <view class="detail-retry" wx:if="{{customerId}}" bindtap="onRetry">重新加载</view>
</view>
