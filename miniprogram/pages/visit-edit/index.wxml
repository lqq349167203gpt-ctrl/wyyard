<view class="container {{readOnly || verified ? 'read-only' : ''}}" wx:if="{{!loading}}">
  <view class="record-meta">
    <text>创建人 · {{createdBy || '未记录'}}</text>
    <text class="readonly-text" wx:if="{{readOnly || verified}}">{{verified ? '邀约已核对，仅下方三类信息可补充' : (viewOnly ? '当前账号仅可浏览' : '部分信息仅创建人可改')}}</text>
  </view>
  <!-- 是否组长 -->
  <view class="form-card">
    <view class="form-item last compact-row">
      <text class="form-label">是否组长</text>
      <view style="flex: 1; display: flex; justify-content: flex-end;">
        <switch checked="{{isLeader}}" disabled="{{viewOnly || verified}}" bindchange="onLeaderChange" color="#3370ff" />
      </view>
    </view>
  </view>

  <!-- 时间地点 -->
  <view class="form-card">
    <view class="form-item">
      <text class="form-label">日期</text>
      <picker wx:if="{{!readOnly && !verified}}" class="form-picker" mode="date" value="{{visitDate}}" bindchange="onDateChange">
        <view class="picker-display">{{visitDate}}</view>
      </picker>
      <text wx:else class="protected-value">{{visitDate || '-'}}</text>
    </view>
    <view class="form-item last">
      <text class="form-label">预计时间</text>
      <picker wx:if="{{!readOnly && !verified}}" class="form-picker" mode="time" value="{{visitTime}}" bindchange="onTimeChange">
        <view class="picker-display">{{visitTime}}</view>
      </picker>
      <text wx:else class="protected-value">{{visitTime || '-'}}</text>
    </view>
  </view>

  <!-- 到店状态允许现场其他员工协作修改 -->
  <view class="form-card arrival-card">
    <view class="form-item switch-row {{arrived ? '' : 'last'}}">
      <text class="form-label">到店</text>
      <view style="flex: 1; display: flex; justify-content: flex-end;">
        <switch checked="{{arrived}}" disabled="{{viewOnly || verified}}" bindchange="onArrivedChange" color="#3370ff" />
      </view>
    </view>
    <view class="form-item last" wx:if="{{arrived}}">
      <text class="form-label">到达时间</text>
      <picker class="form-picker" disabled="{{viewOnly || verified}}" mode="time" value="{{arrivalTime}}" bindchange="onArrivalTimeChange">
        <view class="picker-display">{{arrivalTime || '选择时间'}}</view>
      </picker>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="form-card">
    <view class="form-item" bindtap="onPickerOpen" data-field="customer">
      <text class="form-label">客户</text>
      <view class="picker-value-wrap">
        <text class="{{nickname ? '' : 'placeholder'}}">{{nickname || (readOnly || verified ? '-' : '选择用户')}}</text>
        <text class="picker-clear" wx:if="{{nickname && !readOnly && !verified}}" catchtap="onPickerClear" data-field="customer">x</text>
      </view>
    </view>
    <view class="form-item last" bindtap="onPickerOpen" data-field="referrerHandler">
      <text class="form-label">邀约人</text>
      <view class="picker-value-wrap">
        <text class="{{referrerHandler ? '' : 'placeholder'}}">{{referrerHandler || (readOnly || verified ? '-' : '选择用户')}}</text>
        <text class="picker-clear" wx:if="{{referrerHandler && !readOnly && !verified}}" catchtap="onPickerClear" data-field="referrerHandler">x</text>
      </view>
    </view>
  </view>

  <visit-note-section visit-id="{{visit.id}}" category="visit_need" title="来访需求" private-to-creator="{{true}}" read-only="{{viewOnly}}" />
  <visit-note-section visit-id="{{visit.id}}" category="customer_info" title="客户信息" read-only="{{viewOnly}}" />
  <visit-note-section visit-id="{{visit.id}}" category="follow_up" title="跟进点" read-only="{{viewOnly}}" />

  <!-- 搜索选择弹窗 -->
  <view class="picker-mask" wx:if="{{showPicker}}" bindtap="onPickerClose"></view>
  <view class="picker-popup" wx:if="{{showPicker}}">
    <view class="picker-header">
      <text class="picker-title">选择{{pickerTitle}}</text>
      <text class="picker-close" bindtap="onPickerClose">关闭</text>
    </view>
    <view class="picker-search">
      <input class="picker-search-input" placeholder="搜索昵称" value="{{pickerKeyword}}" bindinput="onPickerSearch" focus="{{showPicker}}" />
    </view>
    <scroll-view class="picker-list" scroll-y>
      <view class="picker-item" wx:for="{{pickerList}}" wx:key="id" bindtap="onPickerSelect" data-id="{{item.id}}" data-nickname="{{item.nickname}}">
        <text class="picker-item-name">{{item.nickname}}</text>
        <text class="picker-item-type" wx:if="{{item.member_type}}">{{item.member_type}}</text>
      </view>
      <view class="picker-empty" wx:if="{{pickerList.length === 0 && !(pickerKeyword && pickerField === 'customer')}}">
        <text>无匹配用户</text>
      </view>
      <view class="picker-create" wx:if="{{pickerList.length === 0 && pickerKeyword && pickerField === 'customer' && !customerViewOnly}}" bindtap="onCreateCustomer">
        <text class="picker-create-text">未找到，新建客户</text>
      </view>
    </scroll-view>
  </view>

  <view class="actions">
    <button class="btn-secondary" bindtap="onBack">返    回</button>
    <button wx:if="{{!viewOnly && !verified}}" class="btn-primary submit-btn" bindtap="onSubmit" loading="{{saving}}" disabled="{{saving}}">保    存</button>
  </view>
</view>

<view class="loading" wx:if="{{loading}}">
  <text>加载中...</text>
</view>
