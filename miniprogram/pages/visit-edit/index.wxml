<view class="container" wx:if="{{!loading}}">
  <!-- 时间地点 -->
  <view class="form-card">
    <view class="form-item">
      <text class="form-label">日期</text>
      <picker class="form-picker" mode="date" value="{{visitDate}}" bindchange="onDateChange">
        <view class="picker-display">{{visitDate}}</view>
      </picker>
    </view>
    <view class="form-item last">
      <text class="form-label">时间</text>
      <picker class="form-picker" mode="time" value="{{visitTime}}" bindchange="onTimeChange">
        <view class="picker-display">{{visitTime}}</view>
      </picker>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="form-card">
    <view class="form-item" bindtap="onPickerOpen" data-field="customer">
      <text class="form-label">客户</text>
      <view class="picker-value-wrap">
        <text class="{{nickname ? '' : 'placeholder'}}">{{nickname || '选择用户'}}</text>
        <text class="picker-clear" wx:if="{{nickname}}" catchtap="onPickerClear" data-field="customer">x</text>
      </view>
    </view>
    <view class="form-item column textarea-row">
      <text class="form-label" style="margin-bottom: 16rpx;">本次需求</text>
      <textarea class="form-textarea" style="height: 126rpx;" value="{{needs}}" bindinput="onNeedsInput" placeholder="描述客户需求" placeholder-class="form-textarea-placeholder" />
    </view>
    <view class="form-item" bindtap="onPickerOpen" data-field="referrerHandler">
      <text class="form-label">邀约人</text>
      <view class="picker-value-wrap">
        <text class="{{referrerHandler ? '' : 'placeholder'}}">{{referrerHandler || '选择用户'}}</text>
        <text class="picker-clear" wx:if="{{referrerHandler}}" catchtap="onPickerClear" data-field="referrerHandler">x</text>
      </view>
    </view>
    <view class="form-item switch-row">
      <text class="form-label">组长</text>
      <view style="flex: 1; display: flex; justify-content: flex-end;">
        <switch checked="{{isLeader}}" bindchange="onLeaderChange" color="#3370ff" />
      </view>
    </view>
    <view class="form-item switch-row {{arrived ? '' : 'last'}}">
      <text class="form-label">已到场</text>
      <view style="flex: 1; display: flex; justify-content: flex-end;">
        <switch checked="{{arrived}}" bindchange="onArrivedChange" color="#3370ff" />
      </view>
    </view>
    <view class="form-item last" wx:if="{{arrived}}">
      <text class="form-label">到达时间</text>
      <picker class="form-picker" mode="time" value="{{arrivalTime}}" bindchange="onArrivalTimeChange">
        <view class="picker-display">{{arrivalTime || '选择时间'}}</view>
      </picker>
    </view>
  </view>

  <!-- 记录 -->
  <view class="form-card">
    <view class="form-item column textarea-row">
      <text class="form-label" style="margin-bottom: 16rpx;">客户收获</text>
      <textarea class="form-textarea" style="height: 126rpx;" value="{{feedback}}" bindinput="onFeedbackInput" placeholder="客户收获" placeholder-class="form-textarea-placeholder" />
    </view>
    <view class="form-item column textarea-row">
      <text class="form-label" style="margin-bottom: 16rpx;">跟进点</text>
      <textarea class="form-textarea" style="height: 126rpx;" value="{{healingNotes}}" bindinput="onHealingNotesInput" placeholder="跟进点" placeholder-class="form-textarea-placeholder" />
    </view>
    <view class="form-item column textarea-row last">
      <text class="form-label" style="margin-bottom: 16rpx;">组长反馈</text>
      <textarea class="form-textarea" style="height: 126rpx;" value="{{groupLeaderFeedback}}" bindinput="onGroupLeaderFeedbackInput" placeholder="组长反馈" placeholder-class="form-textarea-placeholder" />
    </view>
  </view>

  <!-- 搜索选择弹窗 -->
  <view class="picker-mask" wx:if="{{showPicker}}" bindtap="onPickerClose"></view>
  <view class="picker-popup" wx:if="{{showPicker}}">
    <view class="picker-header">
      <text class="picker-title">选择{{pickerTitle}}</text>
      <text class="picker-close" bindtap="onPickerClose">关闭</text>
    </view>
    <view class="picker-search">
      <input class="picker-search-input" placeholder="搜索昵称" value="{{pickerKeyword}}" bindinput="onPickerSearch" focus="{{showPicker}}" />
    </view>
    <scroll-view class="picker-list" scroll-y>
      <view class="picker-item" wx:for="{{pickerList}}" wx:key="id" bindtap="onPickerSelect" data-id="{{item.id}}" data-nickname="{{item.nickname}}">
        <text class="picker-item-name">{{item.nickname}}</text>
        <text class="picker-item-type" wx:if="{{item.member_type}}">{{item.member_type}}</text>
      </view>
      <view class="picker-empty" wx:if="{{pickerList.length === 0}}">
        <text>无匹配用户</text>
      </view>
    </scroll-view>
  </view>

  <button class="btn-primary submit-btn" bindtap="onSubmit" loading="{{saving}}" disabled="{{saving}}">
    保存
  </button>
</view>

<view class="loading" wx:if="{{loading}}">
  <text>加载中...</text>
</view>
