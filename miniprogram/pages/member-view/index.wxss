page { background: #fff; }
.member-page { min-height: 100vh; padding-bottom: 64rpx; background: #fff; color: #212631; font-size: 26rpx; }
.head { padding: 52rpx 44rpx 0; }
.g-hi { font-size: 24rpx; color: #a8b1bd; letter-spacing: 4rpx; }
.id-row { margin-top: 20rpx; display: flex; align-items: center; }
.avatar { width: 104rpx; height: 104rpx; border-radius: 50%; background: #212631; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.avatar-text { font-size: 40rpx; color: #c9f24b; font-weight: 800; }
.id-text { margin-left: 28rpx; flex: 1; min-width: 0; }
.id-name { display: block; font-size: 38rpx; font-weight: 800; letter-spacing: 2rpx; }
.id-meta { margin-top: 6rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.id-slogan { font-size: 22rpx; color: #a8b1bd; min-width: 0; }
.return-button { flex-shrink: 0; font-size: 22rpx; color: #79838f; padding: 8rpx 0 8rpx 12rpx; }
.return-button text { color: #b6bec8; margin-left: 6rpx; }
.stats-flow { margin: 36rpx 44rpx 0; display: flex; align-items: flex-end; gap: 32rpx; }
.sf { display: flex; align-items: baseline; gap: 8rpx; }
.sf-num { font-size: 30rpx; font-weight: 700; }
.sf-lab { font-size: 22rpx; color: #a8b1bd; white-space: nowrap; }
.sf-big { margin-left: auto; text-align: right; }
.sf-big-num { font-size: 60rpx; font-weight: 300; line-height: 1; }
.sf-big-lab { display: block; margin-top: 10rpx; font-size: 20rpx; color: #a8b1bd; }
.mgmt { margin: 36rpx 44rpx 0; display: flex; gap: 16rpx; }
.m-blk { flex: 1; text-align: center; background: #f5f6f7; border-radius: 24rpx; padding: 24rpx 0; font-size: 28rpx; color: #454e59; letter-spacing: 2rpx; }
.sec-head { margin: 36rpx 44rpx 0; display: flex; align-items: center; }
.sec-title { font-size: 32rpx; font-weight: 800; letter-spacing: 4rpx; }
.sec-rule { flex: 1; height: 2rpx; background: #eceff1; margin: 0 24rpx; }
.sec-note, .d-count { font-size: 22rpx; color: #a8b1bd; }
.days { margin: 0 32rpx; }
.day-card { background: #f8f9fa; border-radius: 32rpx; padding: 20rpx 28rpx 10rpx; overflow: hidden; margin-top: 20rpx; }
.d-head { display: flex; align-items: center; padding-bottom: 8rpx; }
.d-chip { font-size: 20rpx; font-weight: 500; padding: 8rpx 16rpx; border-radius: 14rpx; background: #fff; color: #98a1ad; }
.d-count { margin-left: auto; }
.activity-row { padding: 16rpx 0 18rpx; }
.activity-row + .activity-row { border-top: 1rpx solid rgba(33, 38, 49, .06); }
.activity-main { display: flex; align-items: baseline; gap: 16rpx; }
.activity-name { flex: 1; min-width: 0; font-size: 28rpx; font-weight: 600; line-height: 1.6; }
.activity-status { flex-shrink: 0; font-size: 22rpx; }
.activity-meta { margin-top: 10rpx; font-size: 23rpx; color: #98a1ad; line-height: 1.6; }
.deduction { margin-top: 10rpx; font-size: 23rpx; color: #79838f; line-height: 1.6; }
.withdrawn { color: #a14c5f; }
.all-link { margin: 24rpx 44rpx 0; font-size: 24rpx; color: #98a1ad; }
.detail-heading { margin: 36rpx 44rpx 24rpx; display: flex; align-items: center; gap: 20rpx; }
.back-link { font-size: 24rpx; color: #98a1ad; padding: 8rpx 0; }
.section-title { font-size: 30rpx; font-weight: 600; }
.section-count { margin-left: auto; font-size: 22rpx; color: #a8b1bd; }
.detail-list { margin: 0 32rpx; }
.entitlement-card { padding: 28rpx; margin-bottom: 20rpx; border-radius: 24rpx; background: #f8f9fa; }
.card-title { font-size: 28rpx; font-weight: 600; }
.summary { margin-top: 12rpx; color: #646a73; line-height: 1.7; }
.card-detail { border-top: 1rpx solid #eceff1; margin-top: 20rpx; padding-top: 20rpx; }
.line { display: flex; justify-content: space-between; align-items: baseline; gap: 20rpx; line-height: 1.7; }
.balance { margin: 8rpx 0; }
.muted { color: #a8b1bd; font-size: 24rpx; line-height: 1.7; }
.debt { color: #ad8757; margin-top: 20rpx; font-size: 24rpx; }
.debt-line { color: #98a1ad; margin-top: 8rpx; }
.transaction { margin: 14rpx 0; font-size: 28rpx; }
.empty { text-align: center; color: #a8b1bd; font-size: 24rpx; padding: 48rpx 32rpx; }
.member-logout { margin-top: 44rpx; padding: 20rpx 0; text-align: center; font-size: 26rpx; color: #b6bec8; }
.checkin-entry { margin: 32rpx 44rpx 0; padding: 28rpx 0; border-top: 1rpx solid #eceff1; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; font-size: 28rpx; }
.checkin-entry .muted { font-size: 22rpx; }
.show-code { display: inline-block; margin-top: 18rpx; padding: 12rpx 24rpx; border: 1rpx solid #dfe3e7; border-radius: 12rpx; font-size: 24rpx; color: #454e59; background: #fff; }
.code-mask { position: fixed; inset: 0; z-index: 100; background: rgba(0,0,0,.35); display: flex; align-items: center; justify-content: center; padding: 40rpx; }
.code-sheet { width: 100%; padding: 32rpx; border-radius: 24rpx; background: #fff; text-align: center; box-sizing: border-box; }
.code-title { font-size: 30rpx; font-weight: 500; }
.code-image, .code-placeholder { display: block; width: 480rpx; height: 480rpx; margin: 20rpx auto; max-width: 100%; }
.code-placeholder { display: flex; align-items: center; justify-content: center; color: #98a1ad; font-size: 26rpx; }
.code-note { font-size: 22rpx; color: #a8b1bd; }
.code-actions { display: flex; margin-top: 28rpx; border-top: 1rpx solid #f0f1f2; padding-top: 24rpx; font-size: 26rpx; color: #646a73; }
.code-actions view { flex: 1; padding: 8rpx; }
