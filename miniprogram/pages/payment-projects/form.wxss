.container {
  padding: 24rpx 32rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
}

.placeholder {
  color: #b0b5bb;
}

.form-card {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 8rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f1f2;
}

.form-item.last {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #8f959e;
  width: 160rpx;
  flex-shrink: 0;
}

.form-value {
  flex: 1;
  font-size: 28rpx;
  color: #1f2329;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #1f2329;
  text-align: right;
}

.form-input-placeholder {
  color: #b0b5bb;
}

.form-picker {
  flex: 1;
  min-width: 0;
}

.picker-display {
  flex: 1;
  font-size: 28rpx;
  color: #1f2329;
  text-align: right;
}

.picker-display.placeholder {
  color: #b0b5bb;
}

.picker-value-wrap {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 1;
  min-width: 0;
}

.picker-clear {
  font-size: 30rpx;
  color: #b0b5bb;
  padding: 8rpx 16rpx;
  flex-shrink: 0;
}

/* 时长/次数行 */
.duration-wrap {
  display: flex;
  align-items: center;
  flex: 1;
  justify-content: flex-end;
  gap: 16rpx;
}

.duration-input {
  width: 120rpx;
  flex: none;
}

.duration-toggle {
  display: flex;
  border: 1rpx solid #dee0e3;
  border-radius: 8rpx;
  overflow: hidden;
}

.toggle-btn {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #8f959e;
  background-color: #fff;
}

.toggle-btn.active {
  background-color: #3370ff;
  color: #fff;
}

/* 弹窗 */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.picker-popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  display: flex;
  flex-direction: column;
  max-height: 80vh;
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f1f2;
}

.picker-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1f2329;
}

.picker-close {
  font-size: 28rpx;
  color: #8f959e;
  padding: 8rpx;
}

.picker-search {
  padding: 16rpx 32rpx;
}

.picker-search-input {
  height: 72rpx;
  background-color: #f2f3f5;
  border-radius: 12rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}

.picker-list {
  flex: 1;
  max-height: 60vh;
}

.picker-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f5f6f7;
}

.picker-item:active {
  background-color: #f7f8fa;
}

.picker-item-name {
  font-size: 30rpx;
  color: #1f2329;
}

.picker-item-type {
  font-size: 24rpx;
  color: #8f959e;
  background-color: #f0f1f2;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.picker-empty {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
  color: #b0b5bb;
  font-size: 28rpx;
}

/* 操作按钮 */
.actions {
  display: flex;
  gap: 32rpx;
  margin-top: 48rpx;
  padding: 0 28rpx 20rpx;
}

.submit-btn {
  flex: 1;
  font-size: 32rpx;
  padding: 0 8rpx !important;
}

.btn-secondary {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  color: #1f2329;
  background-color: #fff;
  border-radius: 12rpx;
  border: 1rpx solid #dee0e3;
  padding: 0 8rpx !important;
  display: flex;
  align-items: center;
  justify-content: center;
}
