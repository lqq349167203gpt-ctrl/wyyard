.container {
  padding: 24rpx 32rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
}

.form-value {
  flex: 1;
  font-size: 28rpx;
  color: #1f2329;
  text-align: right;
}

.value-wrap {
  flex: 1;
  display: flex;
  justify-content: flex-end;
}

.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.actions {
  margin-top: 48rpx;
}

.btn-danger {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  color: #fff;
  background-color: #e34d59;
  border-radius: 12rpx;
  border: none;
}

.btn-danger[disabled] {
  opacity: 0.5;
}
