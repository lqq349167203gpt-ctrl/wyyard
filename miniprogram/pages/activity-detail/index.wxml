<view class="container" wx:if="{{record}}">
  <!-- 基本信息 -->
  <view class="form-card">
    <view class="form-card-title">基本信息</view>
    <view class="form-item">
      <text class="form-label">类型</text>
      <view class="badge" style="background-color: {{record.color}}20; color: {{record.color}};">{{record.badge}}</view>
      <text class="form-value" wx:if="{{record.name}}" style="margin-left: 12rpx;">{{record.name}}</text>
    </view>
    <view class="form-item">
      <text class="form-label">时间</text>
      <text class="form-value">{{record.time || '-'}}</text>
    </view>
    <view class="form-item">
      <text class="form-label">老师</text>
      <text class="form-value">{{record.teacher || '-'}}</text>
    </view>
    <view class="form-item">
      <text class="form-label">参与人数</text>
      <text class="form-value">{{record.participants || 0}}人</text>
    </view>
    <view class="form-item last">
      <text class="form-label">空间</text>
      <text class="form-value">{{record.space || '-'}}</text>
    </view>
  </view>
</view>

<view class="empty-state" wx:if="{{!record}}">
  <text class="empty-text">未找到活动信息</text>
</view>
