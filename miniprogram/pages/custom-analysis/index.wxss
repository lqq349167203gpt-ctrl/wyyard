.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f8fa;
  padding: 20rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  color: #1f2329;
}

.loading,
.empty {
  padding: 120rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #8f959e;
}

.header-card,
.section-card,
.result-area {
  margin-bottom: 16rpx;
  border: 1rpx solid #eef0f2;
  border-radius: 12rpx;
  background: #fff;
}

.header-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx;
}

.header-copy {
  min-width: 0;
  flex: 1;
}

.header-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 10rpx;
}

.page-title {
  display: block;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1.25;
  color: #1f2329;
}

.page-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #8f959e;
}

.save-button,
.reset-button,
.query-button,
.page-button,
.save-dialog-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0;
  border-radius: 8rpx;
  font-weight: 400;
  line-height: normal;
}

.save-button {
  width: auto;
  min-width: 128rpx;
  flex-shrink: 0;
  height: 58rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dee0e3;
  background: #fff;
  font-size: 23rpx;
  color: #4e535a;
}

.save-button[disabled] {
  border-color: #ebecee;
  background: #fafbfc;
  color: #b7bdc6;
}

.save-button::after,
.reset-button::after,
.query-button::after,
.page-button::after,
.save-dialog-button::after {
  border: none;
}

.save-template-mask {
  position: fixed;
  z-index: 300;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  background: rgba(31, 35, 41, 0.36);
}

.save-template-dialog {
  width: 100%;
  max-width: 660rpx;
  overflow: hidden;
  border: 1rpx solid #e8eaed;
  border-radius: 12rpx;
  background: #fff;
}

.save-template-head {
  padding: 24rpx 28rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.save-template-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2329;
}

.save-template-body {
  padding: 28rpx;
}

.save-form-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.save-form-row:last-child {
  margin-bottom: 0;
}

.save-form-label {
  width: 112rpx;
  flex-shrink: 0;
  text-align: right;
  font-size: 24rpx;
  color: #4e535a;
}

.save-form-input {
  min-width: 0;
  height: 64rpx;
  flex: 1;
  box-sizing: border-box;
  padding: 0 18rpx;
  border: 1rpx solid #dee0e3;
  border-radius: 8rpx;
  background: #fff;
  font-size: 24rpx;
  color: #2b2f36;
}

.save-form-placeholder {
  color: #b7bdc6;
}

.save-scope-options {
  display: flex;
  min-width: 0;
  height: 64rpx;
  flex: 1;
  box-sizing: border-box;
  padding: 4rpx;
  border: 1rpx solid #dee0e3;
  border-radius: 8rpx;
  background: #f7f8fa;
}

.save-scope-item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  flex: 1;
  border-radius: 6rpx;
  font-size: 23rpx;
  color: #646a73;
}

.save-scope-item.active {
  background: #fff;
  color: #3370ff;
}

.save-template-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 20rpx 28rpx;
  border-top: 1rpx solid #f0f0f0;
}

.save-dialog-button {
  width: auto;
  height: 64rpx;
  margin: 0;
  padding: 0 30rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 400;
  line-height: normal;
}

.save-dialog-button.cancel {
  border: 1rpx solid #dee0e3;
  background: #fff;
  color: #646a73;
}

.save-dialog-button.confirm {
  border: 1rpx solid #3370ff;
  background: #3370ff;
  color: #fff;
}

.section-card {
  padding: 24rpx 28rpx;
}

.template-row,
.dimension-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-label,
.dimension-label {
  font-size: 25rpx;
  line-height: 1.3;
  color: #646a73;
}

.row-picker,
.dimension-picker {
  width: 390rpx;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 60rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border: 1rpx solid #dee0e3;
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 1.25;
  color: #2b2f36;
}

.placeholder {
  color: #b0b5bb !important;
}

.section-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.section-index {
  font-size: 21rpx;
  line-height: 1.25;
  color: #3370ff;
}

.section-title {
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.25;
  color: #2b2f36;
}

.period-panel {
  margin-bottom: 20rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  background: #f7f8fa;
}

.period-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.period-copy {
  min-width: 0;
  flex: 1;
}

.period-title,
.period-subtitle {
  display: block;
}

.period-title {
  font-size: 24rpx;
  font-weight: 500;
  color: #4e535a;
}

.period-subtitle {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.35;
  color: #8f959e;
}

.period-picker {
  width: 246rpx;
  flex-shrink: 0;
}

.period-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 56rpx;
  box-sizing: border-box;
  padding: 0 14rpx;
  border: 1rpx solid #dee0e3;
  border-radius: 8rpx;
  background: #fff;
  font-size: 23rpx;
  color: #2b2f36;
}

.logic-switch,
.preset-group {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.logic-switch {
  height: 54rpx;
  box-sizing: border-box;
  padding: 4rpx;
  border: 1rpx solid #e1e4e7;
  border-radius: 8rpx;
}

.logic-item,
.preset {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 44rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  line-height: normal;
  color: #646a73;
}

.logic-item.active {
  background: #f0f5ff;
  color: #3370ff;
}

.preset {
  border: 1rpx solid #e1e4e7;
  background: #fff;
}

/* 选中样式与「信息核对」页的时间快捷项一致 */
.preset.active {
  border-color: #d5d9de;
  background: #f5f6f7;
  color: #1f2329;
  font-weight: 500;
}

.preset-group {
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.date-range,
.condition-value-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.date-range {
  margin-top: 12rpx;
}

.date-picker {
  flex: 1;
}

.date-value,
.condition-input {
  height: 60rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border: 1rpx solid #dee0e3;
  border-radius: 8rpx;
  background: #fff;
  font-size: 24rpx;
  color: #2b2f36;
}

.date-value {
  display: flex;
  align-items: center;
  line-height: normal;
}

.condition-input {
  line-height: 60rpx;
}

.date-separator {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: #8f959e;
}

.condition-empty {
  padding: 22rpx;
  border: 1rpx dashed #dfe3e8;
  border-radius: 8rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.45;
  color: #8f959e;
}

.condition-heading {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.condition-title {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 400;
  color: #8f959e;
}

.add-condition-inline {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 94rpx;
  height: 48rpx;
  flex-shrink: 0;
  border-radius: 6rpx;
  font-size: 22rpx;
  color: #3370ff;
}

.condition-hint {
  display: block;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #8f959e;
}

/* 每行 = 卡片 + 卡外的删除按钮 */
.condition-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.condition-row .condition-card {
  flex: 1;
  min-width: 0;
  margin-top: 0;
}

.condition-card {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  padding: 16rpx;
  padding-right: 64rpx;
  border: 1rpx solid #eef0f2;
  border-radius: 12rpx;
  background: #fff;
  overflow: hidden;
}

.condition-picker {
  flex: 0 0 190rpx;
  width: 190rpx;
  min-width: 0;
  max-width: 190rpx;
}

.condition-picker.operator {
  flex: 0 0 140rpx;
  width: 140rpx;
  max-width: 140rpx;
}

.condition-choice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 56rpx;
  box-sizing: border-box;
  padding: 0 4rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.25;
  color: #1f2329;
}

.condition-choice.secondary {
  font-size: 24rpx;
  font-weight: 400;
  color: #8f959e;
}

.condition-choice-label {
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 下拉箭头：用 SVG 图标（base64）代替字符/CSS 边框，各机型大小与位置完全一致 */
.picker-chevron {
  flex-shrink: 0;
  width: 18rpx;
  height: 18rpx;
  margin-left: 8rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
  background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0naHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmcnIHZpZXdCb3g9JzAgMCAyNCAyNCcgZmlsbD0nbm9uZScgc3Ryb2tlPScjOGY5NTllJyBzdHJva2Utd2lkdGg9JzIuNicgc3Ryb2tlLWxpbmVjYXA9J3JvdW5kJyBzdHJva2UtbGluZWpvaW49J3JvdW5kJz48cGF0aCBkPSdNNiA5bDYgNiA2LTYnLz48L3N2Zz4=");
}

.picker-chevron.light {
  background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0naHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmcnIHZpZXdCb3g9JzAgMCAyNCAyNCcgZmlsbD0nbm9uZScgc3Ryb2tlPScjYjBiNWJiJyBzdHJva2Utd2lkdGg9JzIuNicgc3Ryb2tlLWxpbmVjYXA9J3JvdW5kJyBzdHJva2UtbGluZWpvaW49J3JvdW5kJz48cGF0aCBkPSdNNiA5bDYgNiA2LTYnLz48L3N2Zz4=");
}

/* 取值下拉（文本 + 箭头）用同一套排布，避免箭头掉到下一行 */
.condition-input-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  overflow: hidden;
  line-height: 1.25;
}

/* 取值过长时省略，避免把这一行顶破、盖住左边的规则框 */
.condition-value-text {
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.condition-remove {
  position: absolute;
  top: 50%;
  right: 12rpx;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  height: 44rpx;
  width: 44rpx;
}

.remove-line {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 24rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: #b0b5bb;
}

.remove-line-a {
  transform: translate(-50%, -50%) rotate(45deg);
}

.remove-line-b {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.condition-value-row {
  flex: 1 1 0;
  min-width: 0;
  overflow: hidden;
}

/* 两个日期/两个数字、或带"跟随周期"的条件放不下一行，整行换下去 */
.condition-value-row.wide {
  flex: 1 1 100%;
  padding-top: 8rpx;
  border-top: 1rpx solid #f2f3f5;
}

/* 条件卡片里的取值统一用浅灰填充、不加边框，字号与字段一致 */
.condition-card .condition-input {
  border-color: transparent;
  background: #f5f6f7;
  font-size: 24rpx;
}

.condition-input,
.value-picker {
  flex: 1;
  min-width: 0;
}

.condition-input.half {
  width: 0;
}

.condition-date-picker {
  min-width: 180rpx;
  flex: 1;
}

.condition-date-picker.single {
  min-width: 260rpx;
}

.condition-date-picker .condition-input.half {
  width: auto;
}

.condition-follow-action,
.condition-text-action {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 54rpx;
  flex-shrink: 0;
  padding: 0 10rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  line-height: normal;
  color: #3370ff;
}

.condition-follow-action {
  background: #f0f5ff;
}

.inherited-period {
  flex-wrap: nowrap;
}

.inherited-period-value {
  display: flex;
  align-items: center;
  min-width: 0;
  height: 58rpx;
  flex: 1;
  box-sizing: border-box;
  overflow: hidden;
  padding: 0 14rpx;
  border: 1rpx solid #b9cdf8;
  border-radius: 8rpx;
  background: #f7faff;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
  color: #3370ff;
}

.chip-list,
.selected-columns {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.metric-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 56rpx;
  box-sizing: border-box;
  padding: 0 16rpx;
  border: 1rpx solid #e5e7ea;
  border-radius: 8rpx;
  font-size: 23rpx;
  line-height: 1.25;
  color: #646a73;
}

.metric-chip.selected {
  border-color: #b9cdf8;
  background: #f7faff;
  color: #2b2f36;
}

.chip-check,
.sheet-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24rpx;
  height: 24rpx;
  box-sizing: border-box;
  flex: 0 0 24rpx;
  border: 1rpx solid #c9cdd4;
  border-radius: 4rpx;
  font-size: 17rpx;
  line-height: 1;
  color: #fff;
}

.metric-chip.selected .chip-check,
.sheet-check.selected {
  border-color: #3370ff;
  background: #3370ff;
}

.dimension-row {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.dimension-row-secondary {
  margin-top: 12rpx;
  padding-top: 0;
  border-top: 0;
}

.columns-head {
  justify-content: space-between;
}

.columns-head > view:first-child {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.text-action {
  font-size: 24rpx;
  line-height: 1.25;
  color: #3370ff;
}

.column-tag {
  display: flex;
  align-items: center;
  min-height: 46rpx;
  box-sizing: border-box;
  padding: 9rpx 14rpx;
  border: 1rpx solid #e5e7ea;
  border-radius: 6rpx;
  background: #fafbfc;
  font-size: 22rpx;
  line-height: 1.25;
  color: #4e535a;
}

.display-mode-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f0f0f0;
}

.display-mode-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
}

.display-mode-label {
  font-size: 24rpx;
  color: #646a73;
}

.display-mode-hint {
  font-size: 21rpx;
  color: #8f959e;
}

.display-mode-picker {
  width: 330rpx;
  flex: 0 0 330rpx;
}

.query-bar {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  margin: 18rpx 0 12rpx;
}

.reset-button,
.query-button {
  height: 68rpx;
  padding: 0 32rpx;
  font-size: 25rpx;
}

.reset-button {
  border: 1rpx solid #dee0e3;
  background: #fff;
  color: #646a73;
}

.query-button {
  min-width: 176rpx;
  background: #3370ff;
  color: #fff;
}

.result-area {
  padding: 26rpx 28rpx;
}

.result-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.result-heading-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.result-export-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  flex-shrink: 0;
  height: 44rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0 16rpx;
  border: 1rpx solid #dee0e3;
  border-radius: 8rpx;
  background: #fff;
  color: #646a73;
  font-size: 22rpx;
  font-weight: 400;
  line-height: normal;
}

.result-export-button.disabled {
  color: #b7bdc6;
  opacity: 0.7;
}

.content-toggle-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  flex-shrink: 0;
  height: 44rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0 16rpx;
  border: 1rpx solid #dee0e3;
  border-radius: 8rpx;
  background: #fff;
  color: #646a73;
  font-size: 22rpx;
  font-weight: 400;
  line-height: normal;
}


.result-title {
  font-size: 28rpx;
  font-weight: 500;
}

.result-total,
.dimension-title {
  font-size: 23rpx;
  color: #8f959e;
}

.cards-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.result-card {
  min-width: 0;
  padding: 18rpx;
  border: 1rpx solid #eceef0;
  background: #fff;
}

.result-card.total {
  border-color: #cfdcf5;
}

.result-card.empty-card {
  background: #fafbfc;
}

.card-title {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
  color: #8f959e;
}

.card-number {
  display: inline-block;
  margin-top: 9rpx;
  font-size: 32rpx;
  font-weight: 400;
  color: #1f2329;
}

.card-unit {
  margin-left: 7rpx;
  font-size: 22rpx;
  color: #8f959e;
}

.dimension-block {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.dimension-title {
  display: block;
  margin-bottom: 12rpx;
  color: #4e535a;
}

.customer-list {
  margin-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.customer-list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  margin-bottom: 10rpx;
}

.customer-list-title {
  font-size: 24rpx;
  font-weight: 500;
  color: #4e535a;
}

.customer-row {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.customer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.customer-name {
  font-size: 27rpx;
  font-weight: 500;
  color: #2b2f36;
}

.customer-arrow {
  font-size: 30rpx;
  color: #c0c4cc;
}

.customer-fields {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx 24rpx;
  margin-top: 14rpx;
}

.customer-field {
  display: flex;
  min-width: 0;
  gap: 10rpx;
}

.field-label,
.field-value {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
}

.field-label {
  flex-shrink: 0;
  color: #8f959e;
}

.field-value {
  color: #4e535a;
}

/* 空值用短横线占位，比「—」更短 */
.field-empty-line {
  align-self: center;
  width: 12rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background-color: #e5e8eb;
}

.customer-row.expanded .customer-fields {
  grid-template-columns: minmax(0, 1fr);
  gap: 12rpx;
}

.customer-row.expanded .customer-field {
  align-items: flex-start;
}

.customer-row.expanded .field-value {
  overflow: visible;
  text-overflow: clip;
  white-space: pre-wrap;
  word-break: break-all;
}

.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding-top: 24rpx;
}

.page-button {
  height: 58rpx;
  padding: 0 22rpx;
  border: 1rpx solid #dee0e3;
  background: #fff;
  font-size: 22rpx;
  color: #4e535a;
}

.page-button.disabled {
  color: #c9cdd4;
}

.page-info {
  font-size: 22rpx;
  color: #8f959e;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(31, 35, 41, 0.28);
}

.column-sheet {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 201;
  border-radius: 16rpx 16rpx 0 0;
  background: #fff;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.sheet-title {
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.25;
}

.sheet-done {
  font-size: 25rpx;
  line-height: 1.25;
  color: #3370ff;
}

.sheet-list {
  height: 64vh;
}

.sheet-group-title {
  padding: 22rpx 30rpx 8rpx;
  background: #f7f8fa;
  color: #8f959e;
  font-size: 21rpx;
  line-height: 1.3;
}

.sheet-item {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  margin: 0 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.sheet-item-name {
  flex: 1;
  font-size: 25rpx;
  line-height: 1.3;
  color: #2b2f36;
}

.sheet-item-note {
  margin-right: 18rpx;
  font-size: 21rpx;
  color: #8f959e;
}

/* 字段是单选：只在当前字段上显示一个对勾，不做成勾选框 */
.sheet-item-name.selected {
  color: #3370ff;
  font-weight: 500;
}

.sheet-field-check {
  margin-left: 16rpx;
  font-size: 26rpx;
  line-height: 1.25;
  color: #3370ff;
}

.mode-switch-card {
  display: flex;
  width: 320rpx;
  box-sizing: border-box;
  margin: 0 0 16rpx;
  padding: 5rpx;
  border: 1rpx solid #e5e7ea;
  border-radius: 9rpx;
  background: #f1f2f4;
}

.mode-item {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50%;
  height: 54rpx;
  border-radius: 6rpx;
  font-size: 23rpx;
  color: #646a73;
}

.mode-item.active {
  background: #fff;
  color: #3370ff;
  box-shadow: 0 2rpx 6rpx rgba(31, 35, 41, 0.06);
}

.comparison-section-head {
  justify-content: space-between;
}

.comparison-section-head > view:first-child {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.comparison-hint,
.shared-metric-hint,
.comparison-result-note {
  display: block;
  font-size: 21rpx;
  line-height: 1.5;
  color: #8f959e;
}

.comparison-hint {
  margin: -6rpx 0 18rpx;
}

.shared-metric-hint {
  margin-top: 18rpx;
}

.add-group,
.group-action {
  font-size: 22rpx;
  color: #3370ff;
}

.add-group {
  padding: 8rpx 10rpx;
}

.comparison-group {
  margin-top: 16rpx;
  padding: 20rpx;
  border: 1rpx solid #dfe5ef;
  border-radius: 10rpx;
  background: #fbfcfe;
}

.comparison-group-head,
.comparison-summary-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.group-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #eaf1ff;
  font-size: 20rpx;
  color: #3370ff;
}

.group-name {
  min-width: 0;
  height: 52rpx;
  flex: 1;
  padding: 0 12rpx;
  border-bottom: 1rpx solid #d9dde3;
  font-size: 25rpx;
  font-weight: 500;
  color: #2b2f36;
}

.group-action {
  flex-shrink: 0;
  padding: 8rpx 4rpx;
  color: #646a73;
}

.group-action.danger {
  color: #d85b65;
}

.disabled {
  opacity: 0.35;
}

.group-period {
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: 8rpx;
  background: #f4f6f8;
}

.preset-group.compact {
  justify-content: flex-end;
}

.group-condition-heading {
  margin-top: 20rpx;
}

.compact-empty {
  padding: 24rpx 14rpx;
}

.group-condition-card {
  background: #fff;
}

.comparison-summary-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.comparison-summary {
  min-width: 0;
  padding: 18rpx;
  border: 1rpx solid #dfe5ef;
  border-radius: 8rpx;
  background: #fafbfc;
}

.comparison-summary-name {
  overflow: hidden;
  flex: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
  font-weight: 500;
  color: #2b2f36;
}

.comparison-summary-period,
.comparison-summary-total {
  display: block;
  margin-top: 10rpx;
  font-size: 21rpx;
  line-height: 1.4;
  color: #8f959e;
}

.comparison-summary-total {
  color: #4e535a;
}

.comparison-metric-list {
  margin-top: 20rpx;
  border-top: 1rpx solid #eef0f2;
}

.comparison-metric {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eef0f2;
}

.comparison-metric-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #2b2f36;
}

.comparison-value-row,
.comparison-difference {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.comparison-value-row {
  min-height: 46rpx;
  font-size: 23rpx;
}

.comparison-value-name {
  color: #646a73;
}

.comparison-value-number {
  font-weight: 500;
  color: #212631;
}

.comparison-difference {
  margin-top: 10rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #e5e7ea;
  font-size: 21rpx;
  color: #646a73;
}

.comparison-difference.positive {
  color: #16875d;
}

.comparison-difference.negative {
  color: #d85b65;
}

.comparison-result-note {
  margin-top: 18rpx;
}
