<view class="page">
  <view class="loading" wx:if="{{loading}}">正在加载筛选项...</view>

  <block wx:else>
    <view class="header-card">
      <view class="header-copy">
        <text class="page-title">自定义筛选</text>
        <text class="page-subtitle">按自己的条件找出客户，查看邀约、到店和成交情况</text>
      </view>
      <button class="save-button" bindtap="onSaveTemplate">保存模板</button>
    </view>

    <view class="section-card template-row">
      <text class="row-label">筛选模板</text>
      <picker class="row-picker" mode="selector" range="{{templateOptions}}" range-key="name" value="{{templateIndex}}" bindchange="onTemplateChange">
        <view class="picker-value {{templateIndex === 0 ? 'placeholder' : ''}}">{{templateOptions[templateIndex].name}}<text class="picker-arrow">⌄</text></view>
      </picker>
    </view>

    <view class="mode-switch-card">
      <view class="mode-item {{plan.analysis_mode === 'single' ? 'active' : ''}}" data-value="single" bindtap="onAnalysisModeTap">单组筛选</view>
      <view class="mode-item {{plan.analysis_mode === 'comparison' ? 'active' : ''}}" data-value="comparison" bindtap="onAnalysisModeTap">方案对比</view>
    </view>

    <view class="section-card" wx:if="{{plan.analysis_mode === 'single'}}">
      <view class="section-head">
        <text class="section-index">01</text>
        <text class="section-title">筛选客户</text>
      </view>

      <view class="period-panel">
        <view class="period-head">
          <view class="period-copy">
            <text class="period-title">统计周期</text>
            <text class="period-subtitle">限定期间邀约、到场、活动和成交指标</text>
          </view>
          <picker class="period-picker" mode="multiSelector" range="{{periodRange}}" value="{{periodValue}}" bindchange="onPeriodChange">
            <view class="period-value">{{periodLabel}}<text class="picker-arrow">⌄</text></view>
          </picker>
        </view>
        <view class="preset-group">
          <view class="preset" data-value="today" bindtap="onDatePreset">当天</view>
          <view class="preset" data-value="week" bindtap="onDatePreset">本周</view>
          <view class="preset" data-value="month" bindtap="onDatePreset">本月</view>
          <view class="preset" data-value="year" bindtap="onDatePreset">本年</view>
          <view class="preset" data-value="all" bindtap="onDatePreset">全部</view>
        </view>
        <view class="date-range">
          <picker class="date-picker" mode="date" value="{{plan.date_from}}" bindchange="onDateFromChange">
            <view class="date-value {{plan.date_from ? '' : 'placeholder'}}">{{plan.date_from || '开始日期'}}</view>
          </picker>
          <text class="date-separator">至</text>
          <picker class="date-picker" mode="date" value="{{plan.date_to}}" bindchange="onDateToChange">
            <view class="date-value {{plan.date_to ? '' : 'placeholder'}}">{{plan.date_to || '结束日期'}}</view>
          </picker>
        </view>
      </view>

      <view class="condition-heading">
        <text class="condition-title">客户筛选条件</text>
        <view class="logic-switch">
          <view class="logic-item {{plan.condition_logic === 'all' ? 'active' : ''}}" data-value="all" bindtap="onLogicTap">全部符合</view>
          <view class="logic-item {{plan.condition_logic === 'any' ? 'active' : ''}}" data-value="any" bindtap="onLogicTap">任意一条</view>
        </view>
        <view class="add-condition-inline" bindtap="onAddCondition">＋ 条件</view>
      </view>
      <text class="condition-hint">付费条件会同步限定成交金额、单数和人数</text>
      <view class="condition-empty" wx:if="{{conditionRows.length === 0}}" bindtap="onAddCondition">当前查询全部客户，点击添加筛选条件</view>
      <view class="condition-card" wx:for="{{conditionRows}}" wx:key="index">
        <view class="condition-top">
          <picker class="condition-picker" mode="selector" range="{{fieldOptions}}" range-key="label" value="{{item.fieldIndex}}" data-index="{{index}}" bindchange="onConditionFieldChange">
            <view class="condition-choice">{{item.fieldLabel}}<text class="picker-arrow">⌄</text></view>
          </picker>
          <picker class="condition-picker operator" mode="selector" range="{{item.operatorOptions}}" range-key="label" value="{{item.operatorIndex}}" data-index="{{index}}" bindchange="onConditionOperatorChange">
            <view class="condition-choice secondary">{{item.operatorLabel}}<text class="picker-arrow">⌄</text></view>
          </picker>
          <view class="condition-remove" data-index="{{index}}" bindtap="onRemoveCondition">×</view>
        </view>
        <view class="condition-value-row inherited-period" wx:if="{{item.inheritPeriod}}">
          <text class="inherited-period-value">跟随统计周期 · {{item.periodSummary}}</text>
          <view class="condition-text-action" data-index="{{index}}" bindtap="onConditionUseOwnDate">单独设置</view>
        </view>
        <view class="condition-value-row" wx:elif="{{!item.noValue}}">
          <block wx:if="{{item.between && item.isDate}}">
            <picker class="condition-date-picker" mode="date" value="{{item.valueStart}}" data-index="{{index}}" data-part="start" bindchange="onConditionValueInput">
              <view class="condition-input half {{item.valueStart ? '' : 'placeholder'}}">{{item.valueStart || '开始日期'}}</view>
            </picker>
            <text class="date-separator">至</text>
            <picker class="condition-date-picker" mode="date" value="{{item.valueEnd}}" data-index="{{index}}" data-part="end" bindchange="onConditionValueInput">
              <view class="condition-input half {{item.valueEnd ? '' : 'placeholder'}}">{{item.valueEnd || '结束日期'}}</view>
            </picker>
            <view class="condition-follow-action" data-index="{{index}}" bindtap="onConditionInheritPeriod">跟随周期</view>
          </block>
          <block wx:elif="{{item.between}}">
            <input class="condition-input half" value="{{item.valueStart}}" placeholder="起始值" data-index="{{index}}" data-part="start" bindinput="onConditionValueInput" />
            <text class="date-separator">至</text>
            <input class="condition-input half" value="{{item.valueEnd}}" placeholder="结束值" data-index="{{index}}" data-part="end" bindinput="onConditionValueInput" />
          </block>
          <block wx:elif="{{item.isDate}}">
            <picker class="condition-date-picker single" mode="date" value="{{item.value}}" data-index="{{index}}" bindchange="onConditionValueInput">
              <view class="condition-input {{item.value ? '' : 'placeholder'}}">{{item.value || '选择日期'}}</view>
            </picker>
            <view class="condition-follow-action" data-index="{{index}}" bindtap="onConditionInheritPeriod">跟随周期</view>
          </block>
          <picker wx:elif="{{item.useOptions}}" class="value-picker" mode="selector" range="{{item.valueOptions}}" range-key="label" value="{{item.valueIndex}}" data-index="{{index}}" bindchange="onConditionOptionChange">
            <view class="condition-input {{item.value ? '' : 'placeholder'}}">{{item.value || '选择筛选值'}}<text class="picker-arrow">⌄</text></view>
          </picker>
          <input wx:else class="condition-input" value="{{item.value}}" placeholder="{{item.placeholder}}" data-index="{{index}}" bindinput="onConditionValueInput" />
        </view>
      </view>
    </view>

    <view class="section-card comparison-section" wx:else>
      <view class="section-head comparison-section-head">
        <view><text class="section-index">01</text><text class="section-title">对比条件</text></view>
        <view class="add-group {{comparisonGroupRows.length >= 4 ? 'disabled' : ''}}" wx:if="{{comparisonGroupRows.length < 4}}" bindtap="onAddComparisonGroup">＋ 对比组</view>
      </view>
      <text class="comparison-hint">每组可设置不同日期和任意筛选条件，统计指标在各组之间共用。</text>

      <view class="comparison-group" wx:for="{{comparisonGroupRows}}" wx:key="id" wx:for-item="group" wx:for-index="groupIndex">
        <view class="comparison-group-head">
          <text class="group-badge">{{group.badge}}</text>
          <input class="group-name" value="{{group.name}}" maxlength="24" data-group-index="{{groupIndex}}" bindinput="onComparisonNameInput" />
          <view class="group-action {{comparisonGroupRows.length >= 4 ? 'disabled' : ''}}" data-group-index="{{groupIndex}}" bindtap="onCopyComparisonGroup">复制</view>
          <view class="group-action danger {{comparisonGroupRows.length <= 2 ? 'disabled' : ''}}" data-group-index="{{groupIndex}}" bindtap="onRemoveComparisonGroup">删除</view>
        </view>

        <view class="group-period">
          <view class="period-head">
            <view class="period-copy"><text class="period-title">统计周期</text><text class="period-subtitle">{{group.periodSummary}}</text></view>
            <picker class="period-picker" mode="multiSelector" range="{{periodRange}}" value="{{group.periodValue}}" data-group-index="{{groupIndex}}" bindchange="onComparisonPeriodChange">
              <view class="period-value">{{group.periodLabel}}<text class="picker-arrow">⌄</text></view>
            </picker>
          </view>
          <view class="preset-group compact">
            <view class="preset" data-group-index="{{groupIndex}}" data-value="month" bindtap="onComparisonDatePreset">本月</view>
            <view class="preset" data-group-index="{{groupIndex}}" data-value="year" bindtap="onComparisonDatePreset">本年</view>
            <view class="preset" data-group-index="{{groupIndex}}" data-value="all" bindtap="onComparisonDatePreset">全部</view>
          </view>
          <view class="date-range">
            <picker class="date-picker" mode="date" value="{{group.date_from}}" data-group-index="{{groupIndex}}" data-part="from" bindchange="onComparisonDateChange">
              <view class="date-value {{group.date_from ? '' : 'placeholder'}}">{{group.date_from || '开始日期'}}</view>
            </picker>
            <text class="date-separator">至</text>
            <picker class="date-picker" mode="date" value="{{group.date_to}}" data-group-index="{{groupIndex}}" data-part="to" bindchange="onComparisonDateChange">
              <view class="date-value {{group.date_to ? '' : 'placeholder'}}">{{group.date_to || '结束日期'}}</view>
            </picker>
          </view>
        </view>

        <view class="condition-heading group-condition-heading">
          <text class="condition-title">筛选条件</text>
          <view class="logic-switch">
            <view class="logic-item {{group.condition_logic === 'all' ? 'active' : ''}}" data-group-index="{{groupIndex}}" data-value="all" bindtap="onComparisonLogicTap">全部符合</view>
            <view class="logic-item {{group.condition_logic === 'any' ? 'active' : ''}}" data-group-index="{{groupIndex}}" data-value="any" bindtap="onComparisonLogicTap">任意一条</view>
          </view>
          <view class="add-condition-inline" data-group-index="{{groupIndex}}" bindtap="onComparisonAddCondition">＋ 条件</view>
        </view>
        <view class="condition-empty compact-empty" wx:if="{{group.conditionRows.length === 0}}" data-group-index="{{groupIndex}}" bindtap="onComparisonAddCondition">暂不限定客户条件，点击添加</view>

        <view class="condition-card group-condition-card" wx:for="{{group.conditionRows}}" wx:key="index" wx:for-item="condition" wx:for-index="conditionIndex">
          <view class="condition-top">
            <picker class="condition-picker" mode="selector" range="{{fieldOptions}}" range-key="label" value="{{condition.fieldIndex}}" data-group-index="{{groupIndex}}" data-index="{{conditionIndex}}" bindchange="onConditionFieldChange">
              <view class="condition-choice">{{condition.fieldLabel}}<text class="picker-arrow">⌄</text></view>
            </picker>
            <picker class="condition-picker operator" mode="selector" range="{{condition.operatorOptions}}" range-key="label" value="{{condition.operatorIndex}}" data-group-index="{{groupIndex}}" data-index="{{conditionIndex}}" bindchange="onConditionOperatorChange">
              <view class="condition-choice secondary">{{condition.operatorLabel}}<text class="picker-arrow">⌄</text></view>
            </picker>
            <view class="condition-remove" data-group-index="{{groupIndex}}" data-index="{{conditionIndex}}" bindtap="onRemoveCondition">×</view>
          </view>
          <view class="condition-value-row inherited-period" wx:if="{{condition.inheritPeriod}}">
            <text class="inherited-period-value">跟随本组周期 · {{condition.periodSummary}}</text>
            <view class="condition-text-action" data-group-index="{{groupIndex}}" data-index="{{conditionIndex}}" bindtap="onConditionUseOwnDate">单独设置</view>
          </view>
          <view class="condition-value-row" wx:elif="{{!condition.noValue}}">
            <block wx:if="{{condition.between && condition.isDate}}">
              <picker class="condition-date-picker" mode="date" value="{{condition.valueStart}}" data-group-index="{{groupIndex}}" data-index="{{conditionIndex}}" data-part="start" bindchange="onConditionValueInput"><view class="condition-input half {{condition.valueStart ? '' : 'placeholder'}}">{{condition.valueStart || '开始日期'}}</view></picker>
              <text class="date-separator">至</text>
              <picker class="condition-date-picker" mode="date" value="{{condition.valueEnd}}" data-group-index="{{groupIndex}}" data-index="{{conditionIndex}}" data-part="end" bindchange="onConditionValueInput"><view class="condition-input half {{condition.valueEnd ? '' : 'placeholder'}}">{{condition.valueEnd || '结束日期'}}</view></picker>
              <view class="condition-follow-action" data-group-index="{{groupIndex}}" data-index="{{conditionIndex}}" bindtap="onConditionInheritPeriod">跟随周期</view>
            </block>
            <block wx:elif="{{condition.between}}">
              <input class="condition-input half" value="{{condition.valueStart}}" placeholder="起始值" data-group-index="{{groupIndex}}" data-index="{{conditionIndex}}" data-part="start" bindinput="onConditionValueInput" />
              <text class="date-separator">至</text>
              <input class="condition-input half" value="{{condition.valueEnd}}" placeholder="结束值" data-group-index="{{groupIndex}}" data-index="{{conditionIndex}}" data-part="end" bindinput="onConditionValueInput" />
            </block>
            <block wx:elif="{{condition.isDate}}">
              <picker class="condition-date-picker single" mode="date" value="{{condition.value}}" data-group-index="{{groupIndex}}" data-index="{{conditionIndex}}" bindchange="onConditionValueInput"><view class="condition-input {{condition.value ? '' : 'placeholder'}}">{{condition.value || '选择日期'}}</view></picker>
              <view class="condition-follow-action" data-group-index="{{groupIndex}}" data-index="{{conditionIndex}}" bindtap="onConditionInheritPeriod">跟随周期</view>
            </block>
            <picker wx:elif="{{condition.useOptions}}" class="value-picker" mode="selector" range="{{condition.valueOptions}}" range-key="label" value="{{condition.valueIndex}}" data-group-index="{{groupIndex}}" data-index="{{conditionIndex}}" bindchange="onConditionOptionChange">
              <view class="condition-input {{condition.value ? '' : 'placeholder'}}">{{condition.value || '选择筛选值'}}<text class="picker-arrow">⌄</text></view>
            </picker>
            <input wx:else class="condition-input" value="{{condition.value}}" placeholder="{{condition.placeholder}}" data-group-index="{{groupIndex}}" data-index="{{conditionIndex}}" bindinput="onConditionValueInput" />
          </view>
        </view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-head">
        <text class="section-index">02</text>
        <text class="section-title">统计指标</text>
      </view>
      <view class="chip-list">
        <view class="metric-chip {{item.selected ? 'selected' : ''}}" wx:for="{{metricOptions}}" wx:key="value" data-value="{{item.value}}" bindtap="onMetricTap">
          <view class="chip-check">{{item.selected ? '✓' : ''}}</view>
          <text>{{item.label}}</text>
        </view>
      </view>
      <view class="dimension-row" wx:if="{{plan.analysis_mode === 'single'}}">
        <text class="dimension-label">拆分指标</text>
        <picker class="dimension-picker" mode="selector" range="{{dimensionMetricOptions}}" range-key="label" value="{{dimensionMetricIndex}}" bindchange="onDimensionMetricChange">
          <view class="picker-value">{{dimensionMetricOptions[dimensionMetricIndex].label}}<text class="picker-arrow">⌄</text></view>
        </picker>
      </view>
      <view class="dimension-row dimension-row-secondary" wx:if="{{plan.analysis_mode === 'single'}}">
        <text class="dimension-label">拆分维度</text>
        <picker class="dimension-picker" mode="selector" range="{{dimensionOptions}}" range-key="label" value="{{dimensionIndex}}" bindchange="onDimensionChange">
          <view class="picker-value">{{dimensionOptions[dimensionIndex].label}}<text class="picker-arrow">⌄</text></view>
        </picker>
      </view>
      <text class="shared-metric-hint" wx:if="{{plan.analysis_mode === 'comparison'}}">以上指标会同时用于所有对比组。</text>
    </view>

    <view class="section-card" wx:if="{{plan.analysis_mode === 'single'}}">
      <view class="section-head columns-head">
        <view><text class="section-index">03</text><text class="section-title">显示内容</text></view>
        <view class="text-action" bindtap="onOpenColumns">设置</view>
      </view>
      <view class="selected-columns">
        <text class="column-tag" wx:for="{{selectedColumns}}" wx:key="value">{{item.label}}</text>
      </view>
    </view>

    <view class="query-bar">
      <button class="reset-button" bindtap="onReset">重置</button>
      <button class="query-button" loading="{{querying}}" disabled="{{querying}}" bindtap="onQuery">{{result ? '更新结果' : '查询'}}</button>
    </view>

    <view class="result-area comparison-result" wx:if="{{result && plan.analysis_mode === 'comparison'}}">
      <view class="result-heading"><text class="result-title">方案对比结果</text><text class="result-total">{{comparisonResultGroups.length}} 个对比组</text></view>
      <view class="comparison-summary-list">
        <view class="comparison-summary" wx:for="{{comparisonResultGroups}}" wx:key="id">
          <view class="comparison-summary-head"><text class="group-badge">{{item.badge}}</text><text class="comparison-summary-name">{{item.name}}</text></view>
          <text class="comparison-summary-period">{{item.periodSummary}}</text>
          <text class="comparison-summary-total">符合条件 {{item.total}} 人</text>
        </view>
      </view>
      <view class="comparison-metric-list">
        <view class="comparison-metric" wx:for="{{comparisonResultRows}}" wx:key="metric">
          <text class="comparison-metric-title">{{item.title}}</text>
          <view class="comparison-value-row" wx:for="{{item.valuesView}}" wx:for-item="valueItem" wx:key="name">
            <text class="comparison-value-name">{{valueItem.name}}</text><text class="comparison-value-number">{{valueItem.value}}</text>
          </view>
          <view class="comparison-difference {{item.differenceTone}}" wx:if="{{comparisonResultGroups.length === 2}}">
            <text>B − A：{{item.differenceView}}</text><text>差异率：{{item.differenceRateView}}</text>
          </view>
        </view>
      </view>
      <text class="comparison-result-note">人数类指标在每个组内去重；同一客户可能同时属于多个对比组。</text>
    </view>

    <view class="result-area" wx:elif="{{result}}">
      <view class="result-heading"><text class="result-title">筛选结果</text><text class="result-total">共 {{result.total}} 人</text></view>
      <view class="cards-grid">
        <view class="result-card {{item.is_total ? 'total' : ''}}" wx:for="{{metricCards}}" wx:key="key">
          <text class="card-title">{{item.title}}</text>
          <view><text class="card-number">{{item.format === 'currency' ? '¥' : ''}}{{item.count}}</text><text class="card-unit" wx:if="{{item.format !== 'currency'}}">{{item.unit}}</text></view>
        </view>
      </view>

      <view class="dimension-block" wx:if="{{dimensionCards.length}}">
        <text class="dimension-title">{{dimensionResultTitle}}</text>
        <view class="cards-grid">
          <view class="result-card {{item.title === '未配置' ? 'empty-card' : ''}}" wx:for="{{dimensionCards}}" wx:key="key">
            <text class="card-title">{{item.title}}</text>
            <view><text class="card-number">{{item.format === 'currency' ? '¥' : ''}}{{item.count}}</text><text class="card-unit" wx:if="{{item.format !== 'currency'}}">{{item.unit}}</text></view>
          </view>
        </view>
      </view>

      <view class="customer-list">
        <view class="customer-row" wx:for="{{resultItems}}" wx:key="id" data-id="{{item.id}}" bindtap="onCustomerTap">
          <view class="customer-head"><text class="customer-name">{{item.nickname}}</text><text class="customer-arrow">›</text></view>
          <view class="customer-fields">
            <view class="customer-field" wx:for="{{item.fields}}" wx:for-item="field" wx:key="label">
              <text class="field-label">{{field.label}}</text><text class="field-value">{{field.value}}</text>
            </view>
          </view>
        </view>
        <view class="empty" wx:if="{{resultItems.length === 0}}">暂无符合条件的客户</view>
      </view>

      <view class="pagination" wx:if="{{result.total_pages > 1}}">
        <button class="page-button {{result.page <= 1 ? 'disabled' : ''}}" disabled="{{result.page <= 1}}" bindtap="onPrevPage">上一页</button>
        <text class="page-info">{{result.page}} / {{result.total_pages}}</text>
        <button class="page-button {{result.page >= result.total_pages ? 'disabled' : ''}}" disabled="{{result.page >= result.total_pages}}" bindtap="onNextPage">下一页</button>
      </view>
    </view>
  </block>

  <view class="sheet-mask" wx:if="{{showColumnPicker}}" bindtap="onCloseColumns"></view>
  <view class="column-sheet" wx:if="{{showColumnPicker}}">
    <view class="sheet-head"><text class="sheet-title">选择显示内容</text><text class="sheet-done" bindtap="onCloseColumns">完成</text></view>
    <scroll-view class="sheet-list" scroll-y>
      <view class="sheet-item" wx:for="{{columnOptions}}" wx:key="value" data-value="{{item.value}}" bindtap="onColumnToggle">
        <text class="sheet-item-name">{{item.label}}</text>
        <text class="sheet-item-note" wx:if="{{item.locked}}">固定显示</text>
        <view class="sheet-check {{item.selected ? 'selected' : ''}}">{{item.selected ? '✓' : ''}}</view>
      </view>
    </scroll-view>
  </view>

  <view class="save-template-mask" wx:if="{{showSaveTemplate}}" bindtap="onSaveTemplateMaskTap">
    <view class="save-template-dialog" catchtap="stopPropagation">
      <view class="save-template-head">
        <text class="save-template-title">保存筛选模板</text>
      </view>
      <view class="save-template-body">
        <view class="save-form-row">
          <text class="save-form-label">模板名称</text>
          <input class="save-form-input" value="{{templateName}}" maxlength="30" placeholder="例如：本月引流转化" placeholder-class="save-form-placeholder" bindinput="onTemplateNameInput" />
        </view>
        <view class="save-form-row">
          <text class="save-form-label">模板简介</text>
          <input class="save-form-input" value="{{templateDescription}}" maxlength="200" placeholder="简要说明模板用途（选填）" placeholder-class="save-form-placeholder" bindinput="onTemplateDescriptionInput" />
        </view>
        <view class="save-form-row">
          <text class="save-form-label">可见范围</text>
          <view class="save-scope-options">
            <view class="save-scope-item {{templateScope === 'private' ? 'active' : ''}}" data-scope="private" bindtap="onTemplateScopeTap">仅自己可见</view>
            <view class="save-scope-item {{templateScope === 'shared' ? 'active' : ''}}" data-scope="shared" bindtap="onTemplateScopeTap">团队共享</view>
          </view>
        </view>
      </view>
      <view class="save-template-actions">
        <button class="save-dialog-button cancel" disabled="{{savingTemplate}}" bindtap="onCloseSaveTemplate">取消</button>
        <button class="save-dialog-button confirm" loading="{{savingTemplate}}" disabled="{{savingTemplate}}" bindtap="onConfirmSaveTemplate">保存</button>
      </view>
    </view>
  </view>
</view>
