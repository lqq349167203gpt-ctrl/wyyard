<view class="page">
  <!-- 无权限 -->
  <view class="no-permission" wx:if="{{!hasPagePermission}}">
    <text class="no-permission-text">无权限访问此页面</text>
  </view>
  <block wx:else>
  <!-- 头部：日期 + 空间 -->
  <view class="head">
    <view class="head-row">
      <view class="head-date" bindtap="onCalendarToggle">
        <text>{{currentDateShort}}</text>
        <text class="wk">{{currentWeekday}}</text>
        <text class="drop">{{calendarExpanded ? '▴' : '▾'}}</text>
      </view>
      <picker class="head-space" mode="selector" range="{{spaces}}" range-key="name" value="{{spaceIndex}}" bindchange="onSpaceChange">
        <text>{{currentSpaceName}} ▾</text>
      </picker>
    </view>
    <!-- 下拉日历 -->
    <view class="calendar-dropdown" wx:if="{{calendarExpanded}}">
      <view class="calendar-nav">
        <view class="nav-arrow" catchtap="onPrevMonth">‹</view>
        <text class="nav-title">{{calYear}}年{{calMonth + 1}}月</text>
        <view class="nav-arrow" catchtap="onNextMonth">›</view>
      </view>
      <view class="weekday-row">
        <text class="weekday-cell" wx:for="{{weekdays}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="day-grid">
        <view
          wx:for="{{calendarDays}}"
          wx:key="date"
          class="day-cell {{item.isCurrent ? '' : 'other'}} {{item.isSelected ? 'selected' : ''}} {{item.isToday ? 'today' : ''}}"
          bindtap="onCalendarDayTap"
          data-date="{{item.date}}"
        >
          <text>{{item.day}}</text>
          <view class="day-dot" wx:if="{{item.count > 0}}"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 遮罩 -->
  <view class="calendar-mask" wx:if="{{calendarExpanded}}" bindtap="onCalendarClose"></view>

  <!-- tab 栏 -->
  <view class="tabbar">
    <view class="tab {{activeTab === 'customers' ? 'active' : ''}}" data-tab="customers" bindtap="onTabChange">
      客户<text class="cnt">{{tabCounts.customers}}</text>
    </view>
    <view class="tab {{activeTab === 'activities' ? 'active' : ''}}" data-tab="activities" bindtap="onTabChange">
      活动<text class="cnt">{{tabCounts.activities}}</text>
    </view>
    <view class="tab {{activeTab === 'finance' ? 'active' : ''}}" data-tab="finance" bindtap="onTabChange">
      财务<text class="cnt">{{tabCounts.finance}}</text>
    </view>
    <view class="tab {{activeTab === 'deductions' ? 'active' : ''}}" data-tab="deductions" bindtap="onTabChange">
      销卡<text class="cnt">{{tabCounts.deductions}}</text>
    </view>
  </view>

  <!-- ================= 客户 ================= -->
  <view class="r-body" wx:if="{{activeTab === 'customers'}}">
    <block wx:if="{{!loading}}">
      <view
        class="c-card {{item.identityGrey ? 'n' : 'm'}} {{item.open ? 'open' : ''}}"
        wx:for="{{visits}}"
        wx:key="id"
        bindtap="onVisitToggle"
        data-index="{{index}}"
      >
        <view class="c-l1">
          <text class="c-name">{{item.nickname}}</text>
          <text class="c-id {{item.identityGrey ? 'grey' : ''}}">{{item.identityText}}</text>
          <text class="c-pill {{item.arrived ? 'ok' : 'no'}}">{{item.arrived ? '已到店' : '未到店'}}</text>
          <text class="c-amount {{item.hasAmount ? '' : 'none'}}">{{item.amountText}}</text>
        </view>
        <view class="c-l2">
          <text>受邀 <text class="b">{{item.invitedCount}}</text></text>
          <text>到店 <text class="b">{{item.arrivedCount}}</text></text>
          <text>今日活动 <text class="b">{{item.todayActCount}}</text></text>
          <text>剩 <text class="b">{{item.remainingText}}</text></text>
          <text class="c-more-hint">展开 ∨</text>
        </view>
        <view class="c-l3" wx:if="{{item.needText}}"><text class="k">需求</text>{{item.needText}}</view>
        <view class="c-detail">
          <view class="d-row" wx:if="{{item.infoText}}"><text class="d-label">客户信息</text><text class="d-val">{{item.infoText}}</text></view>
          <view class="d-row" wx:if="{{item.followText}}"><text class="d-label">跟进点</text><text class="d-val">{{item.followText}}</text></view>
          <view class="d-row" wx:if="{{item.leaderText}}"><text class="d-label">组长反馈</text><text class="d-val">{{item.leaderText}}</text></view>
          <view class="d-row"><text class="d-label">引流/邀约</text><text class="d-val">{{item.refText || '自然到店'}}<text wx:if="{{item.refHandlerText}}"> ／ {{item.refHandlerText}}</text><text wx:if="{{item.visitTimeText}}"> · {{item.visitTimeText}}</text></text></view>
        </view>
      </view>
      <view class="empty-state" wx:if="{{visits.length === 0}}">
        <text class="empty-text">当日无邀约记录</text>
      </view>
    </block>
  </view>

  <!-- ================= 活动 ================= -->
  <view class="r-body" wx:if="{{activeTab === 'activities'}}">
    <block wx:if="{{!loading}}">
      <view class="section-note">点击卡片展开老人 / 新人名单</view>
      <view
        class="act-card {{item.open ? 'open' : ''}}"
        wx:for="{{activities}}"
        wx:key="id"
        bindtap="onActivityToggle"
        data-index="{{index}}"
      >
        <view class="act-l1">
          <text class="act-name">{{item.name}}</text>
          <text class="act-tag {{item.isWelfare ? 'grey' : ''}}">{{item.typeText}}</text>
          <text class="act-num">{{item.count}} 人</text>
        </view>
        <view class="act-l2">
          <text wx:if="{{item.timeText}}">{{item.timeText}}</text>
          <text wx:if="{{item.teacherText}}">{{item.teacherText}}</text>
          <text>老人 {{item.oldCount}} / 新人 {{item.newCount}}</text>
        </view>
        <view class="act-detail">
          <view class="d-row"><text class="d-label">老人</text><text class="d-val">{{item.oldText || '-'}}</text></view>
          <view class="d-row"><text class="d-label">新人</text><text class="d-val">{{item.newText || '-'}}</text></view>
        </view>
      </view>
      <view class="empty-state" wx:if="{{activities.length === 0}}">
        <text class="empty-text">当日无活动</text>
      </view>
    </block>
  </view>

  <!-- ================= 财务 ================= -->
  <view class="r-body" wx:if="{{activeTab === 'finance'}}">
    <block wx:if="{{!loading}}">
      <view class="fin-summary">
        <text class="label">今日合计</text>
        <text class="total">{{financeTotal}}</text>
        <view class="by-method">
          <text wx:for="{{byMethod}}" wx:key="method" wx:for-item="m">{{m.method}} {{m.amountText}}</text>
        </view>
      </view>
      <view class="f-card" wx:for="{{financeRows}}" wx:key="id">
        <view class="f-l1">
          <text class="f-name">{{item.nickname}}</text>
          <text class="f-type">{{item.item_type}}</text>
          <text class="f-amount">{{item.amountText}}</text>
        </view>
        <view class="f-l2">
          <text wx:if="{{item.item_name}}">{{item.item_name}}</text>
          <text wx:if="{{item.purchaseCountText}}">{{item.purchaseCountText}}</text>
          <text wx:if="{{item.remainingText}}">{{item.remainingText}}</text>
          <text wx:if="{{item.closer_name}}">成交人：{{item.closer_name}}</text>
          <text wx:if="{{item.payment_method}}">{{item.payment_method}}</text>
          <text wx:if="{{item.referrer}}">引流：{{item.referrer}}</text>
        </view>
      </view>
      <view class="empty-state" wx:if="{{financeRows.length === 0}}">
        <text class="empty-text">当日无财务记录</text>
      </view>
    </block>
  </view>

  <!-- ================= 销卡 ================= -->
  <view class="r-body" wx:if="{{activeTab === 'deductions'}}">
    <block wx:if="{{!loading}}">
      <view class="section-note">仅显示当日有销卡的客户，公益活动不计入</view>
      <view class="ded-wrap" wx:if="{{deductionRows.length > 0}}">
        <view class="ded-head">
          <text class="ded-c1">昵称</text><text class="ded-c2">卡类型</text>
          <text class="ded-c3">人工销</text><text class="ded-c4">活动销</text><text class="ded-c5">剩余</text>
        </view>
        <view class="ded-row" wx:for="{{deductionRows}}" wx:key="customer_id">
          <text class="ded-c1">{{item.nickname}}</text>
          <text class="ded-c2 {{item.cardMuted ? 'muted' : ''}}">{{item.card_type || '未办卡'}}</text>
          <text class="ded-c3 {{item.manualMuted ? 'muted' : ''}}">{{item.manualText || '—'}}</text>
          <text class="ded-c4 {{item.activityMuted ? 'muted' : ''}}">{{item.activityText || '—'}}</text>
          <text class="ded-c5 {{item.cardMuted ? 'muted' : ''}}">{{item.remainingText}}</text>
        </view>
      </view>
      <view class="empty-state" wx:if="{{deductionRows.length === 0}}">
        <text class="empty-text">当日无销卡记录</text>
      </view>
    </block>
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>  </block>
</view>
