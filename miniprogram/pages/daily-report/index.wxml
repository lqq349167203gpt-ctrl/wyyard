<import src="../../templates/note-feedback-meta.wxml" />
<view class="page">
  <!-- 无权限 -->
  <view class="no-permission" wx:if="{{!hasPagePermission}}">
    <text class="no-permission-text">无权限访问此页面</text>
  </view>
  <block wx:else>
  <!-- 头部：日期 + 空间 -->
  <view class="head">
    <view class="head-row">
      <view class="head-date" bindtap="onCalendarToggle">
        <text>{{currentDateShort}}</text>
        <text class="wk">{{currentWeekday}}</text>
        <text class="drop">{{calendarExpanded ? '▴' : '▾'}}</text>
      </view>
      <picker class="head-space" mode="selector" range="{{spaces}}" range-key="name" value="{{spaceIndex}}" bindchange="onSpaceChange">
        <text>{{currentSpaceName}} ▾</text>
      </picker>
    </view>
    <!-- 下拉日历 -->
    <view class="calendar-dropdown" wx:if="{{calendarExpanded}}">
      <view class="calendar-nav">
        <view class="nav-arrow" catchtap="onPrevMonth">‹</view>
        <text class="nav-title">{{calYear}}年{{calMonth + 1}}月</text>
        <view class="nav-arrow" catchtap="onNextMonth">›</view>
      </view>
      <view class="weekday-row">
        <text class="weekday-cell" wx:for="{{weekdays}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="day-grid">
        <view
          wx:for="{{calendarDays}}"
          wx:key="date"
          class="day-cell {{item.isCurrent ? '' : 'other'}} {{item.isSelected ? 'selected' : ''}} {{item.isToday ? 'today' : ''}}"
          bindtap="onCalendarDayTap"
          data-date="{{item.date}}"
        >
          <text>{{item.day}}</text>
          <view class="day-dot" wx:if="{{item.count > 0}}"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 遮罩 -->
  <view class="calendar-mask" wx:if="{{calendarExpanded}}" bindtap="onCalendarClose"></view>

  <!-- tab 栏 -->
  <view class="tabbar">
    <view class="tab {{activeTab === 'customers' ? 'active' : ''}}" data-tab="customers" bindtap="onTabChange">
      客户<text class="cnt">{{tabCounts.customers}}</text>
    </view>
    <view class="tab {{activeTab === 'activities' ? 'active' : ''}}" data-tab="activities" bindtap="onTabChange">
      活动<text class="cnt">{{tabCounts.activities}}</text>
    </view>
    <view wx:if="{{hasFinance}}" class="tab {{activeTab === 'finance' ? 'active' : ''}}" data-tab="finance" bindtap="onTabChange">
      财务<text wx:if="{{financeReady}}" class="cnt">{{tabCounts.finance}}</text>
    </view>
    <view wx:if="{{hasFinance}}" class="tab {{activeTab === 'deductions' ? 'active' : ''}}" data-tab="deductions" bindtap="onTabChange">
      销卡<text wx:if="{{financeReady}}" class="cnt">{{tabCounts.deductions}}</text>
    </view>
  </view>

  <!-- ================= 客户 ================= -->
  <view class="r-body" wx:if="{{activeTab === 'customers'}}">
    <block wx:if="{{!loading && !error}}">
      <block wx:if="{{visits.length > 0}}">
      <view class="c-group" wx:for="{{customerGroups}}" wx:for-item="group" wx:for-index="groupIndex" wx:key="key">
        <view class="c-group-title">{{group.label}}<text class="c-group-count">（{{group.rows.length}}人）</text></view>
        <view class="c-group-empty" wx:if="{{group.rows.length === 0}}">暂无客户</view>
      <view
        class="c-card {{item.cancelled ? 'cancelled' : item.arrived ? 'green' : 'grey'}} {{item.open ? 'open' : ''}}"
        wx:for="{{group.rows}}"
        wx:key="id"
        bindtap="onVisitToggle"
        data-index="{{index}}"
        data-group-index="{{groupIndex}}"
      >
        <view class="c-l1">
          <text class="c-time" wx:if="{{item.visitTimeText}}">{{item.visitTimeText}}</text>
          <text class="c-name" catchtap="onNicknameTap" data-customer-id="{{item.customer_id}}">{{item.nickname}}</text>
          <text class="c-id" wx:if="{{item.hasIdentity}}">{{item.identityText}}</text>
          <text class="c-amount {{item.hasAmount ? '' : 'none'}}" catchtap="onVisitStatTap" data-customer-id="{{item.customer_id}}" data-type="payment" data-nickname="{{item.nickname}}">{{item.amountText}}</text>
        </view>
        <view class="c-l2">
          <view class="stat" catchtap="onVisitStatTap" data-customer-id="{{item.customer_id}}" data-type="invited" data-nickname="{{item.nickname}}"><text class="l">受邀</text><text class="b">{{item.invitedCount}}</text></view>
          <view class="stat" catchtap="onVisitStatTap" data-customer-id="{{item.customer_id}}" data-type="cancelled" data-nickname="{{item.nickname}}"><text class="l">取消</text><text class="b">{{item.cancelledCount}}</text></view>
          <view class="stat" catchtap="onVisitStatTap" data-customer-id="{{item.customer_id}}" data-type="visit" data-nickname="{{item.nickname}}"><text class="l">到店</text><text class="b">{{item.arrivedCount}}</text></view>
          <view class="stat" catchtap="onVisitStatTap" data-customer-id="{{item.customer_id}}" data-type="activity_today" data-nickname="{{item.nickname}}"><text class="l">今日活动</text><text class="b">{{item.todayActCount}}</text></view>
          <view class="stat"><text class="l">剩余</text><text class="b">{{item.remainingText}}</text></view>
          <view class="c-more-hint">
            <text>展开</text>
            <view class="arrow {{item.open ? 'up' : ''}}"></view>
          </view>
        </view>
        <view wx:if="{{noteVisibility.visit_need}}" class="c-l3"><text class="k">来访需求</text><text class="v">{{item.needText || ''}}<text class="dash" wx:if="{{!item.needText}}">-</text></text></view>
        <view class="c-detail">
          <block wx:if="{{item.cancelled}}">
            <view wx:if="{{noteVisibility.follow_up}}" class="d-row"><text class="d-label">取消原因</text><text class="d-val">{{item.cancelReason || ''}}<text class="dash" wx:if="{{!item.cancelReason}}">-</text></text></view>
          </block>
          <block wx:else>
            <view wx:if="{{noteVisibility.customer_info}}" class="d-row"><text class="d-label">深度需求</text><text class="d-val">{{item.infoText || ''}}<text class="dash" wx:if="{{!item.infoText}}">-</text></text></view>
            <view wx:if="{{noteVisibility.follow_up}}" class="d-row"><text class="d-label">跟进点</text><view class="d-val" wx:if="{{item.followEntries.length}}"><view class="note-feedback-entry" wx:for="{{item.followEntries}}" wx:for-item="note" wx:key="id"><template is="note-feedback-meta" data="{{author: note.author, nextFollowUpText: note.nextFollowUpText, inline: true}}" /><text class="note-feedback-content">{{note.content}}</text></view></view><text class="d-val" wx:else>{{item.followText || ''}}<text class="dash" wx:if="{{!item.followText}}">-</text></text></view>
            <view wx:if="{{noteVisibility.customer_feedback}}" class="d-row"><text class="d-label">客户反馈</text><text class="d-val">{{item.feedbackText || ''}}<text class="dash" wx:if="{{!item.feedbackText}}">-</text></text></view>
          </block>
          <view class="d-divider"></view>
          <view class="d-row"><text class="d-label">引流</text><text class="d-val">{{item.refText || '自然到店'}}</text></view>
          <view class="d-row"><text class="d-label">邀约</text><text class="d-val">{{item.refHandlerText || ''}}<text class="dash" wx:if="{{!item.refHandlerText}}">-</text></text></view>
        </view>
      </view>
      </view>
      </block>
      <view class="empty-state" wx:if="{{visits.length === 0}}">
        <text class="empty-text">当日无邀约记录</text>
      </view>
    </block>
  </view>

  <!-- ================= 活动 ================= -->
  <view class="r-body" wx:if="{{activeTab === 'activities'}}">
    <block wx:if="{{!loading && !error}}">
      <view class="section-note">点击卡片展开新人 / 老人名单</view>
      <view
        class="act-card {{item.open ? 'open' : ''}}"
        wx:for="{{activities}}"
        wx:key="id"
        bindtap="onActivityToggle"
        data-index="{{index}}"
      >
        <view class="act-l1">
          <text class="act-name">{{item.name}}</text>
          <text class="act-tag {{item.isWelfare ? 'grey' : ''}}">{{item.typeText}}</text>
        </view>
        <view class="act-l2">
          <text wx:if="{{item.timeText}}">{{item.timeText}}</text>
          <text wx:if="{{item.teacherText}}">{{item.teacherText}}</text>
          <text>新人 {{item.newCount}} / 老人 {{item.oldCount}}</text>
        </view>
        <view class="act-detail">
          <view class="d-row"><text class="d-label">参与人数</text><text class="d-val">{{item.count}} 人</text></view>
          <view class="d-row"><text class="d-label">新人</text><text class="d-val">{{item.newText || ''}}<text class="dash" wx:if="{{!item.newText}}">-</text></text></view>
          <view class="d-row"><text class="d-label">老人</text><text class="d-val">{{item.oldText || ''}}<text class="dash" wx:if="{{!item.oldText}}">-</text></text></view>
          <view class="d-row"><text class="d-label">粗门客户</text><text class="d-val">{{item.coarseText || ''}}<text class="dash" wx:if="{{!item.coarseText}}">-</text></text></view>
          <view class="d-row"><text class="d-label">未到店</text><text class="d-val">{{item.absentText || ''}}<text class="dash" wx:if="{{!item.absentText}}">-</text></text></view>
        </view>
      </view>
      <view class="empty-state" wx:if="{{activities.length === 0}}">
        <text class="empty-text">当日无活动</text>
      </view>
    </block>
  </view>

  <!-- ================= 财务 ================= -->
  <view class="r-body" wx:if="{{activeTab === 'finance'}}">
    <block wx:if="{{!loading && !error && financeReady}}">
      <view class="fin-summary">
        <text class="label">交易笔数</text>
        <text class="total">{{financeRows.length}}笔</text>
      </view>
      <view class="f-card" wx:for="{{financeRows}}" wx:key="id">
        <view class="f-l1">
          <text class="f-name">{{item.nickname}}</text>
          <text class="f-type">{{item.item_type}}</text>
        </view>
        <view class="f-l2">
          <text wx:if="{{item.item_name}}">{{item.item_name}}</text>
          <text wx:if="{{item.purchaseCountText}}">{{item.purchaseCountText}}</text>
          <text wx:if="{{item.remainingText}}">{{item.remainingText}}</text>
        </view>
        <view class="f-l3">
          <view class="fi">
            <text class="lbl">成交人：</text>
            <text class="val">{{item.closer_name || ''}}<text class="dash" wx:if="{{!item.closer_name}}">-</text></text>
          </view>
          <view class="fi">
            <text class="lbl">成交归属：</text>
            <text class="val">{{item.organization_name || '—'}}</text>
          </view>
          <view class="fi">
            <text class="lbl">引流：</text>
            <text class="val">{{item.referrer || ''}}<text class="dash" wx:if="{{!item.referrer}}">-</text></text>
          </view>
        </view>
      </view>
      <view class="empty-state" wx:if="{{financeRows.length === 0}}">
        <text class="empty-text">当日无财务记录</text>
      </view>
    </block>
  </view>

  <!-- ================= 销卡 ================= -->
  <view class="r-body" wx:if="{{activeTab === 'deductions'}}">
    <block wx:if="{{!loading && !error && financeReady}}">
      <view class="section-note">仅显示当日有销卡的客户，公益活动不计入</view>
      <view class="f-card" wx:for="{{deductionRows}}" wx:key="id">
        <view class="f-l1">
          <text class="f-name">{{item.nickname}}</text>
        </view>
        <view class="d-cols">
          <view class="dc"><text class="d-label">卡名称：</text><text class="d-val {{item.has_card ? '' : 'muted'}}">{{item.card_name || '未办卡'}}</text></view>
          <view class="dc"><text class="d-label">销卡类型：</text><text class="d-val">{{item.deduction_type}}</text></view>
        </view>
        <view class="d-cols">
          <view class="dc"><text class="d-label">销卡次数：</text><text class="d-val">{{item.count}} 次</text></view>
          <view class="dc"><text class="d-label">剩余卡次：</text><text class="d-val {{item.has_card ? '' : 'muted'}}">{{item.remainingText}}</text></view>
        </view>
      </view>
      <view class="empty-state" wx:if="{{deductionRows.length === 0}}">
        <text class="empty-text">当日无销卡记录</text>
      </view>
    </block>
  </view>

  <view class="empty-state" wx:if="{{error}}" bindtap="retryData">{{error}} · 点击重试</view>
  <block wx:if="{{activeTab === 'finance' || activeTab === 'deductions'}}">
    <view class="loading" wx:if="{{financeLoading}}">加载中...</view>
    <view class="empty-state" wx:if="{{financeError}}" bindtap="retryFinance">{{financeError}} · 点击重试</view>
  </block>
  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>  </block>

  <!-- 客户详情弹窗 -->
  <view class="detail-mask" wx:if="{{detailOpen}}" bindtap="onDetailClose"></view>
  <view class="detail-panel" wx:if="{{detailOpen}}">
    <view class="detail-head" bindtap="onDetailClose">
      <text class="detail-title">{{detailNickname}} — {{detailTitle}}</text>
      <view class="detail-close">✕</view>
    </view>
    <view class="detail-body">
      <scroll-view scroll-y class="detail-scroll">
        <view class="detail-row thead">
          <text wx:for="{{detailHeader}}" wx:key="index" class="{{item.cls}}">{{item.text}}</text>
          <text class="row-toggle-spacer"></text>
        </view>
        <view class="detail-empty" wx:if="{{detailLoading}}">加载中...</view>
        <view class="detail-empty" wx:if="{{!detailLoading && detailRows.length === 0}}">暂无记录</view>
        <block wx:if="{{!detailLoading && detailRows.length > 0}}">
          <view wx:for="{{detailRows}}" wx:key="index" class="{{item.rowClass}} {{item.expanded ? 'expanded' : 'collapsed'}}" catchtap="onDetailRowToggle" data-index="{{index}}">
            <text wx:for="{{item.cols}}" wx:for-item="col" wx:key="index" class="{{col.cls}}">{{item.expanded ? col.text : col.flat}}<text class="cancelled" wx:if="{{col.cancelled}}">（已取消）</text><text class="unarrived" wx:elif="{{col.unarrived}}">（未参与）</text><text class="dash" wx:if="{{!col.text}}">-</text></text>
            <view class="row-toggle" wx:if="{{item.overflow || item.expanded}}">
              <text class="row-toggle-arrow">{{item.expanded ? '▴' : '▾'}}</text>
            </view>
            <view class="row-toggle-spacer" wx:else></view>
          </view>
        </block>
      </scroll-view>
    </view>
  </view>
</view>
