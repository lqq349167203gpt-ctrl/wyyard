.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #ffffff;
  box-sizing: border-box;
}

.page-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 21vh 64rpx 0;
  box-sizing: border-box;
}

.welcome-title {
  margin-top: 5vh;
  color: #1f2329;
  font-size: 42rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  line-height: 1;
}

.welcome-subtitle {
  margin-top: 22rpx;
  color: #8f959e;
  font-size: 24rpx;
  line-height: 1.5;
}

/* 登录表单 */
.login-card {
  width: 100%;
  margin-top: 5vh;
}

.login-field {
  width: 100%;
  padding: 24rpx 0 22rpx;
  border-bottom: 2rpx solid #eceef1;
  box-sizing: border-box;
  transition: border-color 160ms ease;
}

.login-field.is-focused {
  border-bottom-color: #3370ff;
}

.login-field.is-focused .field-label {
  color: #3370ff;
}

.field-label {
  display: block;
  margin-bottom: 8rpx;
  color: #9aa0a8;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  line-height: 1;
}

.field-input {
  width: 100%;
  height: 48rpx;
  min-height: 48rpx;
  color: #1f2329;
  font-size: 30rpx;
  line-height: 48rpx;
  background-color: transparent;
}

/* 记住账号与密码 */
.save-options {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 60rpx;
  margin-top: 2.5vh;
}

.save-item {
  min-height: 46rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.save-checkbox {
  width: 30rpx;
  height: 30rpx;
  border: 3rpx solid #c9cdd4;
  border-radius: 50%;
  background-color: #ffffff;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-checkbox.checked {
  background-color: #3370ff;
  border-color: #3370ff;
}

.save-checkmark {
  width: 14rpx;
  height: 8rpx;
  border-left: 3rpx solid #ffffff;
  border-bottom: 3rpx solid #ffffff;
  border-radius: 1rpx;
  box-sizing: border-box;
  transform: translateY(-1rpx) rotate(-45deg);
}

.save-label {
  color: #646a73;
  font-size: 24rpx;
  line-height: 1;
}

.login-button {
  width: 100%;
  height: 96rpx;
  margin-top: 5vh;
  padding: 0;
  border: none;
  border-radius: 24rpx;
  background-color: #3370ff;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: none;
  box-sizing: border-box;
}

.login-button-text {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1;
  letter-spacing: 8rpx;
}

.login-button-hover {
  background-color: #2f67eb;
}

.login-button.is-loading {
  background-color: #8fb0ff;
}

/* 错误信息 */
.error-msg {
  width: 100%;
  margin-top: 2.222vh;
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  background-color: #faf1f0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.error-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background-color: #c45a5a;
  flex: none;
}

.error-text {
  color: #b74f4f;
  font-size: 24rpx;
  line-height: 1.5;
}

/* 开发模式 */
.dev-title {
  display: block;
  margin-bottom: 28rpx;
  color: #8f959e;
  font-size: 24rpx;
  text-align: left;
}

.dev-picker {
  width: 100%;
  height: 92rpx;
  padding: 0 4rpx;
  border-bottom: 2rpx solid #e5e8ec;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #1f2329;
  font-size: 30rpx;
  box-sizing: border-box;
}

.picker-arrow {
  color: #b0b5bb;
  font-size: 34rpx;
}

.dev-button {
  margin-top: 48rpx;
}

.dev-toggle {
  margin-top: 32rpx;
  text-align: center;
}

.dev-toggle-text {
  color: #8f959e;
  font-size: 22rpx;
}

/* 页面归属 */
.login-footer {
  padding: 0 0 calc(3.333vh + env(safe-area-inset-bottom));
  text-align: center;
}

.system-tagline {
  display: block;
  color: #c9ced4;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}
