<view class="page">
  <view class="page-content">
    <text class="welcome-title">无忧茶院</text>
    <text class="welcome-subtitle">欢迎回来 · 请使用内部账号登录</text>

    <!-- 登录表单 -->
    <view class="login-card">
      <block wx:if="{{loginMode === 'password'}}">
        <view class="login-field {{focusedField === 'username' ? 'is-focused' : ''}}">
          <text class="field-label">用户名</text>
          <input
            class="field-input"
            placeholder="请输入用户名"
            placeholder-style="color: #b0b5bb;"
            value="{{username}}"
            data-field="username"
            bindfocus="onFieldFocus"
            bindblur="onFieldBlur"
            bindinput="onUsernameInput"
          />
        </view>
        <view class="login-field {{focusedField === 'password' ? 'is-focused' : ''}}">
          <text class="field-label">密码</text>
          <input
            class="field-input"
            placeholder="请输入密码"
            placeholder-style="color: #b0b5bb;"
            password="{{!showPassword}}"
            value="{{password}}"
            data-field="password"
            bindfocus="onFieldFocus"
            bindblur="onFieldBlur"
            bindinput="onPasswordInput"
          />
          <view class="password-toggle" catchtap="onTogglePasswordVisibility" aria-role="button" aria-label="{{showPassword ? '隐藏密码' : '显示密码'}}">
            <view class="eye-shape">
              <view class="eye-pupil"></view>
            </view>
            <view class="eye-slash" wx:if="{{!showPassword}}"></view>
          </view>
        </view>

        <view class="save-options">
          <view class="save-item {{saveAccount ? 'is-checked' : ''}}" bindtap="onToggleSaveAccount">
            <view class="save-checkbox {{saveAccount ? 'checked' : ''}}">
              <view class="save-checkmark" wx:if="{{saveAccount}}"></view>
            </view>
            <text class="save-label">记住账号</text>
          </view>
          <view class="save-item {{savePassword ? 'is-checked' : ''}}" bindtap="onToggleSavePassword">
            <view class="save-checkbox {{savePassword ? 'checked' : ''}}">
              <view class="save-checkmark" wx:if="{{savePassword}}"></view>
            </view>
            <text class="save-label">记住密码</text>
          </view>
        </view>

        <view
          class="login-button {{loading ? 'is-loading' : ''}}"
          bindtap="onPasswordLogin"
          hover-class="login-button-hover"
          aria-role="button"
          aria-disabled="{{loading}}"
        >
          <text class="login-button-text">{{loading ? '登录中' : '登 录'}}</text>
        </view>
      </block>

      <!-- 开发模式 -->
      <block wx:if="{{loginMode === 'dev'}}">
        <text class="dev-title">选择账号登录</text>
        <picker mode="selector" range="{{devAccounts}}" range-key="label" value="{{devIndex}}" bindchange="onDevAccountChange">
          <view class="dev-picker">
            <text>{{devAccounts[devIndex].label}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
        <view
          class="login-button dev-button {{loading ? 'is-loading' : ''}}"
          bindtap="onDevLogin"
          hover-class="login-button-hover"
          aria-role="button"
          aria-disabled="{{loading}}"
        >
          <text class="login-button-text">{{loading ? '登录中' : '登 录'}}</text>
        </view>
      </block>

      <view class="error-msg" wx:if="{{error}}">
        <view class="error-dot"></view>
        <text class="error-text">{{error}}</text>
      </view>
    </view>

    <view class="dev-toggle" wx:if="{{isDev}}" bindtap="onToggleDev">
      <text class="dev-toggle-text">{{loginMode === 'dev' ? '返回登录' : '开发模式'}}</text>
    </view>
  </view>

  <view class="login-footer">
    <text class="system-tagline">无忧茶院 · 内部管理系统</text>
  </view>
</view>
