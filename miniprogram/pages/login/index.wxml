<view class="page">
  <!-- 底图 -->
  <image class="bg-image" src="/images/3.jpg" mode="aspectFill" />
  <view class="bg-mask"></view>

  <!-- 蓝色头部 -->
  <view class="header">
    <view class="header-row">
      <view class="logo-icon">
        <text class="logo-w">W</text>
      </view>
      <text class="logo-text">无忧茶苑管理端</text>
    </view>
  </view>

  <!-- 登录卡 -->
  <view class="login-card">
    <!-- 账号密码登录 -->
    <block wx:if="{{loginMode === 'password'}}">
      <input
        class="login-input"
        placeholder="用户名"
        placeholder-style="color: #b0b5bb;"
        value="{{username}}"
        bindinput="onUsernameInput"
      />
      <input
        class="login-input"
        placeholder="密码"
        placeholder-style="color: #b0b5bb;"
        password="true"
        value="{{password}}"
        bindinput="onPasswordInput"
      />
      <view class="save-item" bindtap="onToggleSaveAccount">
        <view class="save-checkbox {{saveAccount ? 'checked' : ''}}"></view>
        <text class="save-label">记住账号</text>
      </view>
      <button
        class="phone-btn"
        style="width: 550rpx;"
        bindtap="onPasswordLogin"
        loading="{{loading}}"
        disabled="{{loading}}"
      >
        登录
      </button>
    </block>

    <!-- 开发模式 -->
    <block wx:if="{{loginMode === 'dev'}}">
      <text class="dev-title">选择账号登录</text>
      <picker mode="selector" range="{{devAccounts}}" range-key="label" value="{{devIndex}}" bindchange="onDevAccountChange">
        <view class="dev-picker">
          <text>{{devAccounts[devIndex].label}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
      <button class="dev-btn" bindtap="onDevLogin" loading="{{loading}}" disabled="{{loading}}">
        登录
      </button>
    </block>

    <view class="error-msg" wx:if="{{error}}">
      <text class="error-text">{{error}}</text>
    </view>
  </view>

  <view class="dev-toggle" wx:if="{{isDev}}" bindtap="onToggleDev">
    <text class="dev-toggle-text">{{loginMode === 'dev' ? '返回登录' : '开发模式'}}</text>
  </view>

  <!-- 构建标记：核对当前包版本，排查提审包是否为最新代码 -->
  <view class="version-tag">
    <text class="version-tag-text">{{versionTag}}</text>
  </view>
</view>
