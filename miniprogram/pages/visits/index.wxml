<view class="page">
  <!-- 无权限 -->
  <view class="no-permission" wx:if="{{!hasPagePermission}}">
    <text class="no-permission-text">无权限访问此页面</text>
  </view>
  <block wx:else>
  <!-- 头部 -->
  <view class="head">
    <view class="head-row">
      <view class="head-date" bindtap="onCalendarToggle">
        <text class="date-main">{{currentDateShort}}</text>
        <text class="wk">{{currentWeekday}}</text>
        <text class="drop">{{calendarExpanded ? '▴' : '▾'}}</text>
      </view>
      <picker class="head-space" mode="selector" range="{{spaces}}" range-key="name" value="{{spaceIndex}}" bindchange="onSpaceChange">
        <view class="space-content">
          <text>{{currentSpaceName}}</text>
        </view>
      </picker>
    </view>
    <view class="lock-bar {{isDayVerified ? 'locked' : ''}}">
      <view class="lock-status">
        <view class="lock-status-icon"></view>
        <text>{{isDayVerified ? '已核对' : '未核对'}}</text>
        <text class="lock-operator" wx:if="{{isDayVerified && verificationInfo.verified_by}}">· {{verificationInfo.verified_by}}</text>
      </view>
      <view class="lock-action {{verificationSubmitting || !spaceId ? 'disabled' : ''}}" wx:if="{{canManageVisitVerification}}" bindtap="onVerificationToggle">
        {{verificationSubmitting ? '处理中…' : (isDayVerified ? '解锁' : '核对并锁定')}}
      </view>
    </view>
    <!-- 三槽位周轮播：滑动完成后无感回中，避免循环克隆长期滑动后出现空白 -->
    <swiper
      wx:if="{{!calendarExpanded}}"
      class="week-swiper"
      current="{{weekSwiperCurrent}}"
      duration="{{weekSwiperDuration}}"
      easing-function="easeOutCubic"
      bindchange="onWeekSwiperChange"
    >
      <swiper-item wx:for="{{weekPages}}" wx:key="key" wx:for-item="weekPage">
        <view class="week-strip">
          <view
            wx:for="{{weekPage.days}}"
            wx:key="date"
            wx:for-item="day"
            class="week-day {{day.isSelected ? 'selected' : ''}}"
            catchtap="onCalendarDayTap"
            data-date="{{day.date}}"
          >
            <text class="week-label">{{day.weekday}}</text>
            <text class="week-number">{{day.day}}</text>
            <view class="week-count-dot {{day.isVerified ? 'visible verified' : (day.count > 0 ? 'visible' : '')}}"></view>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <!-- 下拉日历 -->
    <view class="calendar-dropdown" wx:if="{{calendarExpanded}}">
      <view class="calendar-nav">
        <view class="nav-arrow" catchtap="onPrevMonth">‹</view>
        <text class="nav-title">{{calYear}}年{{calMonth + 1}}月</text>
        <view class="nav-arrow" catchtap="onNextMonth">›</view>
      </view>
      <view class="weekday-row">
        <text class="weekday-cell" wx:for="{{weekdays}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="day-grid">
        <view
          wx:for="{{calendarDays}}"
          wx:key="date"
          class="day-cell {{item.isCurrent ? '' : 'other'}} {{item.isSelected ? 'selected' : ''}} {{item.isToday ? 'today' : ''}}"
          bindtap="onCalendarDayTap"
          data-date="{{item.date}}"
        >
          <text>{{item.day}}</text>
          <view class="day-dot {{item.isVerified ? 'verified' : ''}}" wx:if="{{item.isCurrent && (item.isVerified || item.count > 0)}}"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 遮罩 -->
  <view class="calendar-mask" wx:if="{{calendarExpanded}}" bindtap="onCalendarClose"></view>

  <!-- 访客列表 -->
  <view class="visit-section" wx:if="{{!loading && visits.length > 0}}">
    <view class="list-heading">
      <view class="list-heading-dot"></view>
      <text class="list-heading-title">邀约名单</text>
      <text class="list-heading-count">{{dateSwitching ? '…' : todayVisitCount}} 人</text>
      <view class="list-heading-actions">
        <view wx:if="{{!isViewOnly && !isDayVerified}}" class="edit-toggle {{editMode ? 'active' : ''}}" catchtap="onToggleEditMode">
          <text>{{editMode ? '完成' : '排序'}}</text>
        </view>
        <view class="export-btn" catchtap="onExportTap">
          <text>导出</text>
        </view>
      </view>
    </view>
    <view class="visit-list">
      <view class="switching-line" wx:if="{{dateSwitching}}"></view>
      <view class="visit-items {{dateSwitching ? 'switching' : ''}}">
        <visit-card
          wx:for="{{visits}}"
          wx:key="id"
          visit="{{item}}"
          leader-name="{{leaderMap[item.customer_id] || ''}}"
          edit-mode="{{editMode}}"
          editable="{{item.can_edit && !isDayVerified}}"
          cancelable="{{!isViewOnly && !isDayVerified}}"
          sortable="{{!isViewOnly && !isDayVerified}}"
          arrival-editable="{{!isViewOnly && !isDayVerified && !item.cancelled}}"
          can-move-up="{{index > 0}}"
          can-move-down="{{index < visits.length - 1}}"
          is-last="{{index === visits.length - 1}}"
          bind:cardtap="onVisitTap"
          data-visit="{{item}}"

          bind:delete="onDeleteTap"
          bind:profile="onProfileTap"
          bind:arrival="onArrivalTap"
          bind:cancelvisit="onCancelVisitTap"
          bind:moveup="onMoveUp"
          bind:movedown="onMoveDown"
        />
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && visits.length === 0}}">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无邀约记录</text>
    <text class="empty-hint">{{isDayVerified ? '当天邀约已核对' : (isViewOnly ? '当前账号仅可浏览' : '点击右下角 + 添加')}}</text>
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 浮动添加按钮 -->
  <view class="fab" wx:if="{{!editMode && !isViewOnly && !isDayVerified}}" bindtap="onAddTap" bindlongpress="onFabLongPress">
    <text class="fab-icon">+</text>
  </view>
  </block>
</view>
