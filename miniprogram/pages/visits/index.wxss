.page {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding-bottom: 140rpx;
}

/* 头部 */
.head {
  background-color: #f3f7ff;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 101;
  padding: 20rpx 32rpx 28rpx;
}

.head-row {
  display: flex;
  align-items: center;
  min-height: 72rpx;
}

.head-date {
  display: flex;
  align-items: center;
  color: #1f2329;
}

.date-main {
  font-size: 42rpx;
  font-weight: 500;
  letter-spacing: -1rpx;
}

.head-date .wk {
  margin-left: 14rpx;
  color: #8f959e;
  font-size: 24rpx;
  font-weight: 400;
}

.head-date .drop {
  margin-left: 12rpx;
  color: #8f959e;
  font-size: 22rpx;
}

.head-space {
  margin-left: auto;
  flex-shrink: 0;
}

.space-content {
  display: flex;
  align-items: center;
  padding: 14rpx 22rpx;
  border-radius: 20rpx;
  background-color: #ffffff;
  color: #646a73;
  font-size: 24rpx;
}

/* 当前周日期条 */
.week-swiper {
  width: 100%;
  height: 142rpx;
  margin-top: 12rpx;
  border-radius: 28rpx;
  background-color: rgba(255, 255, 255, 0.78);
  overflow: hidden;
}

.week-strip {
  display: flex;
  width: 100%;
  height: 142rpx;
  box-sizing: border-box;
  padding: 20rpx 14rpx 14rpx;
}

.week-day {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.week-label {
  color: #8f959e;
  font-size: 20rpx;
}

.week-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-top: 8rpx;
  border-radius: 18rpx;
  color: #646a73;
  font-size: 24rpx;
  font-weight: 500;
  transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
}

.week-day:active .week-number {
  background-color: #f1f4f9;
  transform: scale(0.94);
}

.week-count-dot {
  width: 7rpx;
  height: 7rpx;
  margin-top: 8rpx;
  border-radius: 50%;
  background-color: #b9c8e7;
  opacity: 0;
}

.week-count-dot.visible {
  opacity: 1;
}

.week-day.selected .week-label {
  color: #3370ff;
}

.week-day.selected .week-number {
  background-color: #3370ff;
  color: #ffffff;
}

.week-day.selected:active .week-number {
  background-color: #2f68eb;
}

.week-day.selected .week-count-dot {
  background-color: #3370ff;
}

/* 下拉日历 */
.calendar-dropdown {
  margin: 16rpx -32rpx -28rpx;
  padding: 26rpx 32rpx 30rpx;
  border-top: 1rpx solid #edf1f7;
  border-radius: 0 0 32rpx 32rpx;
  background-color: #ffffff;
}

.calendar-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.3);
  z-index: 100;
}

.calendar-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 20rpx;
}

.nav-arrow {
  font-size: 40rpx;
  color: #8f959e;
  padding: 8rpx 16rpx;
}

.nav-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2329;
}

.weekday-row {
  display: flex;
  padding-bottom: 12rpx;
}

.weekday-cell {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #b0b5bb;
}

.day-grid {
  display: flex;
  flex-wrap: wrap;
}

.day-cell {
  width: 14.2857%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0;
  position: relative;
}

.day-cell text {
  font-size: 26rpx;
  color: #1f2329;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.day-cell.other text {
  color: #d0d3d6;
}

.day-cell.today text {
  color: #3370ff;
  font-weight: 500;
}

.day-cell.selected text {
  background-color: #3370ff;
  color: #ffffff;
  font-weight: 500;
}

.day-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #3370ff;
  margin-top: 4rpx;
}

/* 排序按钮 */
.edit-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 8rpx;
  background-color: #f2f3f5;
  flex-shrink: 0;
}

.edit-toggle text {
  font-size: 22rpx;
  color: #4e535a;
  font-weight: 500;
}

.edit-toggle.active {
  background-color: #3370ff;
}

.edit-toggle.active text {
  color: #ffffff;
}

/* 连续名单：与客户首页保持“一组一卡、组内分行” */
.visit-section {
  padding-top: 270rpx;
}

.list-heading {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 40rpx 16rpx;
}

.list-heading-dot {
  width: 12rpx;
  height: 12rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background-color: #f4dc84;
}

.list-heading-title {
  color: #646a73;
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.list-heading-count {
  color: #b0b5bb;
  font-size: 22rpx;
}

.list-heading-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-left: auto;
  flex-shrink: 0;
}

.visit-list {
  position: relative;
  overflow: hidden;
  margin: 0 24rpx 20rpx;
  border-radius: 24rpx;
  background-color: #ffffff;
}

.visit-items {
  transition: opacity 160ms ease, transform 160ms ease;
}

.visit-items.switching {
  opacity: 0.42;
  pointer-events: none;
  transform: translateY(3rpx);
}

.switching-line {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 2;
  width: 34%;
  height: 4rpx;
  border-radius: 999rpx;
  background-color: #3370ff;
  animation: switching-slide 900ms ease-in-out infinite;
}

@keyframes switching-slide {
  0% {
    opacity: 0.35;
    transform: translateX(-100%);
  }
  50% {
    opacity: 1;
  }
  100% {
    opacity: 0.35;
    transform: translateX(395%);
  }
}

/* 浮动按钮 */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 200rpx;
  z-index: 20;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background-color: #3370ff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.export-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 8rpx;
  background-color: #f2f3f5;
  flex-shrink: 0;
}

.export-btn text {
  font-size: 22rpx;
  color: #4e535a;
  font-weight: 500;
}

.fab-icon {
  font-size: 52rpx;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: -4rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 406rpx 0 0;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 28rpx;
  border-radius: 50%;
  background-color: #f2f3f5;
  color: #c9cdd4;
  font-size: 0;
}

.empty-icon::after {
  color: #c9cdd4;
  content: '空';
  font-size: 40rpx;
  font-weight: 500;
}

.empty-text {
  color: #4e535a;
  font-size: 30rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #c9cdd4;
  margin-top: 12rpx;
}

.loading {
  display: flex;
  justify-content: center;
  padding: 406rpx 0 0;
  color: #b0b5bb;
  font-size: 28rpx;
}
