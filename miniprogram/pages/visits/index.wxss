.page {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding-bottom: 140rpx;
}

/* 日期选择器 */
.date-strip {
  background-color: #ffffff;
  white-space: nowrap;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
  position: relative;
  z-index: 10;
}

.date-items {
  display: flex;
  padding: 20rpx 16rpx;
}

.date-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 28rpx;
  border-radius: 12rpx;
  position: relative;
  min-width: 80rpx;
}

.date-item.active {
  background-color: #f0f5ff;
}

.date-item.active .date-weekday {
  color: #3370ff;
}

.date-item.active .date-day {
  color: #3370ff;
  font-weight: 600;
}

.date-item.active .date-count {
  color: #c9cdd4;
}

.date-weekday {
  font-size: 22rpx;
  color: #8f959e;
}

.date-day {
  font-size: 34rpx;
  font-weight: 500;
  color: #1f2329;
  margin-top: 6rpx;
}

.date-count {
  font-size: 20rpx;
  color: #c9cdd4;
  margin-top: 4rpx;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 32rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #f0f1f2;
}

.date-picker {
  display: flex;
  align-items: center;
}

.date-label {
  font-size: 26rpx;
  color: #8f959e;
}

.space-picker {
  display: flex;
  align-items: center;
}

.space-label {
  font-size: 26rpx;
  color: #8f959e;
}

/* 排序按钮 */
.edit-toggle {
  display: flex;
  align-items: center;
  height: 52rpx;
  padding: 0 24rpx;
  background-color: #f2f3f5;
  border-radius: 12rpx;
  flex-shrink: 0;
  margin-left: auto;
}

.edit-toggle text {
  font-size: 26rpx;
  color: #4e535a;
}

.edit-toggle.active {
  background-color: #3370ff;
}

.edit-toggle.active text {
  color: #ffffff;
}

/* 访客列表 */
.visit-list {
  padding: 20rpx 32rpx;
}

/* 浮动按钮 */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 200rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
  background-color: #3370ff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(51, 112, 255, 0.25);
}

.fab-icon {
  font-size: 52rpx;
  color: #ffffff;
  line-height: 1;
}
