<view class="page">
  <!-- 客户搜索 -->
  <view class="section">
    <view class="section-title">客户</view>
    <view class="search-box">
      <input
        class="search-input"
        placeholder="搜索客户昵称"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        bindfocus="onSearchFocus"
      />
      <view class="search-results" wx:if="{{showResults && searchResults.length > 0}}">
        <view
          class="search-result-item"
          wx:for="{{searchResults}}"
          wx:key="id"
          bindtap="onSelectCustomer"
          data-customer="{{item}}"
        >
          <text>{{item.nickname}}</text>
        </view>
      </view>
    </view>
    <view class="selected-customer" wx:if="{{selectedCustomer}}">
      <text class="selected-name">{{selectedCustomer.nickname}}</text>
      <text class="selected-clear" bindtap="onClearCustomer">✕</text>
    </view>
  </view>

  <!-- 项目类型 -->
  <view class="section" wx:if="{{selectedCustomer}}">
    <view class="section-title">项目类型</view>
    <picker mode="selector" range="{{projectTypes}}" range-key="label" value="{{projectTypeIndex}}" bindchange="onProjectTypeChange">
      <view class="picker-value">
        <text>{{projectTypeIndex >= 0 ? projectTypes[projectTypeIndex].label : '请选择'}}</text>
        <text class="picker-arrow">›</text>
      </view>
    </picker>
  </view>

  <!-- 可退费项目列表 -->
  <view class="section" wx:if="{{availableItems.length > 0}}">
    <view class="section-title">选择项目</view>
    <view class="item-list">
      <view
        class="item-card {{selectedItem.id === item.id ? 'selected' : ''}}"
        wx:for="{{availableItems}}"
        wx:key="id"
        bindtap="onSelectItem"
        data-item="{{item}}"
      >
        <view class="item-main">
          <text class="item-name">{{item.project_name || item.card_type || item.nickname}}</text>
          <text class="item-paid">已付: ¥{{item.paid_amount}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-tip" wx:if="{{selectedCustomer && projectTypeIndex >= 0 && availableItems.length === 0}}">
    <text>暂无可退费的项目</text>
  </view>

  <!-- 退费金额 -->
  <view class="section" wx:if="{{selectedItem}}">
    <view class="section-title">退费金额</view>
    <input class="form-input" type="digit" placeholder="输入退费金额" value="{{refundAmount}}" bindinput="onAmountInput" />
    <view class="amount-tip" wx:if="{{selectedItem.paid_amount}}">已付金额: ¥{{selectedItem.paid_amount}}</view>
  </view>

  <!-- 提交 -->
  <view class="submit-area" wx:if="{{selectedItem}}">
    <button class="submit-btn" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}">确认退费</button>
  </view>
</view>
