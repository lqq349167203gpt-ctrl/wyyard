.page {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding: 24rpx 32rpx;
}

.section {
  margin-bottom: 28rpx;
}

.section-title {
  font-size: 26rpx;
  color: #8f959e;
  margin-bottom: 12rpx;
}

/* 搜索 */
.search-box {
  position: relative;
}

.search-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background-color: #ffffff;
  border: 2rpx solid #e8eaed;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.search-results {
  position: absolute;
  top: 84rpx;
  left: 0;
  right: 0;
  background-color: #ffffff;
  border: 2rpx solid #e8eaed;
  border-radius: 8rpx;
  max-height: 400rpx;
  overflow-y: auto;
  z-index: 100;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.search-result-item {
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #1f2329;
  border-bottom: 1rpx solid #f0f1f2;
}

.selected-customer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #f0f5ff;
  border: 2rpx solid #3370ff;
  border-radius: 8rpx;
  padding: 16rpx 24rpx;
  margin-top: 12rpx;
}

.selected-name {
  font-size: 28rpx;
  color: #3370ff;
}

.selected-clear {
  font-size: 28rpx;
  color: #8f959e;
  padding: 8rpx;
}

/* Picker */
.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  padding: 0 24rpx;
  background-color: #ffffff;
  border: 2rpx solid #e8eaed;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.picker-arrow {
  font-size: 32rpx;
  color: #c0c4cc;
}

/* 项目列表 */
.item-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.item-card {
  background-color: #ffffff;
  border: 2rpx solid #e8eaed;
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
}

.item-card.selected {
  border-color: #3370ff;
  background-color: #f0f5ff;
}

.item-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-name {
  font-size: 28rpx;
  color: #1f2329;
}

.item-paid {
  font-size: 26rpx;
  color: #3370ff;
}

.empty-tip {
  text-align: center;
  padding: 40rpx;
  font-size: 26rpx;
  color: #c0c4cc;
}

/* 表单 */
.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background-color: #ffffff;
  border: 2rpx solid #e8eaed;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.amount-tip {
  font-size: 24rpx;
  color: #8f959e;
  margin-top: 8rpx;
}

/* 提交 */
.submit-area {
  margin-top: 48rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 30rpx;
  font-weight: 500;
  background: linear-gradient(135deg, #3370ff 0%, #5b8def 100%);
  color: #ffffff;
  border-radius: 16rpx;
  border: none;
}

.submit-btn::after {
  border: none;
}
