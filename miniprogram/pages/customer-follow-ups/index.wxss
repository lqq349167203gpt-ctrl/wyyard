/* overflow-x: hidden 兜底：任何一行内容过长都不许把整页撑宽 */
.page { min-height: 100vh; background: #f7f8fa; padding: 24rpx; box-sizing: border-box; color: #1f2329; font-size: 26rpx; overflow-x: hidden; }

/* 搜索：按昵称或姓名 */
.search-card { display: flex; align-items: center; gap: 12rpx; padding: 16rpx 20rpx; border-radius: 12rpx; background: #fff; margin-bottom: 12rpx; box-sizing: border-box; max-width: 100%; }
/* 输入框用 width:0 + flex:1，长内容才不会把这一行顶出去 */
.search-input { flex: 1; width: 0; min-width: 0; height: 64rpx; padding: 0 16rpx; box-sizing: border-box; border-radius: 8rpx; background: #f5f6f7; font-size: 25rpx; }
.search-button { flex-shrink: 0; padding: 0 24rpx; height: 64rpx; line-height: 64rpx; border-radius: 8rpx; background: #3370ff; color: #fff; font-size: 25rpx; }
.search-reset { flex-shrink: 0; padding: 0 12rpx; height: 64rpx; line-height: 64rpx; color: #8f959e; font-size: 24rpx; }

.record-card { padding: 22rpx 24rpx; border-radius: 12rpx; background: #fff; margin-bottom: 12rpx; box-sizing: border-box; max-width: 100%; overflow: hidden; }
/* 一行：到店日期在最左，昵称紧跟着身份 */
.record-head { display: flex; align-items: center; gap: 12rpx; }
.record-date { flex-shrink: 0; font-size: 23rpx; color: #8f959e; }
.record-title { display: flex; align-items: center; gap: 8rpx; flex: 1; min-width: 0; }
.record-name { flex-shrink: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 28rpx; font-weight: 500; color: #1f2329; }
.record-identity { flex-shrink: 0; max-width: 260rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 2rpx 10rpx; border-radius: 6rpx; background: #f2f3f5; font-size: 20rpx; line-height: 1.5; color: #646a73; }
.record-activity { display: flex; align-items: baseline; gap: 12rpx; margin-top: 8rpx; min-width: 0; }
/* 当天没参加活动：用很短的浅灰横线，不用文字 */
.record-activity-empty { width: 20rpx; height: 2rpx; border-radius: 2rpx; background: #e5e8eb; }
.record-activity-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 24rpx; color: #4e535a; }
.record-field { display: flex; align-items: flex-start; gap: 12rpx; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #f2f3f5; }
.record-field-label { flex-shrink: 0; width: 116rpx; font-size: 23rpx; color: #9aa1a9; }
.record-field-value { flex: 1; min-width: 0; font-size: 25rpx; line-height: 1.6; color: #2b2f36; word-break: break-all; overflow-wrap: anywhere; }
/* 长文本先收四行，点一下进编辑面板能看到全文 */
.record-field-value { display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
/* 没填过的位置做成输入框的样子，点一下就能填 */
.record-field-input { flex: 1; min-width: 0; height: 60rpx; line-height: 58rpx; padding: 0 16rpx; box-sizing: border-box; border: 1rpx solid #e1e4e7; border-radius: 8rpx; background: #fafbfc; font-size: 23rpx; color: #9aa1a9; }
.record-updated { display: block; margin-top: 14rpx; font-size: 21rpx; color: #b0b5bb; }

.loading, .end { padding: 24rpx 0 48rpx; text-align: center; }
.empty { padding: 96rpx 24rpx; text-align: center; }
.error { padding: 20rpx 0; color: #c4506a; }
.muted { font-size: 24rpx; color: #8f959e; line-height: 1.6; }

/* 修改内容：底部弹层（和其它页面同一套） */
.sheet-mask { position: fixed; inset: 0; z-index: 200; background: rgba(31,35,41,.34); }
/* 弹层最高 82vh：正文自己滚，标题和按钮永远看得见 */
.edit-sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 201; display: flex; flex-direction: column; max-height: 82vh; border-radius: 16rpx 16rpx 0 0; background: #fff; padding-bottom: env(safe-area-inset-bottom); }
.sheet-head { display: flex; align-items: center; justify-content: space-between; padding: 26rpx 30rpx; border-bottom: 1rpx solid #f0f0f0; }
.sheet-title { font-size: 28rpx; font-weight: 500; }
.sheet-close { font-size: 25rpx; color: #3370ff; }
.edit-body { flex: 1; min-height: 0; padding: 24rpx 30rpx 8rpx; box-sizing: border-box; }
.edit-subtitle { display: block; font-size: 22rpx; line-height: 1.6; color: #8f959e; word-break: break-all; }
.edit-input { width: 100%; height: 42vh; margin-top: 16rpx; padding: 18rpx; box-sizing: border-box; border-radius: 8rpx; background: #f5f6f7; font-size: 25rpx; line-height: 1.6; }
/* 按钮和「退课 / 保存规则」那些弹层一致：左右等宽，取消描边、保存主色 */
.edit-actions { display: flex; gap: 20rpx; padding: 20rpx 30rpx 26rpx; }
.edit-button { display: flex; align-items: center; justify-content: center; flex: 1 1 0; width: 0; height: 72rpx; border-radius: 8rpx; border: 1rpx solid #dfe2e6; font-size: 25rpx; font-weight: 500; color: #646a73; background: #fff; }
.edit-button.confirm { border-color: #3370ff; background: #3370ff; color: #fff; }
.edit-button.disabled { opacity: .6; }
