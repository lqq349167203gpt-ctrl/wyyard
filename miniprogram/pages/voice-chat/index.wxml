<page-meta page-style="{{kbHeight > 0 ? 'overflow:hidden;height:100vh;' : ''}}" />
<view class="page">
  <!-- 消息区域 -->
  <scroll-view class="messages" scroll-y scroll-top="{{scrollTop}}" scroll-into-view="{{scrollTarget}}">
    <view class="msg-list">
      <!-- 引导消息 -->
      <view class="msg-row bot" id="msg-guide">
        <view class="msg-bubble bot">
          <text wx:if="{{mode === 'visit'}}">告诉我你需要什么，比如：</text>
          <text wx:elif="{{mode === 'activity'}}">告诉我你需要什么，比如：</text>
          <text wx:else>告诉我你需要什么，比如：</text>
          <text class="msg-example" wx:if="{{mode === 'visit'}}">"余墨今天来" / "余墨到了" / "今天谁来了"</text>
          <text class="msg-example" wx:elif="{{mode === 'activity'}}">"下午2点加个颂钵" / "今天有什么课" / "把觉醒改到3点"</text>
          <text class="msg-example" wx:else>"加一个张三，女，28岁" / "张三的电话改成138xxx" / "张三的信息"</text>
        </view>
      </view>

      <!-- 消息列表 -->
      <block wx:for="{{messages}}" wx:key="id">
        <view class="msg-row user" wx:if="{{item.type === 'user'}}" id="{{item.id}}">
          <view class="msg-bubble user">
            <text>{{item.text}}</text>
          </view>
        </view>

        <view class="msg-row bot" wx:if="{{item.type === 'ai'}}" id="{{item.id}}">
          <view class="msg-bubble bot">
            <text class="msg-ai-title" wx:if="{{item.status !== 'saved'}}">{{item.customerData.id ? '已找到客户，修改后信息如下：' : '我识别到以下信息，请确认是否正确：'}}</text>
            <view class="msg-fields">
              <view class="msg-field" wx:for="{{item.fields}}" wx:for-item="f" wx:key="key" wx:if="{{f.value}}">
                <text class="msg-field-label">{{f.label}}</text>
                <text class="msg-field-value">{{f.value}}</text>
              </view>
            </view>
            <view class="msg-error-reason" wx:if="{{item.status === 'blocked'}}">
              <text class="error-reason-text">{{item.errorMsg}}</text>
            </view>
            <view class="msg-actions" wx:if="{{item.status === 'pending'}}">
              <view class="msg-action-btn confirm" bindtap="onDirectSave" data-index="{{index}}">
                <text>{{item.customerData.id ? '确认修改' : '直接保存'}}</text>
              </view>
              <view class="msg-action-btn edit" bindtap="onEditResult" data-index="{{index}}">
                <text>有误，前往修改</text>
              </view>
            </view>
            <view class="msg-actions" wx:if="{{item.status === 'blocked'}}">
              <view class="msg-action-btn edit" bindtap="onEditResult" data-index="{{index}}">
                <text>前往修改</text>
              </view>
            </view>
            <text class="msg-hint" wx:if="{{item.status === 'pending'}}">如果部分信息有误，你也可以继续在下方描述来补充</text>
            <view class="msg-status" wx:if="{{item.status === 'saving'}}">
              <view class="spinner-sm"></view>
              <text class="msg-status-text">正在保存...</text>
            </view>
            <view class="msg-status" wx:if="{{item.status === 'saved'}}">
              <text class="msg-status-text">已保存</text>
              <view class="msg-action-btn confirm" style="margin-top: 12rpx;" bindtap="onContinueEdit" data-index="{{index}}">
                <text>继续修改此客户</text>
              </view>
            </view>
          </view>
        </view>

        <view class="msg-row bot" wx:if="{{item.type === 'ai-text'}}" id="{{item.id}}">
          <view class="msg-bubble bot">
            <text>{{item.text}}</text>
          </view>
        </view>

        <view class="msg-row bot" wx:if="{{item.type === 'error'}}" id="{{item.id}}">
          <view class="msg-bubble bot error">
            <text>{{item.text}}</text>
          </view>
        </view>

        <view class="msg-row bot" wx:if="{{item.type === 'thinking'}}" id="{{item.id}}">
          <view class="msg-bubble bot thinking">
            <view class="msg-loading">
              <view class="spinner-sm"></view>
              <text>{{item.text}}</text>
            </view>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>

  <!-- 输入区域 -->
  <view class="input-bar" style="margin-bottom: {{kbHeight}}px;">
    <input
      wx:if="{{inputMode === 'text'}}"
      class="text-input"
      placeholder="{{mode === 'activity' ? '输入课表指令...' : mode === 'customer' ? '输入客户指令...' : '输入邀约人员信息...'}}"
      placeholder-style="color: #b0b5bb;"
      value="{{inputText}}"
      bindinput="onTextInput"
      confirm-type="send"
      bindconfirm="onTextSend"
      adjust-position="{{false}}"
      bindfocus="onInputFocus"
      bindblur="onInputBlur"
    />
    <view wx:if="{{inputMode === 'text' && !inputText}}" class="mode-btn" bindtap="onSwitchToVoice">
      <image class="mode-img" src="data:image/svg+xml;base64," mode="aspectFit" />
    </view>
    <view wx:if="{{inputMode === 'text' && inputText}}" class="send-btn" bindtap="onTextSend">
      <image class="send-icon" src="data:image/svg+xml;base64," mode="aspectFit" />
    </view>

    <view
      wx:if="{{inputMode === 'voice'}}"
      class="press-btn {{isRecording ? 'recording' : ''}}"
      bindtouchstart="onRecordStart"
      bindtouchend="onRecordStop"
      bindtouchcancel="onRecordCancel"
    >
      <text class="press-text">{{isRecording ? '松开发送' : '按住说话'}}</text>
    </view>
    <view wx:if="{{inputMode === 'voice'}}" class="mode-btn" bindtap="onSwitchToText">
      <image class="mode-img" src="data:image/svg+xml;base64," mode="aspectFit" />
    </view>
  </view>
</view>
