.container {
  padding: 24rpx 32rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
}

.form-label.required::before {
  content: '*';
  color: #f54a45;
  margin-right: 4rpx;
}

.placeholder {
  color: #b0b5bb;
}

.picker-display.placeholder {
  color: #b0b5bb;
}

.form-picker {
  flex: 1;
  min-width: 0;
}

.form-input {
  text-align: right;
}

.contact-field {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
}

.contact-field .form-input {
  flex: 1;
  min-width: 0;
}

.contact-field .form-input[disabled] {
  color: #646a73;
  opacity: 1;
}

.contact-action {
  flex-shrink: 0;
  color: #646a73;
  font-size: 24rpx;
  line-height: 44rpx;
}

.contact-action:active {
  color: #1f2329;
}

.picker-display {
  flex: 1;
  font-size: 28rpx;
  color: #1f2329;
  text-align: right;
}

.submit-btn {
  flex: 1;
  font-size: 32rpx;
  padding: 0 8rpx !important;
}

.btn-row {
  display: flex;
  gap: 32rpx;
  margin-top: 48rpx;
  padding: 0 28rpx 20rpx;
}

.btn-row .btn-danger {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  color: #e34d59;
  background-color: #fff;
  border-radius: 12rpx;
  border: 1rpx solid #e34d59;
  padding: 0 8rpx !important;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-row .btn-danger[disabled] {
  opacity: 0.5;
}

.btn-row .submit-btn {
  margin-top: 0;
}

/* 搜索选择 */
.picker-value-wrap {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 1;
  min-width: 0;
}

.picker-clear {
  font-size: 30rpx;
  color: #b0b5bb;
  padding: 8rpx 16rpx;
  flex-shrink: 0;
}

/* 日期选择前后保持固定行高，避免清除按钮出现时撑高表单行 */
.date-picker-value,
.date-picker-value .form-picker,
.date-picker-value .picker-display,
.date-picker-clear {
  height: 40rpx;
}

.date-picker-value .picker-display,
.date-picker-clear {
  line-height: 40rpx;
}

.date-picker-clear {
  box-sizing: border-box;
  padding: 0 16rpx;
}

/* 弹窗 */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.picker-popup {
  position: fixed;
  left: 0;
  right: 0;
  top: 96rpx;
  bottom: 0;
  background-color: #ffffff;
  border-radius: 0 0 24rpx 24rpx;
  z-index: 101;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f1f2;
}

.picker-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1f2329;
}

.picker-close {
  font-size: 28rpx;
  color: #8f959e;
  padding: 8rpx;
}

.picker-search {
  padding: 16rpx 32rpx;
}

.picker-search-input {
  height: 72rpx;
  background-color: #f2f3f5;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}

.picker-list {
  flex: 1;
  height: 0;
}

.picker-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f5f6f7;
}

.picker-item:active {
  background-color: #f7f8fa;
}

.picker-item-name {
  font-size: 30rpx;
  color: #1f2329;
}

.picker-item-type {
  font-size: 24rpx;
  color: #8f959e;
  background-color: #f0f1f2;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.form-textarea.short {
  min-height: 120rpx;
  height: 120rpx;
}

.picker-empty {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
  color: #b0b5bb;
  font-size: 28rpx;
}

/* 每组最后一个输入框去掉下划线 */
.form-item.last {
  border-bottom: none;
}

.tag-field-value {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.tag-field-text {
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 28rpx;
  color: #1f2329;
}

.tag-field-arrow {
  margin-left: 12rpx;
  font-size: 38rpx;
  line-height: 1;
  color: #b0b5bb;
}

.tag-picker-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 120;
  background-color: rgba(0, 0, 0, 0.42);
}

.tag-picker-popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 121;
  display: flex;
  flex-direction: column;
  max-height: 78vh;
  overflow: hidden;
  border-radius: 20rpx 20rpx 0 0;
  background-color: #fff;
}

.tag-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f1f2;
}

.tag-picker-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1f2329;
}

.tag-picker-close {
  padding: 8rpx;
  font-size: 26rpx;
  color: #8f959e;
}

.tag-picker-list {
  flex: 1;
  min-height: 180rpx;
  max-height: 560rpx;
}

.tag-picker-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f5f6f7;
}

.tag-picker-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  gap: 16rpx;
}

.tag-picker-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 28rpx;
  color: #1f2329;
}

.tag-picker-scope {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #8f959e;
}

.tag-picker-empty {
  padding: 70rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #b0b5bb;
}

.tag-create-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  border-top: 1rpx solid #f0f1f2;
}

.tag-create-input {
  flex: 1;
  height: 68rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  border: 1rpx solid #e8eaed;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #1f2329;
}

.tag-create-button {
  width: 120rpx;
  height: 68rpx;
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  background-color: #f0f4ff;
  color: #3370ff;
  font-size: 26rpx;
  line-height: 68rpx;
}

.tag-picker-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f1f2;
}

.tag-picker-cancel,
.tag-picker-confirm {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  box-sizing: border-box;
  height: 76rpx;
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 1;
  text-align: center;
}

.tag-picker-cancel::after,
.tag-picker-confirm::after {
  border: none;
}

.tag-picker-cancel {
  border: 1rpx solid #e8eaed;
  background-color: #fff;
  color: #4e535a;
}

.tag-picker-confirm {
  background-color: #3370ff;
  color: #fff;
}
