.page {
  min-height: 100vh;
  background-color: #f7f8fa;
}

/* 日历 */
.calendar {
  background-color: #ffffff;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
  position: relative;
  z-index: 101;
}

.calendar-header {
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.summary-date {
  font-size: 28rpx;
  color: #8f959e;
}

.summary-space {
  font-size: 28rpx;
  color: #8f959e;
}

/* 下拉日历 */

.calendar-dropdown {
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #f0f1f2;
  background-color: #ffffff;
}

.calendar-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.3);
  z-index: 100;
}

.calendar-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 24rpx;
}

.nav-arrow {
  font-size: 40rpx;
  color: #8f959e;
  padding: 8rpx 16rpx;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1f2329;
}

.weekday-row {
  display: flex;
  padding-bottom: 12rpx;
}

.weekday-cell {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #b0b5bb;
}

.day-grid {
  display: flex;
  flex-wrap: wrap;
}

.day-cell {
  width: 14.2857%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0;
  position: relative;
}

.day-cell text {
  font-size: 28rpx;
  color: #1f2329;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.day-cell.other text {
  color: #d0d3d6;
}

.day-cell.today text {
  color: #3370ff;
  font-weight: 600;
}

.day-cell.selected text {
  background-color: #3370ff;
  color: #ffffff;
  font-weight: 600;
}

.day-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #3370ff;
  margin-top: 4rpx;
}

/* 活动列表 */
.activity-list {
  padding: 20rpx 32rpx;
}

.activity-card {
  background-color: #ffffff;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
  display: flex;
  overflow: hidden;
  position: relative;
}

.card-body {
  flex: 1;
  padding: 24rpx 28rpx;
  min-width: 0;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.card-title {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  min-width: 0;
  flex: 1;
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.card-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #1f2329;
  margin-left: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

.card-time {
  font-size: 24rpx;
  color: #8f959e;
  flex-basis: 100%;
  margin-top: 8rpx;
}

.card-info {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.info-item {
  font-size: 24rpx;
  color: #8f959e;
}

.card-arrow-wrap {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-participants {
  font-size: 24rpx;
  color: #8f959e;
}

.card-arrow {
  font-size: 36rpx;
  color: #d0d3d6;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #b0b5bb;
}

.loading {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
  color: #8f959e;
  font-size: 28rpx;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 200rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
  background-color: #3370ff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(51, 112, 255, 0.25);
}

.fab-icon {
  font-size: 52rpx;
  color: #ffffff;
  line-height: 1;
}
