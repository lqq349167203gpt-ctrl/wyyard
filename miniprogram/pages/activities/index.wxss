.page {
  min-height: 100vh;
  background-color: #f7f8fa;
}

/* 头部 */
.head {
  background-color: #ffffff;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 101;
  padding: 24rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #ebedf0;
}

.head-row {
  display: flex;
  align-items: center;
}

.head-date {
  display: flex;
  align-items: baseline;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

.head-date .wk {
  font-size: 26rpx;
  font-weight: 400;
  color: #646a73;
  margin-left: 10rpx;
}

.head-date .drop {
  font-size: 22rpx;
  color: #8f959e;
  margin-left: 8rpx;
}

.head-space {
  margin-left: auto;
  font-size: 24rpx;
  color: #646a73;
  background-color: #f2f3f5;
  padding: 8rpx 18rpx;
  border-radius: 6rpx;
}

.head-parti {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #8f959e;
}

.head-parti .cnt {
  color: #646a73;
  font-weight: 500;
}

/* 下拉日历 */
.calendar-dropdown {
  margin: 20rpx -32rpx -20rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #f0f1f2;
  background-color: #ffffff;
}

.calendar-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.3);
  z-index: 100;
}

.calendar-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 24rpx;
}

.nav-arrow {
  font-size: 40rpx;
  color: #8f959e;
  padding: 8rpx 16rpx;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1f2329;
}

.weekday-row {
  display: flex;
  padding-bottom: 12rpx;
}

.weekday-cell {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #b0b5bb;
}

.day-grid {
  display: flex;
  flex-wrap: wrap;
}

.day-cell {
  width: 14.2857%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0;
  position: relative;
}

.day-cell text {
  font-size: 28rpx;
  color: #1f2329;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.day-cell.other text {
  color: #d0d3d6;
}

.day-cell.today text {
  color: #3370ff;
  font-weight: 600;
}

.day-cell.selected text {
  background-color: #3370ff;
  color: #ffffff;
  font-weight: 600;
}

.day-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #3370ff;
  margin-top: 4rpx;
}

/* 活动列表 */
.list {
  padding: 156rpx 0 20rpx;
}

.group-label {
  font-size: 22rpx;
  color: #8f959e;
  padding: 4rpx 32rpx 10rpx;
}

.group:first-child .group-label {
  padding-top: 0;
}

.card {
  background-color: #ffffff;
  border-radius: 8rpx;
  margin: 0 24rpx 16rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  min-height: 100rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}

.card-time {
  width: 92rpx;
  flex-shrink: 0;
}

.card-time .t1 {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  display: block;
  font-variant-numeric: tabular-nums;
}

.card-time .t2 {
  font-size: 21rpx;
  color: #8f959e;
  display: block;
  margin-top: 4rpx;
  font-variant-numeric: tabular-nums;
}

.card-mid {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.card-line1 {
  display: flex;
  align-items: center;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  margin-left: 12rpx;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.type {
  font-size: 22rpx;
  color: #8f959e;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.card-line2 {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #646a73;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-height: 32rpx;
}

.card-right {
  flex-shrink: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.ppl {
  font-size: 24rpx;
  color: #646a73;
}

.status {
  font-size: 22rpx;
  color: #8f959e;
  margin-top: 6rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #b0b5bb;
}

.loading {
  display: flex;
  justify-content: center;
  padding: 200rpx 0 0;
  color: #8f959e;
  font-size: 28rpx;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 200rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background-color: #3370ff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(51, 112, 255, 0.25);
}

.fab-icon {
  font-size: 52rpx;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: -4rpx;
}
