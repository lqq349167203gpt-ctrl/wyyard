.page {
  min-height: 100vh;
  background-color: #f7f8fa;
}

/* 日期选择器 */
.date-strip {
  background-color: #ffffff;
  white-space: nowrap;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
  position: relative;
  z-index: 10;
}

.date-items {
  display: flex;
  padding: 20rpx 16rpx;
}

.date-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 28rpx;
  border-radius: 12rpx;
  position: relative;
  min-width: 80rpx;
}

.date-item.active {
  background-color: #f0f5ff;
}

.date-item.active .date-weekday {
  color: #3370ff;
}

.date-item.active .date-day {
  color: #3370ff;
  font-weight: 600;
}

.date-weekday {
  font-size: 22rpx;
  color: #8f959e;
}

.date-day {
  font-size: 34rpx;
  font-weight: 500;
  color: #1f2329;
  margin-top: 6rpx;
}

.date-count {
  font-size: 20rpx;
  color: #c9cdd4;
  margin-top: 4rpx;
}

.date-item.active .date-count {
  color: #c9cdd4;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 32rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #f0f1f2;
}

.date-picker {
  display: flex;
  align-items: center;
}

.date-label {
  font-size: 26rpx;
  color: #8f959e;
}

.space-picker {
  display: flex;
  align-items: center;
}

.space-label {
  font-size: 26rpx;
  color: #8f959e;
}

/* 活动列表 */
.activity-list {
  padding: 20rpx 32rpx;
}

.activity-card {
  background-color: #ffffff;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
  display: flex;
  overflow: hidden;
  position: relative;
}

.card-body {
  flex: 1;
  padding: 24rpx 28rpx;
  min-width: 0;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.card-title {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.card-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #1f2329;
  margin-left: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

.card-time {
  font-size: 24rpx;
  color: #8f959e;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.card-info {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.info-item {
  font-size: 24rpx;
  color: #8f959e;
}

.card-arrow {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  color: #d0d3d6;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 200rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
  background-color: #3370ff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(51, 112, 255, 0.25);
}

.fab-icon {
  font-size: 52rpx;
  color: #ffffff;
  line-height: 1;
}
