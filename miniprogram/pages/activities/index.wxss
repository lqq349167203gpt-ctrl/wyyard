.page {
  min-height: 100vh;
  background-color: #f7f8fa;
}

/* 头部 */
.head {
  background-color: #f3f7ff;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 101;
  padding: 20rpx 32rpx 28rpx;
}

.head-row {
  display: flex;
  align-items: center;
  min-height: 72rpx;
}

.head-date {
  display: flex;
  align-items: center;
  font-size: 42rpx;
  font-weight: 500;
  color: #1f2329;
}

.head-date .wk {
  margin-left: 14rpx;
  color: #8f959e;
  font-size: 24rpx;
  font-weight: 400;
}

.head-date .drop {
  margin-left: 12rpx;
  color: #8f959e;
  font-size: 22rpx;
}

.head-space {
  margin-left: auto;
  padding: 14rpx 22rpx;
  border-radius: 20rpx;
  background-color: #ffffff;
  color: #646a73;
  font-size: 24rpx;
}

.head-row2 {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.head-parti {
  min-width: 0;
  font-size: 23rpx;
  color: #8f959e;
  white-space: nowrap;
}

.head-parti .cnt {
  color: #646a73;
  font-weight: 500;
}

.head-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-left: auto;
  flex-shrink: 0;
}

.lock-bar {
  display: flex;
  align-items: center;
  min-height: 52rpx;
  margin-top: 8rpx;
  padding: 0 6rpx 0 14rpx;
  border: 1rpx solid #dee0e3;
  border-radius: 12rpx;
  background-color: rgba(255, 255, 255, 0.82);
}

.lock-bar.locked {
  border-color: #b7d0ff;
  background-color: #f0f5ff;
}

.lock-status {
  display: flex;
  align-items: center;
  min-width: 0;
  color: #8f959e;
  font-size: 22rpx;
}

.lock-bar.locked .lock-status { color: #245bdb; }
.lock-status-icon { margin-right: 8rpx; font-size: 21rpx; }
.lock-operator { overflow: hidden; margin-left: 5rpx; color: #8f959e; text-overflow: ellipsis; white-space: nowrap; }

.lock-action {
  height: 42rpx;
  margin: 0 0 0 auto;
  padding: 0 16rpx;
  border: 0;
  border-radius: 8rpx;
  background-color: transparent;
  color: #3370ff;
  font-size: 21rpx;
  line-height: 42rpx;
}

.lock-action::after { border: 0; }

/* 当前周日期条 */
.week-swiper {
  width: 100%;
  height: 142rpx;
  margin-top: 12rpx;
  border-radius: 28rpx;
  background-color: rgba(255, 255, 255, 0.78);
  overflow: hidden;
}

.week-strip {
  display: flex;
  width: 100%;
  height: 142rpx;
  box-sizing: border-box;
  padding: 20rpx 14rpx 14rpx;
}

.week-day {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.week-label {
  color: #8f959e;
  font-size: 20rpx;
}

.week-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-top: 8rpx;
  border-radius: 18rpx;
  color: #646a73;
  font-size: 24rpx;
  font-weight: 500;
  transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
}

.week-day:active .week-number {
  background-color: #f1f4f9;
  transform: scale(0.94);
}

.week-count-dot {
  width: 7rpx;
  height: 7rpx;
  margin-top: 8rpx;
  border-radius: 50%;
  background-color: #b9c8e7;
  opacity: 0;
}

.week-count-dot.visible {
  opacity: 1;
}

.week-count-dot.verified {
  opacity: 1;
  background-color: #3370ff;
}

.week-day.selected .week-label {
  color: #3370ff;
}

.week-day.selected .week-number {
  background-color: #3370ff;
  color: #ffffff;
}

.week-day.selected:active .week-number {
  background-color: #2f68eb;
}

.week-day.selected .week-count-dot {
  background-color: #3370ff;
}

/* 下拉日历 */
.calendar-dropdown {
  margin: 16rpx -32rpx -28rpx;
  padding: 26rpx 32rpx 30rpx;
  border-top: 1rpx solid #edf1f7;
  border-radius: 0 0 32rpx 32rpx;
  background-color: #ffffff;
}

.calendar-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.3);
  z-index: 100;
}

.calendar-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 24rpx;
}

.nav-arrow {
  font-size: 40rpx;
  color: #8f959e;
  padding: 8rpx 16rpx;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1f2329;
}

.weekday-row {
  display: flex;
  padding-bottom: 12rpx;
}

.weekday-cell {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #b0b5bb;
}

.day-grid {
  display: flex;
  flex-wrap: wrap;
}

.day-cell {
  width: 14.2857%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0;
  position: relative;
}

.day-cell > text {
  font-size: 28rpx;
  color: #1f2329;
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.day-cell.other > text {
  color: #d0d3d6;
}

.day-cell.today > text {
  color: #3370ff;
  font-weight: 600;
}

.day-cell.selected > text {
  background-color: #3370ff;
  color: #ffffff;
  font-weight: 600;
}

.day-dot {
  position: absolute;
  top: 12rpx;
  right: 18rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #3370ff;
}

.day-check-status {
  min-height: 22rpx;
  margin-top: 2rpx;
  color: #b0b5bb;
  font-size: 18rpx;
  line-height: 22rpx;
}

.day-check-status.verified,
.day-cell.selected .day-check-status {
  color: #3370ff;
}

/* 活动列表：B 方案，按时段一组一卡 */
.list {
  position: relative;
  padding: 330rpx 0 20rpx;
}

.group-card {
  transition: opacity 160ms ease, transform 160ms ease;
}

.list.date-switching .group-card {
  opacity: 0.42;
  pointer-events: none;
  transform: translateY(3rpx);
}

.schedule-switching-line {
  position: absolute;
  top: 330rpx;
  left: 24rpx;
  z-index: 2;
  width: 34%;
  height: 4rpx;
  border-radius: 999rpx;
  background-color: #3370ff;
  animation: schedule-switching-slide 900ms ease-in-out infinite;
}

@keyframes schedule-switching-slide {
  0% {
    opacity: 0.35;
    transform: translateX(-100%);
  }
  50% {
    opacity: 1;
  }
  100% {
    opacity: 0.35;
    transform: translateX(395%);
  }
}

.group {
  margin-bottom: 16rpx;
}

.group-heading {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 40rpx 20rpx;
}

.group-heading-dot {
  width: 12rpx;
  height: 12rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background-color: #f4dc84;
}

.group-label {
  color: #646a73;
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.group-count {
  color: #b0b5bb;
  font-size: 22rpx;
}

.group-heading .withdraw-entry {
  margin-left: auto;
}

.group-card {
  overflow: hidden;
  margin: 0 24rpx;
  border-radius: 24rpx;
  background-color: #ffffff;
}

.group-card .card {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  margin-bottom: 0;
  padding: 16rpx 28rpx;
  border-radius: 0;
  background-color: #ffffff;
  box-shadow: none;
}

.group-card .card.roster-card {
  display: block;
  padding: 0;
}

.card-top {
  min-height: 94rpx;
  display: flex;
  align-items: center;
  padding: 16rpx 28rpx 12rpx;
}

.card-roster-strip {
  min-width: 0;
  display: flex;
  align-items: center;
  padding: 0 28rpx 16rpx 142rpx;
  color: #646a73;
  font-size: 22rpx;
}

.card-roster-strip:active {
  background-color: #f7f8fa;
}

.card-roster-names {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-roster-entry {
  flex-shrink: 0;
  margin-left: 18rpx;
  color: #3370ff;
  font-size: 24rpx;
}

.group-card .card + .card {
  border-top: 1rpx solid #f1f2f4;
}

.group-card .card:last-child {
  border-bottom: none;
}

.readonly-status {
  color: #8f959e;
  font-size: 22rpx;
}

.card-line2 .creator-text {
  margin-left: 16rpx;
  padding-left: 16rpx;
  border-left: 1rpx solid #e8eaed;
  color: #8f959e;
  font-size: 21rpx;
}

.card-line2 .creator-text:first-child {
  margin-left: 0;
  padding-left: 0;
  border-left: none;
}

.card-time {
  width: 92rpx;
  flex-shrink: 0;
}

.card-time .t1 {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  display: block;
  font-variant-numeric: tabular-nums;
}

.card-time .t2 {
  font-size: 21rpx;
  color: #8f959e;
  display: block;
  margin-top: 4rpx;
  font-variant-numeric: tabular-nums;
}

.card-mid {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.card-line1 {
  display: flex;
  align-items: center;
}

.welfare-tag {
  flex-shrink: 0;
  margin-right: 8rpx;
  color: #157a3c;
  font-size: 22rpx;
  font-weight: 400;
}

.name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.type {
  font-size: 22rpx;
  color: #8f959e;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.card-line2 {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #646a73;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-height: 32rpx;
}

.card-right {
  flex-shrink: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  gap: 10rpx;
}

.card-status-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
}

.status {
  font-size: 22rpx;
  color: #8f959e;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 466rpx 0 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #b0b5bb;
}

.loading {
  display: flex;
  justify-content: center;
  padding: 466rpx 0 0;
  color: #8f959e;
  font-size: 28rpx;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 200rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background-color: #3370ff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(51, 112, 255, 0.25);
}

.fab-icon {
  font-size: 52rpx;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: -4rpx;
}

.head-tools {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-left: auto;
}

.head-tools .head-space {
  margin-left: 0;
}

.withdraw-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 8rpx;
  background-color: #f2f3f5;
  flex-shrink: 0;
  color: #4e535a;
  font-size: 22rpx;
  font-weight: 500;
}

.withdraw-entry.disabled {
  color: #b7bdc6;
}

.withdraw-mask {
  position: fixed;
  z-index: 300;
  inset: 0;
  background: rgba(20, 24, 31, 0.42);
  animation: withdraw-mask-in 180ms ease-out;
}

.withdraw-sheet {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 301;
  overflow: hidden;
  border-radius: 24rpx 24rpx 0 0;
  background: #fff;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -8rpx 28rpx rgba(31, 35, 41, 0.1);
  animation: withdraw-sheet-in 220ms cubic-bezier(0.22, 0.61, 0.36, 1);
}

.withdraw-handle {
  width: 64rpx;
  height: 6rpx;
  margin: 14rpx auto 2rpx;
  border-radius: 999rpx;
  background: #dfe2e6;
}

.withdraw-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 32rpx 24rpx;
}

.withdraw-heading {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.withdraw-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1f2329;
}

.withdraw-subtitle {
  font-size: 22rpx;
  line-height: 1.4;
  color: #8f959e;
}

.withdraw-close {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 20rpx;
  font-size: 38rpx;
  font-weight: 300;
  line-height: 1;
  color: #8f959e;
  border-radius: 50%;
  background-color: transparent;
}

.withdraw-close:active {
  background-color: #e9ebee;
}

.withdraw-body {
  padding: 2rpx 32rpx 30rpx;
}

.withdraw-mode {
  display: flex;
  gap: 4rpx;
  margin-bottom: 26rpx;
  padding: 4rpx;
  border-radius: 10rpx;
  background: #f2f3f5;
}

.withdraw-mode-item {
  flex: 1;
  height: 58rpx;
  border-radius: 8rpx;
  font-size: 23rpx;
  line-height: 58rpx;
  text-align: center;
  color: #8f959e;
}

.withdraw-mode-item.active {
  background: #ffffff;
  color: #2b2f36;
  box-shadow: 0 2rpx 8rpx rgba(31, 35, 41, 0.06);
}

.withdraw-field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.withdraw-label {
  font-size: 23rpx;
  font-weight: 500;
  color: #4a5058;
}

.withdraw-picker {
  width: 100%;
}

.withdraw-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 76rpx;
  box-sizing: border-box;
  padding: 0 22rpx;
  border: 1rpx solid #dfe2e6;
  border-radius: 10rpx;
  background-color: #ffffff;
  font-size: 25rpx;
  color: #2b2f36;
}

.withdraw-value:active {
  border-color: #aeb4bc;
  background-color: #f7f8fa;
}

.withdraw-value-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.withdraw-chevron {
  width: 12rpx;
  height: 12rpx;
  flex-shrink: 0;
  margin: -6rpx 3rpx 0 20rpx;
  border-right: 2rpx solid #8f959e;
  border-bottom: 2rpx solid #8f959e;
  transform: rotate(45deg);
}

.withdraw-note {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 2rpx;
  padding: 4rpx 2rpx 0;
}

.withdraw-note-icon {
  width: 28rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2rpx;
  border: 1rpx solid #aeb4bc;
  border-radius: 50%;
  font-size: 19rpx;
  line-height: 1;
  color: #737982;
}

.withdraw-note-text {
  min-width: 0;
  font-size: 22rpx;
  line-height: 1.55;
  color: #737982;
}

.withdraw-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 32rpx 26rpx;
  border-top: 1rpx solid #f0f0f0;
}

.withdraw-cancel,
.withdraw-confirm {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 0;
  height: 72rpx;
  box-sizing: border-box;
  flex: 1 1 0;
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  font-size: 25rpx;
  font-weight: 500;
  line-height: normal;
}

.withdraw-cancel::after,
.withdraw-confirm::after {
  border: none;
}

.withdraw-cancel {
  border: 1rpx solid #dfe2e6;
  background: #ffffff;
  color: #646a73;
}

.withdraw-confirm {
  border: 1rpx solid #3370ff;
  background: #3370ff;
  color: #fff;
}

.withdraw-cancel[disabled],
.withdraw-confirm[disabled] {
  opacity: 0.55;
}

@keyframes withdraw-mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes withdraw-sheet-in {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.participant-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 120;
  background-color: rgba(31, 35, 41, 0.34);
  animation: withdraw-mask-in 180ms ease-out;
}

.participant-sheet {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 121;
  max-height: 86vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border-radius: 24rpx 24rpx 0 0;
  background-color: #ffffff;
  padding-bottom: env(safe-area-inset-bottom);
  animation: withdraw-sheet-in 220ms ease-out;
}

.participant-sheet-handle {
  width: 64rpx;
  height: 6rpx;
  flex-shrink: 0;
  margin: 14rpx auto 4rpx;
  border-radius: 3rpx;
  background-color: #dfe2e6;
}

.participant-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 22rpx;
  border-bottom: 1rpx solid #f0f1f2;
}

.participant-sheet-heading {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.participant-sheet-title {
  color: #1f2329;
  font-size: 30rpx;
  font-weight: 500;
}

.participant-sheet-title-row {
  display: flex;
  align-items: baseline;
}

.participant-sheet-count {
  margin-left: 10rpx;
  color: #8f959e;
  font-size: 26rpx;
  font-weight: 400;
}

.participant-sheet-subtitle {
  max-width: 560rpx;
  margin-top: 6rpx;
  overflow: hidden;
  color: #8f959e;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.participant-sheet-close {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 20rpx;
  border-radius: 50%;
  color: #8f959e;
  font-size: 38rpx;
  font-weight: 300;
  line-height: 1;
  background-color: #f2f3f5;
}

.participant-sheet-close:active {
  background-color: #f2f3f5;
}

.participant-sheet-list {
  max-height: 74vh;
}

.participant-sheet-item {
  display: flex;
  align-items: flex-start;
  margin: 0 32rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f1f2;
}

.participant-sheet-item:active {
  background-color: #f7f8fa;
}

.participant-sheet-content {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.participant-sheet-name-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.participant-sheet-avatar {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
  background-color: #f2f3f5;
  color: #646a73;
  font-size: 24rpx;
  margin-top: 2rpx;
}

.participant-sheet-name-wrap {
  min-width: 0;
  display: flex;
  align-items: center;
}

.participant-sheet-name {
  max-width: 300rpx;
  overflow: hidden;
  color: #2b2f36;
  font-size: 27rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.participant-sheet-withdrawn {
  margin-left: 12rpx;
  color: #c4506a;
  font-size: 21rpx;
}

.participant-no-visit {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  background-color: #f2f3f5;
  color: #8f959e;
  font-size: 19rpx;
}

.participant-sheet-link {
  flex-shrink: 0;
  margin-left: 20rpx;
  color: #3370ff;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1;
}

.participant-meta-line {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  margin-top: 8rpx;
  color: #646a73;
  font-size: 23rpx;
  font-variant-numeric: tabular-nums;
}

.participant-meta-value {
  color: #646a73;
}

.participant-meta-separator {
  margin: 0 10rpx;
  color: #ccd3da;
}

.participant-needs-row {
  display: flex;
  align-items: flex-start;
  margin-top: 8rpx;
  line-height: 1.55;
}

.participant-needs-label {
  flex-shrink: 0;
  color: #8f959e;
  font-size: 23rpx;
}

.participant-needs-value {
  min-width: 0;
  margin-left: 0;
  color: #646a73;
  font-size: 23rpx;
  white-space: pre-wrap;
  word-break: break-all;
}

.participant-sheet-empty {
  padding: 76rpx 0 92rpx;
  color: #b0b5bb;
  font-size: 26rpx;
  text-align: center;
}
