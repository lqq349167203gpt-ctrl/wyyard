<page-meta page-style="{{showWithdrawal || showParticipantSheet ? 'overflow:hidden;height:100vh;' : ''}}" />
<view class="page">
  <!-- 无权限 -->
  <view class="no-permission" wx:if="{{!hasPagePermission}}">
    <text class="no-permission-text">无权限访问此页面</text>
  </view>
  <block wx:else>
  <!-- 头部 -->
  <view class="head">
    <view class="head-row">
      <view class="head-date" bindtap="onCalendarToggle">
        <text>{{currentDateShort}}</text>
        <text class="wk">{{currentWeekday}}</text>
        <text class="drop">{{calendarExpanded ? '▴' : '▾'}}</text>
      </view>
      <view class="head-tools">
        <picker class="head-space" mode="selector" range="{{spaces}}" range-key="name" value="{{spaceIndex}}" bindchange="onSpaceChange">
          <text>{{currentSpaceName}}</text>
        </picker>
      </view>
    </view>
    <view class="lock-bar {{isDayLocked ? 'locked' : ''}}">
      <view class="lock-status">
        <view class="lock-status-icon"></view>
        <text>{{isDayLocked ? '已核对' : '未核对'}}</text>
        <text class="lock-operator" wx:if="{{isDayLocked && lockInfo.locked_by}}">· {{lockInfo.locked_by}}</text>
      </view>
      <view class="lock-action {{lockSubmitting || !spaceId ? 'disabled' : ''}}" wx:if="{{canManageActivityLock}}" bindtap="onLockToggle">
        {{lockSubmitting ? '处理中…' : (isDayLocked ? '解锁' : '核对并锁定')}}
      </view>
    </view>
    <!-- 三槽位周轮播：滑动完成后无感回中，可稳定连续切换前后周 -->
    <swiper
      wx:if="{{!calendarExpanded}}"
      class="week-swiper"
      current="{{weekSwiperCurrent}}"
      duration="{{weekSwiperDuration}}"
      easing-function="easeOutCubic"
      bindchange="onWeekSwiperChange"
    >
      <swiper-item wx:for="{{weekPages}}" wx:key="key" wx:for-item="weekPage">
        <view class="week-strip">
          <view
            wx:for="{{weekPage.days}}"
            wx:key="date"
            wx:for-item="day"
            class="week-day {{day.isSelected ? 'selected' : ''}}"
            catchtap="onCalendarDayTap"
            data-date="{{day.date}}"
          >
            <text class="week-label">{{day.weekday}}</text>
            <text class="week-number">{{day.day}}</text>
            <view class="week-count-dot {{day.count > 0 ? 'visible' : ''}} {{day.isLocked ? 'verified' : ''}}"></view>
          </view>
        </view>
      </swiper-item>
    </swiper>
    <!-- 下拉日历 -->
    <view class="calendar-dropdown" wx:if="{{calendarExpanded}}">
      <view class="calendar-nav">
        <view class="nav-arrow" catchtap="onPrevMonth">‹</view>
        <text class="nav-title">{{calYear}}年{{calMonth + 1}}月</text>
        <view class="nav-arrow" catchtap="onNextMonth">›</view>
      </view>
      <view class="weekday-row">
        <text class="weekday-cell" wx:for="{{weekdays}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="day-grid">
        <view
          wx:for="{{calendarDays}}"
          wx:key="date"
          class="day-cell {{item.isCurrent ? '' : 'other'}} {{item.isSelected ? 'selected' : ''}} {{item.isToday ? 'today' : ''}}"
          bindtap="onCalendarDayTap"
          data-date="{{item.date}}"
        >
          <text>{{item.day}}</text>
          <view class="day-dot {{item.isLocked ? 'verified' : ''}}" wx:if="{{item.isCurrent && (item.isLocked || item.count > 0)}}"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 遮罩 -->
  <view class="calendar-mask" wx:if="{{calendarExpanded}}" bindtap="onCalendarClose"></view>

  <!-- 活动列表（按时段分组） -->
  <view class="list {{dateSwitching ? 'date-switching' : ''}}" wx:if="{{!loading && records.length > 0}}">
    <view class="schedule-switching-line" wx:if="{{dateSwitching}}"></view>
    <view class="group" wx:for="{{timeGroups}}" wx:key="label" wx:for-item="group">
      <view class="group-heading">
        <view class="group-heading-dot"></view>
        <text class="group-label">{{group.label}}</text>
        <text class="group-count">{{group.items.length}} 场</text>
        <view wx:if="{{index === 0 && !isViewOnly && !isDayLocked}}" class="withdraw-entry {{withdrawalCourses.length ? '' : 'disabled'}}" bindtap="onWithdrawalOpen">退课</view>
      </view>
      <view class="group-card">
        <view
          class="card roster-card {{item.canEdit && !isDayLocked ? '' : 'read-only'}}"
          wx:for="{{group.items}}"
          wx:key="key"
          wx:for-item="item"
          bindtap="onActivityTap"
          data-record="{{item}}"
        >
          <view class="card-top">
            <view class="card-time">
              <text class="t1">{{item.startTime || '--'}}</text>
              <text class="t2">{{item.endTime}}</text>
            </view>
            <view class="card-mid">
              <view class="card-line1">
                <text class="welfare-tag" wx:if="{{item.isBookClubWelfare}}">公益</text>
                <text class="name">{{item.displayName}}</text>
                <text class="type" wx:if="{{item.typeText}}">{{item.typeText}}</text>
              </view>
              <view class="card-line2">
                <text wx:if="{{item.metaText}}">{{item.metaText}}</text>
                <text class="creator-text">创建人 · {{item.createdBy || '未记录'}}</text>
              </view>
            </view>
            <view class="card-right">
              <view class="card-status-row" wx:if="{{!item.canEdit || item.isPublished}}">
                <text class="readonly-status" wx:if="{{isDayLocked || !item.canEdit}}">{{isDayLocked ? ((lockInfo.locked_by || '未记录') + '锁定') : ((item.createdBy || '未记录') + '锁定')}}</text>
                <text class="status" wx:if="{{item.isPublished}}">已发布</text>
              </view>
            </view>
          </view>
          <view class="card-roster-strip">
            <text class="card-roster-names">{{item.participantRosterText}}</text>
            <text class="card-roster-entry" catchtap="onParticipantsOpen" data-record="{{item}}">名单 ›</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && records.length === 0}}">
    <text class="empty-icon">📅</text>
    <text class="empty-text">当日暂无活动安排</text>
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 添加按钮 -->
  <view class="fab" wx:if="{{!isViewOnly && !isDayLocked}}" bindtap="onCreateTap" bindlongpress="onFabLongPress">
    <text class="fab-icon">+</text>
  </view>

  <view class="withdraw-mask" wx:if="{{showWithdrawal}}" bindtap="onWithdrawalClose"></view>
  <view class="withdraw-sheet" wx:if="{{showWithdrawal}}">
    <view class="withdraw-handle"></view>
    <view class="withdraw-head">
      <view class="withdraw-heading">
        <text class="withdraw-title">退课管理</text>
        <text class="withdraw-subtitle">办理退课后也可以恢复参与</text>
      </view>
      <view class="withdraw-close" bindtap="onWithdrawalClose" aria-label="关闭">×</view>
    </view>
    <view class="withdraw-body">
      <view class="withdraw-mode">
        <view class="withdraw-mode-item {{withdrawalMode === 'withdraw' ? 'active' : ''}}" data-mode="withdraw" bindtap="onWithdrawalModeChange">办理退课</view>
        <view class="withdraw-mode-item {{withdrawalMode === 'restore' ? 'active' : ''}}" data-mode="restore" bindtap="onWithdrawalModeChange">恢复退课</view>
      </view>
      <view class="withdraw-field">
        <text class="withdraw-label">课程</text>
        <picker class="withdraw-picker" mode="selector" range="{{withdrawalCourses}}" range-key="label" value="{{withdrawalCourseIndex}}" bindchange="onWithdrawalCourseChange">
          <view class="withdraw-value">
            <text class="withdraw-value-text">{{withdrawalCourses[withdrawalCourseIndex].label}}</text>
            <view class="withdraw-chevron"></view>
          </view>
        </picker>
      </view>
      <view class="withdraw-field">
        <text class="withdraw-label">{{withdrawalMode === 'withdraw' ? '参与人' : '已退课人员'}}</text>
        <picker class="withdraw-picker" mode="selector" range="{{withdrawalParticipants}}" range-key="nickname" value="{{withdrawalParticipantIndex}}" bindchange="onWithdrawalParticipantChange">
          <view class="withdraw-value">
            <text class="withdraw-value-text">{{withdrawalParticipants[withdrawalParticipantIndex].nickname}}</text>
            <view class="withdraw-chevron"></view>
          </view>
        </picker>
      </view>
      <view class="withdraw-note">
        <text class="withdraw-note-icon">!</text>
        <text class="withdraw-note-text">{{withdrawalMode === 'withdraw' ? '退课后保留参与记录并标记为“已退课”，本场已扣卡次恢复为 0。' : '恢复后重新计入参与状态，并按本场原有规则恢复扣卡。'}}</text>
      </view>
    </view>
    <view class="withdraw-actions">
      <button class="withdraw-cancel" bindtap="onWithdrawalClose" disabled="{{withdrawing}}">取消</button>
      <button class="withdraw-confirm" bindtap="onWithdrawalConfirm" loading="{{withdrawing}}" disabled="{{withdrawing}}">{{withdrawalMode === 'withdraw' ? '确认退课' : '确认恢复'}}</button>
    </view>
  </view>

  <view class="participant-mask" wx:if="{{showParticipantSheet}}" bindtap="onParticipantSheetClose"></view>
  <view class="participant-sheet" wx:if="{{showParticipantSheet}}">
    <view class="participant-sheet-handle"></view>
    <view class="participant-sheet-head">
      <view class="participant-sheet-heading">
        <view class="participant-sheet-title-row">
          <text class="participant-sheet-title">参与人员</text>
          <text class="participant-sheet-count">{{participantSheetList.length}}</text>
        </view>
        <text class="participant-sheet-subtitle">{{participantSheetMeta || participantSheetTitle}}</text>
      </view>
      <view class="participant-sheet-close" bindtap="onParticipantSheetClose" aria-label="关闭">×</view>
    </view>
    <scroll-view class="participant-sheet-list" scroll-y>
      <view class="participant-sheet-empty" wx:if="{{participantSheetList.length === 0}}">暂无参与人员</view>
      <view class="participant-sheet-item" wx:for="{{participantSheetList}}" wx:key="id" catchtap="onParticipantProfileTap" data-id="{{item.id}}">
        <view class="participant-sheet-avatar">{{item.avatar}}</view>
        <view class="participant-sheet-content">
          <view class="participant-sheet-name-line">
            <view class="participant-sheet-name-wrap">
              <text class="participant-sheet-name">{{item.nickname}}</text>
              <text class="participant-sheet-withdrawn" wx:if="{{item.withdrawn}}">已退课</text>
              <text class="participant-no-visit" wx:if="{{!item.hasVisitInfo}}">当日无邀约</text>
            </view>
            <text class="participant-sheet-link">资料 ›</text>
          </view>
          <view class="participant-meta-line" wx:if="{{item.metaItems.length > 0}}">
            <block wx:for="{{item.metaItems}}" wx:key="*this" wx:for-item="metaItem" wx:for-index="metaIndex">
              <text class="participant-meta-separator" wx:if="{{metaIndex > 0}}">·</text>
              <text class="participant-meta-value">{{metaItem}}</text>
            </block>
          </view>
          <view class="participant-needs-row" wx:if="{{item.hasNeeds}}">
            <text class="participant-needs-label">需求：</text>
            <text class="participant-needs-value">{{item.needs}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
  </block>
</view>
