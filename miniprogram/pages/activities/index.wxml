<view class="page">
  <!-- 无权限 -->
  <view class="no-permission" wx:if="{{!hasPagePermission}}">
    <text class="no-permission-text">无权限访问此页面</text>
  </view>
  <block wx:else>
  <!-- 头部 -->
  <view class="head">
    <view class="head-row">
      <view class="head-date" bindtap="onCalendarToggle">
        <text>{{currentDateShort}}</text>
        <text class="wk">{{currentWeekday}}</text>
        <text class="drop">{{calendarExpanded ? '▴' : '▾'}}</text>
      </view>
      <view class="head-tools">
        <picker class="head-space" mode="selector" range="{{spaces}}" range-key="name" value="{{spaceIndex}}" bindchange="onSpaceChange">
          <text>{{currentSpaceName}} ▾</text>
        </picker>
        <view class="withdraw-entry {{withdrawalCourses.length ? '' : 'disabled'}}" bindtap="onWithdrawalOpen">退课</view>
      </view>
    </view>
    <view class="head-parti">今日 <text class="cnt">{{participants.length}}</text> 位参与者</view>
    <!-- 下拉日历 -->
    <view class="calendar-dropdown" wx:if="{{calendarExpanded}}">
      <view class="calendar-nav">
        <view class="nav-arrow" catchtap="onPrevMonth">‹</view>
        <text class="nav-title">{{calYear}}年{{calMonth + 1}}月</text>
        <view class="nav-arrow" catchtap="onNextMonth">›</view>
      </view>
      <view class="weekday-row">
        <text class="weekday-cell" wx:for="{{weekdays}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="day-grid">
        <view
          wx:for="{{calendarDays}}"
          wx:key="date"
          class="day-cell {{item.isCurrent ? '' : 'other'}} {{item.isSelected ? 'selected' : ''}} {{item.isToday ? 'today' : ''}}"
          bindtap="onCalendarDayTap"
          data-date="{{item.date}}"
        >
          <text>{{item.day}}</text>
          <view class="day-dot" wx:if="{{item.count > 0}}"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 遮罩 -->
  <view class="calendar-mask" wx:if="{{calendarExpanded}}" bindtap="onCalendarClose"></view>

  <!-- 活动列表（按时段分组） -->
  <view class="list" wx:if="{{!loading && records.length > 0}}">
    <view class="group" wx:for="{{timeGroups}}" wx:key="label" wx:for-item="group">
      <view class="group-label">{{group.label}}</view>
      <view
        class="card {{item.canEdit ? '' : 'read-only'}}"
        wx:for="{{group.items}}"
        wx:key="key"
        wx:for-item="item"
        bindtap="onActivityTap"
        data-record="{{item}}"
      >
        <view class="card-time">
          <text class="t1">{{item.startTime || '--'}}</text>
          <text class="t2">{{item.endTime}}</text>
        </view>
        <view class="card-mid">
          <view class="card-line1">
            <view class="dot" style="background-color: {{item.color}};"></view>
            <text class="name">{{item.displayName}}</text>
            <text class="type" wx:if="{{item.typeText}}">{{item.typeText}}</text>
          </view>
          <view class="card-line2">
            <text wx:if="{{item.metaText}}">{{item.metaText}}</text>
            <text class="creator-text">创建人 · {{item.createdBy || '未记录'}}</text>
          </view>
        </view>
        <view class="card-right">
          <text class="readonly-status" wx:if="{{!item.canEdit}}">部分只读</text>
          <text class="ppl" wx:if="{{item.participants > 0}}">{{item.participants}} 人</text>
          <text class="status" wx:if="{{item.isPublished}}">已发布</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && records.length === 0}}">
    <text class="empty-icon">📅</text>
    <text class="empty-text">当日暂无活动安排</text>
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 添加按钮 -->
  <view class="fab" bindtap="onCreateTap" bindlongpress="onFabLongPress">
    <text class="fab-icon">+</text>
  </view>

  <view class="withdraw-mask" wx:if="{{showWithdrawal}}" bindtap="onWithdrawalClose"></view>
  <view class="withdraw-sheet" wx:if="{{showWithdrawal}}">
    <view class="withdraw-head">
      <text class="withdraw-title">办理退课</text>
      <text class="withdraw-close" bindtap="onWithdrawalClose">关闭</text>
    </view>
    <view class="withdraw-body">
      <view class="withdraw-row">
        <text class="withdraw-label">课程</text>
        <picker class="withdraw-picker" mode="selector" range="{{withdrawalCourses}}" range-key="label" value="{{withdrawalCourseIndex}}" bindchange="onWithdrawalCourseChange">
          <view class="withdraw-value">{{withdrawalCourses[withdrawalCourseIndex].label}}<text>⌄</text></view>
        </picker>
      </view>
      <view class="withdraw-row">
        <text class="withdraw-label">参与人</text>
        <picker class="withdraw-picker" mode="selector" range="{{withdrawalParticipants}}" range-key="nickname" value="{{withdrawalParticipantIndex}}" bindchange="onWithdrawalParticipantChange">
          <view class="withdraw-value">{{withdrawalParticipants[withdrawalParticipantIndex].nickname}}<text>⌄</text></view>
        </picker>
      </view>
      <text class="withdraw-note">退课后保留参与人记录并标记“已退课”，本课程已扣卡次会恢复为 0。</text>
    </view>
    <view class="withdraw-actions">
      <button class="withdraw-cancel" bindtap="onWithdrawalClose" disabled="{{withdrawing}}">取消</button>
      <button class="withdraw-confirm" bindtap="onWithdrawalConfirm" loading="{{withdrawing}}" disabled="{{withdrawing}}">确认退课</button>
    </view>
  </view>
  </block>
</view>
