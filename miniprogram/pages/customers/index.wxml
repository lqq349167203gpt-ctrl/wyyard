<page-meta page-style="{{showFilterPanel ? 'overflow:hidden;height:100vh;' : ''}}" />
<view class="page">
  <!-- 无权限 -->
  <view class="no-permission" wx:if="{{!hasPagePermission}}">
    <text class="no-permission-text">无权限访问此页面</text>
  </view>
  <block wx:else>
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrap search-entry" bindtap="onSearchTap" hover-class="search-entry-active" hover-stay-time="80">
      <view class="search-symbol"></view>
      <text class="search-entry-text">搜索客户昵称</text>
    </view>
    <view class="filter-btn {{showFilterPanel ? 'active' : ''}}" bindtap="onToggleFilterPanel">
      <text>筛选</text>
      <text class="filter-count" wx:if="{{filterCount > 0}}">{{filterCount}}</text>
      <view class="filter-toggle-arrow {{showFilterPanel ? 'open' : ''}}"></view>
    </view>
  </view>

  <view class="dropdown-panel" wx:if="{{showFilterPanel}}">
    <view class="dropdown-mask" bindtap="onCloseFilterPanel"></view>
    <view class="dropdown-content filter-dropdown">
      <scroll-view class="filter-scroll" scroll-y="{{true}}" enable-flex="{{true}}" show-scrollbar="{{false}}">
        <view class="filter-body">
          <view class="filter-section">
            <view class="filter-section-title">到店间隔</view>
            <view class="range-panel-content">
              <view class="range-values">
                <text class="range-val">{{rangeMin}}天</text>
                <text class="range-val">{{rangeMax >= 60 ? '60天往上' : rangeMax + '天'}}</text>
              </view>
              <view class="range-track-wrap">
                <view class="range-track">
                  <view class="range-filled" style="left:{{rangeMin / 60 * 100}}%;right:{{(60 - rangeMax) / 60 * 100}}%"></view>
                </view>
                <view
                  class="range-thumb"
                  style="left:{{rangeMin / 60 * 100}}%"
                  data-type="min"
                  catchtouchstart="onRangeTouchStart"
                  catchtouchmove="onRangeTouchMove"
                  catchtouchend="onRangeTouchEnd"
                ></view>
                <view
                  class="range-thumb"
                  style="left:{{rangeMax / 60 * 100}}%"
                  data-type="max"
                  catchtouchstart="onRangeTouchStart"
                  catchtouchmove="onRangeTouchMove"
                  catchtouchend="onRangeTouchEnd"
                ></view>
              </view>
            </view>
          </view>

          <view class="filter-section">
            <view class="filter-section-title">身份</view>
            <view class="tags-wrap">
              <view
                class="tag-item {{item.selected ? 'active' : ''}}"
                wx:for="{{memberTypeList}}"
                wx:key="name"
                bindtap="onToggleMemberType"
                data-type="{{item.name}}"
              >{{item.name}}</view>
            </view>
          </view>

          <view class="filter-section">
            <view class="filter-title-row">
              <view class="filter-section-title">客户标签</view>
              <text class="filter-section-hint" wx:if="{{selectedTagIds.length > 1}}">匹配任一标签</text>
            </view>
            <view class="tags-wrap">
              <view
                class="tag-item customer-filter-tag {{item.selected ? 'active' : ''}}"
                wx:for="{{customerTagList}}"
                wx:key="id"
                bindtap="onToggleCustomerTag"
                data-id="{{item.id}}"
              >
                <text class="customer-filter-tag-name">{{item.name}}</text>
                <text class="customer-filter-tag-scope" wx:if="{{item.scope === 'private'}}">仅自己</text>
              </view>
            </view>
            <view class="filter-section-empty" wx:if="{{!tagLoading && customerTagList.length === 0}}">暂无可用标签</view>
          </view>

          <view class="filter-section">
            <view class="filter-section-title">引流人</view>
            <view class="tags-wrap">
              <view
                class="tag-item {{item.selected ? 'active' : ''}}"
                wx:for="{{referrerList}}"
                wx:key="name"
                bindtap="onToggleReferrer"
                data-name="{{item.name}}"
              >{{item.name}}</view>
            </view>
            <view class="filter-section-empty" wx:if="{{referrerList.length === 0}}">暂无引流人数据</view>
          </view>
        </view>
      </scroll-view>

      <view class="filter-actions">
        <text class="filter-reset" bindtap="onResetFilter">重置</text>
        <text class="filter-confirm" bindtap="onConfirmFilter">确定</text>
      </view>
    </view>
  </view>

  <!-- 分组客户列表 -->
  <view class="customer-groups" wx:if="{{groupedCustomers.length > 0}}">
    <view class="group" wx:for="{{groupedCustomers}}" wx:key="type">
      <view class="c-group-head">
        <view class="c-group-dot {{item.dotClass}}"></view>
        <text class="c-group-title">{{item.type}}</text>
        <text class="c-group-count">{{item.list.length}} 人</text>
      </view>
      <view class="c-group-card">
        <view id="{{customer._rowDomId}}" class="c-row" wx:for="{{item.list}}" wx:for-item="customer" wx:key="id" bindtap="onCustomerTap" data-id="{{customer.id}}">
          <view class="c-line1">
            <view class="c-stale-dot" wx:if="{{customer.isStale}}"></view>
            <text class="c-name">{{customer.nickname}}</text>
            <text class="c-tag" wx:if="{{customer.customer_tags && customer.customer_tags.length}}">{{customer.customer_tags[0].name}}</text>
            <text class="c-days {{customer.isStale ? 'hot' : ''}}">{{customer.daysPillText}}</text>
          </view>
          <view class="c-line2">
            <text>到店 {{customer.visit_count}} 次</text>
            <block wx:if="{{customer.referrer}}">
              <text class="c-sep">·</text>
              <text>引流 {{customer.referrer}}</text>
            </block>
            <block wx:if="{{customer.cardRemainingText}}">
              <text class="c-sep">·</text>
              <text>{{customer.cardRemainingText}}</text>
            </block>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载中（仅首次加载、列表为空时显示） -->
  <view class="loading" wx:if="{{loading && groupedCustomers.length === 0}}">
    <text>加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && groupedCustomers.length === 0}}">
    <view class="empty-circle">
      <text class="empty-char">空</text>
    </view>
    <text class="empty-text">暂无客户</text>
    <text class="empty-hint">{{isViewOnly ? '当前账号仅可浏览' : '点击右下角 + 添加'}}</text>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{loadingMore}}">
    <text>加载中...</text>
  </view>
  <view class="load-more" wx:if="{{!loadingMore && !loading && !hasMore && groupedCustomers.length > 0}}">
    <text>已加载全部</text>
  </view>

  <!-- 浮动添加按钮 -->
  <draggable-fab wx:if="{{!isViewOnly}}" storage-key="customers-fab-position" bindtap="onAddTap" bindlongpress="onFabLongPress" />
  </block>
</view>
