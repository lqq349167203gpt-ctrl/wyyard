.page {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding-bottom: 140rpx;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 32rpx 28rpx;
  background-color: #f3f7ff;
  position: sticky;
  top: 0;
  z-index: 50;
}

.search-input-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  height: 72rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 0 28rpx;
}

.search-entry {
  gap: 18rpx;
}

.search-entry-active {
  background-color: #f9fbff;
}

.search-symbol {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.search-symbol::before {
  position: absolute;
  top: 3rpx;
  left: 3rpx;
  width: 20rpx;
  height: 20rpx;
  box-sizing: border-box;
  border: 3rpx solid #a8aeb6;
  border-radius: 50%;
  content: '';
}

.search-symbol::after {
  position: absolute;
  top: 21rpx;
  left: 20rpx;
  width: 12rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background-color: #a8aeb6;
  content: '';
  transform-origin: left center;
  transform: rotate(45deg);
}

.search-entry-text {
  flex: 1;
  color: #8f959e;
  font-size: 28rpx;
  line-height: 72rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1f2329;
  height: 72rpx;
  line-height: 72rpx;
}

.placeholder {
  color: #b0b5bb;
}

.filter-btn {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 24rpx;
  gap: 10rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.filter-btn text {
  font-size: 26rpx;
  color: #4e535a;
}

.filter-count {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 32rpx;
  height: 32rpx;
  box-sizing: border-box;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background-color: #3370ff;
  color: #ffffff !important;
  font-size: 20rpx !important;
}

/* 下拉面板通用 */
.dropdown-panel {
  position: relative;
  z-index: 40;
}

.dropdown-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 40;
}

.dropdown-content {
  position: fixed;
  top: 116rpx;
  left: 0;
  right: 0;
  background-color: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  z-index: 41;
  padding: 24rpx 32rpx;
}

/* 筛选面板 */
.filter-dropdown {
  box-sizing: border-box;
  max-height: calc(100vh - 116rpx);
  overflow-y: auto;
  padding: 24rpx 32rpx 0;
}

.filter-section {
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f1f2;
  margin-bottom: 24rpx;
}

.filter-section:last-of-type {
  border-bottom: none;
  margin-bottom: 0;
}

.filter-section-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #1f2329;
  margin-bottom: 20rpx;
}

.filter-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.filter-title-row .filter-section-title {
  margin-bottom: 20rpx;
}

.filter-section-hint {
  margin-bottom: 20rpx;
  color: #8f959e;
  font-size: 21rpx;
}

.filter-section-empty {
  font-size: 24rpx;
  color: #b0b5bb;
  padding: 8rpx 0;
}

.filter-actions {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
  padding-top: 24rpx;
  padding-bottom: 8rpx;
  border-top: 1rpx solid #f0f1f2;
}

.filter-reset {
  font-size: 28rpx;
  color: #8f959e;
  padding: 12rpx 32rpx;
}

.filter-confirm {
  font-size: 28rpx;
  color: #ffffff;
  background-color: #3370ff;
  padding: 12rpx 48rpx;
  border-radius: 8rpx;
}

/* 身份标签选择 */
.tags-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  padding: 10rpx 20rpx;
  background-color: #f2f3f5;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #4e535a;
}

.tag-item.active {
  background-color: #e8f0fe;
  color: #1677ff;
  font-weight: 500;
}

.customer-filter-tag {
  display: flex;
  align-items: center;
  max-width: 280rpx;
  gap: 8rpx;
}

.customer-filter-tag-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.customer-filter-tag-scope {
  flex-shrink: 0;
  color: #8f959e;
  font-size: 19rpx;
}

.customer-filter-tag.active .customer-filter-tag-scope {
  color: #5f7fb2;
}

.range-panel-content {
  padding: 0 8rpx;
}

.range-values {
  display: flex;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.range-val {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2329;
}

/* 轨道 */
.range-track-wrap {
  position: relative;
  height: 64rpx;
  margin: 0 16rpx;
}

.range-track {
  position: absolute;
  top: 28rpx;
  left: 0;
  right: 0;
  height: 8rpx;
  background-color: #e8eaed;
  border-radius: 4rpx;
}

.range-filled {
  position: absolute;
  top: 0;
  height: 100%;
  background-color: #3370ff;
  border-radius: 4rpx;
}

/* 滑块 */
.range-thumb {
  position: absolute;
  top: 8rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #ffffff;
  border: 4rpx solid #3370ff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  transform: translateX(-50%);
  z-index: 2;
}

/* 刻度 */
.range-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
  padding: 0 16rpx;
}

.range-labels text {
  font-size: 20rpx;
  color: #b0b5bb;
}

/* 按钮 */
.range-actions {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
  margin-top: 32rpx;
}

.range-reset {
  font-size: 28rpx;
  color: #8f959e;
  padding: 12rpx 32rpx;
}

.range-confirm {
  font-size: 28rpx;
  color: #ffffff;
  background-color: #3370ff;
  padding: 12rpx 48rpx;
  border-radius: 8rpx;
}

/* 分组列表：一组一卡，组内细线分行 */
.customer-groups {
  padding: 12rpx 0;
}

.group {
  margin-bottom: 12rpx;
}

.c-group-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 32rpx 40rpx 16rpx;
}

.c-group-dot {
  width: 12rpx;
  height: 12rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background-color: #f4dc84;
}

.c-group-dot.other {
  background-color: #2bb5a0;
}

.c-group-title {
  font-size: 24rpx;
  font-weight: 500;
  color: #646a73;
  letter-spacing: 1rpx;
}

.c-group-count {
  font-size: 22rpx;
  color: #b0b5bb;
}

.c-group-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  margin: 0 24rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.c-row {
  padding: 24rpx 32rpx;
}

.c-row:active {
  background-color: #f7f8fa;
}

.c-row + .c-row {
  border-top: 1rpx solid #f1f2f4;
}

.c-line1 {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.c-stale-dot {
  width: 10rpx;
  height: 10rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background-color: #d97070;
}

.c-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 30rpx;
  font-weight: 500;
  color: #1f2329;
}

.c-tag {
  flex-shrink: 0;
  max-width: 180rpx;
  overflow: hidden;
  padding: 2rpx 14rpx;
  border-radius: 16rpx;
  background-color: #f5f7ff;
  color: #3370ff;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.c-days {
  margin-left: auto;
  flex-shrink: 0;
  color: #a8aeb6;
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

.c-days.hot {
  color: #c45a5a;
  font-weight: 500;
}

.c-line2 {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8f959e;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-variant-numeric: tabular-nums;
}

.c-sep {
  color: #dde1e6;
}

/* 加载中 */
.loading {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
  color: #b0b5bb;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0 0;
}

.empty-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #f2f3f5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.empty-char {
  font-size: 40rpx;
  font-weight: 600;
  color: #c9cdd4;
}

.empty-text {
  font-size: 30rpx;
  color: #4e535a;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #b0b5bb;
}

/* 加载更多 */
.load-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
  color: #b0b5bb;
  font-size: 24rpx;
}

/* 浮动按钮 */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 200rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background-color: #3370ff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fab-icon {
  font-size: 52rpx;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: -4rpx;
}

/* V3 筛选下拉：内容滚动，操作区钉底 */
.filter-btn.active text {
  color: #3370ff;
  font-weight: 500;
}

.filter-toggle-arrow {
  width: 10rpx;
  height: 10rpx;
  margin-left: 2rpx;
  box-sizing: border-box;
  border-right: 2rpx solid #8f959e;
  border-bottom: 2rpx solid #8f959e;
  transform: rotate(45deg) translateY(-2rpx);
  transform-origin: center;
}

.filter-toggle-arrow.open {
  border-color: #3370ff;
  transform: rotate(225deg) translate(-2rpx, -2rpx);
}

.filter-dropdown {
  top: 114rpx;
  display: flex;
  flex-direction: column;
  height: calc(100vh - 114rpx);
  max-height: 1060rpx;
  padding: 0;
  overflow: hidden;
  border-radius: 0 0 32rpx 32rpx;
  box-shadow: none;
}

.filter-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
}

.filter-body {
  padding: 12rpx 32rpx 16rpx;
}

.filter-section {
  margin: 0;
  padding: 24rpx 0 8rpx;
  border-bottom: none;
}

.filter-section + .filter-section {
  margin-top: 16rpx;
  border-top: 1rpx solid #f1f2f4;
}

.filter-section-title {
  margin-bottom: 22rpx;
  color: #646a73;
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.filter-title-row {
  align-items: baseline;
}

.filter-title-row .filter-section-title,
.filter-section-hint {
  margin-bottom: 22rpx;
}

.filter-section-hint {
  color: #b8bec6;
  font-size: 20rpx;
}

.tags-wrap {
  gap: 14rpx;
}

.tag-item {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background-color: #f4f6f8;
  color: #4e535a;
  font-size: 23rpx;
  line-height: 1.4;
}

.tag-item.active {
  background-color: #eef3ff;
  color: #3370ff;
  font-weight: 500;
}

.customer-filter-tag {
  max-width: 320rpx;
  gap: 6rpx;
}

.customer-filter-tag-scope {
  color: #b8bec6;
  font-size: 18rpx;
}

.customer-filter-tag.active .customer-filter-tag-scope {
  color: #8fb0f5;
}

.range-panel-content {
  padding: 0 4rpx;
}

.range-values {
  margin-bottom: 28rpx;
  padding: 0 4rpx;
}

.range-val {
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

.range-track-wrap {
  height: 52rpx;
  margin: 0 24rpx;
}

.range-track {
  top: 22rpx;
  height: 8rpx;
  border-radius: 999rpx;
}

.range-filled {
  border-radius: 999rpx;
}

.range-thumb {
  top: 8rpx;
  width: 36rpx;
  height: 36rpx;
  border-width: 4rpx;
  box-shadow: none;
}

.filter-actions {
  flex: none;
  align-items: center;
  justify-content: flex-start;
  gap: 20rpx;
  padding: 20rpx 32rpx 28rpx;
  border-top: 1rpx solid #f1f2f4;
  background-color: #fff;
}

.filter-reset,
.filter-confirm {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 80rpx;
  padding: 0;
  border-radius: 20rpx;
  font-size: 26rpx;
}

.filter-reset {
  width: 192rpx;
  flex: none;
  background-color: #f4f6f8;
  color: #646a73;
}

.filter-confirm {
  flex: 1;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}
