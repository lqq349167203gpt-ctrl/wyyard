.page {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding-bottom: 140rpx;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  background-color: #ffffff;
  position: sticky;
  top: 0;
  z-index: 50;
}

.search-input-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  height: 72rpx;
  background-color: #f2f3f5;
  border-radius: 12rpx;
  padding: 0 28rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1f2329;
  height: 72rpx;
  line-height: 72rpx;
}

.placeholder {
  color: #b0b5bb;
}

.filter-btn {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 24rpx;
  background-color: #f2f3f5;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.filter-btn text {
  font-size: 26rpx;
  color: #4e535a;
}

.filter-count {
  color: #4e535a;
  font-size: 22rpx;
  margin-left: 4rpx;
}

/* 下拉面板通用 */
.dropdown-panel {
  position: relative;
  z-index: 40;
}

.dropdown-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
}

.dropdown-content {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  z-index: 41;
  padding: 24rpx 32rpx;
}

/* 筛选面板 */
.filter-dropdown {
  box-sizing: border-box;
  max-height: calc(100vh - 112rpx);
  overflow-y: auto;
  padding: 24rpx 32rpx 0;
}

.filter-section {
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f1f2;
  margin-bottom: 24rpx;
}

.filter-section:last-of-type {
  border-bottom: none;
  margin-bottom: 0;
}

.filter-section-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #1f2329;
  margin-bottom: 20rpx;
}

.filter-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.filter-title-row .filter-section-title {
  margin-bottom: 20rpx;
}

.filter-section-hint {
  margin-bottom: 20rpx;
  color: #8f959e;
  font-size: 21rpx;
}

.filter-section-empty {
  font-size: 24rpx;
  color: #b0b5bb;
  padding: 8rpx 0;
}

.filter-actions {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
  padding-top: 24rpx;
  padding-bottom: 8rpx;
  border-top: 1rpx solid #f0f1f2;
}

.filter-reset {
  font-size: 28rpx;
  color: #8f959e;
  padding: 12rpx 32rpx;
}

.filter-confirm {
  font-size: 28rpx;
  color: #ffffff;
  background-color: #3370ff;
  padding: 12rpx 48rpx;
  border-radius: 8rpx;
}

/* 身份标签选择 */
.tags-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  padding: 10rpx 20rpx;
  background-color: #f2f3f5;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #4e535a;
}

.tag-item.active {
  background-color: #e8f0fe;
  color: #1677ff;
  font-weight: 500;
}

.customer-filter-tag {
  display: flex;
  align-items: center;
  max-width: 280rpx;
  gap: 8rpx;
}

.customer-filter-tag-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.customer-filter-tag-scope {
  flex-shrink: 0;
  color: #8f959e;
  font-size: 19rpx;
}

.customer-filter-tag.active .customer-filter-tag-scope {
  color: #5f7fb2;
}

.range-panel-content {
  padding: 0 8rpx;
}

.range-values {
  display: flex;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.range-val {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2329;
}

/* 轨道 */
.range-track-wrap {
  position: relative;
  height: 64rpx;
  margin: 0 16rpx;
}

.range-track {
  position: absolute;
  top: 28rpx;
  left: 0;
  right: 0;
  height: 8rpx;
  background-color: #e8eaed;
  border-radius: 4rpx;
}

.range-filled {
  position: absolute;
  top: 0;
  height: 100%;
  background-color: #3370ff;
  border-radius: 4rpx;
}

/* 滑块 */
.range-thumb {
  position: absolute;
  top: 8rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #ffffff;
  border: 4rpx solid #3370ff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  transform: translateX(-50%);
  z-index: 2;
}

/* 刻度 */
.range-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
  padding: 0 16rpx;
}

.range-labels text {
  font-size: 20rpx;
  color: #b0b5bb;
}

/* 按钮 */
.range-actions {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
  margin-top: 32rpx;
}

.range-reset {
  font-size: 28rpx;
  color: #8f959e;
  padding: 12rpx 32rpx;
}

.range-confirm {
  font-size: 28rpx;
  color: #ffffff;
  background-color: #3370ff;
  padding: 12rpx 48rpx;
  border-radius: 8rpx;
}

/* 分组列表 */
.customer-groups {
  padding: 8rpx 0;
}

.group {
  margin-bottom: 16rpx;
}

.group-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx 12rpx;
}

.group-title {
  font-size: 24rpx;
  font-weight: 400;
  color: #8f959e;
}

.group-count {
  font-size: 22rpx;
  color: #b0b5bb;
}

.group-list {
  background-color: #ffffff;
  margin: 0 32rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.group-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  border-bottom: 1rpx solid #f5f6f7;
}

.group-item:last-child {
  border-bottom: none;
}

.item-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.item-nickname {
  flex-shrink: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 30rpx;
  font-weight: 400;
  color: #1f2329;
}

.item-customer-tag {
  flex-shrink: 0;
  max-width: 150rpx;
  overflow: hidden;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background-color: #f0f4ff;
  color: #3370ff;
  font-size: 22rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-days {
  font-size: 22rpx;
  color: #b0b5bb;
  flex-shrink: 0;
}

.item-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.item-count {
  font-size: 24rpx;
  color: #8f959e;
}

.item-arrow {
  font-size: 32rpx;
  color: #d0d3d6;
}

/* 加载中 */
.loading {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
  color: #b0b5bb;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0 0;
}

.empty-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #f2f3f5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.empty-char {
  font-size: 40rpx;
  font-weight: 600;
  color: #c9cdd4;
}

.empty-text {
  font-size: 30rpx;
  color: #4e535a;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #b0b5bb;
}

/* 加载更多 */
.load-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
  color: #b0b5bb;
  font-size: 24rpx;
}

/* 浮动按钮 */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 200rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
  background-color: #3370ff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(51, 112, 255, 0.25);
}

.fab-icon {
  font-size: 52rpx;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: -4rpx;
}
