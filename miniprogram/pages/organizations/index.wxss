.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 16rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 500;
  color: #1f2329;
}

.sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8f959e;
}

.tabs {
  display: flex;
  gap: 40rpx;
  border-bottom: 1rpx solid #e8eaed;
}

.tab {
  padding: 16rpx 4rpx;
  font-size: 26rpx;
  color: #8f959e;
  border-bottom: 4rpx solid transparent;
}

.tab.on {
  color: #3370ff;
  font-weight: 500;
  border-bottom-color: #3370ff;
}

.tab-stat {
  margin: 12rpx 0 16rpx;
  font-size: 22rpx;
  color: #8f959e;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #8f959e;
  background: #fff;
  border-radius: 12rpx;
}

.viewer-bar {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #eef0f2;
}

.viewer-head {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-bottom: 12rpx;
}

.viewer-title {
  font-size: 24rpx;
  font-weight: 500;
  color: #4e535a;
}

.viewer-hint {
  font-size: 20rpx;
  color: #8f959e;
}

.viewer-tags,
.ref-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

.tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  border: 1rpx solid #e8eaed;
  border-radius: 6rpx;
  font-size: 22rpx;
  color: #2b2f36;
  background: #fff;
}

.tag-x {
  color: #8f959e;
  padding: 0 4rpx;
}

.link {
  color: #3370ff;
  font-size: 24rpx;
  padding: 4rpx 8rpx;
}

.link.danger {
  color: #c4506a;
}

.org-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.org-card {
  background: #fff;
  border-radius: 12rpx;
  border: 1rpx solid #eef0f2;
  padding: 20rpx 24rpx;
}

.org-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.org-left {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  min-width: 0;
  flex: 1;
}

.sort-col {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: 4rpx;
}

.sort-btn {
  font-size: 18rpx;
  color: #c2c6cc;
  padding: 4rpx;
}

.sort-btn.disabled {
  opacity: 0.3;
}

.org-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #2b2f36;
  word-break: break-all;
}

.org-badge {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #3370ff;
  background: #f0f5ff;
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
}

.org-actions {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}

.org-meta {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #8f959e;
}

.member-list {
  margin-top: 16rpx;
  border-top: 1rpx solid #f0f1f2;
  padding-top: 8rpx;
}

.member-head {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  font-size: 20rpx;
  color: #8f959e;
  border-bottom: 1rpx solid #f5f6f7;
  gap: 8rpx;
}

.member-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f6f7;
  gap: 8rpx;
  font-size: 24rpx;
  color: #2b2f36;
}

.col-nick {
  width: 140rpx;
  flex-shrink: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
}

.col-name {
  width: 110rpx;
  flex-shrink: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #4e535a;
  font-size: 22rpx;
}

.col-type {
  width: 120rpx;
  flex-shrink: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #4e535a;
  font-size: 22rpx;
}

.col-visit {
  width: 70rpx;
  flex-shrink: 0;
  text-align: center;
  color: #4e535a;
  font-size: 22rpx;
}

.col-op {
  flex: 1;
  min-width: 0;
}

.m-sub {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #8f959e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.org-info {
  min-width: 0;
  flex: 1;
}

.badge {
  display: inline-block;
  margin-right: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
}

.badge.gray {
  background: #f2f3f5;
  color: #6b7078;
}

.badge.blue {
  background: #eef3ff;
  color: #4d6fa9;
}

.org-of {
  color: #8f959e;
  font-size: 20rpx;
}

.m-ops {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

.empty-row {
  padding: 24rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: #8f959e;
}

.add-member {
  margin-top: 12rpx;
  text-align: center;
  color: #3370ff;
  font-size: 24rpx;
  padding: 12rpx;
}

.act-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.act-thumb {
  width: 120rpx;
  height: 150rpx;
  border-radius: 8rpx;
  background: #f5f6f7;
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.sheet {
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx 40rpx;
  box-sizing: border-box;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1f2329;
  margin-bottom: 24rpx;
}

.hint-text {
  font-size: 24rpx;
  color: #8f959e;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 24rpx;
  color: #4e535a;
  margin-bottom: 12rpx;
}

.input {
  width: 100%;
  height: 72rpx;
  border: 1rpx solid #dee0e3;
  border-radius: 8rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  color: #1f2329;
}

.input.picker {
  line-height: 72rpx;
  color: #8f959e;
}

.err {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #c4506a;
}

.modes {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.mode {
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  border: 1rpx solid #e1e4e7;
  font-size: 24rpx;
  color: #4e535a;
  background: #fff;
}

.mode.on {
  border-color: #c7d7f7;
  color: #3370ff;
  background: #f0f5ff;
}

.check-row {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #4e535a;
}

.check-hint {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8f959e;
  line-height: 1.4;
}

.search-list {
  margin-top: 12rpx;
  max-height: 360rpx;
  overflow-y: auto;
  border: 1rpx solid #eef0f2;
  border-radius: 8rpx;
}

.search-item {
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  color: #2b2f36;
  border-bottom: 1rpx solid #f5f6f7;
}

.sheet-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f1f2;
}

.btn-primary,
.btn-ghost,
.btn-danger {
  margin: 0;
  font-size: 26rpx;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 8rpx;
}

.btn-primary {
  background: #3370ff;
  color: #fff;
}

.btn-primary[disabled] {
  background: #a3c0ff;
  color: #fff;
}

.btn-ghost {
  background: #fff;
  color: #4e535a;
  border: 1rpx solid #dee0e3;
}

.btn-danger {
  background: #fff4f4;
  color: #c4506a;
  border: 1rpx solid #f1d9dc;
}

.img-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.img-row.wrap {
  flex-wrap: wrap;
}

.thumb {
  width: 120rpx;
  height: 150rpx;
  border-radius: 8rpx;
  background: #f5f6f7;
  border: 1rpx dashed #dee0e3;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8f959e;
  font-size: 40rpx;
}

.thumb.add {
  border: 1rpx dashed #dee0e3;
}

.img-remove-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}
