.page { min-height: 100vh; background: #f5f6f8; padding: 0 24rpx 24rpx; box-sizing: border-box; color: #1f2329; font-size: 26rpx; }
.filter-card { margin-top: 24rpx; }
.panel { background: #fff; border-radius: 12rpx; padding: 26rpx 28rpx; margin-bottom: 12rpx; }
.toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 16rpx; }
.toolbar picker { flex: 1; min-width: 0; }
.control { display: flex; align-items: center; gap: 10rpx; min-height: 60rpx; padding: 0 16rpx; border: 1rpx solid #dee0e3; border-radius: 8rpx; font-size: 24rpx; box-sizing: border-box; background: #fff; }
.control-text { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
/* 下拉箭头：和自定义筛选同一套 SVG 图标（大小与位置各机型一致） */
.chevron {
  flex-shrink: 0;
  width: 18rpx;
  height: 18rpx;
  margin-left: 8rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
  background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0naHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmcnIHZpZXdCb3g9JzAgMCAyNCAyNCcgZmlsbD0nbm9uZScgc3Ryb2tlPScjOGY5NTllJyBzdHJva2Utd2lkdGg9JzIuNicgc3Ryb2tlLWxpbmVjYXA9J3JvdW5kJyBzdHJva2UtbGluZWpvaW49J3JvdW5kJz48cGF0aCBkPSdNNiA5bDYgNiA2LTYnLz48L3N2Zz4=");
}
.small-flex { display: inline-flex; align-items: center; gap: 8rpx; }
.small { margin: 0; padding: 0 20rpx; min-width: 0; height: 60rpx; line-height: 58rpx; font-size: 24rpx; font-weight: 400; border: 1rpx solid #dee0e3; border-radius: 8rpx; background: #fff; color: #4e535a; }
.small::after { border: none; }
.primary { color: #fff; background: #3370ff; border-color: #3370ff; }
.muted { font-size: 24rpx; color: #8f959e; line-height: 1.6; }
.filters .muted { margin-top: 16rpx; }
.link { color: #3370ff; font-size: 24rpx; }
.rule-help { margin-top: 16rpx; padding-left: 20rpx; border-left: 4rpx solid #dee0e3; font-size: 24rpx; line-height: 1.8; color: #4e535a; }
.rule-help > view + view { margin-top: 8rpx; }
.rule-help-label { font-weight: 500; color: #1f2329; }
.tab.active { color: #3370ff; }
.stats { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.stat { background: #fff; padding: 24rpx; border-radius: 12rpx; }
.number { font-size: 36rpx; font-weight: 500; margin-top: 8rpx; }
.count { padding: 20rpx 0; }

/* 经营概况四张卡，两列避免标题和附属值挤压。 */
.cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12rpx; background: #ffffff; border-radius: 12rpx; padding: 24rpx 28rpx; margin-bottom: 12rpx; }
.card { min-width: 0; background: #fff; border: 2rpx solid #e8eaed; border-radius: 6rpx; padding: 18rpx 16rpx; box-sizing: border-box; }
/* 选中态做浅：只比普通描边略深一点的淡蓝，不再用主色实描边 */
.card.active { border-color: #d5e0f5; background: #fbfcff; }
.card-title { display: block; font-size: 22rpx; color: #646a73; }
.card-value { display: flex; align-items: baseline; gap: 6rpx; margin-top: 10rpx; }
.card-number { font-size: 34rpx; font-weight: 500; line-height: 1; color: #1f2329; }
.card-unit { font-size: 20rpx; color: #8f959e; }
.card-sub { display: block; margin-top: 8rpx; font-size: 20rpx; line-height: 1.4; color: #9aa1a9; }
.card-title-line { display: flex; align-items: center; gap: 8rpx; }
.card-help { width: 26rpx; height: 26rpx; border: 1rpx solid #c9cdd4; border-radius: 50%; color: #8f959e; font-size: 18rpx; line-height: 24rpx; text-align: center; }
.card-help-text { display: block; margin-top: 8rpx; padding: 10rpx 12rpx; border-radius: 8rpx; background: #f7f8fa; font-size: 20rpx; line-height: 1.5; color: #646a73; }
.value.expanded { white-space: normal; word-break: break-all; }

/* 筛选区：一行一个条件，标签固定宽度，右边控件对齐 */
.filter-card { padding: 28rpx 28rpx 24rpx; margin: 0 0 12rpx; border: none; }
.filter-row { display: flex; align-items: center; gap: 12rpx; padding: 12rpx 0; }
/* 标签固定宽度且不换行：会员身份 / 跟进阶段 / 流量来源 这类四字标签也要一行放得下 */
.filter-label { width: 116rpx; flex-shrink: 0; font-size: 24rpx; color: #8f959e; white-space: nowrap; }
.filter-control { flex: 1; min-width: 0; }
.date-control { min-width: 180rpx; }
.range-filter-row .scope-control {
  width: 100%;
  min-height: 56rpx;
  box-sizing: border-box;
  justify-content: flex-end;
  gap: 0;
  padding: 0;
  border: 0;
  background: transparent;
  font-size: 24rpx;
}
.range-filter-row .scope-control .control-text {
  flex: 0 1 auto;
  max-width: 100%;
  color: #2b2f36;
  font-size: 24rpx;
  text-align: right;
}
.preset-row { display: flex; flex-wrap: wrap; gap: 10rpx; flex: 1; }
.range-filter-row { min-height: 64rpx; margin-top: 0; padding: 0; gap: 0; }
.range-filter-row .filter-label { width: 128rpx; line-height: 1.25; }
.range-filter-row .course-presets {
  width: 380rpx;
  max-width: 100%;
  flex: 0 1 380rpx;
  flex-wrap: nowrap;
  justify-content: space-between;
  gap: 0;
  margin-left: auto;
  padding-right: 30rpx;
  box-sizing: border-box;
}
.range-filter-row .course-preset {
  display: flex;
  min-height: 56rpx;
  height: 56rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 1rpx solid transparent;
  border-radius: 8rpx;
  background: transparent;
  color: #8f959e;
  font-size: 24rpx;
}
.range-filter-row .course-preset.active {
  border-color: transparent;
  background: transparent;
  color: #2b2f36;
  font-weight: 400;
}
.range-filter-row .course-date-range {
  display: flex;
  min-width: 0;
  align-items: center;
  width: 380rpx;
  max-width: 100%;
  flex: 0 1 380rpx;
  margin-left: auto;
}
.range-filter-row .date-picker { min-width: 0; flex: 1; }
.range-filter-row .course-date-value {
  display: flex;
  height: 56rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  padding: 0;
  border: 0;
  background: transparent;
  color: #2b2f36;
  font-size: 24rpx;
  line-height: 1;
}
.range-filter-row .course-date-value.placeholder { color: #b0b5bb; }
.range-filter-row .date-text {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.range-filter-row .date-separator {
  flex-shrink: 0;
  margin: 0 12rpx;
  color: #8f959e;
  font-size: 24rpx;
  line-height: 1;
}
.range-filter-row .course-picker-arrow,
.overview-page .panel-grid .course-picker-arrow {
  width: 0;
  height: 0;
  flex-shrink: 0;
  margin-left: 16rpx;
  opacity: 0.5;
  background: none;
  border: 0;
  border-right: 7rpx solid transparent;
  border-left: 7rpx solid transparent;
  border-top: 7rpx solid #8f959e;
}
/* 日期快捷项：与「信息核对」「自定义筛选」同一套选中样式 */
.preset { padding: 6rpx 14rpx; box-sizing: border-box; border: 1rpx solid #e1e4e7; border-radius: 8rpx; background: #fff; font-size: 22rpx; color: #646a73; }
.preset.active { border-color: #d5d9de; background: #f5f6f7; color: #1f2329; font-weight: 500; }

/* 顶部 tab：白条，两个页签居中均分，选中是蓝字 + 居中短下划线 */
.seg-tabs { display: flex; background: #ffffff; border-radius: 12rpx; padding: 0 28rpx; margin: 24rpx 0 12rpx; }
.seg-tab { flex: 1; position: relative; padding: 24rpx 0 22rpx; text-align: center; font-size: 28rpx; color: #646a73; }
.seg-tab.active { color: #3370ff; font-weight: 500; }
.seg-tab.active::after { content: ""; position: absolute; left: 50%; transform: translateX(-50%); width: 52rpx; bottom: 0; height: 6rpx; border-radius: 6rpx 6rpx 0 0; background: #3370ff; }

/* 二级拆分面板 */
.panel-head { display: flex; align-items: baseline; gap: 12rpx; margin-bottom: 16rpx; }
.panel-title { font-size: 28rpx; font-weight: 500; }
/* 面板里的筛选下拉：一行两个，省一半高度 */
/* 标题在左、控件在右（不上下排），一行两个 */
.panel-grid { display: flex; flex-wrap: wrap; gap: 18rpx 24rpx; margin-top: 14rpx; padding-bottom: 22rpx; }
.panel-cell { display: flex; align-items: center; gap: 10rpx; width: calc(50% - 12rpx); min-width: 0; }
/* 标题固定宽度，右边控件一样宽 → 两列上下对齐，不会参差 */
.panel-cell-label { flex-shrink: 0; width: 112rpx; font-size: 24rpx; color: #8f959e; white-space: nowrap; }
.panel-cell .control { flex: 1; min-width: 0; max-width: 172rpx; }
.panel-cell .control { min-height: 56rpx; }
.panel-cell .traffic-panel-control {
  justify-content: flex-end;
  min-height: 56rpx;
  padding: 0 12rpx;
  border: 2rpx solid #f7f8fa;
  box-sizing: border-box;
  background: transparent;
}
.panel-cell .traffic-panel-control .control-text {
  flex: 0 1 auto;
  max-width: calc(100% - 30rpx);
  color: #2b2f36;
  font-size: 24rpx;
  text-align: right;
}
.traffic-deal-breakdown { margin: 0 -28rpx; padding: 16rpx 28rpx 2rpx; border-top: 2rpx solid #f7f8fa; }
.traffic-deal-label { color: #9aa1a9; font-size: 22rpx; }
.traffic-deal-total-row { display: flex; align-items: baseline; justify-content: space-between; padding-bottom: 16rpx; }
.traffic-deal-total-value { margin-right: 8rpx; color: #33393f; font-size: 24rpx; font-weight: 600; }
.traffic-deal-total-value.active { color: #3370ff; }
.traffic-deal-products { display: flex; flex-wrap: wrap; align-items: center; gap: 8rpx 30rpx; padding-top: 16rpx; border-top: 2rpx solid #fafbfc; }
.traffic-deal-detail-label { color: #9aa1a9; font-size: 22rpx; white-space: nowrap; }
.traffic-deal-product { display: inline-flex; min-height: 44rpx; align-items: center; gap: 6rpx; white-space: nowrap; }
.traffic-deal-product-label { color: #8f959e; font-size: 22rpx; }
.traffic-deal-product-count { color: #33393f; font-size: 22rpx; font-weight: 500; }
.traffic-deal-product.active .traffic-deal-product-label,
.traffic-deal-product.active .traffic-deal-product-count { color: #3370ff; }
.overview-summary { margin: 0 -28rpx; padding: 0 28rpx 26rpx; border-top: 2rpx solid #f2f3f5; }
.overview-summary-line { display: grid; grid-template-columns: minmax(0, 1fr) 136rpx 116rpx; align-items: center; box-sizing: border-box; min-height: 68rpx; padding: 14rpx 0; }
.overview-summary-line + .overview-summary-line { border-top: 2rpx solid #f6f7f8; }
.overview-summary-line.total { padding-top: 24rpx; }
.overview-summary-line.minor { border-top-color: #f2f3f5; }
.overview-summary-label { min-width: 0; color: #9aa1a9; font-size: 22rpx; }
.overview-summary-value { color: #33393f; font-size: 24rpx; font-weight: 500; text-align: right; white-space: nowrap; }
.overview-summary-value.solo { grid-column: 2 / 4; }
.overview-summary-sub { min-width: 0; color: #9aa1a9; font-size: 22rpx; line-height: 1.4; text-align: right; overflow-wrap: break-word; }
.overview-summary-line.active .overview-summary-label,
.overview-summary-line.active .overview-summary-value { color: #3370ff; }
.chip-group { margin-bottom: 16rpx; }

/* 课程数据的标签和操作与邀约到店一样，贴合在列表内容的同一张白卡中。 */
.course-view-bar { display: flex; align-items: center; gap: 10rpx; min-height: 96rpx; box-sizing: border-box; background: #ffffff; padding: 0 28rpx; margin-bottom: 0; border-bottom: 2rpx solid #f8f9fa; }
.course-view-tabs { display: flex; min-width: 0; flex: none; align-items: center; gap: 4rpx; padding: 6rpx; border-radius: 14rpx; background: #f2f3f5; }
.course-view-tab { display: flex; min-width: 0; flex: none; height: 52rpx; align-items: center; justify-content: center; gap: 5rpx; padding: 0 14rpx; box-sizing: border-box; font-size: 21rpx; line-height: 1; color: #646a73; border-radius: 10rpx; white-space: nowrap; }
.course-view-tab.active { background: #ffffff; color: #1f2329; font-weight: 500; box-shadow: 0 2rpx 4rpx rgba(31, 35, 41, .09); }
.course-toolbar-actions { display: flex; flex: none; align-items: center; gap: 6rpx; margin-left: auto; }
.course-toolbar-actions .tool-btn { min-width: 64rpx; height: 52rpx; padding: 0 10rpx; box-sizing: border-box; font-size: 21rpx; line-height: 52rpx; white-space: nowrap; }
/* 统计数值框里的内/外解释：整行铺满、跟在指标下面，和指标同一块底 */
.metric-hint { grid-column: 1 / -1; padding-top: 12rpx; margin-top: 4rpx; border-top: 1rpx solid #f2f3f5; }
.metric-hint-line { display: block; font-size: 20rpx; line-height: 1.5; color: #9aa1a9; }
.chip-group-title { font-size: 24rpx; color: #8f959e; }
.chip-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 10rpx; }
.chip { padding: 8rpx 16rpx; border: 1rpx solid #e5e7ea; border-radius: 999rpx; background: #fafbfc; font-size: 24rpx; color: #4e535a; }
.chip.active { border-color: #b9cdf8; background: #f0f5ff; color: #3370ff; }
/* 指标两列排开，避免换来换去的参差感 */
.metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx 24rpx; padding-top: 16rpx; border-top: 1rpx solid #f2f3f5; }
.metric { display: flex; flex-direction: column; align-items: flex-start; gap: 6rpx; }
.metric-main { display: inline-flex; align-items: baseline; gap: 8rpx; }
.metric-value { font-size: 28rpx; font-weight: 500; }
/* 子项（内部 / 外部）单独一行，跟在主数值下面，小一号、浅灰 */
.metric-sub { font-size: 20rpx; line-height: 1.4; color: #9aa1a9; }
.metric.tappable { padding: 4rpx 10rpx; margin: -4rpx -10rpx; border-radius: 8rpx; }
.metric.tappable.active { background: #eef3ff; }
.metric.tappable.active .metric-value { color: #3370ff; }

/* 列表标题行 + 列表设置 / 排序入口 */
.list-head { display: flex; align-items: center; justify-content: space-between; padding: 26rpx 0 18rpx; }
.list-count { color: #4e535a; font-size: 24rpx; font-weight: 500; }
.list-actions { display: flex; gap: 12rpx; }
/* 列表栏按钮：与课程记录页的 outline-button 同一套（56rpx 高、8rpx 圆角、22rpx 字） */
.tool-btn {
  display: inline-flex;
  min-width: 92rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #dee0e3;
  border-radius: 8rpx;
  background: #ffffff;
  color: #4e535a;
  font-size: 22rpx;
  line-height: 54rpx;
}
.tool-btn-flex { gap: 4rpx; }
.cards + .list-head { padding-top: 0; }
.chips { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 8rpx 0; }
.column-row { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; border-bottom: 1rpx solid #f2f3f5; }
.column-label { flex: 1; font-size: 26rpx; color: #2b2f36; }
.column-move { width: 56rpx; text-align: center; font-size: 26rpx; color: #8f959e; }

/* 底部弹层（列表设置）：与自定义筛选的 sheet 样式一致 */
.sheet-mask { position: fixed; inset: 0; z-index: 200; background: rgba(31,35,41,.34); }
.column-sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 201; border-radius: 16rpx 16rpx 0 0; background: #fff; padding-bottom: env(safe-area-inset-bottom); }
.sheet-head { display: flex; align-items: center; justify-content: space-between; padding: 26rpx 30rpx; border-bottom: 1rpx solid #f0f0f0; }
.sheet-head .sheet-title { margin-bottom: 0; }
.sheet-title { font-size: 28rpx; font-weight: 500; line-height: 1.25; }
.sheet-done { font-size: 25rpx; line-height: 1.25; color: #3370ff; }
.sheet-list { max-height: 62vh; }
.column-list { height: 58vh; }
.sort-list { height: 38vh; }
.sheet-item { display: flex; align-items: center; min-height: 88rpx; margin: 0 30rpx; border-bottom: 1rpx solid #f0f0f0; }
.sheet-item-name { flex: 1; min-width: 0; font-size: 25rpx; line-height: 1.3; color: #2b2f36; }
.traffic-filter-sheet .sheet-item-name { font-size: 28rpx; }
.sheet-item-name.selected { color: #3370ff; font-weight: 500; }
.sheet-item-copy { display: flex; flex-direction: column; max-width: 66%; min-width: 0; margin-left: 16rpx; text-align: right; }
.sheet-item-note { min-width: 0; font-size: 21rpx; line-height: 1.4; white-space: normal; word-break: break-word; color: #8f959e; }
.sheet-item-subnote { min-width: 0; font-size: 18rpx; line-height: 1.3; white-space: normal; word-break: break-word; color: #b0b5bb; }
.sheet-check { display: flex; align-items: center; justify-content: center; width: 24rpx; height: 24rpx; flex: 0 0 24rpx; margin-left: 16rpx; box-sizing: border-box; border: 1rpx solid #c9cdd4; border-radius: 4rpx; font-size: 17rpx; line-height: 1; color: #fff; }
.sheet-check.selected { border-color: #3370ff; background: #3370ff; }
.column-option .sheet-check { width: 40rpx; height: 40rpx; flex-basis: 40rpx; margin-right: 12rpx; font-size: 24rpx; }
.sheet-foot { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 30rpx 26rpx; border-top: 1rpx solid #f0f0f0; }
.column-limit-note { padding: 14rpx 30rpx 4rpx; color: #8f959e; font-size: 21rpx; line-height: 1.4; }
.sort-help { padding: 18rpx 30rpx 8rpx; color: #8f959e; font-size: 22rpx; line-height: 1.5; }
.sort-section-title { padding: 12rpx 30rpx 4rpx; color: #9aa1a9; font-size: 21rpx; }
.sort-option { display: flex; min-height: 78rpx; align-items: center; justify-content: space-between; gap: 16rpx; margin: 0 30rpx; padding: 8rpx 4rpx; border-bottom: 1rpx solid #f0f1f2; box-sizing: border-box; }
.sort-option-copy { display: flex; flex-direction: column; gap: 4rpx; }
.sort-option-name { color: #2b2f36; font-size: 25rpx; }
.sort-option-note { color: #9aa1a9; font-size: 20rpx; }
.sort-radio { display: flex; width: 32rpx; height: 32rpx; flex: none; align-items: center; justify-content: center; border: 2rpx solid #c9cdd4; border-radius: 50%; box-sizing: border-box; color: #ffffff; font-size: 19rpx; }
.sort-radio.selected { border-color: #3370ff; background: #3370ff; }
.sort-actions { padding: 18rpx 30rpx 24rpx; border-top: 1rpx solid #f0f1f2; }
.sort-direction-head { display: flex; justify-content: space-between; align-items: center; color: #2b2f36; font-size: 24rpx; }
.sort-direction-note { color: #a0a7af; font-size: 20rpx; }
.sort-directions { display: flex; gap: 12rpx; margin-top: 14rpx; }
.sort-directions.disabled { opacity: .5; }
.sort-direction { display: flex; flex: 1; align-items: center; justify-content: center; gap: 8rpx; min-height: 64rpx; border: 1rpx solid #dee0e3; border-radius: 8rpx; color: #4e535a; font-size: 23rpx; box-sizing: border-box; }
.sort-direction text { color: #8f959e; font-size: 20rpx; }
.sort-direction.active { border-color: #a9bff5; background: #f4f7ff; color: #2f61d9; }
.sort-apply { display: flex; align-items: center; justify-content: center; height: 72rpx; margin-top: 20rpx; border-radius: 8rpx; background: #3370ff; color: #ffffff; font-size: 26rpx; }
.deal-row { padding: 16rpx 0; border-bottom: 1rpx solid #f2f3f5; }
.deal-main { display: block; font-size: 26rpx; color: #2b2f36; }
.field { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; padding: 10rpx 0; }
.field + .field { border-top: 1rpx solid #f0f1f2; padding-top: 16rpx; }
.field .muted { flex-shrink: 0; max-width: 40%; font-size: 22rpx; }
.value { flex: 1; min-width: 0; text-align: right; word-break: break-all; white-space: pre-wrap; line-height: 1.55; }
.record { padding: 20rpx 24rpx; }
.record + .record { margin-top: 12rpx; }

/* 列表行：白卡里两行式，行间使用 2rpx 横线。 */
.record-card { background: #ffffff; border-radius: 12rpx; padding: 0 28rpx; margin-bottom: 12rpx; }
.record-row { padding: 24rpx 0; }
.record-row + .record-row { border-top: 2rpx solid #f0f1f2; }
.list-head + .record-row { padding-top: 4rpx; }
.record-main { min-width: 0; }
.record-top { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.record-title { flex: 1; min-width: 0; font-size: 29rpx; font-weight: 500; color: #2b2f36; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
/* 会员身份跟在昵称右边 */
.record-identity { flex-shrink: 0; margin-left: 12rpx; padding: 2rpx 10rpx; border-radius: 6rpx; background: #eef3ff; color: #3370ff; font-size: 20rpx; line-height: 1.6; }
/* 每行末尾的「资料 ›」：进客户资料页 */
.record-link { flex-shrink: 0; margin-left: auto; padding: 2rpx 4rpx 2rpx 16rpx; color: #3370ff; font-size: 22rpx; line-height: 1.6; }
.record-right { display: block; margin-top: 10rpx; font-size: 21rpx; color: #a8b1bd; }
/* 分类值：浅灰小标签，一眼看出是"分类"，不和数字混在一起 */
.record-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 12rpx; }
.record-tag { display: inline-flex; align-items: baseline; max-width: 340rpx; padding: 4rpx 10rpx; border-radius: 6rpx; background: #f7f8fa; font-size: 21rpx; line-height: 1.5; overflow: hidden; }
/* 标题用更浅的灰，值用深色，两者一眼能分开 */
.record-tag-label { flex-shrink: 0; margin-right: 8rpx; color: #9aa1a9; }
.record-tag-value { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #2b2f36; }
.record-tag-value.expanded, .record-profile-value.expanded { white-space: pre-wrap; word-break: break-word; }
/* 数字单独一行，浅灰字，用 · 分隔 */
.record-numbers { display: flex; flex-wrap: wrap; align-items: center; gap: 4rpx 14rpx; margin-top: 10rpx; }
.record-number { font-size: 21rpx; line-height: 1.5; color: #2b2f36; }
.record-number-label { margin-right: 6rpx; color: #9aa1a9; }
.record-numbers .record-number + .record-number::before { content: "·"; margin-right: 14rpx; color: #d0d3d6; }
/* 客户档案类字段：不加底色，一行一条，位于数字和日期之间 */
.record-profiles { margin-top: 12rpx; }
.record-profile { display: flex; align-items: baseline; gap: 8rpx; padding: 3rpx 0; }
.record-profile-label { flex-shrink: 0; color: #9aa1a9; font-size: 21rpx; line-height: 1.5; }
.record-profile-value { min-width: 0; color: #4e535a; font-size: 21rpx; line-height: 1.5; word-break: break-all; white-space: pre-wrap; }
.record-more { display: block; margin-top: 10rpx; font-size: 21rpx; color: #3370ff; }
.detail-link { text-align: right; border-top: 1rpx solid #f0f0f0; margin-top: 12rpx; padding-top: 16rpx; }
.empty { padding: 64rpx 24rpx; text-align: center; }
.notice { padding: 20rpx 0 48rpx; }
.error { color: #c4506a; padding: 24rpx 0; }
.mask { position: fixed; inset: 0; background: rgba(0,0,0,.3); z-index: 500; display: flex; align-items: flex-end; }
.sheet { width: 100%; background: #fff; border-radius: 12rpx 12rpx 0 0; padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.sheet-title { display: flex; justify-content: space-between; font-size: 28rpx; margin-bottom: 24rpx; }
.editor-scroll { height: 65vh; }
.action { padding: 24rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.action .control { margin-bottom: 12rpx; }
.add { margin: 20rpx 0; }
.days { width: 180rpx; }
.footer { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 24rpx; }
.evidence { padding: 20rpx 0; border-bottom: 1rpx solid #f0f0f0; word-break: break-all; line-height: 1.6; }
.evidence-row { display: flex; align-items: center; gap: 12rpx; border-bottom: 1rpx solid #f0f0f0; }
.evidence-row .evidence { flex: 1; min-width: 0; border-bottom: none; }
.teacher-list { overflow: hidden; margin-bottom: 12rpx; border-radius: 12rpx; background: #fff; }
.teacher-day { border-top: 2rpx solid #edf0f2; }
.teacher-day + .teacher-day { margin-top: 24rpx; border-top-color: #e8eaed; }
.teacher-day-head, .teacher-course-head, .teacher-person-head, .teacher-dialog-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.teacher-day-head { padding: 22rpx 24rpx; background: #f7f8fa; }
.teacher-day-date { display: flex; align-items: center; gap: 16rpx; font-size: 28rpx; color: #2b2f36; }
.teacher-day-mark { width: 6rpx; height: 26rpx; border-radius: 6rpx; background: #f4dc84; }
.teacher-day-count, .teacher-course-type, .teacher-dialog-meta { font-size: 21rpx; color: #8f959e; }
.teacher-group + .teacher-group { border-top: 18rpx solid #f3f5f7; }
.teacher-group-head { padding: 26rpx 24rpx 0; }
.teacher-group-summary { display: flex; align-items: flex-start; gap: 12rpx; }
.teacher-group-name { flex-shrink: 0; font-size: 28rpx; font-weight: 600; color: #1f2329; }
.teacher-group-stats { display: flex; flex: 1; min-width: 0; align-items: center; flex-wrap: wrap; gap: 4rpx 12rpx; padding-top: 5rpx; }
.teacher-group-stat { font-size: 21rpx; color: #747d86; }
.teacher-group-stat text { color: #343d46; }
.teacher-group-meta { flex-shrink: 0; margin-left: auto; padding-top: 5rpx; font-size: 21rpx; color: #929aa3; }
.teacher-group-stat .teacher-pending { color: #bd803f; }
.teacher-courses { padding: 14rpx 22rpx 24rpx; }
.teacher-course { overflow: hidden; border: 2rpx solid #e9edf0; border-radius: 16rpx; background: #fff; }
.teacher-course + .teacher-course { margin-top: 20rpx; }
.teacher-course-head { align-items: flex-start; justify-content: flex-start; padding: 20rpx; background: #fafbfc; border-bottom: 2rpx solid #edf0f2; }
.teacher-course-index { flex-shrink: 0; font-size: 21rpx; font-weight: 600; color: #98a0a9; line-height: 34rpx; }
.teacher-course-main { flex: 1; min-width: 0; }
.teacher-course-name { display: block; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 24rpx; font-weight: 600; line-height: 34rpx; color: #2b2f36; }
.teacher-course-type { display: block; margin-top: 6rpx; }
.teacher-course-count { flex-shrink: 0; font-size: 21rpx; color: #929aa3; line-height: 34rpx; }
.teacher-person { padding: 20rpx 22rpx; border-bottom: 2rpx solid #f0f1f3; }
.teacher-person:last-child { border-bottom: 0; }
.teacher-person-name { font-size: 23rpx; color: #2b2f36; }
.teacher-owner { font-size: 20rpx; color: #8f959e; }
.teacher-feedback { display: flex; align-items: flex-start; min-height: 32rpx; gap: 12rpx; padding-top: 8rpx; font-size: 21rpx; line-height: 1.5; }
.teacher-feedback-label { flex: 0 0 104rpx; color: #8f959e; }
.teacher-feedback-text { min-width: 0; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #4e535a; }
.teacher-feedback-text.expanded { white-space: pre-wrap; word-break: break-word; }
.teacher-empty-dash { align-self: center; display: inline-block; width: 12rpx; height: 2rpx; border-radius: 2rpx; background: #e5e8eb; font-size: 0; }
.teacher-dialog-meta { display: block; margin: -12rpx 0 16rpx; }
.teacher-dialog-section { border: 1rpx solid #e9ebed; border-radius: 8rpx; margin-bottom: 14rpx; overflow: hidden; }
.teacher-dialog-label { display: block; padding: 12rpx 16rpx; background: #f8f9fa; font-size: 22rpx; color: #4e535a; }
.teacher-dialog-entry { padding: 14rpx 16rpx; border-top: 1rpx solid #f0f1f3; }
.teacher-dialog-head { flex-wrap: wrap; font-size: 20rpx; color: #8f959e; }
.teacher-dialog-content { display: block; margin-top: 6rpx; white-space: pre-wrap; word-break: break-word; font-size: 23rpx; line-height: 1.6; color: #4e535a; }

/* 经营概况 · 方案一：白底细边框，与参与者卡片使用同一套视觉语言。 */
.overview-page .cards {
  gap: 16rpx;
  border: 1rpx solid #ebedf0;
  border-radius: 16rpx;
}
.overview-page .cards .card {
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-bottom: 0;
  border: 2rpx solid #f5f6f7;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: none;
  padding-top: 28rpx;
  padding-bottom: 28rpx;
}
.overview-page .cards .card.active {
  border-color: #edf2fa;
  background: #fbfcff;
}
.overview-page .cards .card-title {
  color: #9aa1a9;
  font-size: 24rpx;
}
.overview-page .cards .card-number {
  color: #1f2329;
  font-weight: 600;
}
.overview-page .cards .card-sub {
  color: #8f959e;
  font-size: 20rpx;
}
.overview-page .panel {
  border: 1rpx solid #ebedf0;
  border-radius: 16rpx;
  padding: 18rpx 28rpx 24rpx;
}
.overview-page .panel.with-overview-summary { padding-bottom: 0; }
.overview-page .panel-grid { margin-top: 0; }
.overview-page .panel-title {
  color: #1f2329;
  font-weight: 600;
}
.overview-page .panel-cell-label {
  color: #9aa1a9;
}
.overview-page .panel .metrics {
  border-top: 1rpx solid #f2f3f5;
}
.overview-page .panel .metric-main .muted {
  color: #9aa1a9;
}
.overview-page .panel .metric-value {
  color: #33393f;
  font-size: 24rpx;
  font-weight: 400;
}
.overview-page .panel .metric-sub {
  color: #8f959e;
  font-size: 22rpx;
}
.overview-page .record-card {
  border: 1rpx solid #ebedf0;
  border-radius: 16rpx;
}
.overview-page .record-row + .record-row {
  position: relative;
  border-top: 0;
}
.overview-page .record-row + .record-row::before {
  content: "";
  position: absolute;
  top: 0;
  right: -28rpx;
  left: 0;
  height: 2rpx;
  background: #f8f9fa;
}
.overview-page .record-title {
  color: #1f2329;
  font-size: 28rpx;
  font-weight: 600;
}
.overview-page .filter-card {
  border-radius: 16rpx;
}
.overview-page .panel-section {
  margin-bottom: 12rpx;
}
.overview-page .panel-head-outside {
  min-height: 86rpx;
  align-items: center;
  gap: 0;
  margin: 0;
  padding: 0;
}
.overview-page .panel-title-mark {
  width: 12rpx;
  height: 12rpx;
  flex: 0 0 auto;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #f4dc84;
  transform: translateX(2rpx);
}
.overview-page .panel-head-outside .panel-title {
  color: #39424b;
  font-size: 28rpx;
  font-weight: 600;
}
.overview-page .panel-head-outside .muted {
  margin-left: 12rpx;
  color: #8f959e;
  font-size: 21rpx;
}
.overview-page .list-head {
  min-height: 72rpx;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #f8f9fa;
}
.overview-page .record-card .list-head {
  margin: 0 -28rpx;
  padding: 12rpx 28rpx;
  box-sizing: border-box;
}
.overview-page .record-card .record-row { padding: 30rpx 0; }
.overview-page .record-card .list-head + .record-row { padding-top: 26rpx; }
.overview-page .record-card .record-tags { margin-top: 20rpx; column-gap: 10rpx; row-gap: 12rpx; }
.overview-page .record-card .record-tag { padding-top: 5rpx; padding-bottom: 5rpx; }
.overview-page .record-card .record-numbers { margin-top: 18rpx; }
.overview-page .record-card .record-profiles { margin-top: 20rpx; }
.overview-page .record-card .record-profile { padding: 5rpx 0; }
.overview-page .record-card .record-right { margin-top: 14rpx; }
.overview-page .list-actions {
  flex-wrap: nowrap;
  gap: 8rpx;
}
.overview-page .tool-btn {
  min-width: 76rpx;
  height: 52rpx;
  padding: 0 14rpx;
  border: 0;
  border-radius: 8rpx;
  background: #f2f3f5;
  color: #4e535a;
  font-size: 21rpx;
  line-height: 52rpx;
}
/* 邀约到店：方案 B，把页签与常用操作排在同一行。 */
.overview-page .invite-toolbar {
  position: relative;
  z-index: 99;
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 96rpx;
  margin: 0 -28rpx;
  padding: 0 28rpx;
  border-bottom: 2rpx solid #f8f9fa;
}
.overview-page .invite-toolbar-tabs {
  display: flex;
  flex: none;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx;
  border-radius: 14rpx;
  background: #f2f3f5;
}
.overview-page .invite-toolbar-tab {
  display: flex;
  width: 180rpx;
  flex: none;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 12rpx 6rpx;
  border-radius: 10rpx;
  color: #646a73;
  font-size: 22rpx;
  text-align: center;
  white-space: nowrap;
}
.overview-page .invite-toolbar-tab.active {
  background: #ffffff;
  color: #1f2329;
  font-weight: 500;
  box-shadow: 0 2rpx 4rpx rgba(31, 35, 41, .09);
}
.overview-page .invite-tab-count { color: #8f959e; font-size: 18rpx; font-weight: 400; }
.overview-page .invite-toolbar-actions {
  display: flex;
  flex: none;
  align-items: center;
  gap: 8rpx;
  margin-left: auto;
}
.overview-page .invite-toolbar-actions .tool-btn { min-width: 68rpx; padding: 0 16rpx; white-space: nowrap; }
.overview-page .invite-toolbar-more { min-width: 56rpx !important; padding: 0 8rpx !important; font-size: 30rpx !important; }
.invite-tools-overlay { position: fixed; inset: 0; z-index: 98; background: transparent; }
.overview-page .invite-tools-menu {
  position: absolute;
  top: 80rpx;
  right: 0;
  z-index: 100;
  width: 300rpx;
  padding: 8rpx;
  border: 1rpx solid #edf0f2;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(31, 35, 41, .08);
}
.overview-page .invite-tools-menu-item { padding: 14rpx 18rpx; color: #505963; font-size: 22rpx; line-height: 1.5; }
.overview-page .invite-tools-menu-item + .invite-tools-menu-item,
.overview-page .invite-tools-menu picker + .invite-tools-menu-item { border-top: 1rpx solid #f6f7f8; }
.overview-page .invite-display-mode { display: flex; flex-direction: column; gap: 4rpx; }
.overview-page .invite-display-value { color: #8f959e; font-size: 20rpx; }
.overview-page .record-tag,
.overview-page .record-number,
.overview-page .record-profile {
  font-size: 22rpx;
}
.overview-page .record-tag-label,
.overview-page .record-number-label,
.overview-page .record-profile-label {
  color: #9aa1a9;
}
.overview-page .record-tag-value,
.overview-page .record-number,
.overview-page .record-profile-value {
  color: #33393f;
}
.overview-page .record-right {
  color: #8f959e;
}

/* ---- 转化分析：规则就地编辑（和自定义筛选同一套视觉） ---- */
.section-card { background: #ffffff; border-radius: 12rpx; padding: 24rpx 28rpx; margin-bottom: 12rpx; }
/* 标题一行放操作，规则下拉整行铺开，说明压在下拉下面 → 一块白卡看完整个规则 */
.conv-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.conv-title { font-size: 28rpx; font-weight: 500; color: #1f2329; }
.conv-head-actions { display: flex; align-items: center; gap: 12rpx; }
.conv-btn { flex-shrink: 0; display: inline-flex; align-items: center; height: 56rpx; padding: 0 20rpx; border: 1rpx solid #dee0e3; border-radius: 8rpx; font-size: 23rpx; color: #4e535a; white-space: nowrap; }
.conv-btn.danger { color: #c4506a; border-color: #f1d9dc; }
.conv-picker { display: block; margin-top: 16rpx; }
.conv-tips { padding-bottom: 18rpx; border-bottom: 1rpx solid #f2f3f5; }
.conv-desc { display: block; margin-top: 12rpx; font-size: 22rpx; line-height: 1.6; color: #8f959e; }
.conv-note { display: block; margin-top: 10rpx; font-size: 21rpx; line-height: 1.5; color: #9aa1a9; }

.rule-line { display: flex; align-items: flex-start; gap: 16rpx; padding: 22rpx 0; border-bottom: 1rpx solid #f2f3f5; }
.rule-line-head { flex-shrink: 0; display: flex; align-items: center; gap: 8rpx; width: 56rpx; padding-top: 16rpx; }
.rule-line-label { font-size: 26rpx; font-weight: 500; color: #3370ff; }
.rule-line-remove { font-size: 22rpx; color: #b0b5bb; }
.rule-line-body { flex: 1; min-width: 0; }
.rule-controls { display: flex; flex-wrap: wrap; gap: 10rpx; }
.rule-pick { flex: 1 1 46%; min-width: 0; }
.rule-pick .control { min-height: 56rpx; padding: 0 14rpx; font-size: 23rpx; }

/* 一条附加条件：字段 + 规则一行，值单独一行（和自定义筛选的条件行一致） */
.cond-card { margin-top: 12rpx; padding: 14rpx; border: 1rpx solid #eceef0; border-radius: 8rpx; background: #fbfcfd; }
.cond-head { display: flex; align-items: center; gap: 12rpx; }
.cond-choice { display: flex; align-items: center; flex: 0 0 auto; max-width: 58%; }
.cond-choice.secondary { max-width: 40%; }
.cond-choice-text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 23rpx; font-weight: 500; color: #2b2f36; }
.cond-choice.secondary .cond-choice-text { font-weight: 400; color: #4e535a; }
.cond-remove { flex-shrink: 0; margin-left: auto; padding: 0 4rpx; font-size: 22rpx; color: #b0b5bb; }
.chevron.light { width: 16rpx; height: 16rpx; margin-left: 6rpx; }
.cond-value { display: flex; align-items: center; gap: 10rpx; margin-top: 12rpx; }
.cond-full { flex: 1; min-width: 0; }
.cond-half { flex: 1; min-width: 0; }
.cond-input { display: flex; align-items: center; height: 56rpx; padding: 0 14rpx; box-sizing: border-box; border: 1rpx solid transparent; border-radius: 6rpx; background: #f5f6f7; font-size: 23rpx; color: #2b2f36; }
.cond-input.placeholder { color: #9aa1a9; }
.cond-input-picker { justify-content: space-between; }
.cond-value-text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cond-sep { flex-shrink: 0; font-size: 21rpx; color: #8f959e; }
.cond-add { display: block; margin-top: 14rpx; font-size: 24rpx; color: #3370ff; }
.cond-add.target { margin: 18rpx 0 0 72rpx; }

.conv-meta { margin-top: 20rpx; padding: 18rpx 20rpx; border-radius: 8rpx; background: #f7f8fa; }
.conv-mode { display: block; margin-bottom: 14rpx; }
.conv-mode .control { min-height: 56rpx; font-size: 23rpx; }
.conv-days { display: flex; align-items: center; gap: 12rpx; }
.conv-days-label { font-size: 23rpx; color: #4e535a; }
.conv-days .control { width: 160rpx; min-height: 56rpx; font-size: 23rpx; }
.conv-days-unit { font-size: 23rpx; color: #4e535a; }
.conv-check { display: flex; align-items: center; gap: 10rpx; margin-top: 14rpx; }
.conv-check-box { display: flex; align-items: center; justify-content: center; width: 30rpx; height: 30rpx; box-sizing: border-box; border: 1rpx solid #c9cdd4; border-radius: 6rpx; background: #fff; font-size: 20rpx; color: #fff; }
.conv-check-box.checked { border-color: #3370ff; background: #3370ff; }
.conv-check-text { font-size: 23rpx; color: #4e535a; }
.conv-meta-note { display: block; margin-top: 10rpx; font-size: 20rpx; line-height: 1.5; color: #9aa1a9; }

.conv-status { margin-top: 20rpx; }
.conv-status-label { font-size: 24rpx; color: #4e535a; }
.conv-status-tabs { display: flex; gap: 4rpx; margin-top: 12rpx; padding: 4rpx; border-radius: 10rpx; background: #f2f3f5; }
.conv-status-tab { flex: 1; height: 56rpx; line-height: 56rpx; text-align: center; font-size: 23rpx; color: #4e535a; border-radius: 8rpx; }
.conv-status-tab.active { background: #ffffff; color: #1f2329; font-weight: 500; box-shadow: 0 1rpx 3rpx rgba(31, 35, 41, .10); }
.conv-status-note { display: block; margin-top: 12rpx; font-size: 21rpx; line-height: 1.5; color: #8f959e; }

/* 底部：当前规则摘要 + 重置 / 查询（和自定义筛选底部那一栏一致） */
.conv-foot { margin: 24rpx -28rpx -24rpx; padding: 20rpx 28rpx; border-top: 1rpx solid #f0f0f0; background: #fafbfc; border-radius: 0 0 12rpx 12rpx; }
.conv-sentence { display: block; font-size: 21rpx; line-height: 1.6; color: #79838f; }
.conv-foot-actions { display: flex; justify-content: flex-end; gap: 24rpx; margin-top: 16rpx; }
.conv-reset { font-size: 24rpx; color: #8f959e; }
.conv-query { padding: 0 40rpx; height: 64rpx; line-height: 64rpx; border-radius: 8rpx; background: #3370ff; color: #fff; font-size: 25rpx; }
.conv-query.disabled { opacity: .5; }

/* 保存规则弹窗（和自定义筛选的保存模板同一套） */
.save-rule-mask { position: fixed; inset: 0; z-index: 300; display: flex; align-items: center; justify-content: center; padding: 0 40rpx; background: rgba(31, 35, 41, .34); }
.save-rule-dialog { width: 100%; max-width: 660rpx; border-radius: 16rpx; background: #fff; overflow: hidden; }
.save-rule-head { padding: 26rpx 28rpx 20rpx; border-bottom: 1rpx solid #f0f0f0; }
.save-rule-title { font-size: 28rpx; font-weight: 500; color: #1f2329; }
.save-rule-body { padding: 26rpx 28rpx; }
.save-rule-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; }
.save-rule-label { flex-shrink: 0; width: 112rpx; font-size: 24rpx; color: #4e535a; }
.save-rule-input { flex: 1; min-width: 0; height: 64rpx; padding: 0 16rpx; box-sizing: border-box; border: 1rpx solid #e1e4e7; border-radius: 8rpx; font-size: 24rpx; color: #2b2f36; }
.save-rule-placeholder { color: #b0b5bb; }
.save-rule-scope { flex: 1; min-width: 0; display: flex; padding: 4rpx; border-radius: 8rpx; border: 1rpx solid #e1e4e7; background: #f7f8fa; }
.save-rule-scope-item { flex: 1; height: 56rpx; line-height: 56rpx; text-align: center; border-radius: 6rpx; font-size: 23rpx; color: #646a73; }
.save-rule-scope-item.active { background: #fff; color: #3370ff; font-weight: 500; }
.save-rule-note { display: block; font-size: 21rpx; line-height: 1.6; color: #8f959e; }
.save-rule-actions { display: flex; justify-content: flex-end; gap: 20rpx; padding: 20rpx 28rpx 26rpx; border-top: 1rpx solid #f0f0f0; }
.save-rule-button { padding: 0 36rpx; height: 64rpx; line-height: 64rpx; border-radius: 8rpx; font-size: 25rpx; border: 1rpx solid #dee0e3; color: #4e535a; background: #fff; }
.save-rule-button.confirm { border-color: #3370ff; background: #3370ff; color: #fff; }
.save-rule-button.disabled { opacity: .6; }

/* B：连续条件表。转化分析只压缩下面的规则区，顶部「范围 / 周期 / 自定义」筛选区与经营概况共用同一套样式。 */
.conversion-compact .section-card { padding: 14rpx 20rpx; border-radius: 6rpx; margin-bottom: 8rpx; }
.conversion-compact .conv-head { gap: 10rpx; flex-wrap: wrap; }
.conversion-compact .conv-title { font-size: 24rpx; color: #8f959e; font-weight: 400; flex-shrink: 0; }
.conversion-compact .conv-picker { flex: 1; min-width: 200rpx; margin-top: 0; }
.conversion-compact .conv-head-actions { gap: 12rpx; margin-left: auto; }
.conversion-compact .conv-btn { padding: 0; border: none; height: 48rpx; font-size: 22rpx; color: #3370ff; }
.conversion-compact .conv-btn.danger { color: #c4506a; }
.conversion-compact .conv-tips { padding-bottom: 8rpx; border: 0; }
.conversion-compact .conv-desc,
.conversion-compact .conv-note { font-size: 20rpx; margin-top: 6rpx; line-height: 1.4; }
.conversion-compact .rule-line { display: block; padding: 0 0 8rpx; border: none; }
.conversion-compact .rule-line-head { width: auto; padding: 10rpx 20rpx; margin: 6rpx -20rpx 10rpx; background: #f5f7fa; justify-content: space-between; }
.conversion-compact .rule-line-label { color: #2b2f36; font-size: 24rpx; font-weight: 500; }
.conversion-compact .rule-line-remove { padding: 6rpx 12rpx; margin: -6rpx -12rpx; }
.conversion-compact .rule-controls { display: grid; grid-template-columns: 60rpx minmax(0, 1fr); gap: 8rpx 12rpx; align-items: center; }
.conversion-compact .rule-field-label { color: #8f959e; font-size: 24rpx; }
.conversion-compact .rule-pick { min-width: 0; }
.conversion-compact .cond-card { display: flex; align-items: center; gap: 8rpx; padding: 0; margin-top: 8rpx; border: 0; background: none; }
.conversion-compact .cond-head { flex: 1.25; min-width: 0; gap: 8rpx; }
.conversion-compact .cond-choice { flex: 1; min-width: 0; max-width: none; height: 56rpx; padding: 0 10rpx; box-sizing: border-box; border: 1rpx solid #dee0e3; border-radius: 6rpx; }
.conversion-compact .cond-choice.secondary { flex: .75; max-width: none; }
.conversion-compact .cond-choice-text { font-size: 22rpx; font-weight: 400; flex: 1; }
.conversion-compact .cond-remove { font-size: 22rpx; padding: 10rpx 4rpx; }
.conversion-compact .cond-value { flex: 1; min-width: 0; margin: 0; gap: 6rpx; }
.conversion-compact .cond-input { width: 100%; min-width: 0; height: 56rpx; padding: 0 10rpx; font-size: 22rpx; border-color: #dee0e3; background: #fff; }
.conversion-compact .cond-range { flex-wrap: wrap; }
.conversion-compact .cond-range .cond-head,
.conversion-compact .cond-range .cond-value { flex-basis: 100%; }
.conversion-compact .cond-half { width: 0; }
.conversion-compact .cond-add { font-size: 22rpx; margin: 8rpx 0 0 72rpx; padding: 4rpx 0; }
.conversion-compact .cond-add.target { margin: 6rpx 0; }
.conversion-compact .conv-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx 16rpx; padding: 10rpx 0; margin-top: 6rpx; border-top: 1rpx solid #f0f0f0; background: none; }
.conversion-compact .conv-mode { flex: 0 0 100%; margin-bottom: 0; }
.conversion-compact .conv-days { gap: 8rpx; }
.conversion-compact .conv-days-label,
.conversion-compact .conv-check-text { font-size: 22rpx; }
.conversion-compact .conv-days .control { width: 88rpx; }
.conversion-compact .conv-check { margin: 0 0 0 auto; gap: 8rpx; }
.conversion-compact .conv-check-box { width: 26rpx; height: 26rpx; font-size: 18rpx; border-radius: 4rpx; }
.conversion-compact .conv-meta-note { width: 100%; margin: 0; font-size: 20rpx; }
.conversion-compact .conv-status { margin-top: 8rpx; }
.conversion-compact .conv-status-label { font-size: 22rpx; }
.conversion-compact .conv-status-tabs { margin-top: 6rpx; }
.conversion-compact .conv-status-tab { height: 48rpx; line-height: 48rpx; font-size: 22rpx; }
.conversion-compact .conv-status-note { font-size: 20rpx; margin-top: 6rpx; }
.conversion-compact .conv-foot { margin: 10rpx 0 0; padding: 10rpx 0 0; background: none; border-radius: 0; }
.conversion-compact .conv-sentence { font-size: 20rpx; line-height: 1.5; }
.conversion-compact .conv-foot-actions { position: fixed; left: 0; right: 0; bottom: 0; z-index: 100; margin: 0; align-items: center; padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e8eaed; background: #fff; }
.conversion-compact .conv-reset { padding: 12rpx; font-size: 24rpx; }
.conversion-compact .conv-query { height: 60rpx; line-height: 60rpx; padding: 0 44rpx; font-size: 24rpx; }
.conversion-compact { padding-bottom: calc(112rpx + env(safe-area-inset-bottom)); }
.conversion-compact .stats { display: flex; flex-wrap: wrap; gap: 0; background: #fff; border-radius: 6rpx; padding: 14rpx 0; margin-bottom: 8rpx; }
.conversion-compact .stat { flex: 1 1 25%; min-width: 0; padding: 4rpx 8rpx; border-radius: 0; text-align: center; box-sizing: border-box; }
.conversion-compact .stat + .stat { border-left: 1rpx solid #f0f0f0; }
.conversion-compact .stat .muted { font-size: 22rpx; overflow-wrap: break-word; }
.conversion-compact .number { font-size: 34rpx; margin-top: 4rpx; }
.conversion-compact .record-card { padding: 0 20rpx; border-radius: 6rpx; }
.conversion-compact .list-head { padding: 14rpx 0; gap: 12rpx; flex-wrap: wrap; }
.conversion-compact .list-actions { flex-wrap: wrap; }
.conversion-compact .tool-btn { min-width: 72rpx; height: 48rpx; line-height: 46rpx; padding: 0 14rpx; }
.conversion-compact .record-row { padding: 16rpx 0; }
.conversion-compact .record-title { font-size: 26rpx; font-weight: 400; }
.conversion-compact .record-tags,
.conversion-compact .record-numbers,
.conversion-compact .record-right { margin-top: 6rpx; }

/* 组织/俱乐部内容卡片：统一到课程记录卡片的圆角、无描边和轻阴影。 */
.overview-page .filter-card,
.overview-page .cards,
.overview-page .panel,
.overview-page .record-card,
.overview-page .course-view-bar,
.overview-page .teacher-list,
.overview-page .teacher-course,
.conversion-compact .filter-card,
.conversion-compact .stats,
.conversion-compact .section-card,
.conversion-compact .record-card {
  border: 0;
  border-radius: 16rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}

.overview-page .cards {
  border: 0;
  border-radius: 16rpx;
  background: #ffffff;
}

/* 课程数据：工具栏与列表衔接，避免两张白卡和过宽的操作按钮。 */
.overview-page .course-view-bar {
  border-radius: 16rpx 16rpx 0 0;
  border-bottom: 2rpx solid #f8f9fa;
  box-shadow: none;
}
.overview-page .course-result-card,
.overview-page .teacher-list {
  margin-top: 0;
  border-top: 0;
  border-radius: 0 0 16rpx 16rpx;
}
.overview-page .course-toolbar-actions .tool-btn {
  min-width: 64rpx;
  height: 52rpx;
  padding: 0 10rpx;
  font-size: 21rpx;
  line-height: 52rpx;
}
.overview-page .teacher-course { border: 2rpx solid #e9edf0; border-radius: 16rpx; box-shadow: none; }
.overview-page .teacher-person { padding: 20rpx 22rpx; }
.overview-page .teacher-person-head + .teacher-feedback { padding-top: 20rpx; }
.overview-page .teacher-feedback + .teacher-feedback { padding-top: 12rpx; }
