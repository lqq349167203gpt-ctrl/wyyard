<import src="../../templates/note-feedback-meta.wxml" />
<!-- 弹层打开时锁住页面滚动，避免上下滑动带动背景 -->
<page-meta page-style="{{condSheet || showSaveRule || detail || teacherDetail || columnSheetOpen || sortSheetOpen || dealSheet || panelSheet || recordSheet || historySheet ? 'overflow:hidden;height:100vh;' : ''}}" />
<view class="invite-tools-overlay" wx:if="{{inviteToolMenuOpen}}" catchtap="closeInviteToolMenu" catchtouchmove="noop"></view>
<view class="page {{query.tab === 'conversion' ? 'conversion-compact' : ''}} {{query.tab === 'overview' ? 'overview-page' : ''}}" bindtap="closeInviteToolMenu">
  <!-- 顶部 tab：白条 + 蓝字下划线（和课表/付费项目一致），放在筛选项上面 -->
  <view class="seg-tabs"><view wx:for="{{tabs}}" wx:key="key" class="seg-tab {{query.tab === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="onTab">{{item.label}}</view></view>
  <view class="card filter-card">
    <view class="filter-row range-filter-row">
      <text class="filter-label">范围</text>
      <picker class="scope-type-picker" range="{{scopeTypes}}" disabled="{{!scopeTypes.length}}" value="{{scopeTypeIndex}}" bindchange="onScopeType">
        <view class="control scope-control"><text class="control-text">{{scopeTypes[scopeTypeIndex] || "未开通统计范围"}}</text><view class="course-picker-arrow"></view></view>
      </picker>
      <picker class="filter-control" range="{{scopeTargets}}" range-key="name" value="{{scopeTargetIndex}}" bindchange="onScopeTarget">
        <view class="control scope-control"><text class="control-text">{{scopeTargets[scopeTargetIndex].name}}</text><view class="course-picker-arrow"></view></view>
      </picker>
    </view>
    <view wx:if="{{query.scope_type !== 'person'}}" class="archive-scope-control" bindtap="toggleArchivedOrganizations" role="checkbox" aria-checked="{{includeArchived}}">
      <text class="archive-checkbox {{includeArchived ? 'checked' : ''}}">{{includeArchived ? '✓' : ''}}</text><text>包含已归档</text>
    </view>
    <view class="filter-row range-filter-row">
      <text class="filter-label">周期</text>
      <view class="preset-row course-presets">
        <view wx:for="{{rangePresets}}" wx:key="key" class="course-preset {{rangePreset === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="onRangePreset">{{item.label}}</view>
      </view>
    </view>
    <view class="filter-row range-filter-row">
      <text class="filter-label">自定义</text>
      <view class="date-range course-date-range">
        <picker class="date-picker" mode="date" start="{{minDate}}" value="{{query.date_from}}" data-field="date_from" bindchange="onDate">
          <view class="date-value course-date-value {{query.date_from ? '' : 'placeholder'}}"><text class="date-text">{{query.date_from || '开始日期'}}</text><view class="course-picker-arrow"></view></view>
        </picker>
        <text class="date-separator">至</text>
        <picker class="date-picker" mode="date" start="{{query.date_from || minDate}}" value="{{query.date_to}}" data-field="date_to" bindchange="onDate">
          <view class="date-value course-date-value {{query.date_to ? '' : 'placeholder'}}"><text class="date-text">{{query.date_to || '结束日期'}}</text><view class="course-picker-arrow"></view></view>
        </picker>
      </view>
    </view>
  </view>
  <!-- 转化分析：规则、条件、期限、状态全在页面里就地改，不单独拉弹窗（和 PC 一致） -->
  <block wx:if="{{query.tab === 'conversion'}}">
    <view class="section-card">
      <view class="conv-head">
        <text class="conv-title">转化规则</text>
        <picker class="conv-picker" range="{{ruleOptions}}" value="{{ruleIndex}}" bindchange="onRule">
          <view class="control"><text class="control-text">{{ruleOptions[ruleIndex]}}</text><view class="chevron"></view></view>
        </picker>
        <view class="conv-head-actions">
          <text class="conv-btn" bindtap="openSaveRule">保存规则</text>
          <text class="conv-btn danger" wx:if="{{ruleId && canManageRule}}" bindtap="removeRule">删除规则</text>
        </view>
      </view>
      <view class="conv-tips">
        <text class="conv-desc" wx:if="{{query.rule.description}}">规则说明：{{query.rule.description}}</text>
        <text class="conv-note">决定什么算转化；改完点「查询」重算，要长期使用请点「保存规则」</text>
      </view>

      <view class="rule-line" wx:for="{{actionEditors}}" wx:key="index" wx:for-item="act">
        <view class="rule-line-head">
          <text class="rule-line-label">{{act.index + 1}}　{{act.index === 0 ? '起始客户' : act.index === 1 ? '转化目标' : act.title + ' · 转化目标'}}</text>
          <text class="rule-line-remove" wx:if="{{act.index > 0 && canRemoveTarget}}" data-index="{{act.index}}" bindtap="removeTarget">✕</text>
        </view>
        <view class="rule-line-body">
          <view class="rule-controls">
            <text class="rule-field-label">行为</text>
            <picker class="rule-pick" range="{{kindLabels}}" value="{{act.kindIndex}}" data-index="{{act.index}}" data-field="kind" bindchange="onAction">
              <view class="control"><text class="control-text">{{kindLabels[act.kindIndex]}}</text><view class="chevron"></view></view>
            </picker>
            <text class="rule-field-label" wx:if="{{act.products.length > 1}}">产品</text>
            <picker class="rule-pick" wx:if="{{act.products.length > 1}}" range="{{act.products}}" range-key="label" value="{{act.productIndex}}" data-index="{{act.index}}" data-field="product" bindchange="onAction">
              <view class="control"><text class="control-text">{{act.products[act.productIndex].label}}</text><view class="chevron"></view></view>
            </picker>
            <text class="rule-field-label" wx:if="{{act.subtypes.length > 1}}">类型</text>
            <picker class="rule-pick" wx:if="{{act.subtypes.length > 1}}" range="{{act.subtypeLabels}}" value="{{act.subtypeIndex}}" data-index="{{act.index}}" data-field="subtype" bindchange="onAction">
              <view class="control"><text class="control-text">{{act.subtypeLabels[act.subtypeIndex]}}</text><view class="chevron"></view></view>
            </picker>
            <text class="rule-field-label">次数</text>
            <picker class="rule-pick" range="{{act.occurrenceLabels}}" value="{{act.occurrenceIndex}}" data-index="{{act.index}}" data-field="occurrence" bindchange="onAction">
              <view class="control"><text class="control-text">{{act.occurrenceLabels[act.occurrenceIndex]}}</text><view class="chevron"></view></view>
            </picker>
          </view>

          <!-- 附加条件：字段 / 规则 / 值与自定义筛选同一套，可以加多条 -->
          <view class="cond-card {{cond.isBetween ? 'cond-range' : ''}} {{cond.noValue ? 'cond-no-value' : ''}}" wx:for="{{act.conditions}}" wx:key="index" wx:for-item="cond" wx:for-index="ci">
            <view class="cond-head">
              <view class="cond-choice" data-index="{{act.index}}" data-ci="{{ci}}" data-sheet="field" bindtap="onConditionPick">
                <text class="cond-choice-text">{{cond.fieldLabel}}</text>
                <view class="chevron light"></view>
              </view>
              <view class="cond-choice secondary" data-index="{{act.index}}" data-ci="{{ci}}" data-sheet="operator" bindtap="onConditionPick">
                <text class="cond-choice-text">{{cond.operatorLabel}}</text>
                <view class="chevron light"></view>
              </view>
              <text class="cond-remove" data-index="{{act.index}}" data-ci="{{ci}}" bindtap="onConditionRemove">✕</text>
            </view>
            <view class="cond-value" wx:if="{{!cond.noValue}}">
              <block wx:if="{{cond.isBetween}}">
                <picker wx:if="{{cond.isDate}}" class="cond-half" mode="date" value="{{cond.valueStart}}" data-index="{{act.index}}" data-ci="{{ci}}" data-part="start" bindchange="onConditionValue">
                  <view class="cond-input {{cond.valueStart ? '' : 'placeholder'}}">{{cond.valueStart || '开始日期'}}</view>
                </picker>
                <input wx:else class="cond-input cond-half" type="{{cond.isNumber ? 'digit' : 'text'}}" value="{{cond.valueStart}}" placeholder="起始值" data-index="{{act.index}}" data-ci="{{ci}}" data-part="start" bindinput="onConditionValue" />
                <text class="cond-sep">至</text>
                <picker wx:if="{{cond.isDate}}" class="cond-half" mode="date" value="{{cond.valueEnd}}" data-index="{{act.index}}" data-ci="{{ci}}" data-part="end" bindchange="onConditionValue">
                  <view class="cond-input {{cond.valueEnd ? '' : 'placeholder'}}">{{cond.valueEnd || '结束日期'}}</view>
                </picker>
                <input wx:else class="cond-input cond-half" type="{{cond.isNumber ? 'digit' : 'text'}}" value="{{cond.valueEnd}}" placeholder="结束值" data-index="{{act.index}}" data-ci="{{ci}}" data-part="end" bindinput="onConditionValue" />
              </block>
              <picker wx:elif="{{cond.isDate}}" class="cond-full" mode="date" value="{{cond.value}}" data-index="{{act.index}}" data-ci="{{ci}}" data-part="single" bindchange="onConditionValue">
                <view class="cond-input {{cond.value ? '' : 'placeholder'}}">{{cond.value || '选择日期'}}</view>
              </picker>
              <view wx:elif="{{cond.hasOptions}}" class="cond-input cond-input-picker {{(cond.isMulti ? cond.multiLabel : cond.valueLabel) ? '' : 'placeholder'}}" data-index="{{act.index}}" data-ci="{{ci}}" data-sheet="{{cond.isMulti ? 'multi' : 'value'}}" bindtap="onConditionPick">
                <text class="cond-value-text">{{cond.isMulti ? cond.multiLabel : cond.valueLabel || '选择筛选值'}}</text>
                <view class="chevron light"></view>
              </view>
              <input wx:else class="cond-input" type="{{cond.isNumber ? 'digit' : 'text'}}" value="{{cond.value}}" placeholder="填写筛选值" data-index="{{act.index}}" data-ci="{{ci}}" data-part="single" bindinput="onConditionValue" />
            </view>
          </view>
          <text class="cond-add" wx:if="{{act.canAddCondition}}" data-index="{{act.index}}" bindtap="onConditionAdd">＋ 筛选条件</text>
        </view>
      </view>
      <text class="cond-add target" wx:if="{{canAddTarget}}" bindtap="addTarget">＋ 再加一项条件</text>

      <view class="conv-meta">
        <picker wx:if="{{canRemoveTarget}}" class="conv-mode" range="{{modeLabels}}" value="{{targetModeIndex}}" bindchange="onMode">
          <view class="control"><text class="control-text">{{modeLabels[targetModeIndex]}}</text><view class="chevron"></view></view>
        </picker>
        <view class="conv-days">
          <text class="conv-days-label">转化期限</text>
          <input class="control days" type="digit" value="{{query.rule.window_days}}" data-field="window_days" data-number="1" bindinput="onRuleField" />
          <text class="conv-days-unit">天</text>
        </view>
        <view class="conv-check" bindtap="onToggleSameOrg">
          <view class="conv-check-box {{query.rule.same_organization ? 'checked' : ''}}">{{query.rule.same_organization ? '✓' : ''}}</view>
          <text class="conv-check-text">同一组织/俱乐部</text>
        </view>
        <text class="conv-meta-note">0 表示当天（多项目之间的先后不限天数）；不勾选时算所有有权查看的组织/俱乐部。</text>
      </view>

      <view class="conv-status">
        <text class="conv-status-label">结果状态</text>
        <view class="conv-status-tabs">
          <view class="conv-status-tab {{query.status === item.value ? 'active' : ''}}" wx:for="{{statusFilters}}" wx:key="value" data-value="{{item.value}}" bindtap="onStatusTap">{{item.label}}</view>
        </view>
        <text class="conv-status-note">已转化：达到条件；未转化：到期还没达到；观察中：还没到截止日期。</text>
      </view>

      <view class="conv-foot">
        <text class="conv-sentence">当前：{{ruleSentence}}</text>
        <view class="conv-foot-actions">
          <text class="conv-reset" bindtap="onScopeReset">重置</text>
          <text class="conv-query {{loading ? 'disabled' : ''}}" bindtap="runScopeQuery">{{loading ? '查询中' : '查询'}}</text>
        </view>
      </view>
    </view>
  </block>
  <view wx:if="{{error}}" class="error" bindtap="retryLoad">{{error}} · 点击重试</view>
  <view wx:if="{{metadata && !metadata.organizations.length}}" class="muted empty">暂无可查看组织，请检查账号归属人和组织成员配置。同名归属人需先消除歧义。</view>

  <!-- 经营概况：五张卡与 PC 使用相同口径 -->
  <block wx:if="{{query.tab === 'overview' && cards.length}}">
    <view class="cards">
      <view wx:for="{{cards}}" wx:key="key" class="card {{overviewGroup === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="onOverviewCard">
        <view class="card-title-line">
          <text class="card-title">{{item.title}}</text>
          <text class="card-help" wx:if="{{item.help}}" data-key="{{item.key}}" catchtap="toggleCardHelp">?</text>
        </view>
        <view class="card-value"><text class="card-number">{{item.value}}</text><text class="card-unit">{{item.unit}}</text></view>
        <text class="card-sub">{{item.sub}}</text>
        <text class="card-help-text" wx:if="{{helpKey === item.key}}">{{item.help}}</text>
      </view>
    </view>
    <view class="panel-section" wx:if="{{overviewGroup}}">
      <view class="panel-head panel-head-outside"><view class="panel-title-mark"></view><text class="panel-title">{{panelTitle}}</text><text class="muted">按下面的维度筛选列表</text></view>
      <view class="panel {{panelMetrics.length ? 'with-overview-summary' : ''}}">
        <!-- 每个维度一个下拉（和 PC 的面板筛选、自定义筛选同一套）：选了某一维再出现它的子级 -->
        <!-- 面板筛选：用底部弹层选，选项后面带数量（和 PC 的下拉一致） -->
        <view class="panel-grid">
          <view class="panel-cell" wx:for="{{panelSelects}}" wx:key="label" wx:for-item="sel" wx:for-index="si">
            <text class="panel-cell-label">{{sel.label}}</text>
            <view class="control {{overviewGroup === 'traffic' || overviewGroup === 'courses' || overviewGroup === 'deals' || overviewGroup === 'invite' || overviewGroup === 'participation' ? 'traffic-panel-control' : ''}}" data-index="{{si}}" bindtap="openPanelSelect">
              <text class="control-text">{{sel.multi ? sel.displayValue : sel.options[sel.index].label}}</text>
              <view class="chevron {{overviewGroup === 'traffic' || overviewGroup === 'courses' || overviewGroup === 'deals' || overviewGroup === 'invite' || overviewGroup === 'participation' ? 'course-picker-arrow' : ''}}"></view>
            </view>
          </view>
        </view>
        <view class="traffic-deal-breakdown" wx:if="{{overviewGroup === 'traffic' && trafficCustomersCount > 0}}">
          <view class="traffic-deal-total-row">
            <text class="traffic-deal-label">成交总计</text>
            <text class="traffic-deal-total-value {{trafficDealsActive ? 'active' : ''}}" data-kind="deals" bindtap="onTrafficDealFilter">{{trafficDealTotal}} 笔</text>
          </view>
          <view class="traffic-deal-products" wx:if="{{trafficProductTotals.length}}">
            <text class="traffic-deal-detail-label">明细</text>
            <view class="traffic-deal-product {{item.active ? 'active' : ''}}" wx:for="{{trafficProductTotals}}" wx:key="key" data-kind="product" data-key="{{item.key}}" bindtap="onTrafficDealFilter">
              <text class="traffic-deal-product-label">{{item.label}}</text>
              <text class="traffic-deal-product-count">{{item.count}} 笔</text>
            </view>
          </view>
        </view>
        <view class="overview-summary" wx:if="{{panelMetrics.length}}">
          <view wx:for="{{panelMetrics}}" wx:for-item="metricItem" wx:for-index="metricIndex" wx:key="label" class="overview-summary-line {{metricIndex === 0 ? 'total' : ''}} {{overviewGroup === 'invite' && metricIndex === 4 ? 'minor' : ''}} {{metricItem.action ? 'tappable' : ''}} {{metricItem.active ? 'active' : ''}}" data-action="{{metricItem.action}}" bindtap="onMetricTap">
            <text class="overview-summary-label">{{metricItem.label}}</text>
            <text class="overview-summary-value {{overviewGroup === 'courses' ? '' : (metricItem.sub ? '' : 'solo')}}">{{metricItem.value}}</text>
            <text class="overview-summary-sub" wx:if="{{metricItem.sub}}">{{metricItem.sub}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view class="stats" wx:if="{{query.tab !== 'overview'}}"><view wx:for="{{summary}}" wx:key="label" class="stat"><view class="muted">{{item.label}}</view><view class="number">{{item.value}}</view></view></view>
  <!-- 已筛选：点 ✕ 取消这一项，和 PC 一致 -->
  <view class="chips" wx:if="{{picks.length}}">
    <text class="chip active" wx:for="{{pickChips}}" wx:key="value" data-value="{{item.value}}" bindtap="clearPick">已筛选：{{item.label}} ✕</text>
  </view>
  <!-- 列表：一行两行式（主标题 + 灰字详情 + 右侧日期），点行进明细 -->
  <!-- 课程数：课程记录 / 参与者 切换放到列表上面 -->
  <view class="course-view-bar" wx:if="{{query.tab === 'overview' && overviewGroup === 'courses'}}">
    <view class="course-view-tabs">
      <view class="course-view-tab {{query.course_view === 'course' ? 'active' : ''}}" data-view="course" bindtap="onCourseView"><text>课程记录</text><text class="invite-tab-count" wx:if="{{query.course_view === 'course' && !loading}}">{{total}}</text></view>
      <view class="course-view-tab {{query.course_view === 'participant' ? 'active' : ''}}" data-view="participant" bindtap="onCourseView"><text>参与者</text><text class="invite-tab-count" wx:if="{{query.course_view === 'participant' && !loading}}">{{total}}</text></view>
      <view class="course-view-tab {{query.course_view === 'teacher_follow_up' ? 'active' : ''}}" wx:if="{{metadata.can_view_follow_up}}" data-view="teacher_follow_up" bindtap="onCourseView"><text>老师跟进</text><text class="invite-tab-count" wx:if="{{query.course_view === 'teacher_follow_up' && !loading}}">{{total}}</text></view>
    </view>
    <view class="course-toolbar-actions">
      <text class="tool-btn" wx:if="{{query.course_view === 'teacher_follow_up' || (query.course_view === 'participant' && metadata.can_view_follow_up)}}" bindtap="toggleExpandCells">{{expandCells ? '缩略' : '展开'}}</text>
      <text class="tool-btn" bindtap="openSortSheet">排序</text>
      <text class="tool-btn" bindtap="exportData">{{busy ? '导出中' : '导出'}}</text>
    </view>
  </view>
  <view class="teacher-list" wx:if="{{query.tab === 'overview' && overviewGroup === 'courses' && renderCourseView === 'teacher_follow_up'}}">
    <view class="empty muted" wx:if="{{!teacherDays.length && loading}}">加载中…</view>
    <view class="empty muted" wx:if="{{!teacherDays.length && !loading && !error}}">暂无符合条件的数据</view>
    <view class="teacher-day" wx:for="{{teacherDays}}" wx:key="date" wx:for-item="day">
      <view class="teacher-day-head"><view class="teacher-day-date"><view class="teacher-day-mark"></view><text>{{day.shortDate}} {{day.weekday}}</text></view><text class="teacher-day-count">{{day.teacherCount}} 位老师 · {{day.courseCount}} 门课</text></view>
      <view class="teacher-group" wx:for="{{day.teachers}}" wx:key="id" wx:for-item="teacher">
        <view class="teacher-group-head">
          <view class="teacher-group-summary"><text class="teacher-group-name">{{teacher.name}}</text><view class="teacher-group-stats"><text class="teacher-group-stat">深度需求 <text class="{{teacher.infoMissing ? 'teacher-pending' : ''}}">{{teacher.info}}/{{teacher.total}}</text></text><text class="teacher-group-stat">跟进点 <text class="{{teacher.pointMissing ? 'teacher-pending' : ''}}">{{teacher.point}}/{{teacher.total}}</text></text></view><text class="teacher-group-meta">{{teacher.courseCount}} 门课 · {{teacher.total}} 人次</text></view>
        </view>
        <view class="teacher-courses">
          <view class="teacher-course" wx:for="{{teacher.courses}}" wx:key="id" wx:for-item="course">
            <view class="teacher-course-head"><text class="teacher-course-index">{{course.indexText}}</text><view class="teacher-course-main"><text class="teacher-course-name">{{course.name}}</text><text class="teacher-course-type">{{course.typeLabel}}</text></view><text class="teacher-course-count">{{course.rows.length}} 人</text></view>
            <view class="teacher-person" wx:for="{{course.rows}}" wx:key="id" wx:for-item="person">
              <view class="teacher-person-head"><text class="teacher-person-name" data-id="{{person.customer_id}}" data-course="{{person.course_id}}" bindtap="openParticipantProfile">{{person.customer}}</text><text wx:if="{{person.ownerFirst}}" class="teacher-owner">案主</text></view>
              <view class="teacher-feedback" wx:for="{{person.feedback}}" wx:key="index" wx:for-item="feedback" wx:for-index="fi" data-id="{{person.id}}" bindtap="openTeacherDetail">
                <text class="teacher-feedback-label">{{fi === 0 ? '来访需求' : fi === 1 ? '深度需求' : fi === 2 ? '跟进点' : '客户反馈'}}</text>
                <view class="note-feedback-summary" wx:if="{{fi === 2 && person.followUpEntries.length}}">
                  <view class="note-feedback-entry" wx:for="{{person.followUpEntries}}" wx:for-item="entry" wx:key="index">
                    <template is="note-feedback-meta" data="{{author: entry.author, nextFollowUpText: entry.nextFollowUpText}}" />
                    <text class="teacher-feedback-text {{expandCells ? 'expanded' : ''}}">{{entry.content}}</text>
                  </view>
                </view>
                <text class="teacher-feedback-text {{expandCells ? 'expanded' : ''}}" wx:elif="{{feedback}}">{{feedback}}</text>
                <text class="teacher-empty-dash" wx:else>—</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
  <view class="participation-list" wx:if="{{query.tab === 'overview' && overviewGroup === 'participation'}}">
    <view class="participation-toolbar"><text class="mobile-list-count">共 {{total}} 人 · 按参与次数从多到少</text><text class="tool-btn" bindtap="exportData">{{busy ? '导出中' : '导出'}}</text></view>
    <view class="participation-card" wx:for="{{list}}" wx:for-item="member" wx:key="id">
      <view class="participation-person-head"><text class="participation-person-name">{{member.name}}</text><text class="participation-total">参与 {{member.count}} 次</text></view>
      <text class="participation-type-summary">{{member.typeText}}</text>
      <view class="participation-roles"><text wx:if="{{showParticipationOwners}}">案主 {{member.owner_count}} 次</text><text>参与者 {{member.participant_count}} 次</text></view>
      <view class="participation-group" wx:for="{{member.visibleGroups}}" wx:for-item="group" wx:key="type">
        <text class="participation-type-title">{{group.type}} · {{group.count}} 次</text>
        <view class="participation-activity" wx:for="{{group.records}}" wx:for-item="activity" wx:key="id">
          <text class="participation-date">{{activity.date}}</text>
          <view class="participation-activity-main"><text class="participation-activity-name">{{activity.name}}</text><text class="participation-activity-meta">{{activity.role}} · {{activity.teachers || '老师未记录'}}</text></view>
        </view>
      </view>
      <text class="mobile-expand" wx:if="{{member.hiddenCount}}" data-id="{{member.id}}" bindtap="toggleParticipation">{{member.open ? '收起' : '展开全部 ' + member.count + ' 次参与'}}</text>
    </view>
    <view wx:if="{{!list.length && !loading && !error}}" class="empty muted">暂无符合条件的活动参与记录</view>
  </view>
  <view class="participant-course-list" wx:if="{{query.tab === 'overview' && overviewGroup === 'courses' && participantCards && renderCourseView === 'participant'}}">
