      <text class="participant-course-meta">{{course.typeLabel}} · {{course.organization}} · {{course.teachers || '老师未记录'}} · {{course.hours || 0}} 课时</text>
      <view class="participant-person" wx:for="{{course.visiblePeople}}" wx:for-item="person" wx:key="id">
        <view class="participant-person-head"><text class="participant-person-name" data-id="{{person.customer_id}}" data-course="{{course.course_id}}" catchtap="openParticipantProfile">{{person.customer}}</text><member-labels identity="{{person.member_type}}" status="{{person.card_status}}" tone="{{person.card_status_tone}}" /><text class="participant-person-role">{{person.participant_role}}</text></view>
        <view class="participant-totals"><text>累计课程 <text class="participant-total-link" data-id="{{person.customer_id}}" data-course="{{course.course_id}}" catchtap="openHistory">{{person.org_participation_count || 0}}</text></text><text>累计课时 {{person.org_participation_hours || 0}} 课时</text></view>
        <view class="participant-feedback" wx:for="{{person.feedback}}" wx:for-item="field" wx:key="key" data-id="{{person.customer_id}}" data-course="{{course.course_id}}" catchtap="openTeacherDetail">
          <view class="participant-feedback-label"><text>{{field.label}}</text><text wx:if="{{field.count}}">{{field.count}}条</text></view>
          <view class="participant-feedback-body">
            <block wx:for="{{field.entries}}" wx:for-item="entry" wx:for-index="entryIndex" wx:key="id">
              <view class="participant-note-entry" wx:if="{{expandCells || entryIndex === 0}}"><text class="participant-note-text {{expandCells ? 'expanded' : ''}}">{{entry.author}}：{{entry.content}}</text><text wx:if="{{entry.nextFollowUpText}}" class="participant-next-plan">下次跟进：{{entry.nextFollowUpText}}</text></view>
            </block>
            <text class="teacher-empty-dash" wx:if="{{!field.count}}">—</text>
          </view>
        </view>
      </view>
      <text class="mobile-expand" wx:if="{{course.hiddenCount}}" data-course="{{course.course_id}}" bindtap="toggleCoursePeople">{{course.open ? '收起' : '展开其余 ' + course.hiddenCount + ' 人'}}</text>
    </view>
    <view wx:if="{{!list.length && !loading && !error}}" class="empty muted">暂无符合条件的用户</view>
  </view>
  <view class="record-card {{query.tab === 'overview' && overviewGroup === 'courses' ? 'course-result-card' : ''}}" wx:if="{{overviewGroup !== 'participation' && (list.length || (query.tab === 'overview' && (overviewGroup === 'invite' || overviewGroup === 'courses'))) && !(query.tab === 'overview' && overviewGroup === 'courses' && (renderCourseView === 'teacher_follow_up' || participantCards))}}">
    <block wx:if="{{query.tab === 'overview' && overviewGroup === 'invite'}}">
      <view class="invite-toolbar" catchtap="noop">
        <view class="invite-toolbar-tabs">
          <view class="invite-toolbar-tab {{inviteView === 'arrive' ? 'active' : ''}}" data-view="arrive" bindtap="onInviteView"><text>邀约到店</text><text class="invite-tab-count" wx:if="{{inviteView === 'arrive' && !loading}}">{{total}}</text></view>
          <view class="invite-toolbar-tab {{inviteView === 'initiated' ? 'active' : ''}}" data-view="initiated" bindtap="onInviteView"><text>发起邀约</text><text class="invite-tab-count" wx:if="{{inviteView === 'initiated' && !loading}}">{{total}}</text></view>
        </view>
        <view class="invite-toolbar-actions">
          <text class="tool-btn" bindtap="onInviteExport">{{busy ? '导出中' : '导出'}}</text>
          <text class="tool-btn invite-toolbar-more {{inviteToolMenuOpen ? 'active' : ''}}" bindtap="toggleInviteToolMenu">⋯</text>
        </view>
        <view class="invite-tools-menu" wx:if="{{inviteToolMenuOpen}}">
          <picker wx:if="{{inviteView === 'arrive'}}" range="{{arrivalViewOptions}}" value="{{arrivalView === 'date' ? 1 : 0}}" bindchange="onArrivalView">
            <view class="invite-tools-menu-item invite-display-mode"><text>显示方式</text><text class="invite-display-value">{{arrivalView === 'date' ? '按日期显示每条邀约记录' : '单个客户仅显示一次'}}</text></view>
          </picker>
          <view class="invite-tools-menu-item" wx:if="{{arrivalView !== 'date'}}" data-action="columns" bindtap="onInviteToolAction">列表设置</view>
          <view class="invite-tools-menu-item" wx:if="{{arrivalView !== 'date'}}" data-action="expand" bindtap="onInviteToolAction">{{expandCells ? '缩略' : '展开'}}</view>
          <view class="invite-tools-menu-item" wx:if="{{arrivalView !== 'date' && sortFields.length}}" data-action="sort" bindtap="onInviteToolAction">排序</view>
        </view>
      </view>
    </block>
    <!-- 工具按钮放在列表白卡里面（和课程记录页一致），不再浮在灰底上 -->
    <view class="list-head" wx:if="{{overviewGroup !== 'invite' && !(query.tab === 'overview' && overviewGroup === 'courses')}}">
      <text class="list-count">共 {{total}} 条</text>
      <view class="list-actions">
        <picker wx:if="{{overviewGroup === 'deals'}}" range="{{listViewOptions}}" value="{{listViewIndex}}" bindchange="onListView"><view class="tool-btn tool-btn-flex"><text class="control-text">{{listViewOptions[listViewIndex]}}</text><view class="chevron"></view></view></picker>
        <text class="tool-btn" wx:if="{{sortFields.length}}" bindtap="openSortSheet">排序</text>
        <text class="tool-btn" wx:if="{{overviewGroup === 'traffic'}}" bindtap="openColumnSheet">列表设置</text>
        <text class="tool-btn" bindtap="exportData">{{busy ? '导出中' : '导出'}}</text>
      </view>
    </view>
    <block wx:if="{{showArrivalDateCards}}">
      <view class="arrival-day" wx:for="{{list}}" wx:key="id">
        <view class="arrival-day-head">
          <text class="arrival-day-date">{{item.date}}</text>
          <text class="arrival-day-count">共 {{item.people}} 人</text>
        </view>
        <view class="arrival-visit" wx:for="{{item.visibleRecords}}" wx:for-item="visit" wx:key="id">
          <view class="arrival-visit-top">
            <text class="arrival-time">{{visit.arrive_time || '—'}}</text>
            <text class="arrival-name" wx:if="{{visit.customer_id}}" data-id="{{visit.customer_id}}" catchtap="openCustomerProfile">{{visit.name}}</text>
            <text class="arrival-name" wx:else>{{visit.name}}</text>
            <text class="arrival-status {{visit.arrived ? 'arrived' : ''}}">{{visit.status_label}}</text>
          </view>
          <view class="arrival-line"><text class="arrival-label">邀约人</text><text class="arrival-value">{{visit.arrive_inviter || '—'}}</text></view>
          <view class="arrival-line"><text class="arrival-label">来访需求</text><text class="arrival-value">{{visit.needs || '—'}}</text></view>
          <view class="arrival-line"><text class="arrival-label">当日参加活动</text><text class="arrival-value">{{visit.same_day_activities || '—'}}</text></view>
          <view class="arrival-line"><text class="arrival-label">当日成交</text><text class="arrival-value">{{visit.same_day_deal_text || '—'}}</text></view>
        </view>
        <view wx:if="{{item.hiddenCount}}" class="arrival-more" data-id="{{item.id}}" catchtap="toggleArrivalDay">{{item.open ? '收起' : '展开其余 ' + item.hiddenCount + ' 条'}}</view>
      </view>
    </block>
    <block wx:else>
    <view wx:for="{{list}}" wx:key="id" class="record-row" data-index="{{index}}" bindtap="showDetails">
      <view class="record-main">
        <view class="record-top {{item.rowSubtitle ? 'has-subtitle' : ''}}">
          <view class="record-title-wrap">
            <text class="record-title" wx:if="{{item.rowLinkId && query.tab === 'overview' && overviewGroup === 'courses' && (renderCourseView === 'participant' || renderCourseView === 'teacher_follow_up')}}" data-id="{{item.rowLinkId}}" data-course="{{item.course_id}}" catchtap="openParticipantProfile">{{item.rowTitle}}</text>
            <text class="record-title" wx:elif="{{item.rowLinkId}}" data-id="{{item.rowLinkId}}" catchtap="openCustomerProfile">{{item.rowTitle}}</text>
            <text class="record-title" wx:else>{{item.rowTitle}}</text>
            <text class="record-subtitle" wx:if="{{item.rowSubtitle}}">{{item.rowSubtitle}}</text>
          </view>
          <member-labels identity="{{item.rowIdentity}}" status="{{item.card_status}}" tone="{{item.card_status_tone}}" />
        </view>
        <!-- 分类值做成小标签 -->
        <view class="record-tags" wx:if="{{item.rowTags.length}}">
          <view class="record-tag" wx:for="{{item.rowTags}}" wx:key="label">
            <text class="record-tag-label">{{item.label}}</text>
            <text class="record-tag-value {{expandCells ? 'expanded' : ''}}">{{item.value}}</text>
          </view>
        </view>
        <!-- 数字单独一行，带短前缀 -->
        <view class="record-numbers" wx:if="{{item.rowNumbers.length}}">
          <text class="record-number" wx:for="{{item.rowNumbers}}" wx:key="label"><text class="record-number-label">{{item.label}}</text><text class="teacher-empty-dash" wx:if="{{item.empty}}">—</text><text wx:else>{{item.value}}</text></text>
        </view>
        <!-- 客户档案类字段：单独成块、不加底色，放在数字下面、日期上面 -->
        <view class="record-profiles" wx:if="{{item.rowProfiles.length}}">
          <view class="record-profile" wx:for="{{item.rowProfiles}}" wx:key="label">
            <text class="record-profile-label">{{item.label}}</text>
            <text class="record-profile-value {{expandCells ? 'expanded' : ''}}" wx:if="{{item.people.length}}"><block wx:for="{{item.people}}" wx:key="id" wx:for-item="person" wx:for-index="personIndex">{{personIndex ? '、' : ''}}{{person.name}}</block></text>
            <text class="record-profile-value {{expandCells ? 'expanded' : ''}}" wx:else>{{item.value}}</text>
          </view>
        </view>
        <text class="record-right" wx:if="{{item.rowRight}}">{{item.rowRight}}</text>
      </view>
    </view>
    </block>
    <view wx:if="{{query.tab === 'overview' && overviewGroup === 'invite' && !list.length && !loading && !error}}" class="empty muted">暂无符合条件的数据</view>
    <view wx:if="{{query.tab === 'overview' && overviewGroup === 'courses' && !list.length && loading}}" class="empty muted">加载中…</view>
    <view wx:if="{{query.tab === 'overview' && overviewGroup === 'courses' && !list.length && !loading && !error}}" class="empty muted">暂无符合条件的数据</view>
  </view>
  <view wx:if="{{loading && !list.length && query.tab !== 'overview'}}" class="empty muted">加载中…</view>
  <view wx:if="{{loading && !list.length && query.tab === 'overview' && overviewGroup !== 'courses'}}" class="empty muted">加载中…</view>
  <view wx:if="{{!list.length && !loading && !error && query.tab !== 'overview'}}" class="empty muted">暂无符合条件的数据</view>
  <view wx:if="{{!list.length && !loading && !error && query.tab === 'overview' && overviewGroup !== 'invite' && overviewGroup !== 'courses'}}" class="empty muted">暂无符合条件的数据</view>
  <!-- 条件字段 / 规则 / 值：底部弹层，和自定义筛选同一套 -->
  <view class="sheet-mask" wx:if="{{condSheet}}" catchtouchmove="noop" bindtap="closeCondSheet"></view>
  <view class="column-sheet" wx:if="{{condSheet}}">
    <view class="sheet-head"><text class="sheet-title">{{condSheet.title}}</text><text class="sheet-done" bindtap="closeCondSheet">{{condSheet.kind === 'multi' ? '完成' : '关闭'}}</text></view>
    <scroll-view class="sheet-list" scroll-y>
      <view class="sheet-item" wx:for="{{condSheet.options}}" wx:key="value" data-index="{{index}}" bindtap="onCondSheetOption">
        <text class="sheet-item-name {{item.checked ? 'selected' : ''}}">{{item.label}}</text>
        <text class="sheet-item-note" wx:if="{{item.note}}">{{item.note}}</text>
        <view class="sheet-check {{item.checked ? 'selected' : ''}}">{{item.checked ? '✓' : ''}}</view>
      </view>
      <view class="empty muted" wx:if="{{!condSheet.options.length}}">暂无可选项</view>
    </scroll-view>
  </view>

  <!-- 保存规则：名称 / 说明 / 可见范围（和自定义筛选的「保存模板」一致） -->
  <view class="save-rule-mask" wx:if="{{showSaveRule}}" bindtap="closeSaveRule">
    <view class="save-rule-dialog" catchtap="noop">
      <view class="save-rule-head"><text class="save-rule-title">保存转化规则</text></view>
      <view class="save-rule-body">
        <view class="save-rule-row">
          <text class="save-rule-label">规则名称</text>
          <input class="save-rule-input" value="{{ruleNameDraft}}" maxlength="80" placeholder="例如：粗门首次到场 → 会员卡首购" placeholder-class="save-rule-placeholder" bindinput="onRuleNameInput" />
        </view>
        <view class="save-rule-row">
          <text class="save-rule-label">规则说明</text>
          <input class="save-rule-input" value="{{ruleDescriptionDraft}}" maxlength="200" placeholder="简要说明这条规则的用途（选填）" placeholder-class="save-rule-placeholder" bindinput="onRuleDescriptionInput" />
        </view>
        <view class="save-rule-row">
          <text class="save-rule-label">可见范围</text>
          <view class="save-rule-scope">
            <view class="save-rule-scope-item {{ruleScopeDraft === 'private' ? 'active' : ''}}" data-scope="private" bindtap="onRuleScopeTap">仅自己可见</view>
            <view class="save-rule-scope-item {{ruleScopeDraft === 'shared' ? 'active' : ''}}" data-scope="shared" bindtap="onRuleScopeTap">团队共享</view>
          </view>
        </view>
        <text class="save-rule-note">保存时会一并记住当前的筛选范围（组织/俱乐部 + 统计周期），下次选用这条规则会一起还原。</text>
      </view>
      <view class="save-rule-actions">
        <text class="save-rule-button cancel" bindtap="closeSaveRule">取消</text>
        <text class="save-rule-button confirm {{savingRule ? 'disabled' : ''}}" bindtap="confirmSaveRule">{{savingRule ? '保存中' : '保存'}}</text>
      </view>
    </view>
  </view>
  <view wx:if="{{detail}}" class="mask" bindtap="closeDetails"><view class="sheet" catchtap="noop"><view class="sheet-title">{{detail.title || '关联明细'}}<text class="link" bindtap="closeDetails">关闭</text></view><scroll-view scroll-y class="editor-scroll">
    <view wx:for="{{detail.detailRows}}" wx:key="index" class="evidence-row">
      <text class="evidence">{{item.text}}</text>
      <text class="record-link" wx:if="{{item.id}}" data-id="{{item.id}}" data-course="{{detail.id}}" catchtap="openParticipantProfile">资料 ›</text>
    </view>
    <view wx:if="{{!detail.detailRows.length}}" class="empty muted">暂无关联明细</view>
  </scroll-view></view></view>
  <view wx:if="{{teacherDetail}}" class="mask" bindtap="closeTeacherDetail"><view class="sheet" catchtap="noop"><view class="sheet-title">{{teacherDetail.customer}}的课程反馈<text class="link" bindtap="closeTeacherDetail">关闭</text></view><text class="teacher-dialog-meta">{{teacherDetail.participant_role}} · {{teacherDetail.date}} · {{teacherDetail.name}}</text><scroll-view scroll-y class="editor-scroll">
    <view class="teacher-dialog-section" wx:for="{{teacherDetail.sections}}" wx:key="label" wx:for-item="section">
      <text class="teacher-dialog-label">{{section.label}}</text>
      <view class="teacher-dialog-entry" wx:for="{{section.entries}}" wx:key="index" wx:for-item="entry">
        <view class="teacher-dialog-head"><view class="note-feedback-author"><template is="note-feedback-meta" data="{{author: entry.author || teacherDetail.teachers, nextFollowUpText: entry.nextFollowUpText}}" /></view><text>{{entry.atText}} <text wx:if="{{entry.created_by}}">{{entry.created_by}}<text class="attribution-action">创建</text></text></text></view>
        <text class="teacher-dialog-content">{{entry.content}}</text>
      </view>
      <view class="teacher-dialog-entry" wx:if="{{!section.entries.length}}"><view class="teacher-dialog-head" wx:if="{{section.fallback}}"><text>{{teacherDetail.teachers}}<text class="attribution-action">反馈</text></text><text wx:if="{{section.creators}}">{{section.creators}}<text class="attribution-action">创建</text></text><text wx:else>未记录</text></view><text class="teacher-dialog-content">{{section.fallback || '—'}}</text></view>
    </view>
  </scroll-view></view></view>

  <view wx:if="{{historySheet}}" class="mask" bindtap="closeHistory"><view class="sheet course-history-sheet" catchtap="noop">
    <view class="sheet-title">{{historySheet.name}}的参与课程<text class="history-close" bindtap="closeHistory">关闭</text></view>
    <view class="course-history-meta">{{historySheet.organization}} · {{historySheet.all ? '2026-01-01 至今' : (historySheet.query.date_from + ' 至 ' + (historySheet.query.date_to || '今天'))}}</view>
    <view class="course-history-tabs"><text class="{{!historySheet.all ? 'selected' : ''}}" data-all="false" bindtap="onHistoryRange">当前统计范围</text><text class="{{historySheet.all ? 'selected' : ''}}" data-all="true" bindtap="onHistoryRange">全部历史</text></view>
    <scroll-view scroll-y class="course-history-scroll" bindscrolltolower="loadMoreHistory">
      <view class="course-history-row" wx:for="{{historySheet.rows}}" wx:key="id">
        <view class="course-history-line"><text class="course-history-name">{{item.name}}</text><text>{{item.date}}</text></view>
        <text class="course-history-row-meta">{{item.course_subtype || item.type}} · {{item.teachers || '老师未记录'}} · {{item.participant_role}} · {{item.hours || 0}} 课时</text>
      </view>
      <view wx:if="{{historySheet.error}}" class="error" bindtap="retryHistory">{{historySheet.error}} · 点击重试</view>
      <view wx:if="{{historyLoading}}" class="empty muted">加载中…</view>
      <view wx:if="{{!historyLoading && !historySheet.error && !historySheet.rows.length}}" class="empty muted">暂无参与课程记录</view>
      <view wx:if="{{historySheet.hasMore && !historyLoading && !historySheet.error}}" class="mobile-expand" bindtap="loadMoreHistory">加载更多课程</view>
    </scroll-view>
    <text class="course-history-count" wx:if="{{!historyLoading || historySheet.rows.length}}">共 {{historySheet.total}} 场课程</text>
  </view></view>
  <!-- 列表设置：与「自定义筛选 → 选择显示内容」同一套底部弹层样式 -->
  <view class="sheet-mask" wx:if="{{columnSheetOpen}}" catchtouchmove="noop" bindtap="closeColumnSheet"></view>
  <view class="column-sheet" wx:if="{{columnSheetOpen}}">
    <view class="sheet-head" catchtouchmove="noop"><text class="sheet-title">选择显示内容</text><text class="sheet-done" bindtap="closeColumnSheet">完成</text></view>
    <view wx:if="{{query.tab === 'overview' && (overviewGroup === 'invite' || overviewGroup === 'traffic')}}" class="column-limit-note">最多选择15列，已选 {{columnVisibleCount}}/15</view>
    <scroll-view class="sheet-list column-list" scroll-y>
      <view class="sheet-item column-option" wx:for="{{columnSheetItems}}" wx:key="key" data-key="{{item.key}}" bindtap="onToggleColumn">
        <text class="sheet-item-name">{{item.label}}</text>
        <text class="column-move" data-key="{{item.key}}" data-offset="-1" catchtap="onMoveColumn">↑</text>
        <text class="column-move" data-key="{{item.key}}" data-offset="1" catchtap="onMoveColumn">↓</text>
        <view class="sheet-check {{item.visible ? 'selected' : ''}}">{{item.visible ? '✓' : ''}}</view>
      </view>
    </scroll-view>
    <view class="sheet-foot" catchtouchmove="noop"><text class="sheet-done" bindtap="resetColumns">恢复默认</text><text class="muted">↑ ↓ 调整顺序</text></view>
  </view>

  <!-- 排序：先选依据与方向，点应用后整批数据一起排 -->
  <view class="sheet-mask" wx:if="{{sortSheetOpen}}" catchtouchmove="noop" bindtap="closeSortSheet"></view>
  <view class="column-sheet sort-sheet" wx:if="{{sortSheetOpen}}">
    <view class="sheet-head" catchtouchmove="noop"><text class="sheet-title">排序方式</text><text class="sheet-done" bindtap="closeSortSheet">取消</text></view>
    <view class="sort-help">先选排序字段，再选顺序；只在点击“应用排序”后更新列表。</view>
    <view class="sort-section-title">排序字段</view>
    <scroll-view scroll-y class="sheet-list sort-list">
      <view class="sort-option" data-key="" bindtap="onSortField">
        <view class="sort-option-copy"><text class="sort-option-name">默认排序</text><text class="sort-option-note">{{overviewGroup === 'invite' && inviteView === 'arrive' ? '到店日期最近的在前' : '按页面原有顺序'}}</text></view>
        <view class="sort-radio {{!sortDraftField ? 'selected' : ''}}">{{!sortDraftField ? '✓' : ''}}</view>
      </view>
      <view class="sort-option" wx:for="{{sortFields}}" wx:key="key" data-key="{{item.key}}" bindtap="onSortField">
        <text class="sort-option-name">{{item.label}}</text>
        <view class="sort-radio {{sortDraftField === item.key ? 'selected' : ''}}">{{sortDraftField === item.key ? '✓' : ''}}</view>
      </view>
    </scroll-view>
    <view class="sort-actions" catchtouchmove="noop">
      <view class="sort-direction-head"><text>排序方向</text><text class="sort-direction-note" wx:if="{{!sortDraftField}}">选择具体字段后可调整</text></view>
      <view class="sort-directions {{!sortDraftField ? 'disabled' : ''}}">
        <view class="sort-direction {{sortDraftField && sortDraftOrder === 'desc' ? 'active' : ''}}" data-order="desc" bindtap="onSortOrder">降序<text>{{sortDirectionLabels.desc}}</text></view>
        <view class="sort-direction {{sortDraftField && sortDraftOrder === 'asc' ? 'active' : ''}}" data-order="asc" bindtap="onSortOrder">升序<text>{{sortDirectionLabels.asc}}</text></view>
      </view>
      <view class="sort-apply" bindtap="applySort">应用排序</view>
    </view>
  </view>

  <!-- 成交笔数：这个客户在这批数据里的每一笔成交 -->
  <view wx:if="{{dealSheet}}" class="mask" bindtap="closeDealSheet"><view class="sheet" catchtap="noop">
    <view class="sheet-title">{{dealSheet.name}} · 成交明细<text class="link" bindtap="closeDealSheet">关闭</text></view>
    <view wx:if="{{dealLoading}}" class="empty muted">加载中…</view>
    <scroll-view scroll-y class="editor-scroll" wx:else>
      <view class="deal-row" wx:for="{{dealSheet.rows}}" wx:key="id">
        <text class="deal-main">{{item.date}} · {{item.label}}</text>
        <text class="muted">{{item.organization}} · {{item.classification}} · {{item.closers}}</text>
      </view>
      <view wx:if="{{!dealSheet.rows.length}}" class="empty muted">暂无成交记录</view>
    </scroll-view>
  </view></view>

  <!-- 邀约 / 取消 / 到店 / 参与活动记录 -->
  <!-- 面板筛选项弹层：选项名 + 数量 -->
  <view class="sheet-mask" wx:if="{{panelSheet}}" catchtouchmove="noop" bindtap="closePanelSheet"></view>
  <view class="column-sheet {{overviewGroup === 'traffic' || overviewGroup === 'courses' || overviewGroup === 'deals' || overviewGroup === 'invite' || overviewGroup === 'participation' ? 'traffic-filter-sheet' : ''}}" wx:if="{{panelSheet}}">
    <view class="sheet-head"><text class="sheet-title">{{panelSheet.title}}</text><text class="sheet-done" bindtap="closePanelSheet">完成</text></view>
    <scroll-view class="sheet-list" scroll-y>
      <block wx:for="{{panelSheet.options}}" wx:key="rowKey">
      <view class="sheet-group" wx:if="{{item.groupLabel}}">{{item.groupLabel}}</view>
      <view class="sheet-item" data-index="{{index}}" bindtap="onPanelOption">
        <text class="sheet-item-name {{item.selected ? 'selected' : ''}}">{{item.label}}</text>
        <view class="sheet-item-copy">
          <text class="sheet-item-note">{{item.text}}</text>
          <text class="sheet-item-subnote" wx:if="{{item.note}}">{{item.note}}</text>
        </view>
        <view class="sheet-check {{item.selected ? 'selected' : ''}}">{{item.selected ? '✓' : ''}}</view>
      </view>
      </block>
    </scroll-view>
  </view>

  <view wx:if="{{recordSheet}}" class="mask" bindtap="closeRecordSheet"><view class="sheet" catchtap="noop">
    <view class="sheet-title">{{recordSheet.name}} · {{recordSheet.type === 'initiated' ? '发起邀约明细' : recordSheet.type === 'invited' ? '受邀记录' : recordSheet.type === 'cancelled' ? '取消记录' : recordSheet.type === 'arrived' ? '到店记录' : '参与活动'}}<text class="link" bindtap="closeRecordSheet">关闭</text></view>
    <view wx:if="{{recordLoading}}" class="empty muted">加载中…</view>
    <scroll-view scroll-y class="editor-scroll">
      <view class="deal-row" wx:for="{{recordSheet.rows}}" wx:key="index">
        <text class="deal-main">{{item.main}}</text>
        <text class="muted">{{item.sub}}</text>
        <text class="record-link" wx:if="{{item.id}}" data-id="{{item.id}}" catchtap="openCustomerProfile">查看客户资料 ›</text>
      </view>
      <view class="empty muted" wx:if="{{recordSheet.hasMore && !recordLoading}}" bindtap="loadMoreInviterRecords">继续加载 ›</view>
      <view wx:if="{{!recordSheet.rows.length && !recordLoading}}" class="empty muted">暂无记录</view>
    </scroll-view>
  </view></view>
</view>
