<page-meta page-style="{{showFilterPanel ? 'overflow:hidden;height:100vh;' : ''}}" />
<view class="page search-page">
  <view class="no-permission" wx:if="{{!hasPagePermission}}">
    <text class="no-permission-text">无权限访问此页面</text>
  </view>

  <block wx:else>
    <view class="search-bar search-screen-bar">
      <view class="search-input-wrap">
        <view class="search-symbol"></view>
        <input
          class="search-input"
          placeholder="搜索客户昵称"
          placeholder-class="placeholder"
          value="{{keyword}}"
          focus="{{true}}"
          bindinput="onSearchInput"
          bindconfirm="onSearchConfirm"
          confirm-type="search"
        />
        <view class="search-clear" wx:if="{{keyword}}" bindtap="onClearKeyword"></view>
      </view>
      <view class="filter-btn {{showFilterPanel ? 'active' : ''}}" bindtap="onToggleFilterPanel">
        <text>筛选</text>
        <text class="filter-count" wx:if="{{filterCount > 0}}">{{filterCount}}</text>
        <view class="filter-toggle-arrow {{showFilterPanel ? 'open' : ''}}"></view>
      </view>
    </view>

    <view class="dropdown-panel" wx:if="{{showFilterPanel}}">
      <view class="dropdown-mask" bindtap="onCloseFilterPanel"></view>
      <view class="dropdown-content filter-dropdown">
        <scroll-view class="filter-scroll" scroll-y="{{true}}" enable-flex="{{true}}" show-scrollbar="{{false}}">
          <view class="filter-body">
            <view class="filter-section">
              <view class="filter-section-title">创建人</view>
              <view class="tags-wrap">
                <view
                  class="tag-item {{item.selected ? 'active' : ''}}"
                  wx:for="{{creatorList}}"
                  wx:key="name"
                  bindtap="onToggleCreator"
                  data-name="{{item.name}}"
                >{{item.name}}</view>
              </view>
              <view class="filter-section-empty" wx:if="{{creatorList.length === 0}}">暂无创建人数据</view>
            </view>
          </view>
        </scroll-view>
        <view class="filter-actions">
          <text class="filter-reset" bindtap="onResetFilter">重置</text>
          <text class="filter-confirm" bindtap="onConfirmFilter">确定</text>
        </view>
      </view>
    </view>

    <view class="search-welcome" wx:if="{{!hasSearched && !loading}}">
      <view class="search-welcome-icon"><view class="search-symbol large"></view></view>
      <text class="search-welcome-title">搜索沟通记录</text>
      <text class="search-welcome-hint">输入客户昵称，或点击右上角按创建人筛选</text>
    </view>

    <view class="search-result-summary" wx:if="{{hasSearched && !loading}}">
      <text class="search-result-title">搜索结果</text>
      <text class="search-result-count">共 {{filtered.length}} 条</text>
    </view>

    <view class="list-area search-results-card" wx:if="{{!loading && filtered.length > 0}}">
      <view
        class="record-item"
        wx:for="{{filtered}}"
        wx:key="id"
        bindtap="onEdit"
        bindlongpress="onLongPress"
        data-id="{{item.id}}"
      >
        <view class="item-body">
          <view class="item-header">
            <text class="item-nickname">{{item.customer_nickname}}</text>
            <view class="item-meta">
              <text class="item-creator">{{item.creator || ''}}</text>
              <text class="item-date">{{item._dateStr}}</text>
              <text class="item-arrow" wx:if="{{item.can_edit}}">›</text>
            </view>
          </view>
          <text class="item-content">{{item.content}}</text>
        </view>
      </view>
    </view>

    <view class="loading" wx:if="{{loading}}"><text>搜索中...</text></view>
    <view class="empty-state search-empty" wx:if="{{hasSearched && !loading && filtered.length === 0}}">
      <view class="empty-circle"><text class="empty-char">空</text></view>
      <text class="empty-text">没有找到匹配的沟通记录</text>
      <text class="empty-hint">试试更短的昵称或调整创建人筛选</text>
    </view>
  </block>
</view>
