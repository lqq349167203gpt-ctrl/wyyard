.page {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
}

.placeholder {
  color: #b0b5bb;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search-input-wrap {
  flex: 1;
  background-color: #fff;
  border-radius: 12rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}

.filter-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  height: 72rpx;
  padding: 0 24rpx;
  background-color: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #8f959e;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
  flex-shrink: 0;
}

.filter-btn.active {
  color: #3370ff;
}

.filter-arrow {
  font-size: 20rpx;
}

/* 下拉面板 */
.dropdown-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
}

.dropdown-panel {
  position: fixed;
  top: 130rpx;
  right: 32rpx;
  background-color: #fff;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.12);
  z-index: 100;
  min-width: 240rpx;
  max-height: 480rpx;
  overflow-y: auto;
}

.dropdown-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: #1f2329;
  border-bottom: 1rpx solid #f5f6f7;
}

.dropdown-item:last-child {
  border-bottom: none;
}

.dropdown-item:active {
  background-color: #f7f8fa;
}

.dropdown-item.active {
  color: #3370ff;
}

.check {
  font-size: 28rpx;
  color: #3370ff;
}

.search-input {
  height: 72rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}

/* 列表 */
.list-area {
  background-color: #fff;
  border-radius: 12rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}

.record-item {
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f7f8fa;
}

.record-item:last-child {
  border-bottom: none;
}

.record-item:active {
  background-color: #f7f8fa;
}

.item-body {
  display: flex;
  flex-direction: column;
}

.item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 44rpx;
}

.item-nickname {
  font-size: 30rpx;
  color: #1f2329;
}

.item-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.item-creator {
  font-size: 22rpx;
  color: #8f959e;
}

.item-date {
  font-size: 22rpx;
  color: #b0b5bb;
}

.item-arrow {
  font-size: 32rpx;
  color: #c0c4cc;
}

.item-content {
  font-size: 24rpx;
  color: #8f959e;
  line-height: 1.5;
  word-break: break-all;
  margin-top: 8rpx;
}

/* 加载中 */
.loading {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
  color: #8f959e;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #b0b5bb;
}

/* 悬浮按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 80rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #3370ff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(51, 112, 255, 0.3);
}

.fab-icon {
  font-size: 48rpx;
  color: #fff;
  line-height: 1;
}
