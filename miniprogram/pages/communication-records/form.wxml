<page-meta page-style="{{showPicker ? 'overflow:hidden;height:100vh;' : ''}}" />
<view class="container">
  <view class="form-card">
    <view class="form-item" bindtap="onPickerOpen">
      <text class="form-label">用户昵称</text>
      <view class="picker-value-wrap">
        <text class="{{nickname ? '' : 'placeholder'}}">{{nickname || '搜索选择'}}</text>
        <text class="picker-clear" wx:if="{{nickname}}" catchtap="onClearNickname">x</text>
      </view>
    </view>
    <view class="form-item-content last">
      <text class="form-label-block">沟通记录</text>
      <textarea
        class="form-textarea"
        placeholder="请输入沟通记录"
        placeholder-class="form-textarea-placeholder"
        value="{{content}}"
        bindinput="onContentInput"
        disabled="{{isEdit && !canEdit}}"
        auto-height
        maxlength="-1"
      />
    </view>
  </view>

  <view class="actions">
    <button class="btn-delete" wx:if="{{isEdit && canDelete}}" bindtap="onDelete">删    除</button>
    <button class="btn-primary submit-btn" wx:if="{{!isEdit || canEdit}}" bindtap="onSubmit" loading="{{saving}}" disabled="{{saving}}">保    存</button>
  </view>

  <!-- 搜索选择弹窗 -->
  <view class="picker-mask" wx:if="{{showPicker}}" bindtap="onPickerClose"></view>
  <view class="picker-popup" wx:if="{{showPicker}}">
    <view class="picker-header">
      <text class="picker-title">选择客户</text>
      <text class="picker-close" bindtap="onPickerClose">关闭</text>
    </view>
    <view class="picker-search">
      <input class="picker-search-input" placeholder="搜索姓名或昵称" value="{{pickerKeyword}}" bindinput="onPickerSearch" focus="{{showPicker}}" />
    </view>
    <view class="search-match-count" wx:if="{{pickerKeyword && pickerMatchCount}}">匹配 {{pickerMatchCount}} 人<text wx:if="{{pickerMatchCount > 50}}">，显示前 50 人，请继续输入缩小范围</text></view>
    <scroll-view class="picker-list" scroll-y>
      <view
        class="picker-item"
        wx:for="{{pickerList}}"
        wx:key="id"
        bindtap="onPickerSelect"
        data-nickname="{{item.nickname}}"
      >
        <view class="search-person-copy"><text class="picker-item-name">{{item.nickname}}<text class="search-person-name" wx:if="{{item.name && item.name !== item.nickname}}">（{{item.name}}）</text></text><text class="search-person-phone" wx:if="{{item.phone_masked || item.phone_suffix}}">{{item.phone_masked || ('****' + item.phone_suffix)}}</text></view>
      </view>
      <view class="picker-empty" wx:if="{{pickerList.length === 0}}">
        <text>无匹配数据</text>
      </view>
    </scroll-view>
  </view>
</view>
