# LLM 配置
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-5

# Anthropic（备用）
ANTHROPIC_API_KEY=

# 飞书
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 微信小程序（员工端：账号密码登录 + 静默绑定 openid 续登）
WECHAT_APPID=
WECHAT_SECRET=

# 微信小程序（客户端：手机号登录）
WECHAT_CLIENT_APPID=
WECHAT_CLIENT_SECRET=

# 服务器
HOST=127.0.0.1
PORT=8000
DEBUG=false

# 开发环境免密登录开关（/api/wechat/dev-login）
# 反代后客户端 IP 恒为 127.0.0.1，IP 白名单失效，必须同时 DEBUG=true 且 ENABLE_DEV_LOGIN=true 才可用
# 生产环境务必保持 false 或不设置
ENABLE_DEV_LOGIN=false
