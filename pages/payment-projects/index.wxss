.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f7f8fa;
}

/* Tab 栏 */
.tab-bar {
  white-space: nowrap;
  background-color: #fff;
  padding: 0 16rpx;
  border-bottom: 1rpx solid #f0f1f2;
  flex-shrink: 0;
}

.tab-item {
  display: inline-block;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: #8f959e;
  position: relative;
}

.tab-item.active {
  color: #1f2329;
  font-weight: 500;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 24rpx;
  right: 24rpx;
  height: 4rpx;
  background-color: #3370ff;
  border-radius: 2rpx;
}

/* 列表区域 */
.list-area {
  flex: 1;
  padding: 20rpx 32rpx;
}

.empty-tip {
  text-align: center;
  padding: 120rpx 0;
  font-size: 28rpx;
  color: #b0b5bb;
}

/* 项目卡片 */
.project-card {
  display: flex;
  align-items: stretch;
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.card-main {
  flex: 1;
  padding: 28rpx 32rpx;
  min-width: 0;
}

.card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-nickname {
  font-size: 30rpx;
  font-weight: 500;
  color: #1f2329;
}

.card-amount {
  font-size: 30rpx;
  font-weight: 600;
  color: #3370ff;
}

.card-sub {
  margin-top: 12rpx;
}

.card-date {
  font-size: 24rpx;
  color: #8f959e;
}

.card-closer {
  font-size: 24rpx;
  color: #8f959e;
}

.card-extra {
  font-size: 24rpx;
  color: #b0b5bb;
}

.card-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  background-color: #e02020;
  flex-shrink: 0;
}

.delete-text {
  font-size: 26rpx;
  color: #fff;
}

/* 悬浮按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 80rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #3370ff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(51, 112, 255, 0.3);
}

.fab-text {
  font-size: 48rpx;
  color: #fff;
  line-height: 1;
}
