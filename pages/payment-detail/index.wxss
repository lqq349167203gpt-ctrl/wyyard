.pd-container {
  padding: 24rpx 32rpx;
  padding-bottom: 180rpx;
  min-height: 100vh;
  background-color: #f7f8fa;
}

.pd-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
  color: #8f959e;
  font-size: 28rpx;
}

/* 用户卡片 */
.pd-card {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.pd-user {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
}

.pd-username {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2329;
  margin-right: 16rpx;
}

.pd-type-tag {
  font-size: 24rpx;
  color: #3370ff;
  background-color: #f0f5ff;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
}

/* 信息行 */
.pd-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f1f2;
}

.pd-row-last {
  border-bottom: none;
}

.pd-label {
  min-width: 180rpx;
  font-size: 28rpx;
  color: #8f959e;
  flex-shrink: 0;
}

.pd-value {
  flex: 1;
  font-size: 28rpx;
  color: #1f2329;
  text-align: right;
}

.pd-price {
  color: #ff4d4f;
  font-weight: 500;
}

/* 底部按钮 */
.pd-bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 32rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  box-shadow: 0 -1rpx 4rpx rgba(0, 0, 0, 0.04);
}

.pd-btn-back {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  color: #1f2329;
  background-color: #f7f8fa;
  border-radius: 12rpx;
  border: none;
  padding: 0;
  text-align: center;
}

.pd-btn-back::after {
  border: none;
}

.pd-btn-edit {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  color: #ffffff;
  background-color: #3370ff;
  border-radius: 12rpx;
  border: none;
  padding: 0;
  text-align: center;
}

.pd-btn-edit::after {
  border: none;
}
