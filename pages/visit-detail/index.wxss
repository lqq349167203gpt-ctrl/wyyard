.container {
  padding: 24rpx 32rpx;
  padding-bottom: 180rpx;
  min-height: 100vh;
  background-color: #f7f8fa;
}

/* 客户信息卡 */
.profile-card {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}

.profile-header {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2329;
  margin-right: 16rpx;
}

.member-type {
  font-size: 24rpx;
  color: #3370ff;
  background-color: #f0f5ff;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
}

.profile-stats {
  display: flex;
  justify-content: space-around;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f1f2;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 600;
  color: #1f2329;
}

.stat-label {
  font-size: 22rpx;
  color: #8f959e;
  margin-top: 6rpx;
}

/* 到店按钮 */
.section {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}

.arrival-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 500;
  background-color: #3370ff;
  color: #ffffff;
  border-radius: 8rpx;
  border: none;
}

.arrival-btn::after {
  border: none;
}

.arrival-btn.arrived-btn {
  background-color: #34c759;
}

.arrival-time {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #8f959e;
  margin-top: 16rpx;
}

/* 信息区块 */
.section-title {
  display: block;
  font-size: 26rpx;
  color: #8f959e;
  margin-bottom: 16rpx;
}

.section-content {
  display: block;
  font-size: 28rpx;
  color: #1f2329;
  line-height: 1.6;
}

/* 活动列表 */
.activity-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.activity-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background-color: #f7f8fa;
  border-radius: 8rpx;
}

.activity-name {
  font-size: 28rpx;
  color: #1f2329;
}

.activity-role {
  font-size: 24rpx;
  color: #8f959e;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  box-shadow: 0 -1rpx 4rpx rgba(0, 0, 0, 0.04);
}

.edit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 500;
  background-color: #f7f8fa;
  color: #3370ff;
  border-radius: 8rpx;
  border: none;
}

.edit-btn::after {
  border: none;
}
