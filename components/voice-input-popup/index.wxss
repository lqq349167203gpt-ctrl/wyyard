.voice-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.voice-panel {
  width: 100%;
  height: 75vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 顶部 */
.voice-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #fff;
  border-bottom: 2rpx solid #e8eaed;
}

.voice-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

.voice-close {
  font-size: 32rpx;
  color: #8f959e;
  padding: 8rpx;
}

/* 消息区域 */
.voice-messages {
  flex: 1;
  overflow-y: auto;
}

.voice-msg-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 24rpx;
}

/* 消息行 */
.msg-row {
  display: flex;
}

.msg-row.user {
  justify-content: flex-end;
}

.msg-row.bot {
  justify-content: flex-start;
}

/* 气泡 */
.msg-bubble {
  max-width: 80%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.msg-bubble.user {
  background: #e8eaed;
  color: #1f2329;
  border-bottom-right-radius: 4rpx;
}

.msg-bubble.bot {
  background: transparent;
  color: #1f2329;
  padding: 8rpx 0;
  max-width: 100%;
}

.msg-bubble.bot.error {
  background: transparent;
  color: #d94040;
}

.msg-bubble.bot.thinking {
  background: transparent;
  color: #8f959e;
}

.msg-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8f959e;
}

.msg-error-reason {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: #fff5f5;
  border: 2rpx solid #fde2e2;
  border-radius: 8rpx;
}

.error-reason-text {
  font-size: 24rpx;
  color: #d94040;
}

.msg-example {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8f959e;
}

.msg-bubble.user .msg-example {
  color: rgba(255, 255, 255, 0.7);
}

/* AI 结果 */
.msg-ai-title {
  display: block;
  font-size: 26rpx;
  color: #1f2329;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.msg-fields {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.msg-field {
  display: flex;
  gap: 12rpx;
}

.msg-field-label {
  font-size: 24rpx;
  color: #8f959e;
  flex-shrink: 0;
  min-width: 100rpx;
}

.msg-field-value {
  font-size: 24rpx;
  color: #1f2329;
  word-break: break-all;
}

/* 操作按钮 */
.msg-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.msg-action-btn {
  flex: 1;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.msg-action-btn.confirm {
  background: #3370ff;
  color: #fff;
}

.msg-action-btn.edit {
  background: #f7f8fa;
  color: #3370ff;
  border: 2rpx solid #3370ff;
}

.msg-status {
  margin-top: 12rpx;
}

.msg-status-text {
  font-size: 24rpx;
  color: #07c160;
}

/* 加载 */
.msg-loading {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.voice-spinner-sm {
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid #e8eaed;
  border-top-color: #3370ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 输入区域 */
.voice-input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 2rpx solid #e8eaed;
}

.voice-mode-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f7f8fa;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.voice-mode-img {
  width: 44rpx;
  height: 44rpx;
}

.voice-text-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #f7f8fa;
  border-radius: 36rpx;
  font-size: 28rpx;
  color: #1f2329;
}

.voice-press-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  background: #f7f8fa;
  display: flex;
  align-items: center;
  justify-content: center;
  user-select: none;
}

.voice-press-btn.recording {
  background: #07c160;
}

.voice-press-text {
  font-size: 28rpx;
  color: #1f2329;
}

.voice-press-btn.recording .voice-press-text {
  color: #fff;
}

.voice-send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #3370ff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.voice-send-icon {
  width: 104rpx;
  height: 104rpx;
}
